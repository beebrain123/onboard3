<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Settings — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'settings', admin:user }) %>
<div class="a-main">
 <div class="a-content">
 <div class="a-page-header"><div><h1><i class="fas fa-gear"></i> Settings</h1><p>Platform configuration</p></div></div>

 <!-- Pathway Approval Mode -->
 <div class="a-card" style="animation-delay:0ms">
 <div class="a-card-header"><h2><i class="fas fa-shield-check"></i> Pathway Approval Mode</h2></div>
 <p style="font-size:.875rem;color:var(--text-3);margin-bottom:1.5rem">Control whether users are auto-approved when they select a pathway, or must submit an application for review.</p>
 <form method="POST" action="/admin/settings/pathway-approval-mode">
 <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem">
 <label style="flex:1;min-width:200px;cursor:pointer">
 <input type="radio" name="pathwayApprovalMode" value="auto" <%= pathwayApprovalMode === 'auto' ? 'checked' : '' %> style="accent-color:var(--green)">
 <span style="margin-left:.5rem;font-size:.9rem;font-weight:700;color:var(--text)">Auto-Approve</span>
 <div style="font-size:.78rem;color:var(--text-3);margin-left:1.375rem;margin-top:.25rem">Everyone is instantly approved when they select a pathway — no application needed.</div>
 </label>
 <label style="flex:1;min-width:200px;cursor:pointer">
 <input type="radio" name="pathwayApprovalMode" value="manual" <%= pathwayApprovalMode !== 'auto' ? 'checked' : '' %> style="accent-color:var(--green)">
 <span style="margin-left:.5rem;font-size:.9rem;font-weight:700;color:var(--text)">Manual Approval</span>
 <div style="font-size:.78rem;color:var(--text-3);margin-left:1.375rem;margin-top:.25rem">Users must submit a short application. You review and approve/reject from Pathway Applications.</div>
 </label>
 </div>
 <button type="submit" class="a-btn a-btn-primary a-btn-sm"><i class="fas fa-save"></i> Save Mode</button>
 </form>

 </div>

 <!-- Pathway Community Links -->
 <div class="a-card" style="animation-delay:30ms">
 <div class="a-card-header"><h2><i class="fas fa-map-signs"></i> Pathway Community Links</h2></div>
 <p style="font-size:.875rem;color:var(--text-3);margin-bottom:1.5rem">Set the Telegram group link for each pathway — shows as "Join Community" button on user dashboard.</p>
 <form method="POST" action="/admin/settings/pathways">
 <% ['web3_jobs','ai','nft','trading'].forEach(pw => { const pCfg = pathwayConfigs.find(p=>p.pathway===pw)||{}; const labels = {web3_jobs:'Web3 Jobs',ai:'AI & Web3',nft:'NFTs & Digital Assets',trading:'Trading'}; const icons = {web3_jobs:'fa-briefcase',ai:'fa-microchip',nft:'fa-image',trading:'fa-chart-line'}; %>
 <div style="background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;padding:1.125rem;margin-bottom:.875rem">
 <p style="font-size:.875rem;font-weight:800;color:var(--green);margin-bottom:.875rem;display:flex;align-items:center;gap:.5rem"><i class="fas <%= icons[pw] %>"></i> <%= labels[pw] %></p>
 <div class="a-form-row">
 <div class="a-form-group" style="margin-bottom:0"><label>Telegram Group Link</label><input type="url" name="<%= pw %>_groupLink" class="a-input" value="<%= pCfg.groupLink||'' %>" placeholder="https://t.me/..."></div>
 <div class="a-form-group" style="margin-bottom:0"><label>X Community Link</label><input type="url" name="<%= pw %>_xLink" class="a-input" value="<%= pCfg.xLink||'' %>" placeholder="https://x.com/..."></div>
 </div>
 </div>
 <% }) %>
 <button type="submit" class="a-btn a-btn-primary"><i class="fas fa-floppy-disk"></i> Save Pathway Links</button>
 </form>
 </div>

 <!-- Twitter Setting -->
 <div class="a-card" style="animation-delay:60ms">
 <div class="a-card-header"><h2><i class="fab fa-x-twitter"></i> X (Twitter) Requirement</h2></div>
 <p style="font-size:.875rem;color:var(--text-3);margin-bottom:1.25rem">When enabled, users must connect their X account to attempt social quests.</p>
 <form method="POST" action="/admin/settings/twitter">
 <div style="display:flex;align-items:center;gap:1.5rem">
 <label style="display:flex;align-items:center;gap:.75rem;cursor:pointer">
 <input type="checkbox" name="twitterRequired" value="true" <%= settings.twitterRequired ? 'checked' : '' %> style="width:18px;height:18px;accent-color:var(--green)">
 <span style="font-size:.9rem;font-weight:600;color:var(--text)">Require X account for social quests</span>
 </label>
 <button type="submit" class="a-btn a-btn-primary a-btn-sm"><i class="fas fa-save"></i> Save</button>
 </div>
 </form>
 </div>

 <!-- Platform Stats -->
 <div class="a-card" style="animation-delay:120ms">
 <div class="a-card-header"><h2><i class="fas fa-chart-bar"></i> Platform Statistics</h2></div>
 <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem">
 <% Object.entries(platformStats).forEach(([key,val]) => { %>
 <div style="text-align:center;padding:1.125rem;border-radius:12px;background:rgba(255,255,255,.025);border:1px solid var(--border)">
 <div style="font-size:1.5rem;font-weight:900;color:var(--green);letter-spacing:-.5px"><%= val %></div>
 <div style="font-size:.68rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.8px;margin-top:3px"><%= key %></div>
 </div>
 <% }) %>
 </div>
 </div>
 </div>
</div>
<script>
async function resetAllPathways() {
 if (!confirm('This will clear the pathway for ALL users so they must pick again. Are you sure?')) return;
 const btn = document.getElementById('resetPathwaysBtn');
 const result = document.getElementById('resetPathwaysResult');
 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting...';
 try {
 const r = await fetch('/admin/api/reset-pathways', { method: 'POST' });
 const data = await r.json();
 result.style.display = '';
 if (data.success) {
 result.style.color = '#10b981';
 result.textContent = `Done — reset pathway for ${data.count} users.`;
 btn.innerHTML = '<i class="fas fa-check"></i> Done';
 } else {
 result.style.color = '#ef4444';
 result.textContent = data.message || 'Error resetting pathways.';
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-rotate-left"></i> Reset All Pathways';
 }
 } catch (e) {
 result.style.display = '';
 result.style.color = '#ef4444';
 result.textContent = 'Network error.';
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-rotate-left"></i> Reset All Pathways';
 }
}
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
</html>
