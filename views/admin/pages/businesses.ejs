<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Businesses — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'businesses', admin:user }) %>

<div class="a-main">
 <div class="a-content">
 <div class="a-page-header">
 <div>
 <h1><i class="fas fa-building"></i> Businesses</h1>
 <p><%= businesses.length %> total business accounts</p>
 </div>
 </div>

 <div style="display:flex;gap:.25rem;border-bottom:1px solid var(--border);margin-bottom:1.5rem">
 <% ['all','pending','approved','rejected','suspended'].forEach(t => { %>
 <a href="?status=<%= t %>" style="padding:.625rem 1.25rem;font-size:.875rem;font-weight:600;color:<%= (activeStatus||'all')===t?'var(--green)':'var(--text-3)' %>;border-bottom:2px solid <%= (activeStatus||'all')===t?'var(--green)':'transparent' %>;transition:color .15s">
 <%= t.charAt(0).toUpperCase()+t.slice(1) %>
 <span style="background:var(--surface-2);border-radius:20px;padding:.1rem .5rem;font-size:.7rem;margin-left:.25rem"><%= counts[t]||0 %></span>
 </a>
 <% }) %>
 </div>

 <div class="a-card">
 <% if (!businesses.length) { %>
 <div style="text-align:center;padding:3rem;color:var(--text-3)">
 <i class="fas fa-building" style="font-size:2.5rem;margin-bottom:1rem;opacity:.4;display:block"></i>
 <p>No business accounts yet.</p>
 </div>
 <% } else { %>
 <div class="a-table-wrap">
 <table class="at">
 <thead>
 <tr>
 <th>Business</th>
 <th>Username</th>
 <th>BD</th>
 <th>Industry</th>
 <th>Balance</th>
 <th>Spent</th>
 <th>Quests</th>
 <th>Bounties</th>
 <th>Status</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 <% businesses.forEach(biz => { %>
 <tr>
 <td>
 <div style="display:flex;align-items:center;gap:.625rem">
 <div style="width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#3b82f6,#1d4ed8);display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:800;color:#fff;flex-shrink:0">
 <%= biz.name.charAt(0).toUpperCase() %>
 </div>
 <div>
 <p style="font-weight:700;color:var(--text)"><%= biz.name %></p>
 <% if (biz.website) { %>
 <a href="<%= biz.website %>" target="_blank" style="font-size:.7rem;color:var(--blue)"><i class="fas fa-link"></i> site</a>
 <% } %>
 </div>
 </div>
 </td>
 <td style="font-family:monospace;color:var(--text-3);font-size:.8125rem">@<%= biz.username %></td>
 <td style="font-size:.8125rem;color:var(--text-2)"><%= biz.createdBy ? biz.createdBy.name : '—' %></td>
 <td style="color:var(--text-3);font-size:.8rem"><%= biz.industry %></td>
 <td style="color:var(--green);font-weight:700">$<%= (biz.balance||0).toFixed(2) %></td>
 <td style="color:var(--amber);font-weight:600">$<%= (biz.totalSpent||0).toFixed(2) %></td>
 <td style="color:var(--text-2)"><%= (biz.quests||[]).length %></td>
 <td style="color:var(--text-2)"><%= (biz.bounties||[]).length %></td>
 <td>
 <span class="a-badge a-badge-<%= biz.status==='approved'?'success':biz.status==='pending'?'warning':'danger' %>">
 <% if(biz.status==='approved'){ %><i class="fas fa-check"></i><% } else if(biz.status==='pending'){ %><i class="fas fa-clock"></i><% } else { %><i class="fas fa-times"></i><% } %>
 <%= biz.status %>
 </span>
 </td>
 <td>
 <div style="display:flex;gap:.375rem;flex-wrap:wrap">
 <% if (biz.status === 'pending') { %>
 <button class="a-btn a-btn-success" style="padding:.35rem .75rem;font-size:.75rem" onclick="approveBiz('<%= biz._id %>')">
 <i class="fas fa-check"></i> Approve
 </button>
 <button class="a-btn a-btn-danger" style="padding:.35rem .75rem;font-size:.75rem" onclick="rejectBiz('<%= biz._id %>', '<%= biz.name %>')">
 <i class="fas fa-times"></i> Reject
 </button>
 <% } else if (biz.status === 'approved') { %>
 <button class="a-btn a-btn-warning" style="padding:.35rem .75rem;font-size:.75rem" onclick="suspendBiz('<%= biz._id %>')">
 <i class="fas fa-ban"></i> Suspend
 </button>
 <% } else { %>
 <button class="a-btn a-btn-success" style="padding:.35rem .75rem;font-size:.75rem" onclick="approveBiz('<%= biz._id %>')">
 <i class="fas fa-rotate-left"></i> Re-approve
 </button>
 <% } %>
 <button class="a-btn a-btn-secondary" style="padding:.35rem .75rem;font-size:.75rem" onclick="loginAsBiz('<%= biz._id %>')">
 <i class="fas fa-right-to-bracket"></i> Login As
 </button>
 <button class="a-btn a-btn-danger" style="padding:.35rem .75rem;font-size:.75rem" onclick="deleteBiz('<%= biz._id %>', '<%= biz.name %>')">
 <i class="fas fa-trash"></i>
 </button>
 </div>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 <% } %>
 </div>
 </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;align-items:center;justify-content:center">
 <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;width:100%;max-width:420px;margin:1rem">
 <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
 <h3 style="font-size:1rem;font-weight:800">Reject Business</h3>
 <button onclick="document.getElementById('rejectModal').style.display='none'" style="background:none;border:none;color:var(--text-3);font-size:1.125rem;cursor:pointer"><i class="fas fa-times"></i></button>
 </div>
 <form id="rejectForm" method="POST">
 <div style="padding:1.5rem">
 <p style="color:var(--text-2);font-size:.875rem;margin-bottom:1rem">Rejecting <strong id="rejectName"></strong>. Reason:</p>
 <textarea name="reason" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:.75rem;color:var(--text);font-size:.875rem;font-family:inherit;resize:vertical;min-height:80px;outline:none" placeholder="Reason for rejection..."></textarea>
 </div>
 <div style="padding:1rem 1.5rem;border-top:1px solid var(--border);display:flex;gap:.5rem;justify-content:flex-end">
 <button type="button" onclick="document.getElementById('rejectModal').style.display='none'" class="a-btn a-btn-secondary" style="padding:.5rem 1rem;font-size:.8125rem">Cancel</button>
 <button type="submit" class="a-btn a-btn-danger" style="padding:.5rem 1rem;font-size:.8125rem"><i class="fas fa-times"></i> Reject</button>
 </div>
 </form>
 </div>
</div>

<script>
function approveBiz(id) {
 if (!confirm('Approve this business? They will be able to log in.')) return;
 fetch('/admin/businesses/' + id + '/approve', { method: 'POST' })
 .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.message); });
}
function suspendBiz(id) {
 if (!confirm('Suspend this business? They will lose portal access.')) return;
 fetch('/admin/businesses/' + id + '/suspend', { method: 'POST' })
 .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.message); });
}
function loginAsBiz(id) {
 fetch('/admin/businesses/' + id + '/login-as', { method: 'POST' })
 .then(r => r.json()).then(d => { if (d.success) window.open(d.redirect, '_blank'); else alert(d.message); });
}
function deleteBiz(id, name) {
 if (!confirm('Permanently delete business "' + name + '"? This cannot be undone.')) return;
 fetch('/admin/businesses/' + id + '/delete', { method: 'POST' })
 .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.message); });
}
function rejectBiz(id, name) {
 document.getElementById('rejectName').textContent = name;
 document.getElementById('rejectForm').action = '/admin/businesses/' + id + '/reject';
 document.getElementById('rejectModal').style.display = 'flex';
}
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
</html>
