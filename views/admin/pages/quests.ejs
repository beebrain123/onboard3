<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Quests — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 /* ── Responsive table ── */
 .a-table-wrap { width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch; }
 .at { min-width:720px; }
 .at td, .at th { white-space:nowrap; }
 .at td:first-child { white-space:normal; min-width:200px; }

 /* ── Quest Manager Panel ── */
 .qm-overlay {
 position:fixed;inset:0;background:rgba(0,0,0,.55);
 backdrop-filter:blur(4px);z-index:1000;
 opacity:0;pointer-events:none;transition:opacity .25s;
 }
 .qm-overlay.open { opacity:1;pointer-events:all; }
 .qm-panel {
 position:fixed;top:0;right:0;bottom:0;
 width:min(680px,100vw);
 background:#0d160d;
 border-left:1px solid rgba(94,194,19,.2);
 display:flex;flex-direction:column;
 transform:translateX(100%);
 transition:transform .3s cubic-bezier(.4,0,.2,1);
 z-index:1001;overflow:hidden;
 }
 .qm-overlay.open .qm-panel { transform:translateX(0); }

 .qm-head {
 display:flex;align-items:flex-start;justify-content:space-between;
 padding:1.25rem 1.5rem 0;border-bottom:1px solid rgba(94,194,19,.12);
 padding-bottom:1rem;flex-shrink:0;
 }
 .qm-head h3 { font-size:1.05rem;font-weight:800;color:#e8f5e2;margin-bottom:.35rem; }
 .qm-close {
 background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
 color:#8aaf85;width:32px;height:32px;border-radius:8px;cursor:pointer;
 display:flex;align-items:center;justify-content:center;flex-shrink:0;
 transition:background .15s;
 }
 .qm-close:hover { background:rgba(239,68,68,.15);color:#ef4444; }

 .qm-tabs {
 display:flex;gap:0;flex-shrink:0;
 border-bottom:1px solid rgba(94,194,19,.12);
 padding:0 1.5rem;
 }
 .qm-tab {
 padding:.625rem 1.25rem;font-size:.82rem;font-weight:700;
 background:transparent;border:none;cursor:pointer;
 color:#5a7a56;border-bottom:2px solid transparent;
 margin-bottom:-1px;transition:color .15s,border-color .15s;
 font-family:'Outfit',sans-serif;
 }
 .qm-tab.active { color:#5ec213;border-bottom-color:#5ec213; }
 .qm-tab:hover { color:#8aaf85; }

 .qm-body { flex:1;overflow-y:auto;padding:1.25rem 1.5rem; }
 .qm-body::-webkit-scrollbar { width:4px; }
 .qm-body::-webkit-scrollbar-thumb { background:rgba(94,194,19,.2);border-radius:2px; }

 /* Task list in panel */
 .task-row {
 display:flex;align-items:center;gap:.75rem;
 padding:.625rem .875rem;border-radius:10px;
 background:rgba(255,255,255,.03);border:1px solid rgba(94,194,19,.1);
 margin-bottom:.5rem;
 }
 .task-num {
 flex-shrink:0;width:26px;height:26px;border-radius:50%;
 background:rgba(94,194,19,.12);color:#5ec213;
 display:flex;align-items:center;justify-content:center;
 font-size:.72rem;font-weight:900;
 }
 .task-info { flex:1;min-width:0; }
 .task-info p { font-size:.83rem;font-weight:700;color:#e8f5e2;
 white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
 .task-info span { font-size:.7rem;color:#5a7a56; }
 .task-xp { font-size:.75rem;font-weight:800;color:#5ec213;white-space:nowrap; }
 .task-row--managed { align-items:flex-start;flex-wrap:wrap; }
 .task-row--managed .task-info { min-width:180px; }
 .task-row--managed .task-info p { white-space:normal;overflow:visible;text-overflow:clip;margin-bottom:.2rem; }
 .task-detail-chips { display:flex;gap:.3rem;flex-wrap:wrap;margin-top:.35rem; }
 .task-detail-chip { display:inline-flex;align-items:center;padding:.14rem .45rem;border-radius:999px;background:rgba(94,194,19,.08);color:#8aaf85!important;font-size:.65rem!important;border:1px solid rgba(94,194,19,.12); }
 .task-detail-chip--review { background:rgba(245,158,11,.08);color:#fbbf24!important;border-color:rgba(245,158,11,.2); }
 .task-row-actions { display:flex;gap:.35rem;margin-left:auto; }
 .task-row-actions button { padding:.4rem .55rem;font-size:.72rem; }
 .nt-detail-grid { grid-template-columns:1fr 1fr; }
 .nt-input-grid { grid-template-columns:1fr 1fr 1fr; }
 @media(max-width:620px){ .nt-detail-grid,.nt-input-grid { grid-template-columns:1fr; } .task-row-actions { width:100%;margin-left:34px; } }

 /* Add task form */
 .add-task-form {
 border:1px dashed rgba(94,194,19,.25);border-radius:12px;
 padding:1rem;margin-top:1rem;background:rgba(94,194,19,.03);
 }
 .add-task-form h4 { font-size:.8rem;font-weight:800;color:#8aaf85;
 text-transform:uppercase;letter-spacing:.08em;margin-bottom:.875rem; }
 .aqf-grid { display:grid;grid-template-columns:1fr 1fr;gap:.625rem;margin-bottom:.625rem; }
 @media(max-width:520px){ .aqf-grid{grid-template-columns:1fr;} }

 /* Entries table */
 .entries-wrap { overflow-x:auto;border-radius:10px;border:1px solid rgba(94,194,19,.12); }
 .entries-table { width:100%;border-collapse:collapse;min-width:540px; }
 .entries-table th {
 background:rgba(94,194,19,.06);font-size:.7rem;font-weight:800;
 text-transform:uppercase;letter-spacing:.07em;color:#5a7a56;
 padding:.6rem .875rem;text-align:left;white-space:nowrap;
 }
 .entries-table td {
 padding:.6rem .875rem;font-size:.8125rem;color:#e8f5e2;
 border-top:1px solid rgba(94,194,19,.07);vertical-align:middle;
 }
 .entries-table tr:hover td { background:rgba(94,194,19,.03); }
 .rank-badge {
 display:inline-flex;align-items:center;justify-content:center;
 width:26px;height:26px;border-radius:50%;
 font-size:.72rem;font-weight:900;
 }
 .rank-1 { background:rgba(234,179,8,.15);color:#eab308;border:1px solid rgba(234,179,8,.3); }
 .rank-2 { background:rgba(148,163,184,.1);color:#94a3b8;border:1px solid rgba(148,163,184,.25); }
 .rank-3 { background:rgba(180,83,9,.12);color:#c2793a;border:1px solid rgba(180,83,9,.25); }
 .rank-n { background:rgba(255,255,255,.05);color:#5a7a56;border:1px solid rgba(255,255,255,.08); }
 .sub-link {
 display:inline-flex;align-items:center;gap:.3rem;
 color:#60a5fa;font-size:.75rem;text-decoration:none;
 padding:.15rem .5rem;border-radius:20px;
 background:rgba(96,165,250,.08);border:1px solid rgba(96,165,250,.2);
 transition:background .15s;white-space:nowrap;
 }
 .sub-link:hover { background:rgba(96,165,250,.15); }
 .bonus-xp-btn {
 display:inline-flex;align-items:center;gap:.3rem;
 font-size:.72rem;font-weight:700;padding:.2rem .6rem;
 border-radius:20px;background:rgba(245,158,11,.08);
 color:#f59e0b;border:1px solid rgba(245,158,11,.25);
 cursor:pointer;transition:background .15s;font-family:'Outfit',sans-serif;
 }
 .bonus-xp-btn:hover { background:rgba(245,158,11,.18); }

 /* Reward plan preview */
 .reward-preview {
 margin-top:.625rem;padding:.625rem .875rem;border-radius:8px;
 background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.2);
 font-size:.8rem;color:#8aaf85;display:none;
 }
 .reward-preview strong { color:#5ec213; }

 /* Status tags */
 .qt-tag {
 display:inline-block;padding:.15rem .55rem;border-radius:20px;
 font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;
 }
 .qt-standard { background:rgba(94,194,19,.1); color:#5ec213; }
 .qt-fcfs { background:rgba(59,130,246,.1);color:#60a5fa; }
 .qt-competition{ background:rgba(168,85,247,.1);color:#c084fc; }
 .qt-referral_boost{ background:rgba(251,191,36,.1);color:#fbbf24; }
 .qt-default { background:rgba(255,255,255,.07);color:#8aaf85; }

 /* Flash */
 .qm-flash {
 padding:.5rem .875rem;border-radius:8px;font-size:.8rem;font-weight:700;
 margin-bottom:.875rem;display:none;
 }
 .qm-flash.ok { background:rgba(94,194,19,.12);color:#5ec213;border:1px solid rgba(94,194,19,.3); }
 .qm-flash.err { background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25); }
 </style>
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'quests', admin:user }) %>

<div class="a-main">
 <div class="a-content">

 <div class="a-page-header">
 <div>
 <h1><i class="fas fa-trophy"></i> Quest Management</h1>
 <p><%= quests.length %> quests — <%= quests.filter(q=>q.isActive).length %> active</p>
 </div>
 <button onclick="openModal('createQuestModal'); onCqTypeChange()" class="a-btn a-btn-primary">
 <i class="fas fa-plus"></i> Create Quest
 </button>
 </div>

 <!-- Stats -->
 <div class="a-stats">
 <div class="a-stat"><div class="a-stat-icon"><i class="fas fa-fire"></i></div><div class="a-stat-val"><%= quests.filter(q=>q.isActive).length %></div><div class="a-stat-lbl">Active</div></div>
 <div class="a-stat"><div class="a-stat-icon"><i class="fas fa-users"></i></div><div class="a-stat-val"><%= quests.reduce((s,q)=>s+(q.totalParticipants||0),0) %></div><div class="a-stat-lbl">Participants</div></div>
 <div class="a-stat"><div class="a-stat-icon"><i class="fas fa-check-circle"></i></div><div class="a-stat-val"><%= quests.reduce((s,q)=>s+(q.totalCompletions||0),0) %></div><div class="a-stat-lbl">Completions</div></div>
 <div class="a-stat"><div class="a-stat-icon"><i class="fas fa-coins"></i></div><div class="a-stat-val">$<%= quests.reduce((s,q)=>s+(q.usdcReward||0),0).toFixed(0) %></div><div class="a-stat-lbl">Total USDC</div></div>
 </div>

 <!-- Pending Business Quests -->
 <% var pendingBizQuests = quests.filter(function(q){ return q.approvalStatus === 'pending' && q.sponsoredBy; }); %>
 <% if (pendingBizQuests.length) { %>
 <div class="a-card" style="border-color:rgba(245,158,11,.3);margin-bottom:1.25rem">
 <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid rgba(245,158,11,.15)">
 <i class="fas fa-clock" style="color:#f59e0b"></i>
 <span style="font-weight:800;color:#f59e0b;font-size:.9rem">Pending Business Quests (<%= pendingBizQuests.length %>)</span>
 <span style="font-size:.75rem;color:#5a7a56;margin-left:auto">Review and approve or reject sponsor quests</span>
 </div>
 <% pendingBizQuests.forEach(function(q) { %>
 <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;padding:.875rem;background:rgba(245,158,11,.04);border:1px solid rgba(245,158,11,.12);border-radius:10px;margin-bottom:.625rem">
 <div style="min-width:0;flex:1">
 <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
 <span style="font-weight:700;color:#e8f5e2;font-size:.9rem"><%= q.title || '(untitled)' %></span>
 <span class="qt-tag qt-<%= q.questType || 'standard' %>"><%= q.questType || 'standard' %></span>
 <span style="font-size:.72rem;color:#f59e0b;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);padding:.1rem .5rem;border-radius:20px">$<%= (q.usdcReward||0).toFixed(2) %> pool</span>
 </div>
 <div style="font-size:.75rem;color:#5a7a56;margin-top:.2rem">
 by <strong style="color:#8aaf85"><%= q.sponsoredBy.name || q.sponsoredBy.username || 'Business' %></strong>
 &nbsp;·&nbsp; <%= (q.tasks && q.tasks.length) || 0 %> tasks
 </div>
 </div>
 <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
 <form method="POST" action="/admin/business-quests/<%= q._id %>/approve" style="display:inline">
 <button type="submit" class="a-btn a-btn-success a-btn-sm" onclick="return confirm('Approve and launch this quest?')">
 <i class="fas fa-check"></i> Approve
 </button>
 </form>
 <div class="bq-reject-wrap" style="position:relative">
 <button type="button" class="a-btn a-btn-danger a-btn-sm" onclick="toggleRejectForm(this)">
 <i class="fas fa-times"></i> Reject
 </button>
 <div class="bq-reject-form" style="display:none;position:absolute;right:0;top:calc(100% + .5rem);z-index:50;background:#0d160d;border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:.875rem;min-width:280px;box-shadow:0 8px 32px rgba(0,0,0,.5)">
 <form method="POST" action="/admin/business-quests/<%= q._id %>/reject">
 <label style="display:block;font-size:.72rem;font-weight:700;color:#ef4444;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.375rem">Rejection Reason</label>
 <textarea name="reason" placeholder="Explain why this quest is being rejected..." style="width:100%;box-sizing:border-box;background:rgba(255,255,255,.04);border:1px solid rgba(239,68,68,.25);border-radius:8px;color:#e8f5e2;padding:.5rem .75rem;font-size:.8rem;font-family:'Outfit',sans-serif;min-height:70px;resize:vertical;outline:none;margin-bottom:.5rem"></textarea>
 <div style="display:flex;gap:.5rem;justify-content:flex-end">
 <button type="button" class="a-btn a-btn-secondary a-btn-sm" onclick="toggleRejectForm(this.closest('.bq-reject-form').previousElementSibling)">Cancel</button>
 <button type="submit" class="a-btn a-btn-danger a-btn-sm"><i class="fas fa-ban"></i> Confirm Reject</button>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
 <% }); %>
 </div>
 <% } %>

 <!-- Quest Table -->
 <div class="a-card">
 <div class="a-table-wrap">
 <table class="at">
 <thead>
 <tr>
 <th>Quest</th>
 <th>Type</th>
 <th>Rewards</th>
 <th>Reward Plan</th>
 <th>Participants</th>
 <th>Status</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 <% quests.forEach(q => {
 const typeClass = 'qt-' + (q.questType || 'standard');
 const hasPlan = q.rewardPlan && q.rewardPlan.rewardPerPerson > 0;
 %>
 <tr>
 <td>
 <div style="display:flex;align-items:center;gap:.625rem">
 <% if (q.image) { %>
 <img src="<%= q.image %>" style="width:32px;height:32px;border-radius:8px;object-fit:contain;background:#fff;padding:2px;flex-shrink:0">
 <% } else { %>
 <div style="width:32px;height:32px;border-radius:8px;background:rgba(94,194,19,.1);border:1px solid rgba(94,194,19,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
 <i class="fas fa-trophy" style="color:var(--green);font-size:.8rem"></i>
 </div>
 <% } %>
 <div style="min-width:0">
 <p style="font-weight:700;color:var(--text);max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= q.title || '(untitled)' %></p>
 <p style="font-size:.7rem;color:var(--text-3)"><%= (q.tasks && q.tasks.length) || 0 %> tasks</p>
 </div>
 </div>
 </td>
 <td><span class="qt-tag <%= typeClass %>"><%= q.questType || 'standard' %></span></td>
 <td>
 <p style="font-size:.8rem;font-weight:700;color:var(--green)"><%= q.baseXpReward||0 %> XP</p>
 <% if (q.usdcReward > 0) { %><p style="font-size:.72rem;color:var(--amber)">$<%= q.usdcReward %> budget</p><% } %>
 </td>
 <td>
 <% if (hasPlan) { %>
 <span style="font-size:.75rem;color:#e8f5e2;font-weight:700">$<%= q.rewardPlan.rewardPerPerson %> × <%= q.rewardPlan.maxWinners || '∞' %></span>
 <% } else { %>
 <span style="font-size:.72rem;color:var(--text-3)">—</span>
 <% } %>
 </td>
 <td style="font-weight:700;color:var(--text)"><%= q.totalParticipants || 0 %></td>
 <td>
 <span class="a-badge <%= q.isActive ? 'a-badge-success' : 'a-badge-neutral' %>">
 <%= q.isActive ? 'Active' : 'Draft' %>
 </span>
 </td>
 <td>
 <div style="display:flex;gap:.4rem;flex-wrap:nowrap">
 <button class="a-btn a-btn-primary a-btn-sm" title="Manage"
 data-qid="<%= q._id %>" data-qtype="<%= q.questType %>" data-qtitle="<%= (q.title||'').replace(/</g,'&lt;').replace(/>/g,'&gt;') %>"
 onclick="openQuestManager(this.dataset.qid,this.dataset.qtitle,this.dataset.qtype)">
 <i class="fas fa-sliders"></i> Manage
 </button>
 <form method="POST" action="/admin/quests/<%= q._id %>/toggle" style="display:inline" onsubmit="return confirm('<%= q.isActive?'Deactivate':'Launch' %> this quest?')">
 <button type="submit" class="a-btn <%= q.isActive?'a-btn-warning':'a-btn-success' %> a-btn-sm" title="<%= q.isActive?'Deactivate':'Launch' %>">
 <i class="fas fa-<%= q.isActive?'pause':'rocket' %>"></i>
 </button>
 </form>
 <form method="POST" action="/admin/quests/<%= q._id %>/delete" style="display:inline" onsubmit="return confirm('Delete this quest permanently?')">
 <button type="submit" class="a-btn a-btn-danger a-btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
 </form>
 </div>
 </td>
 </tr>
 <% }) %>
 <% if (!quests.length) { %>
 <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--text-3)">
 <i class="fas fa-trophy" style="display:block;font-size:1.5rem;margin-bottom:.5rem"></i>No quests yet
 </td></tr>
 <% } %>
 </tbody>
 </table>
 </div>
 </div>

 </div><!-- /a-content -->
</div><!-- /a-main -->

<!-- ══════════════ CREATE QUEST MODAL ══════════════ -->
<div class="a-modal-overlay" id="createQuestModal">
 <div class="a-modal" style="max-width:720px">
 <div class="a-modal-header">
 <h3><i class="fas fa-plus" style="color:var(--green)"></i> Create New Quest</h3>
 <button class="a-modal-close" onclick="closeModal('createQuestModal')"><i class="fas fa-times"></i></button>
 </div>
 <form id="createQuestForm" method="POST" action="/admin/quests/create" onsubmit="return normalizeQuestDateInputs(this)">
 <div class="a-form-row">
 <div class="a-form-group">
 <label>Title *</label>
 <input type="text" name="title" class="a-input" required placeholder="Quest title">
 </div>
 <div class="a-form-group">
 <label>Short Description *</label>
 <input type="text" name="shortDescription" class="a-input" required placeholder="One-liner">
 </div>
 </div>
 <div class="a-form-group">
 <label>Full Description *</label>
 <textarea name="description" class="a-input" required placeholder="Detailed quest description" style="min-height:80px"></textarea>
 </div>
 <div class="a-form-group">
 <label>Banner Image URL <span style="color:var(--text-3)">(optional)</span></label>
 <input type="url" name="image" class="a-input" placeholder="https://... or /img/...">
 </div>

 <div class="a-form-row-3">
 <div class="a-form-group">
 <label>Category</label>
 <select name="category" class="a-input">
 <option value="learning">Learning</option>
 <option value="social">Social</option>
 <option value="development">Development</option>
 <option value="community">Community</option>
 <option value="special">Special</option>
 </select>
 </div>
 <div class="a-form-group">
 <label>Difficulty</label>
 <select name="difficulty" class="a-input">
 <option value="beginner">Beginner</option>
 <option value="intermediate">Intermediate</option>
 <option value="advanced">Advanced</option>
 </select>
 </div>
 <div class="a-form-group">
 <label>Quest Type</label>
 <select name="questType" class="a-input" id="cqType" onchange="onCqTypeChange()">
 <option value="standard">Standard</option>
 <option value="fcfs">FCFS (First Come First Served)</option>
 <option value="competition">Competition</option>
 <option value="referral_boost">Referral Boost</option>
 </select>
 </div>
 </div>

 <!-- XP -->
 <div class="a-form-row">
 <div class="a-form-group">
 <label>Base XP Reward</label>
 <input type="number" name="baseXpReward" class="a-input" value="0" min="0">
 </div>
 <div class="a-form-group">
 <label>Total USDC Budget</label>
 <input type="number" name="usdcReward" id="cqBudget" class="a-input" value="0" min="0" step="0.01" oninput="calcRewardPlan()">
 </div>
 </div>

 <div id="cqReferralConfig" style="display:none;background:rgba(251,191,36,.05);border:1px solid rgba(251,191,36,.2);border-radius:10px;padding:1rem;margin-bottom:.875rem">
 <p style="font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fbbf24;margin-bottom:.75rem"><i class="fas fa-users"></i> Referral XP Bonuses</p>
 <div class="a-form-row">
 <div class="a-form-group" style="margin-bottom:0"><label>XP per referral who joins</label><input type="number" name="xpPerReferralJoin" class="a-input" value="0" min="0"></div>
 <div class="a-form-group" style="margin-bottom:0"><label>XP per referral who completes</label><input type="number" name="xpPerReferralComplete" class="a-input" value="0" min="0"></div>
 </div>
 <input type="hidden" name="referralEnabled" id="cqReferralEnabled" value="false">
 </div>

 <!-- Reward Distribution Plan -->
 <div style="background:rgba(94,194,19,.04);border:1px solid rgba(94,194,19,.15);border-radius:10px;padding:1rem;margin-bottom:.875rem">
 <p style="font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#5a7a56;margin-bottom:.75rem">
 <i class="fas fa-chart-pie" style="color:var(--green)"></i> Reward Distribution Plan
 </p>
 <div class="a-form-row" id="cqEqualRewardFields" style="display:none">
 <div class="a-form-group" style="margin-bottom:0">
 <label>USDC per person</label>
 <input type="number" name="rewardPerPerson" id="cqPerPerson" class="a-input" value="0" min="0" step="0.01" oninput="calcRewardPlan()">
 </div>
 <div class="a-form-group" style="margin-bottom:0">
 <label>Max recipients</label>
 <input type="number" name="maxWinners" id="cqMaxWinners" class="a-input" value="0" min="0" placeholder="Auto from budget">
 </div>
 </div>
