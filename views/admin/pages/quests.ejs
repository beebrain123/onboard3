<script>
/* ── Modal helpers ── */
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.a-modal-overlay').forEach(m => m.addEventListener('click', e => { if(e.target===m) m.classList.remove('open'); }));

/* ── Business quest reject form toggle ── */
function toggleRejectForm(btn) {
 var wrap = btn.closest('.bq-reject-wrap');
 var form = wrap.querySelector('.bq-reject-form');
 // close all others first
 document.querySelectorAll('.bq-reject-form').forEach(function(f) {
 if (f !== form) f.style.display = 'none';
 });
 form.style.display = form.style.display === 'none' ? 'block' : 'none';
}
// Close reject forms when clicking outside
document.addEventListener('click', function(e) {
 if (!e.target.closest('.bq-reject-wrap')) {
 document.querySelectorAll('.bq-reject-form').forEach(function(f) { f.style.display = 'none'; });
 }
});

/* ── Reward plan calculator ── */
function calcRewardPlan() {
 var budget = parseFloat(document.getElementById('cqBudget').value) || 0;
 var perPerson = parseFloat(document.getElementById('cqPerPerson').value) || 0;
 var preview = document.getElementById('rewardPreview');
 if (budget <= 0 || perPerson <= 0) { preview.style.display='none'; return; }
 var winners = Math.floor(budget / perPerson);
 document.getElementById('cqMaxWinners').value = winners;
 preview.style.display = 'block';
 preview.innerHTML = '<strong>$' + budget.toFixed(2) + '</strong> total &nbsp;→&nbsp; <strong>$' + perPerson.toFixed(2) + '</strong> each &nbsp;→&nbsp; <strong>' + winners + ' recipients</strong>';
}

/* ── Quest type change ── */
function onCqTypeChange() {
 var t = document.getElementById('cqType').value;
 document.getElementById('cqFcfsConfig').style.display = t==='fcfs' ? 'block' : 'none';
 document.getElementById('cqCompConfig').style.display = t==='competition' ? 'block' : 'none';
 document.getElementById('cqReferralConfig').style.display = t==='referral_boost' ? 'block' : 'none';
 document.getElementById('cqReferralEnabled').value = t==='referral_boost' ? 'true' : 'false';
 if(t==='competition')renderQuestRankShares('create');
}

function renderQuestRankShares(mode, values) {
 var countInput=document.getElementById(mode==='create'?'cqTopWinners':'sq_topWinners');
 var holder=document.getElementById(mode==='create'?'cqRankShares':'sqRankShares'); if(!countInput||!holder)return;
 var count=Math.max(1,Math.min(100,parseInt(countInput.value,10)||1)); countInput.value=count;
 var current=values||getQuestRankShares(mode);
 if(current.length!==count){var each=Math.floor(10000/count)/100;current=Array(count).fill(each);current[count-1]=Number((100-each*(count-1)).toFixed(2));}
 holder.innerHTML='';
 for(var i=0;i<count;i++){
  var field=document.createElement('div');field.className='a-form-group';field.style.marginBottom='0';
  var label=document.createElement('label');label.textContent=(i+1)+(i===0?'st':i===1?'nd':i===2?'rd':'th')+' place (%)';
  var input=document.createElement('input');input.type='number';input.className='a-input quest-rank-share';input.min='0';input.max='100';input.step='0.1';input.value=Number(current[i])>=0?Number(current[i]):0;
  if(mode==='create')input.name='rankPercentages[]';input.oninput=function(){updateQuestRankShareTotal(mode);};
  field.appendChild(label);field.appendChild(input);holder.appendChild(field);
 }
 updateQuestRankShareTotal(mode);
}
function getQuestRankShares(mode){var h=document.getElementById(mode==='create'?'cqRankShares':'sqRankShares');return h?Array.from(h.querySelectorAll('.quest-rank-share')).map(function(i){return parseFloat(i.value)||0;}):[];}
function updateQuestRankShareTotal(mode){var total=getQuestRankShares(mode).reduce(function(a,b){return a+b;},0);var l=document.getElementById(mode==='create'?'cqRankSharesTotal':'sqRankSharesTotal');if(l){l.textContent='Total: '+total.toFixed(1)+'% (must equal 100%).';l.style.color=Math.abs(total-100)<0.01?'var(--green)':'#f59e0b';}}
function onTaskTypeChange() {
 var type = document.getElementById('nt_type').value;
 var approvalRow = document.getElementById('approvalToggleRow');
 if (!approvalRow) return;
 var needsReview = type === 'submission' || type === 'image_upload';
 document.getElementById('nt_approval').checked = needsReview && _qmQuestType !== 'fcfs';
}

/* ── Quest Manager Panel ── */
var _qmQuestId = null;
var _qmQuestType = null;

function openQuestManager(id, title, type) {
 _qmQuestId = id;
 _qmQuestType = type;
 document.getElementById('qmTitle').textContent = title;
 var metaEl = document.getElementById('qmMeta');
 var typeColors = { standard:'#5ec213', fcfs:'#60a5fa', competition:'#c084fc', referral_boost:'#fbbf24' };
 var col = typeColors[type] || '#8aaf85';
 metaEl.innerHTML = '<span style="font-size:.7rem;font-weight:800;padding:.15rem .55rem;border-radius:20px;background:' + col + '18;color:' + col + ';border:1px solid ' + col + '33;text-transform:uppercase">' + type + '</span>';
 document.getElementById('qmFcfsNote').style.display = type==='fcfs' ? 'inline-flex' : 'none';
 /* For FCFS quests disable approval checkbox and show note */
 var approvalRow = document.getElementById('approvalToggleRow');
 var approvalCb = document.getElementById('nt_approval');
 var fcfsNote = document.getElementById('approvalFcfsNote');
 if (type === 'fcfs') {
 approvalCb.checked = false;
 approvalCb.disabled = true;
 if (approvalRow) approvalRow.style.opacity = '.45';
 if (fcfsNote) fcfsNote.style.display = 'inline';
 } else {
 approvalCb.disabled = false;
 if (approvalRow) approvalRow.style.opacity = '1';
 if (fcfsNote) fcfsNote.style.display = 'none';
 }
 /* Load current quest settings into the Settings tab */
 fetch('/admin/quests/' + id + '/entries')
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) return;
 var q = d.quest;
 document.getElementById('sq_baseXp').value = q.baseXpReward || 0;
 document.getElementById('sq_title').value = q.title || '';
 document.getElementById('sq_shortDescription').value = q.shortDescription || '';
 document.getElementById('sq_description').value = q.description || '';
 document.getElementById('sq_category').value = q.category || 'learning';
 document.getElementById('sq_difficulty').value = q.difficulty || 'beginner';
 document.getElementById('sq_usdc').value = q.usdcReward || 0;
 document.getElementById('sq_perPerson').value = (q.rewardPlan && q.rewardPlan.rewardPerPerson) || 0;
 document.getElementById('sq_maxWinners').value = (q.rewardPlan && q.rewardPlan.maxWinners) || 0;
 document.getElementById('sq_maxParticipants').value = q.maxParticipants || 0;
 document.getElementById('sq_referralEnabled').checked = !!(q.referralConfig && q.referralConfig.enabled);
 document.getElementById('sq_referralJoin').value = (q.referralConfig && q.referralConfig.xpPerReferralJoin) || 0;
 document.getElementById('sq_referralComplete').value = (q.referralConfig && q.referralConfig.xpPerReferralComplete) || 0;
 document.getElementById('sq_topWinners').value = (q.competitionConfig && q.competitionConfig.topWinnersCount) || 10;
 document.getElementById('sq_winnerBonusXP').value = (q.competitionConfig && q.competitionConfig.winnerBonusXP) || 0;
 renderQuestRankShares('settings', q.competitionConfig?.rankPercentages);
 calcSqPlan();
 }).catch(function(){});
 /* reset to tasks tab */
 qmTab('tasks');
 document.getElementById('qmOverlay').classList.add('open');
 loadQmTasks();
}

function closeQM() {
 document.getElementById('qmOverlay').classList.remove('open');
}
function onQmOverlayClick(e) {
 if (e.target === document.getElementById('qmOverlay')) closeQM();
}

function qmTab(tab) {
 ['tasks','entries','settings'].forEach(function(t) {
 document.getElementById('qtab-' + t).classList.toggle('active', t===tab);
 document.getElementById('qm-' + t).style.display = t===tab ? 'block' : 'none';
 });
 if (tab === 'entries') loadQmEntries();
}

/* ── Load tasks ── */
function loadQmTasks() {
 var list = document.getElementById('qmTaskList');
 list.innerHTML = '<div style="color:#5a7a56;font-size:.85rem;padding:.5rem 0">Loading…</div>';
 fetch('/admin/quests/' + _qmQuestId + '/entries')
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) { list.innerHTML = '<div style="color:#ef4444;font-size:.82rem">Failed to load tasks</div>'; return; }
 var tasks = (d.quest.tasks || []).concat(d.quest.dailyTasks || []);
 if (!tasks.length) {
 list.innerHTML = '<div style="color:#5a7a56;font-size:.82rem;padding:.5rem 0"><i class="fas fa-info-circle"></i> No tasks yet — add one below.</div>';
 return;
 }
 list.innerHTML = tasks.map(function(t, i) {
 var dayBadge = t.availableFromDay > 0
   ? ' · <span style="color:#a78bfa;font-size:.68rem;font-weight:700">📅 Day ' + (t.availableFromDay + 1) + '</span>'
   : '';
 return '<div class="task-row">' +
 '<div class="task-num">' + (i+1) + '</div>' +
 '<div class="task-info">' +
 '<p>' + escHtml(t.title) + '</p>' +
 '<span>' + (t.taskType || 'external') + dayBadge + (t.requiresApproval ? ' · <span style="color:#f59e0b;font-size:.68rem">⏳ manual review</span>' : '') + (t.buttonLink ? ' · <a href="' + escHtml(t.buttonLink) + '" target="_blank" style="color:#60a5fa">' + escHtml(t.buttonLink.replace(/^https?:\/\//,'').substring(0,40)) + '</a>' : '') + '</span>' +
 '</div>' +
 '<span class="task-xp">' + (t.xpReward||0) + ' XP</span>' +
 '</div>';
 }).join('');
 })
 .catch(function() { list.innerHTML = '<div style="color:#ef4444;font-size:.82rem">Error loading tasks</div>'; });
}

/* ── Add task ── */
function submitAddTask() {
 var title = document.getElementById('nt_title').value.trim();
 var type = document.getElementById('nt_type').value;
 var xp = document.getElementById('nt_xp').value;
 var day = document.getElementById('nt_day').value;
 var link = document.getElementById('nt_link').value.trim();
 var desc = document.getElementById('nt_desc').value.trim();
 if (!title) { showQmFlash('Title is required', false); return; }
 var btn = document.getElementById('addTaskBtn');
 btn.disabled = true; btn.textContent = 'Adding…';
 fetch('/admin/quests/' + _qmQuestId + '/add-task', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ title: title, taskType: type, xpReward: parseInt(xp)||0, availableFromDay: parseInt(day)||0, buttonLink: link, description: desc || title, requiresApproval: document.getElementById('nt_approval').checked })
 })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 btn.disabled = false; btn.innerHTML = '<i class="fas fa-plus"></i> Add Task';
 if (d.success) {
 showQmFlash('Task added!', true);
 document.getElementById('nt_title').value = '';
 document.getElementById('nt_link').value = '';
 document.getElementById('nt_desc').value = '';
 document.getElementById('nt_xp').value = '0';
 document.getElementById('nt_day').value = '0';
 loadQmTasks();
 } else {
 showQmFlash(d.message || 'Failed to add task', false);
 }
 })
 .catch(function() {
 btn.disabled = false; btn.innerHTML = '<i class="fas fa-plus"></i> Add Task';
 showQmFlash('Network error', false);
 });
}

/* ── Load entries ── */
function loadQmEntries() {
 var wrap = document.getElementById('qmEntriesWrap');
 wrap.innerHTML = '<div style="color:#5a7a56;font-size:.85rem;padding:.75rem 0">Loading…</div>';
 fetch('/admin/quests/' + _qmQuestId + '/entries')
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) { wrap.innerHTML = '<div style="color:#ef4444;font-size:.82rem">Failed to load entries</div>'; return; }
 var entries = d.entries || [];
 var tasks = (d.quest.tasks || []).concat(d.quest.dailyTasks || []);
 var isFcfs = _qmQuestType === 'fcfs';
 if (!entries.length) {
 wrap.innerHTML = '<div style="color:#5a7a56;font-size:.85rem;text-align:center;padding:2rem 0"><i class="fas fa-satellite-dish" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.4"></i>No entries yet</div>';
 return;
 }
 /* Sort: FCFS → by completedAt, others → by totalXp desc */
 if (isFcfs) {
 entries.sort(function(a,b){ return new Date(a.completedAt||'9999') - new Date(b.completedAt||'9999'); });
 }
 var rows = entries.map(function(e, idx) {
 var rank = idx + 1;
 var rankClass = rank===1?'rank-1':rank===2?'rank-2':rank===3?'rank-3':'rank-n';
 var xp = (e.xpBreakdown && e.xpBreakdown.totalXp) || e.totalXp || 0;
 var username = (e.userId && e.userId.username) || 'Unknown';
 var userId = e.userId && e.userId._id;
 var email = (e.userId && e.userId.email) || '';
 /* Gather submission URLs from task progress */
 var submissionLinks = '';
 if (e.taskProgress && e.taskProgress.length) {
 var links = [];
 e.taskProgress.forEach(function(tp, ti) {
 /* Match task by taskId, fall back to index */
 var tobj = tasks.find(function(t){ return String(t._id) === String(tp.taskId); }) || tasks[ti];
 var tname = (tobj && tobj.title) || ('Task ' + (ti+1));
 if (tp.submissionImage) {
 links.push('<a href="' + escHtml(tp.submissionImage) + '" target="_blank" class="sub-link" style="color:#c084fc;border-color:rgba(168,85,247,.3);background:rgba(168,85,247,.08)"><i class="fas fa-image"></i>' + escHtml(tname.substring(0,16)) + '</a>');
 } else if (tp.submissionUrl) {
 links.push('<a href="' + escHtml(tp.submissionUrl) + '" target="_blank" class="sub-link"><i class="fas fa-link"></i>' + escHtml(tname.substring(0,20)) + '</a>');
 } else if (tp.submissionText) {
 links.push('<span style="font-size:.72rem;color:#8aaf85">' + escHtml(tp.submissionText.substring(0,40)) + '</span>');
 } else if (tp.submissionData && typeof tp.submissionData === 'object') {
 /* Custom inputName fields land here */
 var vals = Object.values(tp.submissionData).filter(function(v){ return v && String(v).trim(); });
 vals.forEach(function(v) {
 var sv = String(v).trim();
 var isUrl = /^https?:\/\//.test(sv);
 if (isUrl) {
 links.push('<a href="' + escHtml(sv) + '" target="_blank" class="sub-link"><i class="fas fa-link"></i>' + escHtml(tname.substring(0,20)) + '</a>');
 } else {
 links.push('<span style="font-size:.72rem;color:#8aaf85">' + escHtml(sv.substring(0,40)) + '</span>');
 }
 });
 }
 });
 submissionLinks = links.join(' ') || '<span style="color:#5a7a56;font-size:.72rem">—</span>';
 } else {
 submissionLinks = '<span style="color:#5a7a56;font-size:.72rem">—</span>';
 }
 var completed = e.completedAt ? new Date(e.completedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : 'In progress';
 var bonusCell = !isFcfs && userId
 ? '<button class="bonus-xp-btn" onclick="openBonusXp(' + JSON.stringify(userId) + ',' + JSON.stringify(username) + ')"><i class="fas fa-bolt"></i> Bonus XP</button>'
 : '<span style="color:#5a7a56;font-size:.7rem">—</span>';

 /* Gather pending approval tasks */
 var approvalCells = '';
 if (e.taskProgress && e.taskProgress.length) {
 e.taskProgress.forEach(function(tp, ti) {
 var atobj = tasks.find(function(t){ return String(t._id) === String(tp.taskId); }) || tasks[ti];
 var atname = (atobj && atobj.title) || ('Task ' + (ti+1));
 var tid = tp.taskId || '';
 if (tp.approvalStatus === 'pending') {
 approvalCells += '<div style="display:flex;align-items:center;gap:.35rem;margin-bottom:.25rem">' +
 '<span style="font-size:.68rem;color:#f59e0b;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);border-radius:20px;padding:.1rem .4rem">⏳ ' + escHtml(atname.substring(0,18)) + '</span>' +
 '<button onclick="approveTask(' + JSON.stringify(e._id) + ',' + JSON.stringify(tid) + ',this)" style="font-size:.65rem;padding:.1rem .4rem;background:rgba(94,194,19,.12);color:#5ec213;border:1px solid rgba(94,194,19,.3);border-radius:20px;cursor:pointer;font-family:Outfit,sans-serif"> Approve</button>' +
 '<button onclick="rejectTask(' + JSON.stringify(e._id) + ',' + JSON.stringify(tid) + ',this)" style="font-size:.65rem;padding:.1rem .4rem;background:rgba(239,68,68,.08);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:20px;cursor:pointer;font-family:Outfit,sans-serif"> Reject</button>' +
 '</div>';
 } else if (tp.approvalStatus === 'approved') {
 approvalCells += '<span style="font-size:.68rem;color:#5ec213"> ' + escHtml(atname.substring(0,18)) + '</span><br>';
 } else if (tp.approvalStatus === 'rejected') {
 approvalCells += '<span style="font-size:.68rem;color:#ef4444"> ' + escHtml(atname.substring(0,18)) + '</span><br>';
 }
 });
 }
 if (!approvalCells) approvalCells = '<span style="color:#5a7a56;font-size:.7rem">—</span>';

 var removeCell = e.status === 'abandoned'
 ? '<span style="font-size:.68rem;color:#5a7a56;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:20px;padding:.15rem .5rem"><i class="fas fa-ban"></i> Removed</span>'
 : '<button onclick="adminRemoveEntry(' + JSON.stringify(e._id) + ')" style="font-size:.68rem;padding:.2rem .6rem;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.3);border-radius:20px;cursor:pointer;font-family:Outfit,sans-serif"><i class="fas fa-user-minus"></i> Remove</button>';

 return '<tr>' +
 '<td><span class="rank-badge ' + rankClass + '">' + rank + '</span></td>' +
 '<td><a href="/u/' + escHtml(username) + '" target="_blank" style="color:#5ec213;font-weight:700;text-decoration:none">@' + escHtml(username) + '</a><br><span style="font-size:.68rem;color:#5a7a56">' + escHtml(email) + '</span></td>' +
 '<td style="font-weight:800;color:#e8f5e2">' + (isFcfs ? '<span style="color:#5a7a56;font-size:.72rem">FCFS</span>' : xp.toLocaleString() + ' XP') + '</td>' +
 '<td>' + submissionLinks + '</td>' +
 '<td>' + approvalCells + '</td>' +
 '<td style="font-size:.72rem;color:#8aaf85">' + completed + '</td>' +
 '<td>' + bonusCell + '</td>' +
 '<td>' + removeCell + '</td>' +
 '</tr>';
 }).join('');
 wrap.innerHTML = '<div class="entries-wrap"><table class="entries-table">' +
 '<thead><tr><th>#</th><th>User</th><th>' + (isFcfs?'Status':'XP') + '</th><th>Submissions</th><th>Approval</th><th>Completed</th><th>Bonus XP</th><th>Remove</th></tr></thead>' +
 '<tbody>' + rows + '</tbody>' +
 '</table></div>';
 })
 .catch(function() { wrap.innerHTML = '<div style="color:#ef4444;font-size:.82rem">Error loading entries</div>'; });
}

/* ── Remove quest entry ── */
function adminRemoveEntry(progressId) {
 if (!confirm('Remove this participant from the quest?\n\nAll their quest XP will be deducted. This cannot be undone.')) return;
 fetch('/admin/quests/' + _qmQuestId + '/entries/' + progressId + '/remove', { method: 'POST' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) { alert(d.message || 'Participant removed.'); loadQmEntries(); }
 else alert(d.message || 'Error removing participant.');
 });
}

/* ── Bonus XP ── */
var _bonusUserId = null;
function openBonusXp(userId, username) {
 _bonusUserId = userId;
 document.getElementById('bonusXpTarget').textContent = 'Award extra XP to @' + username + ' — this raises their leaderboard position.';
 document.getElementById('bonusXpAmount').value = '';
 openModal('bonusXpModal');
}
function confirmBonusXp() {
 var xp = parseInt(document.getElementById('bonusXpAmount').value) || 0;
 if (xp < 1) { alert('Enter a valid XP amount'); return; }
 fetch('/admin/quests/' + _qmQuestId + '/users/' + _bonusUserId + '/bonus-xp', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ xp: xp })
 })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 closeModal('bonusXpModal');
 if (d.success) {
 showQmFlash('+' + xp + ' XP awarded! New total: ' + d.newTotal + ' XP', true);
 loadQmEntries();
 } else {
 alert(d.message || 'Failed to award XP');
 }
 })
 .catch(function() { alert('Network error'); });
}

/* ── Helpers ── */
function showQmFlash(msg, ok) {
 var el = document.getElementById('qmFlash');
 el.textContent = msg;
 el.className = 'qm-flash ' + (ok ? 'ok' : 'err');
 el.style.display = 'block';
 setTimeout(function(){ el.style.display='none'; }, 3500);
}
function approveTask(progressId, taskId, btn) {
 if (!confirm('Approve this submission and grant XP?')) return;
 btn.disabled = true; btn.textContent = '…';
 fetch('/admin/quests/' + _qmQuestId + '/submissions/' + progressId + '/review', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ taskId: taskId, action: 'approve' })
 }).then(function(r){ return r.json(); })
 .then(function(d) {
 if (d.success) { showQmFlash('Approved! +' + (d.xpGranted||0) + ' XP granted', true); loadQmEntries(); }
 else { alert(d.message || 'Failed'); btn.disabled = false; btn.textContent = ' Approve'; }
 }).catch(function() { btn.disabled = false; btn.textContent = ' Approve'; });
}

function rejectTask(progressId, taskId, btn) {
 if (!confirm('Reject this submission?')) return;
 btn.disabled = true; btn.textContent = '…';
 fetch('/admin/quests/' + _qmQuestId + '/submissions/' + progressId + '/review', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ taskId: taskId, action: 'reject' })
 }).then(function(r){ return r.json(); })
 .then(function(d) {
 if (d.success) { showQmFlash('Submission rejected', true); loadQmEntries(); }
 else { alert(d.message || 'Failed'); btn.disabled = false; btn.textContent = ' Reject'; }
 }).catch(function() { btn.disabled = false; btn.textContent = ' Reject'; });
}

function calcSqPlan() {
 var budget = parseFloat(document.getElementById('sq_usdc').value) || 0;
 var perPerson = parseFloat(document.getElementById('sq_perPerson').value) || 0;
 var preview = document.getElementById('sqRewardPreview');
 if (budget <= 0 || perPerson <= 0) { preview.style.display='none'; return; }
 var winners = Math.floor(budget / perPerson);
 document.getElementById('sq_maxWinners').value = winners;
 preview.style.display = 'block';
 preview.innerHTML = '<strong>$' + budget.toFixed(2) + '</strong> total &nbsp;→&nbsp; <strong>$' + perPerson.toFixed(2) + '</strong> each &nbsp;→&nbsp; <strong>' + winners + ' recipients</strong>';
}

function saveQuestSettings() {
 var btn = document.getElementById('saveSettingsBtn');
 btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';
 fetch('/admin/quests/' + _qmQuestId + '/update-settings', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({
 title: document.getElementById('sq_title').value.trim(),
 shortDescription: document.getElementById('sq_shortDescription').value.trim(),
 description: document.getElementById('sq_description').value.trim(),
 category: document.getElementById('sq_category').value,
 difficulty: document.getElementById('sq_difficulty').value,
 baseXpReward: parseInt(document.getElementById('sq_baseXp').value) || 0,
 usdcReward: parseFloat(document.getElementById('sq_usdc').value) || 0,
 rewardPerPerson: parseFloat(document.getElementById('sq_perPerson').value) || 0,
 maxWinners: parseInt(document.getElementById('sq_maxWinners').value) || 0,
 maxParticipants: parseInt(document.getElementById('sq_maxParticipants').value) || 0,
 referralEnabled: document.getElementById('sq_referralEnabled').checked,
 xpPerReferralJoin: parseInt(document.getElementById('sq_referralJoin').value) || 0,
 xpPerReferralComplete: parseInt(document.getElementById('sq_referralComplete').value) || 0,
 topWinnersCount: parseInt(document.getElementById('sq_topWinners').value) || 10,
 winnerBonusXP: parseInt(document.getElementById('sq_winnerBonusXP').value) || 0,
 firstPlacePercent: getQuestRankShares('settings')[0] || 0,
 secondPlacePercent: getQuestRankShares('settings')[1] || 0,
 rankPercentages: getQuestRankShares('settings')
 })
 }).then(function(r){ return r.json(); })
 .then(function(d) {
 btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Save Settings';
 if (d.success) {
 showSettingsFlash('Settings saved!', true);
 } else {
 showSettingsFlash(d.message || 'Failed to save', false);
 }
 }).catch(function() {
 btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Save Settings';
 showSettingsFlash('Network error', false);
 });
}

function showSettingsFlash(msg, ok) {
 var el = document.getElementById('qmSettingsFlash');
 el.textContent = msg;
 el.className = 'qm-flash ' + (ok ? 'ok' : 'err');
 el.style.display = 'block';
 setTimeout(function(){ el.style.display='none'; }, 3500);
}

function escHtml(s) {
 return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
