<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Support Chat — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 .sup-grid { display:grid; grid-template-columns:300px 1fr; gap:1rem; height:calc(100vh - 10rem); }
 @media(max-width:768px){ .sup-grid{grid-template-columns:1fr;height:auto} }

 .sup-list { display:flex; flex-direction:column; gap:.5rem; overflow-y:auto; }
 .sup-item {
 padding:.875rem 1rem; border-radius:14px; border:1px solid var(--border);
 background:var(--surface); cursor:pointer; transition:all .2s;
 }
 .sup-item:hover,.sup-item.active { border-color:rgba(57,255,20,.35); background:rgba(57,255,20,.05); }
 .sup-item-name { font-size:.875rem; font-weight:800; color:var(--text); }
 .sup-item-preview { font-size:.75rem; color:var(--text-3); margin-top:.2rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
 .sup-item-meta { display:flex; align-items:center; gap:.4rem; margin-top:.4rem; }
 .sup-unread { background:#f87171; color:#fff; border-radius:50px; padding:.1rem .5rem; font-size:.65rem; font-weight:900; }
 .sup-complaint { background:rgba(239,68,68,.15); color:#f87171; border:1px solid rgba(239,68,68,.3); border-radius:50px; padding:.1rem .5rem; font-size:.65rem; font-weight:800; }
 .sup-time { font-size:.68rem; color:var(--text-3); margin-left:auto; }

 .sup-chat { display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--border); border-radius:18px; overflow:hidden; }
 .sup-chat-head { padding:1rem 1.25rem; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:.75rem; flex-shrink:0; }
 .sup-chat-msgs { flex:1; overflow-y:auto; padding:1rem; display:flex; flex-direction:column; gap:.625rem; min-height:300px; }
 .sup-chat-msg { max-width:80%; padding:.625rem .875rem; border-radius:14px; font-size:.875rem; line-height:1.55; }
 .sup-msg--user { align-self:flex-end; background:rgba(57,255,20,.12); color:var(--text); border:1px solid rgba(57,255,20,.25); border-bottom-right-radius:4px; }
 .sup-msg--ai { align-self:flex-start; background:rgba(255,255,255,.05); color:var(--text-2); border:1px solid var(--border); border-bottom-left-radius:4px; }
 .sup-msg--admin { align-self:flex-start; background:rgba(168,85,247,.1); color:#c084fc; border:1px solid rgba(168,85,247,.25); border-bottom-left-radius:4px; }
 .sup-msg-label { font-size:.68rem; font-weight:800; opacity:.7; margin-bottom:.2rem; }
 .sup-msg-time { font-size:.65rem; color:var(--text-3); margin-top:.2rem; }

 .sup-reply { padding:.75rem 1rem; border-top:1px solid var(--border); display:flex; gap:.5rem; flex-shrink:0; }
 .sup-reply-input { flex:1; background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:.625rem .875rem; color:var(--text); font-family:'Outfit',sans-serif; font-size:.875rem; outline:none; resize:none; }
 .sup-reply-input:focus { border-color:rgba(57,255,20,.4); }
 .sup-reply-btn { padding:.625rem 1.125rem; border-radius:10px; background:linear-gradient(135deg,var(--green),var(--green-dark)); border:none; color:#000; font-family:'Outfit',sans-serif; font-size:.8125rem; font-weight:800; cursor:pointer; }

 .sup-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:var(--text-3); gap:.5rem; text-align:center; padding:2rem; }
 .sup-empty i { font-size:2rem; margin-bottom:.5rem; }
 </style>
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'support', admin:user }) %>

<div class="a-main">
 <div class="a-content">
 <div class="a-page-header">
 <div>
 <h1><i class="fas fa-headset"></i> Support Chat</h1>
 <p><%= conversations.length %> conversation<%= conversations.length !== 1 ? 's' : '' %></p>
 </div>
 <div style="display:flex;gap:.5rem">
 <button class="a-btn a-btn-sm filter-btn active" onclick="filterConvos('all',this)">All</button>
 <button class="a-btn a-btn-sm filter-btn" onclick="filterConvos('complaints',this)" style="background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.3);color:#f87171">Complaints</button>
 <button class="a-btn a-btn-sm filter-btn" onclick="filterConvos('unread',this)" style="background:rgba(245,158,11,.1);border-color:rgba(245,158,11,.3);color:#f59e0b">Unread</button>
 </div>
 </div>

 <div class="sup-grid">
 <!-- Left: conversation list -->
 <div class="sup-list" id="convoList">
 <% if (conversations.length === 0) { %>
 <div style="text-align:center;padding:2rem;color:var(--text-3)">
 <i class="fas fa-comments" style="font-size:1.5rem;display:block;margin-bottom:.5rem"></i>
 No conversations yet
 </div>
 <% } %>
 <% conversations.forEach(function(c, i) { %>
 <div class="sup-item" id="ci-<%= c._id %>"
 data-complaint="<%= c.hasComplaint %>"
 data-unread="<%= c.unreadByAdmin %>"
 onclick="openConvo('<%= c._id %>')">
 <div style="display:flex;align-items:center;gap:.5rem">
 <% if (c.userId && c.userId.profilePicture) { %>
 <img src="<%= c.userId.profilePicture %>" style="width:28px;height:28px;border-radius:50%;object-fit:cover;flex-shrink:0" alt="">
 <% } else { %>
 <div style="width:28px;height:28px;border-radius:50%;background:rgba(57,255,20,.15);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:900;color:var(--green);flex-shrink:0">
 <%= c.userId ? c.userId.username.charAt(0).toUpperCase() : '?' %>
 </div>
 <% } %>
 <span class="sup-item-name"><%= c.userId ? c.userId.username : 'Deleted user' %></span>
 </div>
 <div class="sup-item-preview"><%= c.messages.length > 0 ? c.messages[c.messages.length-1].content.slice(0,60) : 'No messages' %></div>
 <div class="sup-item-meta">
 <% if (c.hasComplaint) { %><span class="sup-complaint"><i class="fas fa-flag"></i> Complaint</span><% } %>
 <% if (c.unreadByAdmin > 0) { %><span class="sup-unread"><%= c.unreadByAdmin %> new</span><% } %>
 <span class="sup-time"><%= c.lastMessageAt ? new Date(c.lastMessageAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '' %></span>
 </div>
 </div>
 <% }); %>
 </div>

 <!-- Right: active conversation -->
 <div class="sup-chat" id="chatView">
 <div class="sup-empty" id="chatEmpty">
 <i class="fas fa-comments"></i>
 <p>Select a conversation to view messages and reply</p>
 </div>
 <div id="chatActive" style="display:none;flex-direction:column;height:100%">
 <div class="sup-chat-head" id="chatActiveHead">
 <div class="chat-ai-avatar" style="width:36px;height:36px;border-radius:50%;background:rgba(57,255,20,.15);display:flex;align-items:center;justify-content:center;color:var(--green);font-size:.875rem">
 <i class="fas fa-user"></i>
 </div>
 <div>
 <div id="chatActiveName" style="font-size:.9rem;font-weight:800;color:var(--text)"></div>
 <div id="chatActiveSub" style="font-size:.72rem;color:var(--text-3)"></div>
 </div>
 <div style="margin-left:auto">
 <button class="a-btn a-btn-sm" id="markResolvedBtn" onclick="markResolved()" style="background:rgba(57,255,20,.08);border-color:rgba(57,255,20,.25);color:var(--green)"><i class="fas fa-check"></i> Mark Resolved</button>
 </div>
 </div>
 <div class="sup-chat-msgs" id="chatActiveMsgs"></div>
 <div class="sup-reply">
 <textarea class="sup-reply-input" id="adminReplyInput" rows="2" placeholder="Reply to user…" maxlength="500"></textarea>
 <button class="sup-reply-btn" onclick="sendAdminReply()"><i class="fas fa-paper-plane"></i></button>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>

<script>
var _convos = <%- JSON.stringify(conversations) %>;
var _activeId = null;

function openConvo(id) {
 _activeId = id;
 document.querySelectorAll('.sup-item').forEach(function(el){ el.classList.remove('active'); });
 var item = document.getElementById('ci-' + id);
 if (item) item.classList.add('active');

 var c = _convos.find(function(x){ return x._id === id; });
 if (!c) return;

 document.getElementById('chatEmpty').style.display = 'none';
 var active = document.getElementById('chatActive');
 active.style.display = 'flex';

 document.getElementById('chatActiveName').textContent = c.userId ? c.userId.username : 'Deleted user';
 document.getElementById('chatActiveSub').textContent = c.messages.length + ' messages' + (c.hasComplaint ? ' · Has complaint' : '');

 var msgs = document.getElementById('chatActiveMsgs');
 msgs.innerHTML = '';
 c.messages.forEach(function(m) {
 var div = document.createElement('div');
 var cls = m.role === 'user' ? 'sup-msg--user' : m.role === 'admin' ? 'sup-msg--admin' : 'sup-msg--ai';
 var label = m.role === 'user' ? (c.userId ? c.userId.username : 'User') : m.role === 'admin' ? ' ' + (m.adminName || 'Admin') : ' Assistant';
 var t = m.createdAt ? new Date(m.createdAt).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '';
 div.className = 'sup-chat-msg ' + cls;
 div.innerHTML = '<div class="sup-msg-label">' + label + '</div>' + m.content.replace(/\n/g,'<br>') + (t ? '<div class="sup-msg-time">' + t + '</div>' : '');
 msgs.appendChild(div);
 });
 msgs.scrollTop = msgs.scrollHeight;

 // Mark as read
 fetch('/admin/support/' + id + '/mark-read', { method: 'POST', headers: {'Content-Type':'application/json'} });
 if (item) {
 var badge = item.querySelector('.sup-unread');
 if (badge) badge.remove();
 }
}

function sendAdminReply() {
 var input = document.getElementById('adminReplyInput');
 var text = input.value.trim();
 if (!text || !_activeId) return;
 input.value = '';

 fetch('/admin/support/' + _activeId + '/reply', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ message: text })
 }).then(function(r){ return r.json(); }).then(function(d) {
 if (d.success) {
 // Add to local data and re-render
 var c = _convos.find(function(x){ return x._id === _activeId; });
 if (c) {
 c.messages.push({ role: 'admin', content: text, adminName: d.adminName, createdAt: new Date().toISOString() });
 openConvo(_activeId);
 }
 } else {
 aToast(d.message || 'Error sending reply', 'error');
 }
 });
}

function markResolved() {
 if (!_activeId) return;
 fetch('/admin/support/' + _activeId + '/resolve', { method: 'POST', headers: {'Content-Type':'application/json'} })
 .then(function(r){ return r.json(); }).then(function(d) {
 if (d.success) { aToast('Marked as resolved', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
 });
}

function filterConvos(type, btn) {
 document.querySelectorAll('.filter-btn').forEach(function(b){ b.classList.remove('active'); });
 btn.classList.add('active');
 document.querySelectorAll('.sup-item').forEach(function(el) {
 if (type === 'all') { el.style.display = ''; return; }
 if (type === 'complaints' && el.dataset.complaint === 'true') { el.style.display = ''; return; }
 if (type === 'unread' && parseInt(el.dataset.unread) > 0) { el.style.display = ''; return; }
 el.style.display = 'none';
 });
}

document.getElementById('adminReplyInput').addEventListener('keydown', function(e) {
 if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendAdminReply(); }
});
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
</html>
