<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Quest Applications — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'quest-applications', admin:user }) %>

<div class="a-main">
 <div class="a-content">
 <div class="a-page-header">
 <div>
 <h1><i class="fas fa-shield-halved"></i> Quest Applications</h1>
 <p><%= applications.length %> application<%= applications.length !== 1 ? 's' : '' %> total</p>
 </div>
 </div>

 <!-- Campaign Settings -->
 <% if (grouped && grouped.length > 0 && grouped[0].quest) { %>
 <div class="a-card" style="margin-bottom:1.25rem">
 <div class="a-card-header">
 <h2><i class="fas fa-cog" style="color:var(--green)"></i> Campaign Settings — <%= grouped[0].quest.title %></h2>
 </div>
 <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap">
 <div>
 <p style="font-size:.78rem;font-weight:700;color:var(--text-3);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.5px">Campaign Logo</p>
 <div style="width:72px;height:72px;border-radius:14px;overflow:hidden;background:rgba(57,255,20,.08);border:1px solid rgba(57,255,20,.2);display:flex;align-items:center;justify-content:center">
 <% if (grouped[0].quest.image) { %>
 <img src="<%= grouped[0].quest.image %>" id="logoPreview" alt="" style="width:100%;height:100%;object-fit:cover">
 <% } else { %>
 <i class="fas fa-image" style="color:var(--text-3);font-size:1.5rem" id="logoPreviewIcon"></i>
 <img id="logoPreview" style="display:none;width:100%;height:100%;object-fit:cover" alt="">
 <% } %>
 </div>
 </div>
 <div style="flex:1;min-width:200px">
 <p style="font-size:.78rem;font-weight:700;color:var(--text-3);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.5px">Upload New Logo</p>
 <div style="display:flex;gap:.625rem;align-items:center;flex-wrap:wrap">
 <input type="file" id="logoFile" accept="image/*" style="display:none" onchange="previewLogo(this)">
 <label for="logoFile" class="a-btn a-btn-sm a-btn-secondary" style="cursor:pointer"><i class="fas fa-upload"></i> Choose Image</label>
 <button class="a-btn a-btn-sm a-btn-primary" onclick="uploadLogo('<%= grouped[0].quest._id %>')"><i class="fas fa-save"></i> Save Logo</button>
 <span id="logoUploadMsg" style="font-size:.8125rem;color:var(--text-3)"></span>
 </div>
 <p style="font-size:.75rem;color:var(--text-3);margin-top:.4rem">Max 4MB · JPG, PNG, WebP</p>
 </div>
 <div>
 <a href="/dashboard/quests/<%= grouped[0].quest._id %>" target="_blank" class="a-btn a-btn-sm" style="background:rgba(57,255,20,.08);border-color:rgba(57,255,20,.2);color:var(--green)">
 <i class="fas fa-external-link-alt"></i> View Campaign Page
 </a>
 </div>
 </div>
 </div>
 <% } %>

 <!-- Filter tabs -->
 <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.25rem">
 <button class="a-btn a-btn-sm filter-btn active" data-filter="all" onclick="filterApps('all',this)">
 All (<%= applications.length %>)
 </button>
 <button class="a-btn a-btn-sm filter-btn" data-filter="pending" onclick="filterApps('pending',this)" style="background:rgba(245,158,11,.1);border-color:rgba(245,158,11,.3);color:#f59e0b">
 Pending (<%= applications.filter(function(a){return a.status==='pending';}).length %>)
 </button>
 <button class="a-btn a-btn-sm filter-btn" data-filter="approved" onclick="filterApps('approved',this)" style="background:rgba(16,185,129,.1);border-color:rgba(16,185,129,.3);color:#6ee7b7">
 Approved (<%= applications.filter(function(a){return a.status==='approved';}).length %>)
 </button>
 <button class="a-btn a-btn-sm filter-btn" data-filter="rejected" onclick="filterApps('rejected',this)" style="background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.3);color:#f87171">
 Rejected (<%= applications.filter(function(a){return a.status==='rejected';}).length %>)
 </button>
 </div>

 <!-- Applications table -->
 <div class="a-card">
 <div class="a-table-wrap">
 <table class="at">
 <thead>
 <tr>
 <th>User</th>
 <th>Quest</th>
 <th>X Handle</th>
 <th>Telegram</th>
 <th>Status</th>
 <th>Applied</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody id="appsTableBody">
 <% if (applications && applications.length > 0) { %>
 <% applications.forEach(function(app) { %>
 <tr class="app-row" data-status="<%= app.status %>">
 <td>
 <div style="display:flex;align-items:center;gap:.625rem">
 <% if (app.userId && app.userId.profilePicture) { %>
 <img src="<%= app.userId.profilePicture %>" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover">
 <% } else { %>
 <div style="width:28px;height:28px;border-radius:50%;background:rgba(57,255,20,.15);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;color:var(--green)">
 <%= app.userId ? app.userId.username.charAt(0).toUpperCase() : '?' %>
 </div>
 <% } %>
 <span style="font-weight:700;color:var(--text)"><%= app.userId ? app.userId.username : 'Deleted user' %></span>
 </div>
 </td>
 <td style="color:var(--text-2);font-size:.8125rem"><%= app.questId ? app.questId.title : 'Unknown quest' %></td>
 <td style="color:var(--text-3);font-size:.8125rem"><%= app.xHandle || '—' %></td>
 <td style="color:var(--text-3);font-size:.8125rem"><%= app.telegramUsername || '—' %></td>
 <td>
 <span class="a-badge <%= app.status==='approved' ? 'a-badge-success' : app.status==='rejected' ? 'a-badge-danger' : 'a-badge-warning' %>">
 <%= app.status %>
 </span>
 </td>
 <td style="color:var(--text-3);font-size:.8125rem">
 <%= new Date(app.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
 </td>
 <td>
 <div style="display:flex;gap:.375rem;align-items:center">
 <% if (app.status === 'pending') { %>
 <button class="a-btn a-btn-primary a-btn-sm" onclick="approveApp('<%= app._id %>')" title="Approve">
 <i class="fas fa-check"></i>
 </button>
 <button class="a-btn a-btn-danger a-btn-sm" onclick="rejectApp('<%= app._id %>')" title="Reject">
 <i class="fas fa-times"></i>
 </button>
 <% } else if (app.status === 'approved') { %>
 <button class="a-btn a-btn-sm" style="background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.3);color:#f87171" onclick="rejectApp('<%= app._id %>')" title="Revoke">
 <i class="fas fa-ban"></i>
 </button>
 <% } %>
 </div>
 </td>
 </tr>
 <% }) %>
 <% } else { %>
 <tr>
 <td colspan="7" style="text-align:center;padding:3rem;color:var(--text-3)">
 <i class="fas fa-shield-halved" style="display:block;font-size:1.5rem;margin-bottom:.5rem"></i>
 No quest applications yet
 </td>
 </tr>
 <% } %>
 </tbody>
 </table>
 </div>
 </div>

 <!-- Grouped by quest -->
 <% if (grouped && grouped.length > 0) { %>
 <div style="margin-top:2rem">
 <h2 style="font-size:1rem;font-weight:800;color:var(--text-2);letter-spacing:1px;text-transform:uppercase;margin-bottom:1rem">By Quest</h2>
 <% grouped.forEach(function(g) { %>
 <div class="a-card" style="margin-bottom:1rem">
 <div class="a-card-header">
 <h2><i class="fas fa-trophy" style="color:var(--green)"></i> <%= g.quest ? g.quest.title : 'Unknown Quest' %></h2>
 <span style="font-size:.78rem;color:var(--text-3)"><%= g.items.length %> application<%= g.items.length !== 1 ? 's' : '' %></span>
 </div>
 <div style="display:flex;gap:.5rem;flex-wrap:wrap">
 <span style="font-size:.8125rem;color:var(--text-3)">
 Pending: <strong style="color:#f59e0b"><%= g.items.filter(function(i){return i.status==='pending';}).length %></strong>
 </span>
 <span style="color:var(--text-3)">|</span>
 <span style="font-size:.8125rem;color:var(--text-3)">
 Approved: <strong style="color:var(--green)"><%= g.items.filter(function(i){return i.status==='approved';}).length %></strong>
 </span>
 <span style="color:var(--text-3)">|</span>
 <span style="font-size:.8125rem;color:var(--text-3)">
 Rejected: <strong style="color:#f87171"><%= g.items.filter(function(i){return i.status==='rejected';}).length %></strong>
 </span>
 </div>
 </div>
 <% }) %>
 </div>
 <% } %>

 </div>
</div>

<!-- Reject reason modal -->
<div id="rejectModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:1000;align-items:center;justify-content:center;padding:1rem">
 <div style="background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:1.75rem;width:100%;max-width:440px">
 <h3 style="font-size:1rem;font-weight:800;color:var(--text);margin-bottom:1rem"><i class="fas fa-times-circle" style="color:#f87171"></i> Reject Application</h3>
 <input type="hidden" id="rejectAppId">
 <div style="margin-bottom:1rem">
 <label style="display:block;font-size:.8125rem;font-weight:700;color:var(--text-2);margin-bottom:.4rem">Reason (optional)</label>
 <input type="text" id="rejectReason" style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:.75rem 1rem;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9375rem;outline:none" placeholder="e.g. Does not meet requirements">
 </div>
 <div style="display:flex;gap:.625rem">
 <button class="a-btn a-btn-danger" style="flex:1" onclick="confirmReject()"><i class="fas fa-times"></i> Reject</button>
 <button class="a-btn a-btn-secondary" style="flex:1" onclick="closeRejectModal()">Cancel</button>
 </div>
 </div>
</div>

<script>
// Filter tabs
function filterApps(status, btn) {
 document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
 btn.classList.add('active');
 document.querySelectorAll('.app-row').forEach(function(row) {
 if (status === 'all' || row.dataset.status === status) {
 row.style.display = '';
 } else {
 row.style.display = 'none';
 }
 });
}

// Approve
function approveApp(id) {
 if (!confirm('Approve this application? This will create a quest progress record for the user.')) return;
 fetch('/admin/quest-applications/' + id + '/approve', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
 .then(function(r) { return r.json(); })
 .then(function(data) {
 if (data.success) {
 aToast('Application approved!', 'success');
 setTimeout(function() { location.reload(); }, 1200);
 } else {
 aToast(data.message || 'Error', 'error');
 }
 })
 .catch(function() { aToast('Network error', 'error'); });
}

// Reject
var _rejectId = null;
function rejectApp(id) {
 _rejectId = id;
 document.getElementById('rejectAppId').value = id;
 document.getElementById('rejectReason').value = '';
 var m = document.getElementById('rejectModal');
 m.style.display = 'flex';
}
function closeRejectModal() {
 document.getElementById('rejectModal').style.display = 'none';
 _rejectId = null;
}
function confirmReject() {
 var id = _rejectId;
 var reason = document.getElementById('rejectReason').value.trim();
 fetch('/admin/quest-applications/' + id + '/reject', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ reason: reason })
 })
 .then(function(r) { return r.json(); })
 .then(function(data) {
 closeRejectModal();
 if (data.success) {
 aToast('Application rejected', 'success');
 setTimeout(function() { location.reload(); }, 1200);
 } else {
 aToast(data.message || 'Error', 'error');
 }
 })
 .catch(function() { aToast('Network error', 'error'); });
}
// Close reject modal on overlay click
document.getElementById('rejectModal').addEventListener('click', function(e) {
 if (e.target === this) closeRejectModal();
});

// Logo upload
function previewLogo(input) {
 if (!input.files || !input.files[0]) return;
 var reader = new FileReader();
 reader.onload = function(e) {
 var img = document.getElementById('logoPreview');
 var icon = document.getElementById('logoPreviewIcon');
 img.src = e.target.result;
 img.style.display = 'block';
 if (icon) icon.style.display = 'none';
 };
 reader.readAsDataURL(input.files[0]);
}
function uploadLogo(questId) {
 var file = document.getElementById('logoFile').files[0];
 var msg = document.getElementById('logoUploadMsg');
 if (!file) { msg.textContent = 'Choose an image first'; msg.style.color = '#f87171'; return; }
 var fd = new FormData();
 fd.append('logo', file);
 msg.textContent = 'Uploading...'; msg.style.color = 'var(--text-3)';
 fetch('/admin/quests/' + questId + '/upload-logo', { method: 'POST', body: fd })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) { msg.textContent = 'Logo saved!'; msg.style.color = '#6ee7b7'; }
 else { msg.textContent = d.message || 'Error'; msg.style.color = '#f87171'; }
 })
 .catch(function() { msg.textContent = 'Network error'; msg.style.color = '#f87171'; });
}
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
</html>
