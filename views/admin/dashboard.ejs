// ── Admin task management ─────────────────────────────────────────────────────
var _adminTaskCache = {};

function adminOpenEditTask(questId, taskId) {
 var t = _adminTaskCache[taskId];
 if (!t) { alert('Task data not loaded. Close and reopen the leaderboard.'); return; }
 document.getElementById('aet_quest_id').value = questId;
 document.getElementById('aet_task_id').value = taskId;
 document.getElementById('aet_title').value = t.title || '';
 document.getElementById('aet_desc').value = t.description || '';
 document.getElementById('aet_type').value = t.taskType || 'external';
 document.getElementById('aet_xp').value = t.xpReward || t.xp || 0;
 document.getElementById('aet_btntext').value = t.buttonText || '';
 document.getElementById('aet_btnlink').value = t.buttonLink || '';
 document.getElementById('aet_input_type').value = t.inputType || 'none';
 document.getElementById('aet_input_name').value = t.inputName || '';
 document.getElementById('aet_input_label').value = t.inputLabel || '';
 var msg = document.getElementById('aetMsg');
 msg.style.display = 'none';
 openModal('adminEditTaskModal');
}

function adminSaveEditTask() {
 var questId = document.getElementById('aet_quest_id').value;
 var taskId = document.getElementById('aet_task_id').value;
 var title = document.getElementById('aet_title').value.trim();
 if (!title) { alert('Task title is required'); return; }
 var payload = {
 title: title,
 description: document.getElementById('aet_desc').value.trim(),
 taskType: document.getElementById('aet_type').value,
 xpReward: parseInt(document.getElementById('aet_xp').value) || 0,
 buttonText: document.getElementById('aet_btntext').value.trim(),
 buttonLink: document.getElementById('aet_btnlink').value.trim(),
 inputType: document.getElementById('aet_input_type').value,
 inputName: document.getElementById('aet_input_name').value.trim(),
 inputLabel: document.getElementById('aet_input_label').value.trim()
 };
 fetch('/admin/api/quests/' + questId + '/tasks/' + taskId, {
 method: 'PATCH',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(payload)
 })
 .then(r => r.json())
 .then(d => {
 var msg = document.getElementById('aetMsg');
 msg.textContent = d.success ? 'Task updated!' : (d.message || 'Error');
 msg.style.display = '';
 msg.style.background = d.success ? 'rgba(94,194,19,.15)' : 'rgba(239,68,68,.15)';
 msg.style.color = d.success ? 'var(--green)' : '#ef4444';
 if (d.success) {
 // Update cache and label in leaderboard modal
 Object.assign(_adminTaskCache[taskId], payload);
 var row = document.getElementById('atrow-' + taskId);
 if (row) {
 row.querySelector('p').textContent = payload.title;
 row.querySelector('span').textContent = payload.taskType + ' · ' + payload.xpReward + ' XP';
 }
 setTimeout(function() { closeModal('adminEditTaskModal'); }, 900);
 }
 });
}

function adminDeleteTask(questId, taskId) {
 if (!confirm('Delete this task? This cannot be undone.')) return;
 fetch('/admin/api/quests/' + questId + '/tasks/' + taskId, { method: 'DELETE' })
 .then(r => r.json())
 .then(d => {
 if (d.success) {
 var row = document.getElementById('atrow-' + taskId);
 if (row) row.remove();
 delete _adminTaskCache[taskId];
 } else {
 alert(d.message || 'Error deleting task');
 }
 });
}

