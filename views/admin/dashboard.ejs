 <!-- Competition Settings -->
 <div id="competitionSettings" style="display: none; border-bottom: 2px solid rgba(94,194,19,0.2); padding-bottom: 1.5rem; margin-bottom: 1.5rem; background: rgba(255,193,7,0.05); padding: 1.5rem; border-radius: 12px;">
