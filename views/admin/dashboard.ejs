async function questResetProgress(questId) {
 if (!confirm(' RESET ALL PROGRESS\n\nThis will:\n• Set every participant back to 0 XP\n• Clear all task completions and submissions\n• Deduct the XP from their global profile\n• Zero out the quest completion bonus\n• NOT touch approvals — everyone stays approved\n\nAre you sure?')) return;
 if (!confirm('Last chance — this cannot be undone. Reset all participants to 0 XP?')) return;
 try {
 var r = await fetch('/admin/api/quest/reset-progress', { method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify({ questId: questId }) });
 var d = await r.json();
 alert(d.success ? (d.message || 'Done!') : ('Error: ' + (d.message || 'Unknown error')));
 if (d.success) closeLeaderboardModal();
 } catch(e) { alert('Network error'); }
}

