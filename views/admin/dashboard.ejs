 <div class="form-group">
 <label>Quest Title *</label>
 <input type="text" id="questTitle" required>
 </div>
 
 <div class="form-group">
 <label>Short Description *</label>
 <input type="text" id="questShortDesc" required>
 </div>

 <div class="form-group">
 <label>Full Description *</label>
 <textarea id="questDescription" required></textarea>
 </div>

 <div class="form-group">
 <label>Quest Banner Image URL <span style="color:#888;font-weight:400">(optional — partner logo or banner)</span></label>
 <input type="url" id="questImage" placeholder="https://example.com/image.png or /img/partners/ginox.jpg">
 <small style="color:#888;font-size:0.8rem;">Use /img/partners/name.jpg for partner quests or paste any public image URL</small>
 </div>

 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
 <div class="form-group">
 <label>Category *</label>
 <select id="questCategory" required>
 <option value="development">Development</option>
 <option value="social">Social</option>
 <option value="learning">Learning</option>
 <option value="community">Community</option>
 <option value="nft">NFT & Digital Assets</option>
 </select>
 </div>
 
 <div class="form-group">
 <label>Difficulty *</label>
 <select id="questDifficulty" required>
 <option value="beginner">Beginner</option>
 <option value="intermediate">Intermediate</option>
 <option value="advanced">Advanced</option>
 </select>
 </div>
 </div>
 </div>

 <!-- Quest Type -->
 <div style="border-bottom: 2px solid rgba(94,194,19,0.2); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
 <h4 style="color:var(--green); margin-bottom: 1rem;"><i class="fas fa-trophy"></i> Quest Type</h4>
 
 <div class="form-group">
 <label>Quest Type *</label>
 <select id="questType" onchange="toggleQuestTypeSettings()" required>
 <option value="standard">Standard (Regular quest)</option>
 <option value="referral_boost">Referral Boost (Earn XP from referrals)</option>
 <option value="fcfs">First Come First Serve (Speed competition)</option>
 <option value="competition">Competition (Leaderboard with prizes)</option>
 </select>
 <small style="color: #888; display: block; margin-top: 0.5rem;">
 Standard: Normal quest | Referral Boost: Bonus XP for referred users | FCFS: First to finish wins | Competition: Top performers get prizes
 </small>
 </div>
 </div>

 <!-- Dates & Limits -->
 <div style="border-bottom: 2px solid rgba(94,194,19,0.2); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
 <h4 style="color:var(--green); margin-bottom: 1rem;"><i class="fas fa-calendar"></i> Duration & Limits</h4>

 <div style="background: rgba(94,194,19,0.05); border: 1px solid rgba(94,194,19,0.2); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
 <p style="color:var(--green); margin: 0; font-size: 0.9rem;">
 <i class="fas fa-info-circle"></i> <strong>Leave dates EMPTY to make quest available immediately!</strong>
 </p>
 <p style="color: #888; margin: 0.5rem 0 0 0; font-size: 0.85rem;">
 Only set dates if you want to schedule the quest for a specific time period.
 </p>
 </div>

 <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
 <div class="form-group">
 <label>Start Date (Optional)</label>
 <input type="date" id="questStartDate" placeholder="">
 <small style="color: #888; display: block; margin-top: 0.3rem;">Leave empty for immediate start</small>
 </div>

 <div class="form-group">
 <label>End Date (Optional)</label>
 <input type="date" id="questEndDate" placeholder="">
 <small style="color: #888; display: block; margin-top: 0.3rem;">Leave empty for no end date</small>
 </div>
 </div>

 <button type="button" onclick="clearQuestDates()" class="btn btn-secondary" style="margin-top: 0.5rem; font-size: 0.85rem; padding: 0.4rem 0.8rem;">
