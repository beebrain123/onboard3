function rankDefaultPercentages(count, first, second) {
 count = Math.max(1, Math.min(100, parseInt(count, 10) || 1));
 first = Number.isFinite(Number(first)) ? Math.max(0, Math.min(100, Number(first))) : 50;
 second = Number.isFinite(Number(second)) ? Math.max(0, Math.min(100 - first, Number(second))) : 30;
 if (count === 1) return [100];
 if (count === 2) return [first, 100 - first];
 const share = Math.floor(((100 - first - second) / (count - 2)) * 100) / 100;
 const rest = Array(count - 2).fill(share);
 rest[rest.length - 1] = Math.round((100 - first - second - share * (count - 3)) * 100) / 100;
 return [first, second].concat(rest);
}
function renderRankPrizeFields(mode, saved) {
 const countInput = document.getElementById(mode === 'edit' ? 'editTopWinnersCount' : 'topWinnersCount');
 const target = document.getElementById(mode === 'edit' ? 'editRankPrizeFields' : 'createRankPrizeFields');
 if (!countInput || !target) return;
 const count = Math.max(1, Math.min(100, parseInt(countInput.value, 10) || 1)); countInput.value = count;
 const first = document.getElementById(mode === 'edit' ? 'editFirstPlacePercent' : 'firstPlacePercent')?.value;
 const second = document.getElementById(mode === 'edit' ? 'editSecondPlacePercent' : 'secondPlacePercent')?.value;
 const defaults = rankDefaultPercentages(count, first, second);
 const current = Array.from(target.querySelectorAll('.rank-prize-percent')).map(input => parseFloat(input.value));
 const values = Array.isArray(saved) && saved.length ? saved : current.length ? current.concat(defaults.slice(current.length)).slice(0, count) : defaults;
 target.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.65rem">' + Array.from({length:count}, function(_, i) {
  const value = Number.isFinite(Number(values[i])) ? Number(values[i]) : defaults[i];
  return '<label style="font-size:.8rem;color:#bbb">Place ' + (i + 1) + ' (%)<input class="rank-prize-percent" type="number" min="0" max="100" step="0.01" value="' + value.toFixed(2) + '" oninput="updateRankPrizePreview(\'' + mode + '\')" style="display:block;width:100%;margin-top:.3rem"></label>';
 }).join('') + '</div>';
 updateRankPrizePreview(mode);
}
function getRankPercentages(mode) {
 const target = document.getElementById(mode === 'edit' ? 'editRankPrizeFields' : 'createRankPrizeFields');
 return target ? Array.from(target.querySelectorAll('.rank-prize-percent')).map(input => parseFloat(input.value) || 0) : [];
}
function updateRankPrizePreview(mode) {
 const pool = parseFloat(document.getElementById(mode === 'edit' ? 'editQuestUSDC' : 'questUSDC')?.value) || 0;
 const values = getRankPercentages(mode); const total = values.reduce((sum, pct) => sum + pct, 0);
 const summary = document.getElementById(mode === 'edit' ? 'editRankPrizeSummary' : 'createRankPrizeSummary');
 const first = document.getElementById(mode === 'edit' ? 'editFirstPlacePercent' : 'firstPlacePercent');
 const second = document.getElementById(mode === 'edit' ? 'editSecondPlacePercent' : 'secondPlacePercent');
 if (first && values.length) first.value = values[0]; if (second && values.length > 1) second.value = values[1];
 if (summary) {
  summary.innerHTML = values.map((pct, i) => 'Place ' + (i + 1) + ': $' + (pool * pct / 100).toFixed(2)).join(' ? ') + '<br><span style="color:' + (Math.abs(total - 100) < .011 ? '#5EC213' : '#f87171') + '">Total: ' + total.toFixed(2) + '% (' + (Math.abs(total - 100) < .011 ? 'ready' : 'must equal 100%') + ')</span>';
 }
}

