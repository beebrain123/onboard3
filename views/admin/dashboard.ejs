 <div id="batchSettings" style="display: none; border-bottom: 2px solid rgba(94,194,19,0.2); padding-bottom: 1.5rem; margin-bottom: 1.5rem; background: rgba(59,130,246,0.05); padding: 1.5rem; border-radius: 12px;">
