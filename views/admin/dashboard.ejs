 <input type="url" id="pw-x-ai" placeholder="X community: https://x.com/..." style="width:100%;padding:.6rem .875rem;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:#fff;font-size:.85rem;font-family:inherit">
