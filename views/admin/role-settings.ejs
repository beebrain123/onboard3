<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Role Settings - Admin | ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <style>
 * {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }

 body {
 font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
 background: #050810;
 color: #fff;
 overflow-x: hidden;
 -webkit-font-smoothing: antialiased;
 -moz-osx-font-smoothing: grayscale;
 }

 .grid-bg {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background-image:
 linear-gradient(rgba(57, 255, 20, 0.03) 1px, transparent 1px),
 linear-gradient(90deg, rgba(57, 255, 20, 0.03) 1px, transparent 1px);
 background-size: 50px 50px;
 pointer-events: none;
 z-index: 0;
 }

 /* Admin Navbar Styles */
 .admin-navbar {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 70px;
 background: rgba(15, 15, 15, 0.98);
 border-bottom: 2px solid rgba(57, 255, 20, 0.2);
 display: flex;
 align-items: center;
 justify-content: space-between;
 padding: 0 2rem;
 z-index: 1000;
 backdrop-filter: blur(10px);
 }

 .navbar-logo {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 }

 .navbar-logo h1 {
 color: #39FF14;
 font-size: 1.5rem;
 margin: 0;
 }

 .navbar-menu {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 flex: 1;
 justify-content: center;
 }

 .menu-item {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 padding: 0.75rem 1.25rem;
 color: #888;
 text-decoration: none;
 transition: all 0.3s;
 cursor: pointer;
 border-radius: 8px;
 white-space: nowrap;
 font-size: 0.9rem;
 border-bottom: 3px solid transparent;
 }

 .menu-item:hover {
 color: #39FF14;
 background: rgba(57, 255, 20, 0.05);
 }

 .menu-item.active {
 color: #39FF14;
 background: rgba(57, 255, 20, 0.1);
 border-bottom-color: #39FF14;
 }

 .mobile-nav-toggle {
 display: none;
 background: #39FF14;
 border: none;
 color: #000;
 width: 40px;
 height: 40px;
 border-radius: 8px;
 cursor: pointer;
 font-size: 1.25rem;
 }

 .mobile-dropdown {
 display: none;
 position: fixed;
 top: 70px;
 left: 0;
 width: 100%;
 background: rgba(15, 15, 15, 0.98);
 backdrop-filter: blur(10px);
 border-bottom: 2px solid rgba(57, 255, 20, 0.2);
 z-index: 999;
 flex-direction: column;
 padding: 1rem;
 }

 .mobile-dropdown.active {
 display: flex;
 }

 @media (max-width: 768px) {
 .navbar-menu {
 display: none;
 }

 .mobile-nav-toggle {
 display: flex;
 align-items: center;
 justify-content: center;
 }
 }


 .admin-container {
 max-width: 1400px;
 margin: 90px auto 0;
 padding: 2rem;
 position: relative;
 z-index: 1;
 }

 .admin-header {
 background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(57, 255, 20, 0.1));
 border-radius: 20px;
 padding: 2rem;
 margin-bottom: 2rem;
 border: 2px solid rgba(255, 107, 53, 0.3);
 }

 .admin-title {
 font-size: 2rem;
 font-weight: 900;
 color: #FF6B35;
 margin-bottom: 0.5rem;
 }

 .admin-subtitle {
 color: #888;
 font-size: 1rem;
 }

 .role-card {
 background: rgba(0, 0, 0, 0.3);
 border-radius: 16px;
 padding: 2rem;
 margin-bottom: 1.5rem;
 border: 2px solid rgba(57, 255, 20, 0.2);
 transition: all 0.3s;
 }

 .role-card:hover {
 border-color: #39FF14;
 box-shadow: 0 10px 30px rgba(57, 255, 20, 0.2);
 }

 .role-card-header {
 display: flex;
 justify-content: space-between;
 align-items: center;
 margin-bottom: 1.5rem;
 padding-bottom: 1rem;
 border-bottom: 1px solid rgba(57, 255, 20, 0.2);
 }

 .role-name {
 font-size: 1.5rem;
 font-weight: 700;
 display: flex;
 align-items: center;
 gap: 0.75rem;
 }

 .role-badge {
 width: 40px;
 height: 40px;
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 1.2rem;
 }

 .form-grid {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
 gap: 1.5rem;
 }

 .form-group {
 display: flex;
 flex-direction: column;
 gap: 0.5rem;
 }

 .form-label {
 font-size: 0.9rem;
 font-weight: 600;
 color: #39FF14;
 }

 .form-input {
 padding: 0.75rem 1rem;
 background: rgba(0, 0, 0, 0.5);
 border: 1px solid rgba(57, 255, 20, 0.3);
 border-radius: 8px;
 color: #fff;
 font-family: 'Outfit', sans-serif;
 font-size: 1rem;
 }

 .form-input:focus {
 outline: none;
 border-color: #39FF14;
 box-shadow: 0 0 0 3px rgba(57, 255, 20, 0.1);
 }

 .checkbox-group {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 padding: 0.75rem;
 background: rgba(0, 0, 0, 0.3);
 border-radius: 8px;
 }

 .checkbox-input {
 width: 20px;
 height: 20px;
 cursor: pointer;
 }

 .save-btn {
 padding: 1rem 2rem;
 background: linear-gradient(135deg, #39FF14, #00D9FF);
 border: none;
 border-radius: 12px;
 color: #000;
 font-family: 'Outfit', sans-serif;
 font-size: 1rem;
 font-weight: 700;
 cursor: pointer;
 transition: all 0.3s;
 margin-top: 1rem;
 }

 .save-btn:hover {
 transform: translateY(-2px);
 box-shadow: 0 10px 30px rgba(57, 255, 20, 0.5);
 }

 .alert {
 padding: 1rem 1.5rem;
 border-radius: 12px;
 margin-bottom: 1.5rem;
 display: none;
 align-items: center;
 gap: 0.75rem;
 font-weight: 600;
 }

 .alert.show {
 display: flex;
 }

 .alert-success {
 background: rgba(57, 255, 20, 0.2);
 border: 2px solid #39FF14;
 color: #39FF14;
 }

 .alert-error {
 background: rgba(255, 82, 82, 0.2);
 border: 2px solid #FF5252;
 color: #FF5252;
 }

 @media (max-width: 768px) {
 .admin-container {
 padding: 1rem;
 }

 .role-card {
 padding: 1.5rem;
 }

 .form-grid {
 grid-template-columns: 1fr;
 }
 }
 </style>
</head>
<body>
 <div class="grid-bg"></div>

 <%- include('../partials/admin-navbar', { currentPage: 'role-settings' }) %>

 <div class="admin-container">
 <!-- Header -->
 <div class="admin-header">
 <h1 class="admin-title">
 <i class="fas fa-shield-alt"></i> Role Configuration
 </h1>
 <p class="admin-subtitle">Configure XP ranges, monthly bonuses, and benefits for each role</p>
 </div>

 <!-- Alert Messages -->
 <div id="alertSuccess" class="alert alert-success">
 <i class="fas fa-check-circle"></i>
 <span id="successMessage">Settings saved successfully!</span>
 </div>
 <div id="alertError" class="alert alert-error">
 <i class="fas fa-exclamation-circle"></i>
 <span id="errorMessage">Error saving settings</span>
 </div>

 <!-- Role Configuration Form -->
 <form id="roleConfigForm">
 <%
 const roleOrder = ['citizen', 'contributor', 'ambassador', 'legend', 'major'];
 roleOrder.forEach(roleKey => {
 const role = roles[roleKey];
 if (!role || role.special) return;
 %>
 <div class="role-card" data-role="<%= roleKey %>">
 <div class="role-card-header">
 <div class="role-name">
 <div class="role-badge" style="background: <%= role.color %>22; color: <%= role.color %>;">
 <i class="<%= role.icon %>"></i>
 </div>
 <span style="color: <%= role.color %>;"><%= role.name %></span>
 </div>
 </div>

 <div class="form-grid">
 <!-- XP Range -->
 <div class="form-group">
 <label class="form-label">Minimum XP</label>
 <input type="number" class="form-input" name="<%= roleKey %>_minXP" value="<%= role.minXP %>" min="0">
 </div>
 <div class="form-group">
 <label class="form-label">Maximum XP</label>
 <input type="text" class="form-input" name="<%= roleKey %>_maxXP" value="<%= role.maxXP === Infinity ? 'Infinity' : role.maxXP %>">
 </div>

 <!-- Monthly Bonus -->
 <div class="form-group">
 <label class="form-label">Monthly Bonus XP</label>
 <input type="number" class="form-input" name="<%= roleKey %>_monthlyBonus" value="<%= role.benefits.monthlyBonus %>" min="0" step="100">
 </div>

 <!-- Class Discount -->
 <div class="form-group">
 <label class="form-label">Class Discount (%)</label>
 <input type="number" class="form-input" name="<%= roleKey %>_classDiscount" value="<%= role.benefits.classDiscount %>" min="0" max="100">
 </div>
 </div>

 <!-- Benefits Checkboxes -->
 <div class="form-grid" style="margin-top: 1rem;">
 <div class="checkbox-group">
 <input type="checkbox" class="checkbox-input" name="<%= roleKey %>_multiplayerAccess" <%= role.benefits.multiplayerAccess ? 'checked' : '' %>>
 <label style="color: #fff;">Multiplayer Access</label>
 </div>
 <div class="checkbox-group">
 <input type="checkbox" class="checkbox-input" name="<%= roleKey %>_jobBoardAccess" <%= role.benefits.jobBoardAccess ? 'checked' : '' %>>
 <label style="color: #fff;">Job Board Access</label>
 </div>
 <div class="checkbox-group">
 <input type="checkbox" class="checkbox-input" name="<%= roleKey %>_prioritySupport" <%= role.benefits.prioritySupport ? 'checked' : '' %>>
 <label style="color: #fff;">Priority Support</label>
 </div>
 <div class="checkbox-group">
 <input type="checkbox" class="checkbox-input" name="<%= roleKey %>_exclusiveQuests" <%= role.benefits.exclusiveQuests ? 'checked' : '' %>>
 <label style="color: #fff;">Exclusive Quests</label>
 </div>
 </div>
 </div>
 <% }); %>

 <!-- Save Button -->
 <button type="submit" class="save-btn">
 <i class="fas fa-save"></i> Save All Changes
 </button>
 </form>
 </div>

 <script>
 document.getElementById('roleConfigForm').addEventListener('submit', async (e) => {
 e.preventDefault();

 const formData = new FormData(e.target);
 const config = {};

 // Parse form data
 const roleOrder = ['citizen', 'contributor', 'ambassador', 'legend', 'major'];

 roleOrder.forEach(roleKey => {
 config[roleKey] = {
 minXP: parseInt(formData.get(`${roleKey}_minXP`)) || 0,
 maxXP: formData.get(`${roleKey}_maxXP`) === 'Infinity' ? Infinity : parseInt(formData.get(`${roleKey}_maxXP`)),
 benefits: {
 monthlyBonus: parseInt(formData.get(`${roleKey}_monthlyBonus`)) || 0,
 classDiscount: parseInt(formData.get(`${roleKey}_classDiscount`)) || 0,
 multiplayerAccess: formData.get(`${roleKey}_multiplayerAccess`) === 'on',
 jobBoardAccess: formData.get(`${roleKey}_jobBoardAccess`) === 'on',
 prioritySupport: formData.get(`${roleKey}_prioritySupport`) === 'on',
 exclusiveQuests: formData.get(`${roleKey}_exclusiveQuests`) === 'on'
 }
 };
 });

 try {
 const response = await fetch('/admin/api/update-roles', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ roles: config })
 });

 const data = await response.json();

 if (data.success) {
 showAlert('success', 'Settings saved successfully! Changes will take effect immediately.');
 setTimeout(() => {
 window.location.reload();
 }, 2000);
 } else {
 showAlert('error', data.message || 'Error saving settings');
 }
 } catch (error) {
 console.error('Error saving settings:', error);
 showAlert('error', 'Network error. Please try again.');
 }
 });

 function showAlert(type, message) {
 const successAlert = document.getElementById('alertSuccess');
 const errorAlert = document.getElementById('alertError');

 if (type === 'success') {
 document.getElementById('successMessage').textContent = message;
 successAlert.classList.add('show');
 setTimeout(() => successAlert.classList.remove('show'), 5000);
 } else {
 document.getElementById('errorMessage').textContent = message;
 errorAlert.classList.add('show');
 setTimeout(() => errorAlert.classList.remove('show'), 5000);
 }
 }
 </script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
