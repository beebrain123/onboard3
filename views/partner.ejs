 <script src="./js/head.js"></script>
 <script>
 // Navbar scroll
 window.addEventListener('scroll', () => {
 document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
 });

 // Scroll reveal
 const revealObs = new IntersectionObserver((entries) => {
 entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); } });
 }, { threshold: 0.08, rootMargin: '0px 0px -50px 0px' });
 document.querySelectorAll('.reveal-up').forEach(el => revealObs.observe(el));

 // Stat counter
 function animateCount(el, target, formatter) {
 if (target === 0) { el.textContent = formatter ? formatter(0) : '0'; return; }
 let cur = 0, step = Math.max(1, Math.ceil(target / 55));
 const t = setInterval(() => {
 cur = Math.min(cur + step, target);
 el.textContent = formatter ? formatter(cur) : cur.toLocaleString();
 if (cur >= target) clearInterval(t);
 }, 22);
 }

 function fmtNum(n) {
 if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
 if (n >= 1000) return (n / 1000).toFixed(1) + 'K';
 return n.toLocaleString();
 }

 async function loadStats() {
 try {
 const res = await fetch('/api/public/stats');
 const d = await res.json();
 if (!d.success) return;

 const map = [
 { el: 's-members', val: d.totalMembers, plus: 's-members-plus', showPlus: d.totalMembers > 0 },
 { el: 's-attendees', val: d.totalAttendees },
 { el: 's-events', val: d.totalEvents },
 { el: 's-quests', val: d.questsCompleted },
 { el: 's-active-quests',val: d.activeQuests },
 { el: 's-rewards', val: 6800, fmt: (n) => n >= 1000 ? (n/1000).toFixed(1)+'K' : n.toFixed(2) },
 ];

 const strip = document.getElementById('statsStrip');
 const done = { triggered: false };

 const obs = new IntersectionObserver((entries) => {
 if (entries[0].isIntersecting && !done.triggered) {
 done.triggered = true;
 map.forEach(({ el, val, plus, showPlus, fmt }) => {
 const node = document.getElementById(el);
 if (!node) return;
 if (plus && showPlus) document.getElementById(plus).textContent = '+';
 animateCount(node, val, fmt || fmtNum);
 });
 obs.disconnect();
 }
 }, { threshold: 0.3 });
 obs.observe(strip);
 } catch (e) {
 console.error('Stats load failed', e);
 }
 }
 loadStats();

 // Floating particles
 (function() {
 const c = document.getElementById('particles');
 if (!c) return;
 for (let i = 0; i < 35; i++) {
 const p = document.createElement('div');
 p.className = 'particle';
 const size = Math.random() * 4 + 2;
 p.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*100}%;width:${size}px;height:${size}px;animation-delay:${Math.random()*12}s;animation-duration:${Math.random()*12+10}s;opacity:${Math.random()*0.45+0.08};`;
 c.appendChild(p);
 }
 })();

 // Type selector visual state
 document.querySelectorAll('.type-option input').forEach(r => {
 r.addEventListener('change', () => {
 document.querySelectorAll('.type-opt-card').forEach(c => c.classList.remove('selected'));
 if (r.checked) r.parentElement.querySelector('.type-opt-card').classList.add('selected');
 });
 });

 // Form submit
 document.getElementById('partnerForm').addEventListener('submit', async function(e) {
 e.preventDefault();
 const btn = document.getElementById('submitBtn');
 document.getElementById('submitText').style.display = 'none';
 document.getElementById('submitSpinner').style.display = 'inline-flex';
 btn.disabled = true;

 const selected = document.querySelector('input[name="partnershipType"]:checked');
 if (!selected) {
 alert('Please select a partnership type.');
 document.getElementById('submitText').style.display = 'inline-flex';
 document.getElementById('submitSpinner').style.display = 'none';
 btn.disabled = false;
 return;
 }

 const payload = {
 projectName: document.getElementById('projectName').value,
 email: document.getElementById('email').value,
 website: document.getElementById('website').value,
 telegram: document.getElementById('telegram').value,
 partnershipType: selected.value,
 description: document.getElementById('description').value,
 budget: document.getElementById('budget').value,
 timeline: document.getElementById('timeline').value,
 };

 try {
 const res = await fetch('/api/partnership/public-inquiry', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(payload)
 });
 const data = await res.json();
 if (data.success) {
 document.getElementById('submitSpinner').style.display = 'none';
 document.getElementById('formSuccess').style.display = 'flex';
 this.reset();
 document.querySelectorAll('.type-opt-card').forEach(c => c.classList.remove('selected'));
 } else {
 throw new Error(data.message);
 }
 } catch (err) {
 document.getElementById('submitText').style.display = 'inline-flex';
 document.getElementById('submitSpinner').style.display = 'none';
 btn.disabled = false;
 alert(err.message || 'Something went wrong. Please try again.');
 }
 });
 </script>

