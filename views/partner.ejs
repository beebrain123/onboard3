 <!-- ── QUEST ── -->
 <div class="ptype-card reveal-up" style="--d:0ms">
 <div class="ptype-glow"></div>
 <div class="ptype-top">
 <div class="ptype-icon-wrap">
 <div class="ptype-icon-ring"></div>
