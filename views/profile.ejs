<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <meta property="og:type" content="profile">
 <meta property="og:site_name" content="ONBOARD3">
 <meta property="og:title" content="@<%= profileUser.username %> — <%= role.name %> on ONBOARD3">
 <meta property="og:description" content="<%= (profileUser.xp||0).toLocaleString() %> XP · $<%= totalUsdc %> USDC earned · <%= questsDone %> quests completed">
 <meta property="og:url" content="https://<%= host %>/u/<%= profileUser.username %>">
 <meta property="og:image" content="https://<%= host %>/img/og-default.png">
 <meta name="twitter:card" content="summary_large_image">
 <meta name="twitter:site" content="@onboard3__">
 <meta name="twitter:title" content="@<%= profileUser.username %> — <%= role.name %> on ONBOARD3">
 <meta name="twitter:description" content="<%= (profileUser.xp||0).toLocaleString() %> XP · $<%= totalUsdc %> USDC · <%= questsDone %> quests ">
 <title>@<%= profileUser.username %> — ONBOARD3</title>
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <style>
 *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
 :root{
 --bg:#0a0f0a;--bg2:#0f160f;--surface:#111811;
 --border:rgba(94,194,19,.12);--border2:rgba(94,194,19,.22);
 --text:#e8f5e2;--text2:#8aaf85;--text3:#4a6a46;
 --green:#5ec213;--green-d:#45960e;
 }
 body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;min-height:100vh;-webkit-font-smoothing:antialiased;}
 .grid-bg{position:fixed;inset:0;z-index:0;pointer-events:none;
 background-image:linear-gradient(rgba(94,194,19,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(94,194,19,.04) 1px,transparent 1px);
 background-size:48px 48px;}
 .glow-orb{position:fixed;pointer-events:none;z-index:0;border-radius:50%;filter:blur(110px);}
 .glow-1{width:480px;height:480px;top:-120px;left:-120px;background:radial-gradient(circle,rgba(94,194,19,.09) 0%,transparent 70%);}
 .glow-2{width:360px;height:360px;bottom:-80px;right:-80px;background:radial-gradient(circle,rgba(94,194,19,.06) 0%,transparent 70%);}

 /* Topbar */
 .topbar{position:sticky;top:0;z-index:200;display:flex;align-items:center;justify-content:space-between;
 padding:.875rem 1.5rem;background:rgba(10,15,10,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
 .topbar-logo{display:flex;align-items:center;gap:.5rem;text-decoration:none;color:var(--text);font-weight:700;font-size:1rem;}
 .topbar-logo img{height:26px;object-fit:contain;}
 .topbar-right{display:flex;gap:.625rem;align-items:center;}
 .btn-join{background:var(--green);color:#000;font-weight:800;padding:.45rem 1.1rem;border-radius:7px;text-decoration:none;font-size:.82rem;transition:opacity .2s;}
 .btn-join:hover{opacity:.85;}
 .btn-ghost-sm{background:transparent;color:var(--text2);font-weight:700;padding:.45rem 1rem;border-radius:7px;text-decoration:none;font-size:.82rem;border:1px solid var(--border2);transition:color .2s,border-color .2s;}
 .btn-ghost-sm:hover{color:var(--green);border-color:var(--green);}

 /* Page layout */
 .page{position:relative;z-index:1;max-width:720px;margin:0 auto;padding:2rem 1rem 4rem;display:grid;grid-template-columns:1fr 260px;gap:1.25rem;align-items:start;}
 @media(max-width:680px){.page{grid-template-columns:1fr;}.page-sidebar{order:3;}}

 /* Profile card */
 .profile-banner{height:140px;border-radius:18px 18px 0 0;background:linear-gradient(135deg,#061404 0%,#0a1c07 40%,#050e04 75%,#040b03 100%);position:relative;overflow:hidden;}
 .profile-banner::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 80%,rgba(94,194,19,.32) 0%,transparent 50%),radial-gradient(ellipse at 80% 20%,rgba(94,194,19,.14) 0%,transparent 45%);}
 .banner-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(94,194,19,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(94,194,19,.08) 1px,transparent 1px);background-size:22px 22px;}
 .banner-bottom-glow{position:absolute;bottom:0;left:0;right:0;height:60px;background:linear-gradient(to top,rgba(94,194,19,.12),transparent);}
 .banner-brand{position:absolute;top:14px;right:18px;display:flex;align-items:center;gap:.4rem;}
 .banner-brand-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);}
 .banner-brand-text{font-size:.65rem;font-weight:900;letter-spacing:.18em;color:rgba(94,194,19,.7);text-transform:uppercase;}
 .profile-card{background:var(--surface);border:1px solid var(--border);border-radius:0 0 18px 18px;border-top:none;padding:0 1.25rem 1.25rem;}
 .avatar-wrap{position:relative;margin-top:-44px;margin-bottom:.625rem;}
 .avatar{width:82px;height:82px;border-radius:50%;border:3px solid #5ec213;background:linear-gradient(135deg,#1c3d10,#0d1f0a);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:900;color:var(--green);overflow:hidden;box-shadow:0 0 0 2px var(--surface),0 0 22px rgba(94,194,19,.35);}
 .avatar img{width:100%;height:100%;object-fit:cover;}
 .profile-name{font-size:1.45rem;font-weight:900;letter-spacing:-.7px;margin-bottom:.3rem;color:#fff;}
 .profile-role{display:inline-flex;align-items:center;gap:.4rem;padding:.25rem .7rem;border-radius:20px;border:1.5px solid;font-size:.72rem;font-weight:900;letter-spacing:.05em;margin-bottom:.4rem;box-shadow:0 0 12px currentColor;}
 .profile-bio{font-size:.82rem;color:var(--text2);margin:.4rem 0 .65rem;line-height:1.5;}
 .profile-since{font-size:.75rem;color:var(--text3);margin-bottom:1rem;}
 .ref-hint{display:inline-flex;align-items:center;gap:.45rem;font-size:.72rem;color:var(--text3);background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.18);border-radius:8px;padding:.3rem .7rem;margin-bottom:.875rem;}
 .ref-hint i{color:var(--green);font-size:.65rem;}
 .ref-code{font-weight:900;color:var(--green);letter-spacing:.06em;}
 .stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(70px,1fr));gap:.5rem;margin-bottom:.875rem;}
 .pstat{background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.16);border-radius:12px;padding:.75rem .5rem;text-align:center;transition:border-color .2s;}
 .pstat:hover{border-color:rgba(94,194,19,.3);}
 .pstat-val{font-size:1.1rem;font-weight:900;line-height:1;margin-bottom:.2rem;}
 .pstat-val.green{color:var(--green);text-shadow:0 0 14px rgba(94,194,19,.4);}
 .pstat-val.usdc{color:#f59e0b;text-shadow:0 0 14px rgba(245,158,11,.35);}
 .pstat-label{font-size:.58rem;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;font-weight:700;}
 .xp-section{margin-bottom:.875rem;}
 .xp-bar-wrap{height:6px;background:rgba(255,255,255,.06);border-radius:3px;overflow:hidden;margin:.4rem 0;border:1px solid rgba(94,194,19,.1);}
 .xp-bar-fill{height:100%;background:linear-gradient(90deg,#2f7008,var(--green),#7dde2e);border-radius:3px;transition:width .9s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px rgba(94,194,19,.5);}
 .xp-meta{display:flex;justify-content:space-between;font-size:.68rem;color:var(--text3);}
 .pathway-pill{display:inline-flex;align-items:center;gap:.45rem;padding:.3rem .8rem;border-radius:20px;font-size:.74rem;font-weight:800;margin-bottom:.875rem;letter-spacing:.03em;}
 .sep{height:1px;background:linear-gradient(90deg,rgba(94,194,19,.25),rgba(94,194,19,.06),transparent);margin:.875rem 0;}
 .action-bar{display:flex;gap:.5rem;flex-wrap:wrap;}
 .btn-share-x{display:inline-flex;align-items:center;gap:.4rem;background:#000;color:#fff;border:1px solid #333;padding:.55rem 1rem;border-radius:8px;font-family:'Outfit',sans-serif;font-size:.8rem;font-weight:700;text-decoration:none;cursor:pointer;transition:background .2s,border-color .2s;}
 .btn-share-x:hover{background:#111;border-color:#555;}
 .btn-copy{display:inline-flex;align-items:center;gap:.4rem;background:rgba(94,194,19,.12);color:var(--green);border:1.5px solid rgba(94,194,19,.3);padding:.55rem 1rem;border-radius:8px;font-family:'Outfit',sans-serif;font-size:.8rem;font-weight:800;cursor:pointer;transition:background .2s,box-shadow .2s;}
 .btn-copy:hover{background:rgba(94,194,19,.2);box-shadow:0 0 14px rgba(94,194,19,.2);}
 .btn-card-view{display:inline-flex;align-items:center;gap:.4rem;background:transparent;color:var(--text2);border:1px solid var(--border2);padding:.55rem 1rem;border-radius:8px;font-family:'Outfit',sans-serif;font-size:.8rem;font-weight:700;cursor:pointer;transition:color .2s,border-color .2s;}
 .btn-card-view:hover{color:var(--text);border-color:rgba(94,194,19,.4);}

 /* Activity feed */
 .page-sidebar{display:flex;flex-direction:column;gap:.875rem;}
 .feed-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
 .feed-panel-head{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border-bottom:1px solid var(--border);background:rgba(255,255,255,.02);}
 .feed-panel-head h4{font-size:.82rem;font-weight:800;color:var(--text);}
 .feed-item{display:flex;gap:.625rem;padding:.75rem 1rem;border-bottom:1px solid rgba(94,194,19,.06);}
 .feed-item:last-child{border-bottom:none;}
 .feed-av{width:28px;height:28px;border-radius:50%;background:#1a2a1a;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;color:var(--green);flex-shrink:0;overflow:hidden;}
 .feed-av img{width:100%;height:100%;object-fit:cover;}
 .feed-body{flex:1;min-width:0;}
 .feed-text{font-size:.78rem;color:var(--text);line-height:1.4;}
 .feed-time{font-size:.65rem;color:var(--text3);margin-top:.2rem;}
 .feed-like{display:inline-flex;align-items:center;gap:.3rem;background:none;border:none;cursor:pointer;color:var(--text3);font-size:.68rem;font-family:'Outfit',sans-serif;padding:.15rem 0;transition:color .15s;margin-top:.25rem;}
 .feed-like.liked{color:#ef4444;}
 .feed-like:hover{color:#ef4444;}
 .feed-empty{padding:1.5rem 1rem;text-align:center;font-size:.8rem;color:var(--text3);}

 /* Private wall */
 .private-wall{text-align:center;padding:3rem 1rem;}
 .private-wall i{font-size:2.5rem;color:var(--text3);display:block;margin-bottom:1rem;}

 /* Card Modal */
 .card-modal-overlay{display:none;position:fixed;inset:0;z-index:900;background:rgba(0,0,0,.82);align-items:center;justify-content:center;padding:1rem;}
 .card-modal-overlay.open{display:flex;}
 .card-modal{background:#111811;border:1px solid rgba(94,194,19,.2);border-radius:18px;padding:1.5rem;max-width:540px;width:100%;display:flex;flex-direction:column;gap:1rem;}
 .card-modal-head{display:flex;align-items:center;justify-content:space-between;}
 .card-modal-title{font-weight:800;font-size:1rem;}
 .card-modal-close{background:transparent;border:none;color:#8aaf85;font-size:1.1rem;cursor:pointer;padding:.2rem .4rem;}
 .card-modal-close:hover{color:#e8f5e2;}
 .card-modal-img-wrap{border-radius:12px;overflow:hidden;border:1px solid rgba(94,194,19,.15);min-height:160px;display:flex;align-items:center;justify-content:center;background:#0a0f0a;}
 .card-modal-img-wrap img{width:100%;display:block;border-radius:12px;}
 .card-modal-actions{display:flex;gap:.75rem;flex-wrap:wrap;}
 .btn-dl{flex:1;min-width:130px;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;background:#5ec213;color:#000;border:none;border-radius:8px;padding:.65rem 1rem;font-family:'Outfit',sans-serif;font-size:.82rem;font-weight:800;cursor:pointer;text-decoration:none;transition:opacity .2s;}
 .btn-dl:hover{opacity:.85;}
 .btn-share-card{flex:1;min-width:130px;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;background:#000;color:#fff;border:1px solid #333;border-radius:8px;padding:.65rem 1rem;font-family:'Outfit',sans-serif;font-size:.82rem;font-weight:700;cursor:pointer;transition:background .2s;}
 .btn-share-card:hover{background:#111;}
 .card-modal-hint{font-size:.72rem;color:#4a6a46;text-align:center;}

 /* Off-screen card source */
 #cardSource{position:absolute;left:-9999px;top:-9999px;width:760px;height:420px;font-family:'Outfit',sans-serif;overflow:hidden;}

 /* Toast */
 .toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(16px);background:var(--green);color:#000;padding:.5rem 1.25rem;border-radius:30px;font-size:.82rem;font-weight:800;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:999;}
 .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

 @media(max-width:480px){.stats-row{grid-template-columns:1fr 1fr;}.action-bar{flex-direction:column;}.action-bar>*{justify-content:center;}}
 </style>
</head>
<body>
<div class="grid-bg"></div>
<div class="glow-orb glow-1"></div>
<div class="glow-orb glow-2"></div>

<%
 var refCode = referralCode || '';
 var refSuffix = refCode ? '?ref=' + refCode : '';
 var joinHref = refCode ? '/auth?ref=' + refCode : '/auth';

 var pathwayMeta = {
 web3_jobs: { fa:'fa-briefcase', name:'Web3 Jobs', color:'rgba(251,191,36,.1)', border:'rgba(251,191,36,.3)', text:'#fbbf24' },
 ai: { fa:'fa-microchip', name:'AI & Web3', color:'rgba(168,85,247,.1)', border:'rgba(168,85,247,.3)', text:'#c084fc' },
 trading: { fa:'fa-chart-line', name:'Trading', color:'rgba(16,185,129,.1)', border:'rgba(16,185,129,.3)', text:'#10b981' },
 nft: { fa:'fa-image', name:'NFTs', color:'rgba(236,72,153,.1)', border:'rgba(236,72,153,.3)', text:'#f472b6' }
 };
 var pm = profileUser.pathway ? (pathwayMeta[profileUser.pathway] || null) : null;
 var since = new Date(profileUser.createdAt).toLocaleDateString('en-US', { month:'long', year:'numeric' });

 var MILESTONES = [
 { key:'citizen', label:'Citizen', min:0, next:10000 },
 { key:'contributor', label:'Contributor', min:10000, next:25000 },
 { key:'ambassador', label:'Ambassador', min:25000, next:100000 },
 { key:'legend', label:'Legend', min:100000, next:250000 },
 { key:'major', label:'Major', min:250000, next:null }
 ];
 var xp = profileUser.xp || 0;
 var curMile = MILESTONES.find(function(m){ return m.key === role.key; }) || MILESTONES[0];
 var curIdx = MILESTONES.indexOf(curMile);
 var nxtMile = MILESTONES[curIdx + 1] || null;
 var pct = nxtMile ? Math.min(100, Math.round(((xp - curMile.min) / (nxtMile.min - curMile.min)) * 100)) : 100;
 var shareUrl = 'https://' + host + '/u/' + profileUser.username + refSuffix;
 var tweetText = encodeURIComponent('Check out my ONBOARD3 profile \n@' + profileUser.username + ' · ' + role.name + ' · ' + xp.toLocaleString() + ' XP\n\nJoin me on @onboard3__ ');

 function timeAgo(d) {
 var diff = (Date.now() - new Date(d).getTime()) / 1000;
 if (diff < 60) return 'just now';
 if (diff < 3600) return Math.floor(diff/60) + 'm ago';
 if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
 return Math.floor(diff/86400) + 'd ago';
 }
%>

<nav class="topbar">
 <a href="/" class="topbar-logo">
 <img src="/img/logo.png" alt="ONBOARD3"> ONBOARD3
 </a>
 <div class="topbar-right">
 <a href="/" class="btn-ghost-sm">Home</a>
 <% if (viewerLoggedIn) { %>
 <a href="/dashboard" class="btn-ghost-sm"><i class="fas fa-th-large" style="font-size:.7rem"></i> Dashboard</a>
 <% } else { %>
 <a href="<%= joinHref %>" class="btn-join">Join Free</a>
 <% } %>
 </div>
</nav>

<% if (isPrivate && !viewerLoggedIn) { %>
<!-- ── Private Profile Wall ── -->
<div class="page" style="display:block;max-width:460px">
 <div class="profile-banner" style="border-radius:18px">
 <div class="banner-grid"></div>
 </div>
 <div class="profile-card" style="border-radius:0 0 18px 18px;text-align:center;padding:2.5rem 1.5rem">
 <i class="fas fa-lock" style="font-size:2rem;color:var(--text3);display:block;margin-bottom:1rem"></i>
 <p style="font-size:1.1rem;font-weight:800;margin-bottom:.5rem">@<%= profileUser.username %></p>
 <p style="font-size:.85rem;color:var(--text2);margin-bottom:1.5rem">This profile is private. Log in to view.</p>
 <a href="<%= joinHref %>" class="btn-join" style="display:inline-block;text-align:center;padding:.65rem 1.5rem;font-size:.9rem">Join / Log In</a>
 </div>
</div>
<% } else { %>

<div class="page">
 <!-- ── Left: Profile Card ── -->
 <div class="page-main-col">
 <div class="profile-banner">
 <div class="banner-grid"></div>
 <div class="banner-bottom-glow"></div>
 <div class="banner-brand">
 <div class="banner-brand-dot"></div>
 <span class="banner-brand-text">ONBOARD3</span>
 </div>
 </div>
 <div class="profile-card">
 <div class="avatar-wrap">
 <div class="avatar">
 <% if (profileUser.profilePicture) { %>
 <img src="<%= profileUser.profilePicture %>" alt="<%= profileUser.username %>">
 <% } else { %>
 <%= profileUser.username.charAt(0).toUpperCase() %>
 <% } %>
 </div>
 </div>

 <div class="profile-name">@<%= profileUser.username %></div>
 <div class="profile-role" style="color:<%= role.color %>;border-color:<%= role.color %>;background:<%= role.color %>18;box-shadow:0 0 12px <%= role.color %>44;">
 <i class="fas fa-shield-halved" style="font-size:.6rem"></i> <%= role.name %>
 </div>
 <% if (pm) { %>
 <div class="pathway-pill" style="background:<%= pm.color %>;border:1px solid <%= pm.border %>;color:<%= pm.text %>;display:inline-flex">
 <i class="fas <%= pm.fa %>"></i> <%= pm.name %> Pathway
 </div>
 <% } %>
 <% if (profileUser.bio) { %>
 <div class="profile-bio"><%= profileUser.bio %></div>
 <% } %>
 <div class="profile-since"><i class="fas fa-calendar-alt" style="margin-right:.3rem;font-size:.6rem"></i>Building since <%= since %></div>

 <% if (refCode) { %>
 <div class="ref-hint">
 <i class="fas fa-gift"></i>
 Use code <span class="ref-code"><%= refCode %></span> when you register — they earn bonus XP!
 </div>
 <% } %>

 <div class="stats-row">
 <div class="pstat">
 <div class="pstat-val green"><%= xp.toLocaleString() %></div>
 <div class="pstat-label">XP</div>
 </div>
 <% if (profileUser.privacy?.showEarnings !== false) { %>
 <div class="pstat">
 <div class="pstat-val usdc">$<%= totalUsdc %></div>
 <div class="pstat-label">USDC</div>
 </div>
 <% } %>
 <% if (profileUser.privacy?.showQuests !== false) { %>
 <div class="pstat">
 <div class="pstat-val"><%= questsDone %></div>
 <div class="pstat-label">Quests</div>
 </div>
 <% } %>
 <% if (globalRank) { %>
 <div class="pstat">
 <div class="pstat-val" style="color:#f59e0b">#<%= globalRank.toLocaleString() %></div>
 <div class="pstat-label">Global Rank</div>
 </div>
 <% } %>
 </div>

 <div class="xp-section">
 <div class="xp-meta">
 <span style="color:var(--text2);font-weight:700"><%= curMile.label %></span>
 <span style="color:var(--green);font-weight:800"><%= pct %>%</span>
 <% if (nxtMile) { %><span style="color:var(--text2);font-weight:700"><%= nxtMile.label %></span><% } %>
 </div>
 <div class="xp-bar-wrap"><div class="xp-bar-fill" id="xpBar" style="width:0%"></div></div>
 <% if (nxtMile) { %>
 <div style="font-size:.68rem;color:var(--text3)">
 <i class="fas fa-bolt" style="color:var(--green);font-size:.58rem"></i>
 <%= (nxtMile.min - xp).toLocaleString() %> XP to reach <%= nxtMile.label %>
 </div>
 <% } %>
 </div>

 <div class="sep"></div>

 <div class="action-bar">
 <a class="btn-share-x"
 href="https://twitter.com/intent/tweet?text=<%= tweetText %>&url=<%= encodeURIComponent(shareUrl) %>"
 target="_blank" rel="noopener">
 <svg width="12" height="12" viewBox="0 0 1200 1227" fill="currentColor"><path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"/></svg>
 Share on X
 </a>
 <button class="btn-copy" onclick="copyProfileLink()">
 <i class="fas fa-link"></i> Copy Link
 </button>
 <button class="btn-card-view" onclick="openCardModal()">
 <i class="fas fa-id-card"></i> Get Card
 </button>
 </div>
 </div>
 </div>

 <!-- ── Right Sidebar: Activity Feed ── -->
 <div class="page-sidebar">
 <% if (!viewerLoggedIn) { %>
 <div class="feed-panel">
 <div class="feed-panel-head"><h4><i class="fas fa-lock" style="color:var(--text3);margin-right:.3rem"></i>Activity Feed</h4></div>
 <div class="feed-empty">
 <i class="fas fa-lock" style="display:block;font-size:1.5rem;margin-bottom:.5rem;opacity:.3"></i>
 <a href="/auth" style="color:var(--green);font-weight:700;text-decoration:none">Log in</a> to see <%= profileUser.username %>'s activity
 </div>
 </div>
 <% } else if (feedEvents && feedEvents.length > 0) { %>
 <div class="feed-panel">
 <div class="feed-panel-head">
 <h4><i class="fas fa-bolt" style="color:var(--green);margin-right:.35rem"></i>Activity</h4>
 <span style="font-size:.68rem;color:var(--text3)"><%= feedEvents.length %> events</span>
 </div>
 <% feedEvents.forEach(function(ev) {
 var evText = '';
 var evIcon = 'fa-bolt';
 var evColor = '#5ec213';
 if (ev.type === 'role_upgrade') {
 var roleLabels = { citizen:'Citizen', contributor:'Contributor', ambassador:'Ambassador', legend:'Legend', major:'Major' };
 evText = 'Leveled up to ' + (roleLabels[ev.data.newRole] || ev.data.newRole);
 evIcon = 'fa-shield-halved';
 evColor = '#a855f7';
 } else if (ev.type === 'usdc_earned') {
 evText = 'Earned $' + (ev.data.amount || 0).toFixed(2) + ' USDC' + (ev.data.questTitle ? ' — ' + ev.data.questTitle : '');
 evIcon = 'fa-coins';
 evColor = '#f59e0b';
 } else if (ev.type === 'quest_completed') {
 evText = 'Completed quest' + (ev.data.questTitle ? ': ' + ev.data.questTitle : '');
 evIcon = 'fa-trophy';
 evColor = '#5ec213';
 }
 var likeCount = (ev.likes && ev.likes.count) || 0;
 var liked = ev.viewerLiked || false;
 %>
 <div class="feed-item">
 <div class="feed-av" style="background:<%= evColor %>18;color:<%= evColor %>">
 <i class="fas <%= evIcon %>" style="font-size:.65rem"></i>
 </div>
 <div class="feed-body">
 <div class="feed-text"><%= evText %></div>
 <div class="feed-time"><%= timeAgo(ev.createdAt) %></div>
 <button class="feed-like <%= liked ? 'liked' : '' %>"
 onclick="toggleFeedLike(this,'<%= ev._id %>',<%= likeCount %>)"
 data-liked="<%= liked ? '1' : '0' %>"
 data-count="<%= likeCount %>">
 <i class="fas fa-heart"></i>
 <span><%= likeCount > 0 ? likeCount : '' %></span>
 </button>
 </div>
 </div>
 <% }) %>
 </div>
 <% } else { %>
 <div class="feed-panel">
 <div class="feed-panel-head"><h4><i class="fas fa-bolt" style="color:var(--green);margin-right:.35rem"></i>Activity</h4></div>
 <div class="feed-empty">No activity yet</div>
 </div>
 <% } %>
 </div>
</div>
<% } %>

<!-- ── Card Modal ── -->
<div class="card-modal-overlay" id="cardModalOverlay">
 <div class="card-modal">
 <div class="card-modal-head">
 <div class="card-modal-title"><i class="fas fa-id-card" style="color:#5ec213;margin-right:.4rem"></i>Member Card</div>
 <button class="card-modal-close" onclick="closeCardModal()"><i class="fas fa-times"></i></button>
 </div>
 <div class="card-modal-img-wrap" id="cardImgWrap">
 <div style="color:#5ec213;font-size:1.5rem"><i class="fas fa-spinner fa-spin"></i></div>
 </div>
 <div class="card-modal-actions" id="cardModalActions" style="display:none">
 <a class="btn-dl" id="btnDownload" download="onboard3-card.png"><i class="fas fa-download"></i> Save Image</a>
 <button class="btn-share-card" onclick="shareCard()">
 <svg width="12" height="12" viewBox="0 0 1200 1227" fill="currentColor"><path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"/></svg>
 Share on X
 </button>
 </div>
 <div class="card-modal-hint" id="cardModalHint" style="display:none">Long-press or right-click to save on mobile</div>
 </div>
</div>

<!-- ── Off-screen card for html2canvas ── -->
<%
 var cardAvatar = profileUser.profilePicture || '';
 var cardInitial = profileUser.username.charAt(0).toUpperCase();
 var cardXp = (xp||0).toLocaleString();
 var cardUsdc = '$' + totalUsdc;
 var cardRole = role.name;
 var cardRoleCol = role.color;
 var cardUser = '@' + profileUser.username;
 var cardSince = since;
 var cardQuests = String(questsDone);
 var cardPathway = pm ? pm.name : '';
 var cardPathwayColor = pm ? pm.text : '';
 var cardPathwayBg = pm ? pm.color : '';
 var cardPathwayBorder= pm ? pm.border : '';
 var cardPathwayIcon = pm ? pm.fa : '';
 var cardRank = globalRank ? '#' + globalRank.toLocaleString() : '';
%>
<div id="cardSource">
 <div style="width:760px;height:420px;background:linear-gradient(145deg,#020c02 0%,#050f04 35%,#030a08 65%,#020905 100%);position:relative;overflow:hidden;font-family:'Outfit',sans-serif;">

 <!-- Dramatic glow orbs -->
 <div style="position:absolute;top:-80px;left:-60px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(94,194,19,.28) 0%,rgba(94,194,19,.10) 35%,transparent 65%);"></div>
 <div style="position:absolute;bottom:-100px;right:-60px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(94,194,19,.18) 0%,rgba(50,200,100,.06) 40%,transparent 70%);"></div>
 <div style="position:absolute;top:50%;right:200px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(94,194,19,.06) 0%,transparent 70%);transform:translateY(-50%);"></div>

 <!-- Grid overlay -->
 <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(94,194,19,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(94,194,19,.055) 1px,transparent 1px);background-size:22px 22px;"></div>

 <!-- Left accent bar -->
 <div style="position:absolute;left:0;top:0;bottom:0;width:6px;background:linear-gradient(180deg,#5ec213 0%,#3a8a0a 60%,rgba(94,194,19,.15) 100%);"></div>

 <!-- Top edge glow -->
 <div style="position:absolute;top:0;left:6px;right:0;height:1px;background:linear-gradient(90deg,#5ec213,rgba(94,194,19,.35),transparent 60%);"></div>

 <!-- ONBOARD3 brand — top right -->
 <div style="position:absolute;top:18px;right:26px;display:flex;align-items:center;gap:7px;">
 <div style="width:4px;height:4px;border-radius:50%;background:#5ec213;box-shadow:0 0 6px #5ec213;"></div>
 <span style="font-size:11px;font-weight:900;letter-spacing:.22em;color:rgba(94,194,19,.7);text-transform:uppercase;">ONBOARD3</span>
 </div>

 <!-- MEMBER CARD label -->
 <div style="position:absolute;top:38px;right:26px;font-size:8px;font-weight:700;letter-spacing:.18em;color:rgba(94,194,19,.35);text-transform:uppercase;">MEMBER CARD</div>

 <!-- Avatar + Identity block -->
 <div style="position:absolute;top:38px;left:26px;display:flex;align-items:flex-start;gap:22px;">
 <!-- Avatar -->
 <div style="position:relative;flex-shrink:0;">
 <div style="width:92px;height:92px;border-radius:50%;background:linear-gradient(135deg,#1c3d10,#0d1f0a);border:3px solid #5ec213;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:900;color:#5ec213;overflow:hidden;box-shadow:0 0 0 1px rgba(94,194,19,.15),0 0 28px rgba(94,194,19,.4),0 0 60px rgba(94,194,19,.15);">
 <% if (cardAvatar) { %><img src="<%= cardAvatar %>" style="width:100%;height:100%;object-fit:cover;" crossorigin="anonymous"><% } else { %><%= cardInitial %><% } %>
 </div>
 <div style="position:absolute;bottom:3px;right:3px;width:15px;height:15px;border-radius:50%;background:#5ec213;border:2px solid #020c02;box-shadow:0 0 8px rgba(94,194,19,.8);"></div>
 </div>

 <!-- Name + Role + Pathway -->
 <div style="padding-top:2px;">
 <div style="font-size:32px;font-weight:900;color:#ffffff;letter-spacing:-1.5px;line-height:1;margin-bottom:10px;text-shadow:0 0 40px rgba(94,194,19,.25);">
 <%= cardUser %>
 </div>

 <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
 <!-- Role badge -->
 <div style="display:inline-flex;align-items:center;gap:5px;background:<%= cardRoleCol %>22;border:1.5px solid <%= cardRoleCol %>;border-radius:30px;padding:5px 13px;font-size:11px;font-weight:900;letter-spacing:.07em;color:<%= cardRoleCol %>;box-shadow:0 0 12px <%= cardRoleCol %>33;">
 <span style="font-size:9px;">&#9679;</span> <%= cardRole.toUpperCase() %>
 </div>
 <% if (cardPathway) { %>
 <!-- Pathway badge -->
 <div style="display:inline-flex;align-items:center;gap:5px;background:<%= cardPathwayBg %>;border:1.5px solid <%= cardPathwayBorder %>;border-radius:30px;padding:5px 13px;font-size:11px;font-weight:800;letter-spacing:.05em;color:<%= cardPathwayColor %>;">
 <span style="font-size:9px;">&#9670;</span> <%= cardPathway.toUpperCase() %>
 </div>
 <% } %>
 </div>

 <div style="margin-top:8px;font-size:9px;color:rgba(138,175,133,.45);letter-spacing:.05em;">
 BUILDING SINCE <%= cardSince.toUpperCase() %>
 </div>
 </div>
 </div>

 <!-- Divider -->
 <div style="position:absolute;top:162px;left:26px;right:26px;height:1px;background:linear-gradient(90deg,rgba(94,194,19,.5),rgba(94,194,19,.15),transparent);"></div>

 <!-- XP Progress bar -->
 <div style="position:absolute;top:174px;left:26px;right:26px;">
 <div style="display:flex;justify-content:space-between;margin-bottom:5px;">
 <span style="font-size:8px;font-weight:700;color:rgba(94,194,19,.55);letter-spacing:.08em;"><%= curMile.label.toUpperCase() %></span>
 <span style="font-size:8px;font-weight:900;color:#5ec213;"><%= pct %>% TO NEXT</span>
 <% if (nxtMile) { %><span style="font-size:8px;font-weight:700;color:rgba(94,194,19,.55);letter-spacing:.08em;"><%= nxtMile.label.toUpperCase() %></span><% } %>
 </div>
 <div style="height:7px;background:rgba(255,255,255,.05);border-radius:4px;overflow:hidden;border:1px solid rgba(94,194,19,.12);">
 <div style="width:<%= pct %>%;height:100%;background:linear-gradient(90deg,#2f7008,#5ec213,#7dde2e);border-radius:4px;box-shadow:0 0 10px rgba(94,194,19,.6);"></div>
 </div>
 </div>

 <!-- Stats tiles -->
 <div style="position:absolute;bottom:28px;left:26px;right:26px;display:flex;gap:10px;">
 <!-- XP -->
 <div style="flex:1.2;background:rgba(94,194,19,.08);border:1px solid rgba(94,194,19,.22);border-radius:14px;padding:15px 10px 12px;text-align:center;box-shadow:inset 0 0 20px rgba(94,194,19,.04);">
 <div style="font-size:22px;font-weight:900;color:#5ec213;line-height:1;letter-spacing:-1px;text-shadow:0 0 20px rgba(94,194,19,.55);"><%= cardXp %></div>
 <div style="font-size:7px;color:rgba(94,194,19,.5);text-transform:uppercase;letter-spacing:.14em;margin-top:5px;font-weight:700;">XP EARNED</div>
 </div>
 <!-- USDC -->
 <div style="flex:1.2;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);border-radius:14px;padding:15px 10px 12px;text-align:center;box-shadow:inset 0 0 20px rgba(245,158,11,.04);">
 <div style="font-size:22px;font-weight:900;color:#f59e0b;line-height:1;letter-spacing:-1px;text-shadow:0 0 20px rgba(245,158,11,.5);"><%= cardUsdc %></div>
 <div style="font-size:7px;color:rgba(245,158,11,.5);text-transform:uppercase;letter-spacing:.14em;margin-top:5px;font-weight:700;">USDC EARNED</div>
 </div>
 <!-- Quests -->
 <div style="flex:1;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:15px 10px 12px;text-align:center;">
 <div style="font-size:22px;font-weight:900;color:#e8f5e2;line-height:1;letter-spacing:-1px;"><%= cardQuests %></div>
 <div style="font-size:7px;color:rgba(138,175,133,.4);text-transform:uppercase;letter-spacing:.14em;margin-top:5px;font-weight:700;">QUESTS</div>
 </div>
 <!-- Rank (if available) -->
 <% if (cardRank) { %>
 <div style="flex:1;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.22);border-radius:14px;padding:15px 10px 12px;text-align:center;">
 <div style="font-size:22px;font-weight:900;color:#f59e0b;line-height:1;letter-spacing:-1px;text-shadow:0 0 16px rgba(245,158,11,.5);"><%= cardRank %></div>
 <div style="font-size:7px;color:rgba(245,158,11,.45);text-transform:uppercase;letter-spacing:.14em;margin-top:5px;font-weight:700;">GLOBAL RANK</div>
 </div>
 <% } %>
 </div>

 <!-- Bottom glow bar -->
 <div style="position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#5ec213,rgba(94,194,19,.5) 50%,transparent);"></div>

 <!-- Corner geometric accent (top-right) -->
 <div style="position:absolute;top:0;right:0;width:80px;height:80px;overflow:hidden;">
 <div style="position:absolute;top:-40px;right:-40px;width:80px;height:80px;border-radius:50%;border:1px solid rgba(94,194,19,.18);"></div>
 </div>
 </div>
</div>

<div class="toast" id="toast"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous"></script>
<script>
 var SHARE_URL = '<%= shareUrl %>';
 var TWEET_TEXT = '<%= tweetText %>';
 var USERNAME = '<%= profileUser.username %>';
 var cardDataUrl = null;

 document.getElementById('xpBar') && (document.getElementById('xpBar').style.width = '<%= pct %>%');

 function showToast(msg) {
 var t = document.getElementById('toast');
 t.textContent = msg;
 t.classList.add('show');
 setTimeout(function(){ t.classList.remove('show'); }, 2200);
 }

 function copyProfileLink() {
 navigator.clipboard.writeText(SHARE_URL).then(function() {
 showToast('Profile link copied! Share it to earn referral XP.');
 }).catch(function(){ showToast('Copy: ' + SHARE_URL); });
 }

 /* ── Card Modal ── */
 function openCardModal() {
 document.getElementById('cardModalOverlay').classList.add('open');
 if (!cardDataUrl) generateCard();
 }
 function closeCardModal() { document.getElementById('cardModalOverlay').classList.remove('open'); }
 document.getElementById('cardModalOverlay').addEventListener('click', function(e){ if(e.target===this) closeCardModal(); });

 function generateCard() {
 var src = document.getElementById('cardSource');
 var wrap = document.getElementById('cardImgWrap');
 wrap.innerHTML = '<div style="color:#5ec213;font-size:1.5rem"><i class="fas fa-spinner fa-spin"></i></div>';
 document.getElementById('cardModalActions').style.display = 'none';
 document.getElementById('cardModalHint').style.display = 'none';
 html2canvas(src, { scale:2, useCORS:true, allowTaint:true, backgroundColor:null, logging:false })
 .then(function(canvas) {
 cardDataUrl = canvas.toDataURL('image/png');
 var img = document.createElement('img');
 img.src = cardDataUrl;
 img.style.width = '100%';
 img.style.borderRadius = '10px';
 wrap.innerHTML = '';
 wrap.appendChild(img);
 document.getElementById('btnDownload').href = cardDataUrl;
 document.getElementById('cardModalActions').style.display = 'flex';
 document.getElementById('cardModalHint').style.display = 'block';
 })
 .catch(function() {
 wrap.innerHTML = '<div style="color:#8aaf85;font-size:.82rem;padding:1rem;text-align:center">Could not generate card. Try again.</div>';
 });
 }

 function shareCard() {
 var tweetUrl = 'https://twitter.com/intent/tweet?text=' + TWEET_TEXT + '&url=' + encodeURIComponent(SHARE_URL);
 if (navigator.share && cardDataUrl) {
 fetch(cardDataUrl).then(function(r){ return r.blob(); }).then(function(blob) {
 var file = new File([blob], 'onboard3-card.png', { type:'image/png' });
 if (navigator.canShare && navigator.canShare({ files:[file] })) {
 return navigator.share({ title: USERNAME + ' on ONBOARD3', text: 'Check out my ONBOARD3 profile! ', url: SHARE_URL, files:[file] });
 } else { window.open(tweetUrl, '_blank'); }
 }).catch(function(){ window.open(tweetUrl, '_blank'); });
 } else { window.open(tweetUrl, '_blank'); }
 }

 /* ── Feed Likes ── */
 function toggleFeedLike(btn, evId, currentCount) {
 var liked = btn.getAttribute('data-liked') === '1';
 var newCount = liked ? Math.max(0, currentCount - 1) : currentCount + 1;
 btn.setAttribute('data-liked', liked ? '0' : '1');
 btn.setAttribute('data-count', newCount);
 btn.classList.toggle('liked', !liked);
 var span = btn.querySelector('span');
 if (span) span.textContent = newCount > 0 ? newCount : '';
 fetch('/api/feed/' + evId + '/like', { method:'POST', headers:{'Content-Type':'application/json'} })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) {
 // revert
 btn.setAttribute('data-liked', liked ? '1' : '0');
 btn.classList.toggle('liked', liked);
 if (span) span.textContent = currentCount > 0 ? currentCount : '';
 }
 }).catch(function(){});
 }
</script>

<%- include('partials/whatsapp-float') %>
</body>
</html>
