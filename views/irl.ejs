 <!-- Event Detail Modal -->
 <div id="eventModal" class="modal">
 <div class="modal-content">
 <button class="modal-close" id="closeModal"><i class="fas fa-times"></i></button>
 <div class="modal-banner" id="modalBanner">
 <div class="modal-banner-placeholder"></div>
 </div>
 <div class="modal-body">
 <h2 class="modal-title" id="modalTitle"></h2>
 <div class="modal-meta-grid" id="modalMeta"></div>
 <div class="modal-divider"></div>
 <div class="modal-section" id="modalDesc"></div>
 <div id="modalActions" style="margin-top:1.5rem;"></div>
 </div>
 </div>
 </div>

 <script src="./js/head.js"></script>
 <script>
 // Navbar scroll
 window.addEventListener('scroll', () => {
 document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
 });

 // Scroll reveal
 const revealObs = new IntersectionObserver((entries) => {
 entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); } });
 }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
 document.querySelectorAll('.reveal-up').forEach(el => revealObs.observe(el));

 // Animated counter
 function animateCount(el, target) {
 if (target === 0) { el.textContent = '0'; return; }
 let cur = 0;
 const step = Math.ceil(target / 60);
 const t = setInterval(() => {
 cur = Math.min(cur + step, target);
 el.textContent = cur;
 if (cur >= target) clearInterval(t);
 }, 20);
 }

 // Modal
 const modal = document.getElementById('eventModal');
 document.getElementById('closeModal').addEventListener('click', () => { modal.classList.remove('active'); document.body.style.overflow = ''; });
 modal.addEventListener('click', (e) => { if (e.target === modal) { modal.classList.remove('active'); document.body.style.overflow = ''; } });

 function openEventModal(event) {
 const banner = document.getElementById('modalBanner');
 banner.innerHTML = event.bannerImage
 ? `<img src="${event.bannerImage}" alt="${event.title}">`
 : `<div class="modal-banner-placeholder"></div>`;

 document.getElementById('modalTitle').textContent = event.title;

 const loc = event.eventType === 'virtual' ? 'Online' : (event.venue || 'TBA');
 const dateStr = new Date(event.startDate).toLocaleDateString('en-US', { weekday:'short', month:'long', day:'numeric', year:'numeric' });

 document.getElementById('modalMeta').innerHTML = `
 <div class="modal-meta-item"><label><i class="fas fa-calendar"></i> Date</label><span>${dateStr}${event.startTime ? ' · ' + event.startTime : ''}</span></div>
 <div class="modal-meta-item"><label><i class="fas fa-map-pin"></i> Location</label><span>${loc}</span></div>
 <div class="modal-meta-item"><label><i class="fas fa-tag"></i> Type</label><span style="text-transform:capitalize;">${event.eventType || 'In-Person'}</span></div>
 <div class="modal-meta-item"><label><i class="fas fa-users"></i> Registered</label><span>${event.totalApproved || 0}${event.maxAttendees ? ' / ' + event.maxAttendees : ''}</span></div>
 `;

 document.getElementById('modalDesc').innerHTML = `<h3>About this Event</h3><p>${event.description}</p>`;
 document.getElementById('modalActions').innerHTML = `<a href="/events/${event._id}" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;"><i class="fas fa-arrow-right"></i> View Full Details & Register</a>`;

 modal.classList.add('active');
 document.body.style.overflow = 'hidden';
 }

 function formatDate(d) {
 return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
 }

 function renderUpcoming(events) {
 const grid = document.getElementById('upcomingGrid');
 if (!events || !events.length) {
 grid.innerHTML = `<div class="empty-state"><i class="fas fa-calendar-times"></i><p>No upcoming events right now. Check back soon!</p></div>`;
 return;
 }
 grid.innerHTML = events.map((ev, i) => {
 const loc = ev.eventType === 'virtual' ? 'Online' : (ev.venue || 'TBA');
 const typeLabel = ev.eventType === 'virtual' ? 'Virtual' : ev.eventType === 'hybrid' ? 'Hybrid' : 'IRL';
 const capPct = ev.maxAttendees ? Math.min(100, ((ev.totalApproved || 0) / ev.maxAttendees) * 100) : 0;
 const banner = ev.bannerImage
 ? `<img class="event-banner-img" src="${ev.bannerImage}" alt="${ev.title}">`
 : `<div class="event-banner-placeholder"></div>`;
 return `
 <div class="event-card reveal-up" style="--d:${i * 80}ms">
 <div class="event-banner" style="position:relative;">
 ${banner}
 <span class="event-type-badge">${typeLabel}</span>
 </div>
 <div class="event-body">
 <div class="event-title">${ev.title}</div>
 <div class="event-meta">
 <div class="event-meta-row"><i class="fas fa-calendar-alt"></i><span>${formatDate(ev.startDate)}${ev.startTime ? ' · ' + ev.startTime : ''}</span></div>
 <div class="event-meta-row"><i class="fas fa-map-pin"></i><span>${loc}</span></div>
 </div>
 <p class="event-desc">${ev.description.substring(0, 110)}${ev.description.length > 110 ? '...' : ''}</p>
 ${ev.maxAttendees ? `
 <div>
 <div style="font-size:.8125rem;color:var(--green);font-weight:700;margin-bottom:.3rem;">${ev.totalApproved || 0} / ${ev.maxAttendees} seats</div>
 <div class="capacity-bar"><div class="capacity-fill" style="width:${capPct}%"></div></div>
 </div>` : `<div style="font-size:.8125rem;color:var(--green);font-weight:700;">${ev.totalApproved || 0} registered</div>`}
 <div class="event-footer">
 <span></span>
 <button class="btn btn-outline btn-sm" onclick='openEventModal(${JSON.stringify(ev).replace(/'/g, "&#39;")})'>View Details</button>
 </div>
 </div>
 </div>`;
 }).join('');
 grid.querySelectorAll('.reveal-up').forEach(el => revealObs.observe(el));
 }

 function renderPast(events) {
 const grid = document.getElementById('pastGrid');
 if (!events || !events.length) {
 grid.innerHTML = `<div class="empty-state"><i class="fas fa-history"></i><p>No past events recorded yet.</p></div>`;
 return;
 }
 grid.innerHTML = events.map((ev, i) => {
 const attendees = ev.totalApproved || 0;
 const dateStr = formatDate(ev.startDate);
 const banner = ev.bannerImage
 ? `<img src="${ev.bannerImage}" alt="${ev.title}" style="width:100%;height:100%;object-fit:cover;">`
 : `<div class="past-banner-placeholder"></div>`;
 return `
 <div class="past-card reveal-up" style="--d:${i * 70}ms">
 <div class="past-banner">${banner}</div>
 <div class="past-body">
 <div class="past-name">${ev.title}</div>
 <div class="past-stats">
 <div class="past-stat"><i class="fas fa-calendar"></i><span>${dateStr}</span></div>
 <div class="past-stat"><i class="fas fa-users"></i><strong>${attendees}</strong><span>attended</span></div>
 </div>
 </div>
 </div>`;
 }).join('');
 grid.querySelectorAll('.reveal-up').forEach(el => revealObs.observe(el));

 // Update header stats
 const totalAttendees = events.reduce((sum, ev) => sum + (ev.totalApproved || 0), 0);
 animateCount(document.getElementById('totalAttendeesNum'), totalAttendees);
 }

 async function loadEvents() {
 try {
 const res = await fetch('/api/events');
 const data = await res.json();
 if (data.success) {
 const total = (data.activeEvents?.length || 0) + (data.pastEvents?.length || 0);
 animateCount(document.getElementById('totalEventsNum'), total);
 renderUpcoming(data.activeEvents || []);
 renderPast(data.pastEvents || []);
 } else {
 document.getElementById('upcomingGrid').innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-circle"></i><p>${data.message || 'Failed to load events.'}</p></div>`;
 }
 } catch (err) {
 document.getElementById('upcomingGrid').innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-circle"></i><p>Could not load events. Try again later.</p></div>`;
 }
 }

 document.addEventListener('DOMContentLoaded', loadEvents);
 </script>

