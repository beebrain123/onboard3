 <h3><i class="fab fa-x-twitter" style="color:var(--green);margin-right:.5rem"></i> Follow These Projects</h3>
 <p style="color:var(--text-2);font-size:.875rem;margin-bottom:.875rem">You are raiding for these 3 projects. Follow them on X before completing any tasks.</p>
 <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:.875rem">
 <a href="https://x.com/eyecoinHQ" target="_blank" rel="noopener noreferrer" class="brand-follow-row">
 <div class="brand-follow-icon" style="background:rgba(57,255,20,.1);border-color:var(--border-green);color:var(--green)"><i class="fab fa-x-twitter"></i></div>
 <div>
 <div class="brand-follow-name">Eyecoin</div>
 <div class="brand-follow-handle">@eyecoinHQ</div>
 </div>
 <div class="brand-follow-btn"><i class="fas fa-arrow-up-right-from-square"></i> Follow</div>
 </a>
 <a href="https://x.com/ginox_official" target="_blank" rel="noopener noreferrer" class="brand-follow-row">
 <div class="brand-follow-icon" style="background:rgba(59,130,246,.1);border-color:rgba(59,130,246,.3);color:var(--blue)"><i class="fab fa-x-twitter"></i></div>
 <div>
 <div class="brand-follow-name">Ginox</div>
 <div class="brand-follow-handle">@ginox_official</div>
 </div>
 <div class="brand-follow-btn"><i class="fas fa-arrow-up-right-from-square"></i> Follow</div>
 </a>
 <a href="https://x.com/stxbuzz" target="_blank" rel="noopener noreferrer" class="brand-follow-row">
 <div class="brand-follow-icon" style="background:rgba(245,158,11,.1);border-color:rgba(245,158,11,.3);color:var(--yellow)"><i class="fab fa-x-twitter"></i></div>
 <div>
 <div class="brand-follow-name">StxBuzz</div>
 <div class="brand-follow-handle">@stxbuzz</div>
 </div>
 <div class="brand-follow-btn"><i class="fas fa-arrow-up-right-from-square"></i> Follow</div>
 </a>
 </div>
