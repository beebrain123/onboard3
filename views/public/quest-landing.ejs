</div>

<!-- TASK SUBMISSION MODAL -->
<div class="modal-overlay" id="taskModal">
 <div class="modal-box">
 <button class="modal-close" onclick="closeTaskModal()"><i class="fas fa-times"></i></button>
 <div class="modal-title" id="modalTaskTitle">Submit Task</div>
 <p style="color:var(--text-2);font-size:.875rem;margin-bottom:1.25rem" id="modalDesc">Provide your submission link or proof below.</p>
 <input type="hidden" id="modalTaskId">
 <div class="form-group" id="modalLinkGroup">
 <label class="form-label" id="modalLinkLabel">Submission Link</label>
 <input type="text" id="modalSubmissionUrl" class="form-input" placeholder="https://...">
 </div>
 <div class="form-group" id="modalTextGroup" style="display:none">
 <label class="form-label" id="modalTextLabel">Your Submission</label>
 <textarea id="modalSubmissionText" class="form-input" rows="4" placeholder="Write your submission here..." style="resize:vertical;min-height:100px"></textarea>
 </div>
 <div class="form-group" id="modalNotesGroup">
 <label class="form-label">Additional Notes (optional)</label>
 <input type="text" id="modalSubmissionNotes" class="form-input" placeholder="Any context or notes">
 </div>
 <div class="msg msg-error" id="modalError"></div>
 <div class="msg msg-success" id="modalOk"><i class="fas fa-check-circle"></i> Submitted! Under review.</div>
 <button class="btn btn-green btn-full" id="modalSubmitBtn" onclick="submitTask()">
 <i class="fas fa-paper-plane"></i> Submit
 </button>
 </div>
</div>

<script>
var QUEST_ID = '<%= quest._id %>';
var USER_ID = '<%= user ? user._id : "" %>';

// ── Countdown timer ──────────────────────────────────────────────
(function() {
 var target = new Date('2026-08-24T00:00:00Z').getTime();
 function tick() {
 var diff = target - Date.now();
 if (diff <= 0) {
 var w = document.getElementById('countdownWrap');
 if (w) w.style.display = 'none';
 return;
 }
 var d = Math.floor(diff / 86400000);
 var h = Math.floor((diff % 86400000) / 3600000);
 var m = Math.floor((diff % 3600000) / 60000);
 var s = Math.floor((diff % 60000) / 1000);
 var pad = function(n) { return n < 10 ? '0'+n : ''+n; };
 var el = function(id, v) { var e = document.getElementById(id); if (e) e.textContent = pad(v); };
 el('cdDays', d); el('cdHours', h); el('cdMins', m); el('cdSecs', s);
 }
 tick();
 setInterval(tick, 1000);
})();

// ── Code verification ─────────────────────────────────────────────
function verifyCode() {
 var code = (document.getElementById('codeInput').value || '').trim();
 if (!code) return;
 var btn = document.getElementById('verifyCodeBtn');
 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying...';
 document.getElementById('codeError').classList.remove('show');
 document.getElementById('codeOk').classList.remove('show');

 fetch('/api/quests/' + QUEST_ID + '/apply-code', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ code: code })
 })
 .then(function(r) { return r.json(); })
 .then(function(data) {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-key"></i> Verify Code';
 if (data.success) {
 document.getElementById('codeOk').classList.add('show');
 document.getElementById('step2').style.display = 'block';
 document.getElementById('step2').scrollIntoView({ behavior: 'smooth', block: 'start' });
 } else {
 document.getElementById('codeError').classList.add('show');
 }
 })
 .catch(function() {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-key"></i> Verify Code';
 document.getElementById('codeError').classList.add('show');
 });
}

// ── Submit application ────────────────────────────────────────────
function submitApplication() {
 var xHandle = (document.getElementById('xHandleInput').value || '').trim();
 var telegram = (document.getElementById('telegramInput').value || '').trim();
 var btn = document.getElementById('applyBtn');
 var errEl = document.getElementById('applyError');
 var okEl = document.getElementById('applyOk');
 errEl.classList.remove('show');
 okEl.classList.remove('show');
 if (!xHandle && !telegram) {
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> Please fill in at least one field.';
 errEl.classList.add('show');
 return;
 }
 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';

 fetch('/api/quests/' + QUEST_ID + '/apply', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ xHandle: xHandle, telegramUsername: telegram })
 })
 .then(function(r) { return r.json(); })
 .then(function(data) {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Application';
 if (data.success) {
 okEl.classList.add('show');
 setTimeout(function() { location.reload(); }, 2000);
 } else {
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> ' + (data.message || 'Error submitting');
 errEl.classList.add('show');
 }
 })
 .catch(function() {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit Application';
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> Network error. Please try again.';
 errEl.classList.add('show');
 });
}

// ── Task modal ────────────────────────────────────────────────────
var _currentTaskId = null;
var _currentInputType = 'link';
function openTaskModal(taskId, taskTitle, inputType, inputLabel) {
 _currentTaskId = taskId;
 _currentInputType = inputType || 'link';
 document.getElementById('modalTaskId').value = taskId;
 document.getElementById('modalTaskTitle').textContent = 'Submit: ' + taskTitle;
 document.getElementById('modalSubmissionUrl').value = '';
 document.getElementById('modalSubmissionText').value = '';
 document.getElementById('modalSubmissionNotes').value = '';
 document.getElementById('modalError').classList.remove('show');
 document.getElementById('modalOk').classList.remove('show');
 document.getElementById('modalSubmitBtn').disabled = false;
 document.getElementById('modalSubmitBtn').innerHTML = '<i class="fas fa-paper-plane"></i> Submit';

 var linkGroup = document.getElementById('modalLinkGroup');
 var textGroup = document.getElementById('modalTextGroup');
 var notesGroup = document.getElementById('modalNotesGroup');
 var descEl = document.getElementById('modalDesc');

 linkGroup.style.display = 'none';
 textGroup.style.display = 'none';
 notesGroup.style.display = 'none';

 if (_currentInputType === 'none') {
 descEl.textContent = 'Click Submit to confirm you completed this task.';
 } else if (_currentInputType === 'text') {
 textGroup.style.display = 'block';
 document.getElementById('modalTextLabel').textContent = inputLabel || 'Your Submission';
 descEl.textContent = 'Write your submission below.';
 } else {
 // link or file — use URL input (file upload via URL for now)
 linkGroup.style.display = 'block';
 notesGroup.style.display = 'block';
 document.getElementById('modalLinkLabel').textContent = inputLabel || 'Submission Link';
 descEl.textContent = 'Provide your submission link or proof below.';
 }

 document.getElementById('taskModal').classList.add('open');
}
function closeTaskModal() {
 document.getElementById('taskModal').classList.remove('open');
 _currentTaskId = null;
}
// Close on overlay click
document.getElementById('taskModal').addEventListener('click', function(e) {
 if (e.target === this) closeTaskModal();
});

function submitTask() {
 var taskId = _currentTaskId;
 var url = '', text = '';
 if (_currentInputType === 'text') {
 text = (document.getElementById('modalSubmissionText').value || '').trim();
 } else if (_currentInputType !== 'none') {
 url = (document.getElementById('modalSubmissionUrl').value || '').trim();
 text = (document.getElementById('modalSubmissionNotes').value || '').trim();
 }
 var btn = document.getElementById('modalSubmitBtn');
 var errEl = document.getElementById('modalError');
 var okEl = document.getElementById('modalOk');
 errEl.classList.remove('show');
 okEl.classList.remove('show');

 if (_currentInputType !== 'none' && !url && !text) {
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> Please provide a submission.';
 errEl.classList.add('show');
 return;
 }

 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';

 fetch('/dashboard/quests/submit-task', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({
 questId: QUEST_ID,
 taskId: taskId,
 submissionUrl: url,
 submissionText: text
 })
 })
 .then(function(r) { return r.json(); })
 .then(function(data) {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit';
 if (data.success) {
 okEl.classList.add('show');
 setTimeout(function() { location.reload(); }, 2000);
 } else {
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> ' + (data.message || 'Error submitting task');
 errEl.classList.add('show');
 }
 })
 .catch(function() {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit';
 errEl.innerHTML = '<i class="fas fa-circle-xmark"></i> Network error. Please try again.';
 errEl.classList.add('show');
 });
}

// Enter key for code input
document.getElementById('codeInput') && document.getElementById('codeInput').addEventListener('keydown', function(e) {
 if (e.key === 'Enter') verifyCode();
});
</script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
