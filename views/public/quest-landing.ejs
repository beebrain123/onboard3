 <div class="info-section">
 <h3><i class="fas fa-list-ol" style="color:var(--green);margin-right:.5rem"></i> How It Works</h3>
 <div class="how-steps">
 <div class="how-step">
 <div class="how-icon"><i class="fas fa-key"></i></div>
