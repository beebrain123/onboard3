 <div class="sponsor-logo-item">
 <div class="sponsor-logo-circle">
 <% if (sp.logo) { %>
 <img src="<%= sp.logo %>" alt="<%= sp.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<%= sp.name.charAt(0) %>'">
 <% } else { %>
 <%= sp.name.charAt(0) %>
