 <span></span><span></span><span></span>
 </button>
 </div>
 </nav>

 <div class="mobile-menu" id="mobileMenu">
 <ul class="mobile-nav-menu">
 <br>
 <li><a href="/" class="mobile-nav-link active">Home</a></li>
 <li><a href="/about" class="mobile-nav-link">About</a></li>
 <li><a href="/events" class="mobile-nav-link">Events</a></li>
 <li><a href="/ecosystem" class="mobile-nav-link">Ecosystem</a></li>
 <li><a href="/partner" class="mobile-nav-link">Partner</a></li>
 </ul>
 <div class="mobile-cta">
