 <script>
 // ── Particle Canvas ─────────────────────────────────────
 (function () {
 const canvas = document.getElementById('particleCanvas');
 const ctx = canvas.getContext('2d');
 let pts = [];
 function resize() { canvas.width = innerWidth; canvas.height = innerHeight; }
 resize(); window.addEventListener('resize', resize);
 for (let i = 0; i < 70; i++) pts.push({
 x: Math.random() * innerWidth, y: Math.random() * innerHeight,
 r: Math.random() * 1.6 + 0.3,
 dx: (Math.random() - 0.5) * 0.3, dy: (Math.random() - 0.5) * 0.3,
 o: Math.random() * 0.45 + 0.08,
 pulse: Math.random() * Math.PI * 2
 });
 (function draw() {
 ctx.clearRect(0, 0, canvas.width, canvas.height);
 const t = Date.now() * 0.001;
 pts.forEach(p => {
 const o = p.o + Math.sin(t + p.pulse) * 0.15;
 ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
 ctx.fillStyle = `rgba(94,194,19,${Math.max(0,o)})`; ctx.fill();
 p.x += p.dx; p.y += p.dy;
 if (p.x < 0 || p.x > canvas.width) p.dx *= -1;
 if (p.y < 0 || p.y > canvas.height) p.dy *= -1;
 });
 requestAnimationFrame(draw);
 })();
 })();

 // ── Typed text ──────────────────────────────────────────
 (function () {
 const words = ['Web3', 'Builder', 'Creator'];
 let wi = 0, ci = 0, del = false;
 const el = document.getElementById('typedText');
 function tick() {
 const w = words[wi];
 el.textContent = del ? w.slice(0, --ci) : w.slice(0, ++ci);
 let d = del ? 40 : 90;
 if (!del && ci === w.length) { d = 2000; del = true; }
 else if (del && ci === 0) { del = false; wi = (wi + 1) % words.length; d = 350; }
 setTimeout(tick, d);
 }
 tick();
 })();

 // ── Animated counters ───────────────────────────────────
 document.querySelectorAll('.count-up').forEach(el => {
 const target = parseInt(el.dataset.target, 10);
 if (!target) return;
 new IntersectionObserver(([e], obs) => {
 if (!e.isIntersecting) return;
 obs.disconnect();
 let v = 0; const step = Math.ceil(target / 80);
 const t = setInterval(() => {
 v = Math.min(v + step, target);
 el.textContent = v.toLocaleString() + '+';
 if (v >= target) clearInterval(t);
 }, 18);
 }, { threshold: 0.5 }).observe(el);
 });

 // ── Scroll reveal ───────────────────────────────────────
 const revObs = new IntersectionObserver((entries) => {
 entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); } });
 }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
 document.querySelectorAll('.reveal-up').forEach(el => revObs.observe(el));

 // ── Navbar scroll ───────────────────────────────────────
 window.addEventListener('scroll', () => {
 document.getElementById('navbar').classList.toggle('scrolled', scrollY > 50);
 });

 // ── Tilt effect on bento cards ──────────────────────────
 document.querySelectorAll('.bento-card').forEach(card => {
 card.addEventListener('mousemove', e => {
 const r = card.getBoundingClientRect();
 const x = (e.clientX - r.left) / r.width - 0.5;
 const y = (e.clientY - r.top) / r.height - 0.5;
 card.style.transform = `translateY(-4px) rotateX(${-y * 5}deg) rotateY(${x * 5}deg)`;
 });
 card.addEventListener('mouseleave', () => { card.style.transform = ''; });
 });

 // ── Stat cards stagger entrance ─────────────────────────
 document.querySelectorAll('.stat-card').forEach((card, i) => {
 card.style.setProperty('--d', (i * 60) + 'ms');
 });

 </script>

