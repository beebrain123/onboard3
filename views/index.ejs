 </section>

 <!-- ═══════════════════ FINAL CTA ═══════════════════ -->
 <section class="final-cta">
 <div class="cta-bg-blur"></div>
 <div class="container">
 <div class="cta-inner reveal-up">
 <span class="section-label">Ready?</span>
 <h2>Your Web3 journey<br>starts <span class="gradient-text">right now.</span></h2>
 <p>Join thousands of builders already learning, earning, and building on ONBOARD3. It's free to start.</p>
 <div class="cta-btns">
 <a href="/auth" class="btn btn-primary btn-hero">
 <i class="fas fa-rocket"></i> Get Onboarded — It's Free
 </a>
 <a href="/partner" class="btn btn-ghost">Partner With Us</a>
