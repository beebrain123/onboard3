<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title><%= business.name %> — ONBOARD3 Business</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/portal.css">
 <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
 <style>
 @media (max-width: 600px) {
 /* Modal: full-height sheet from bottom */
 .p-modal-overlay { padding: 0 !important; align-items: flex-end !important; }
 .p-modal { border-radius: 1rem 1rem 0 0 !important; max-height: 92vh !important; }
 .p-modal-body { padding: 1rem !important; }
 .p-modal-head { padding: 1rem !important; }

 /* Quest manager tab bar: scroll horizontally */
 #questManagerModal .p-modal [style*="display:flex"][style*="border-bottom"],
 .qm-tabbar { overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; }

 /* Stats strip: 2x2 grid */
 #qmStats { grid-template-columns: 1fr 1fr !important; gap: .5rem !important; }
 #qmStats > div { padding: .625rem !important; }
 #qmStats > div > div:first-child { font-size: 1.2rem !important; }

 /* Award XP form: stack */
 #questManagerModal [style*="grid-template-columns:1fr 120px"] {
 grid-template-columns: 1fr !important;
 }

 /* Add task form grids: stack */
 #qmAddTaskSection [style*="grid-template-columns:1fr 1fr 1fr"],
 #qmAddTaskSection [style*="grid-template-columns:1fr 1fr"],
 #qmAddTaskSection [style*="grid-template-columns:1fr 120px"] {
 grid-template-columns: 1fr !important;
 }

 /* Entries max-height: more space on phone */
 #qmEntriesWrap { max-height: none !important; }
 #qmLeaderboard { max-height: 200px; }

 /* Disburse section */
 #questManagerModal [style*="grid-template-columns:1fr 120px auto"] {
 grid-template-columns: 1fr !important;
 }
 }
 </style>
</head>
<body>
<div class="p-overlay" id="pOverlay" onclick="closeSidebar()"></div>
<div class="p-layout">

 <!-- Sidebar -->
 <aside class="p-sidebar" id="pSidebar">
 <div class="p-sb-head">
 <img src="/img/logo.png" alt="ONBOARD3">
 <div>
 <div class="p-sb-head-text">ONBOARD3</div>
 <div style="font-size:.65rem;color:var(--green);font-weight:700;letter-spacing:.08em">BUSINESS</div>
 </div>
 </div>

 <nav class="p-sb-nav">
 <span class="p-nav-section">Overview</span>
 <a href="#" class="p-nav-item active" onclick="showSection('overview',this);closeSidebar()">
 <i class="fas fa-gauge"></i> Dashboard
 </a>

 <span class="p-nav-section">Campaigns</span>
 <a href="#" class="p-nav-item" onclick="showSection('quests',this);closeSidebar()">
 <i class="fas fa-trophy"></i> Quests
 </a>
 <a href="#" class="p-nav-item" onclick="showSection('applications',this);closeSidebar()">
 <i class="fas fa-user-check"></i> Applications
 </a>
 <a href="#" class="p-nav-item" onclick="showSection('bounties',this);closeSidebar()">
 <i class="fas fa-coins"></i> Bounties
 </a>
 <a href="#" class="p-nav-item" onclick="showSection('events',this);closeSidebar()">
 <i class="fas fa-calendar-alt"></i> Events
 </a>

 <span class="p-nav-section">Finance</span>
 <a href="#" class="p-nav-item" onclick="showSection('wallet',this);closeSidebar()">
 <i class="fas fa-wallet"></i> Wallet & Funding
 </a>
 <a href="#" class="p-nav-item" onclick="showSection('transactions',this);closeSidebar()">
 <i class="fas fa-receipt"></i> Transactions
 </a>

 <span class="p-nav-section">Insights</span>
 <a href="#" class="p-nav-item" onclick="showSection('analytics',this);closeSidebar()">
 <i class="fas fa-chart-bar"></i> Analytics
 </a>
 </nav>

 <div class="p-sb-foot">
 <div class="p-sb-avatar"><%= business.name.charAt(0).toUpperCase() %></div>
 <div class="p-sb-info">
 <div class="p-sb-name"><%= business.name %></div>
 <div class="p-sb-role">@<%= business.username %></div>
 </div>
 <form method="POST" action="/business/logout" style="margin-left:auto">
 <button type="submit" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:1rem" title="Logout">
 <i class="fas fa-right-from-bracket"></i>
 </button>
 </form>
 </div>
 </aside>

 <!-- Mobile topbar -->
 <div class="p-topbar">
 <button class="p-topbar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
 <span style="font-weight:900;font-size:.9375rem"><%= business.name %></span>
 <span class="p-auth-badge bd-badge" style="margin-left:auto">BIZ</span>
 </div>

 <!-- Main -->
 <main class="p-main">
 <div class="p-content">

 <!-- ── OVERVIEW ── -->
 <div id="sec-overview" class="p-section">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-gauge" style="color:var(--green)"></i> Dashboard</h1>
 <p>Welcome, <%= business.name %>. Here's a snapshot of your activity.</p>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="showSection('wallet',null);openModal('fundModal')">
 <i class="fas fa-plus"></i> Fund Account
 </button>
 </div>

 <div style="background:linear-gradient(135deg,#0d1f14,#0a1a0f);border:1px solid rgba(16,185,129,.25);border-radius:var(--radius);padding:1.75rem;margin-bottom:1.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
 <div>
 <div style="font-size:.75rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.375rem">Available Balance</div>
 <div style="font-size:2.5rem;font-weight:900;color:#fff">$<%= (business.balance||0).toFixed(2) %></div>
 <div style="font-size:.8125rem;color:var(--text-2);margin-top:.375rem">
 Total funded: $<%= (business.totalFunded||0).toFixed(2) %> &nbsp;·&nbsp; Total spent: $<%= (business.totalSpent||0).toFixed(2) %>
 </div>
 </div>
 <div style="display:flex;gap:.75rem;flex-wrap:wrap">
 <button class="p-btn p-btn-bd p-btn-sm" onclick="openModal('fundModal')">
 <i class="fas fa-arrow-up-from-bracket"></i> Fund Account
 </button>
 <button class="p-btn p-btn-secondary p-btn-sm" onclick="showSection('quests',null);openModal('questModal')">
 <i class="fas fa-trophy"></i> Create Quest
 </button>
 <button class="p-btn p-btn-secondary p-btn-sm" onclick="showSection('bounties',null);openModal('bountyModal')">
 <i class="fas fa-coins"></i> Create Bounty
 </button>
 </div>
 </div>

 <div class="p-stats">
 <div class="p-stat">
 <div class="p-stat-label">Active Quests</div>
 <div class="p-stat-value v-green"><%= quests.filter(q=>q.isActive).length %></div>
 <div class="p-stat-sub"><%= quests.length %> total</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Active Bounties</div>
 <div class="p-stat-value v-green"><%= bounties.filter(b=>b.isActive).length %></div>
 <div class="p-stat-sub"><%= bounties.length %> total</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Quest Completions</div>
 <div class="p-stat-value v-green"><%= totalQuestCompletions %></div>
 <div class="p-stat-sub">Across all quests</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Bounty Submissions</div>
 <div class="p-stat-value v-green"><%= totalBountySubmissions %></div>
 <div class="p-stat-sub">Across all bounties</div>
 </div>
 </div>

 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;flex-wrap:wrap">
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-trophy" style="color:var(--green)"></i> Recent Quests</div>
 <% if (!quests.length) { %>
 <div class="p-empty" style="padding:1.5rem"><i class="fas fa-trophy" style="font-size:1.5rem;margin-bottom:.5rem"></i><p style="font-size:.875rem">No quests yet</p></div>
 <% } else { %>
 <% quests.slice(0,3).forEach(q => { %>
 <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid var(--border)">
 <div>
 <div style="font-weight:600;font-size:.875rem"><%= q.title %></div>
 <div style="font-size:.75rem;color:var(--text-3)">Pool: $<%= (q.usdcReward||0).toFixed(2) %></div>
 </div>
 <span class="p-badge <%= q.approvalStatus==='pending'?'p-badge-warning':q.approvalStatus==='rejected'?'p-badge-danger':q.isActive?'p-badge-active':'p-badge-draft' %>"><%= q.approvalStatus==='pending'?'Pending Review':q.approvalStatus==='rejected'?'Rejected':q.isActive?'Live':'Inactive' %></span>
 </div>
 <% }) %>
 <% } %>
 </div>
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-coins" style="color:var(--green)"></i> Recent Bounties</div>
 <% if (!bounties.length) { %>
 <div class="p-empty" style="padding:1.5rem"><i class="fas fa-coins" style="font-size:1.5rem;margin-bottom:.5rem"></i><p style="font-size:.875rem">No bounties yet</p></div>
 <% } else { %>
 <% bounties.slice(0,3).forEach(b => { %>
 <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid var(--border)">
 <div>
 <div style="font-weight:600;font-size:.875rem"><%= b.title %></div>
 <div style="font-size:.75rem;color:var(--text-3)">Pool: $<%= (b.rewardPool||0).toFixed(2) %></div>
 </div>
 <span class="p-badge <%= b.approvalStatus==='pending'?'p-badge-warning':'p-badge-'+b.status %>"><%= b.approvalStatus==='pending'?'Pending Review':b.status %></span>
 </div>
 <% }) %>
 <% } %>
 </div>
 </div>
 </div>

 <!-- ── QUESTS ── -->
 <div id="sec-quests" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-trophy" style="color:var(--green)"></i> Quests</h1>
 <p>Create and manage quests that community members can complete</p>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="openModal('questModal')">
 <i class="fas fa-plus"></i> Create Quest
 </button>
 </div>
 <%
 var gatedQuests = quests.filter(function(q){ return q.gated && q.accessCode; });
 %>
 <% if (gatedQuests.length) { %>
 <% gatedQuests.forEach(function(gq) { %>
 <div style="background:linear-gradient(135deg,#0d1f14,#091508);border:1px solid rgba(16,185,129,.35);border-radius:var(--radius);padding:1.25rem 1.5rem;margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
 <div>
 <div style="font-size:.7rem;font-weight:800;color:var(--green);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.375rem"><i class="fas fa-lock"></i> Campaign Access Code — <%= gq.title %></div>
 <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
 <span id="codeDisplay_<%= gq._id %>" style="font-size:1.75rem;font-weight:900;color:#fff;letter-spacing:.12em;font-family:monospace"><%= gq.accessCode %></span>
 <button onclick="var el=document.getElementById('codeDisplay_<%= gq._id %>');navigator.clipboard.writeText(el.textContent.trim()).then(()=>{this.innerHTML='<i class=\'fas fa-check\'></i> Copied!';setTimeout(()=>this.innerHTML='<i class=\'fas fa-copy\'></i> Copy',1600)}).catch(()=>{})" style="display:inline-flex;align-items:center;gap:.35rem;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.4);color:var(--green);border-radius:8px;padding:.35rem .85rem;font-size:.8rem;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif"><i class="fas fa-copy"></i> Copy</button>
 </div>
 <div style="font-size:.75rem;color:var(--text-3);margin-top:.375rem">Share this code with raiders. Only people with this code can apply.</div>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="goToApplications()">
 <i class="fas fa-user-check"></i> Review Applicants
 </button>
 </div>
 <% }); %>
 <% } %>
 <% if (!quests.length) { %>
 <div class="p-card"><div class="p-empty"><i class="fas fa-trophy"></i><p>No quests yet. Create your first quest to start engaging the community.</p></div></div>
 <% } else { %>
 <div class="p-card">
 <div class="p-table-wrap">
 <table class="pt">
 <thead><tr><th>Quest</th><th>Type</th><th>Pool</th><th>Status</th><th>End Date</th><th>Access Code</th><th>Actions</th></tr></thead>
 <tbody>
 <% quests.forEach(q => { %>
 <tr>
 <td>
 <div style="font-weight:700"><%= q.title %></div>
 <div style="font-size:.75rem;color:var(--text-3)"><%= q.category %> · <%= q.difficulty %></div>
 </td>
 <td><span class="p-badge p-badge-info" style="text-transform:capitalize;font-size:.7rem"><%= (q.questType||'standard').replace('_',' ') %></span></td>
 <td style="color:var(--green);font-weight:700">$<%= (q.usdcReward||0).toFixed(2) %></td>
 <td>
 <% if(q.approvalStatus==='pending'){ %>
 <span class="p-badge p-badge-warning">Pending Review</span>
 <% } else if(q.approvalStatus==='rejected'){ %>
 <span class="p-badge p-badge-danger" title="<%= q.approvalNote ? 'Reason: '+q.approvalNote : '' %>">Rejected</span>
 <% if(q.approvalNote){ %><div style="font-size:.7rem;color:#ef4444;margin-top:.2rem;max-width:140px;word-break:break-word"><%= q.approvalNote %></div><% } %>
 <% } else if(q.approvalStatus==='approved' && !q.isActive){ %>
 <span class="p-badge p-badge-info">Approved - Not live</span>
 <% } else if(q.rewardsDistributed){ %>
 <span class="p-badge p-badge-approved">Distributed</span>
 <% } else if(q.endDate && new Date()>new Date(q.endDate)){ %>
 <span class="p-badge p-badge-draft">Ended</span>
 <% } else if(q.isActive){ %>
 <span class="p-badge p-badge-active">Live</span>
 <% } else { %>
 <span class="p-badge p-badge-draft">Inactive</span>
 <% } %>
 </td>
 <td style="color:var(--text-2);font-size:.8rem"><%= q.endDate ? new Date(q.endDate).toLocaleDateString() : 'No end' %></td>
 <td>
 <% if (q.gated && q.accessCode) { %>
 <div style="display:flex;align-items:center;gap:.4rem">
 <code style="font-size:.75rem;font-weight:800;color:var(--green);background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);border-radius:6px;padding:.2rem .5rem;letter-spacing:.04em"><%= q.accessCode %></code>
 <button onclick="navigator.clipboard.writeText('<%= q.accessCode %>').then(()=>this.innerHTML='<i class=\'fas fa-check\'></i>').catch(()=>{})" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:.75rem;padding:.1rem" title="Copy code"><i class="fas fa-copy"></i></button>
 </div>
 <% } else { %>
 <span style="color:var(--text-3);font-size:.75rem">—</span>
 <% } %>
 </td>
 <td>
 <div style="display:flex;gap:.4rem;flex-wrap:wrap">
 <button class="p-btn p-btn-ghost p-btn-sm" onclick="openQuestManager('<%= q._id %>','<%= q.title.replace(/'/g,`\\'`) %>')">
 <i class="fas fa-sliders"></i> Manage
 </button>
 <% if (q.gated && q.memberApproval) { %>
 <button class="p-btn p-btn-ghost p-btn-sm" onclick="openApplications('<%= q._id %>','<%= q.title.replace(/'/g,`\\'`) %>')" style="color:var(--amber);border-color:rgba(245,158,11,.35)">
 <i class="fas fa-user-check"></i> Applicants
 </button>
 <% } %>
 </div>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 </div>
 <% } %>
 </div>

 <!-- ── APPLICATIONS ── -->
 <div id="sec-applications" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-user-check" style="color:var(--green)"></i> Applications</h1>
 <p>Approve or reject people who applied to your gated campaigns</p>
 </div>
 <div style="display:flex;gap:.5rem;align-items:center">
 <select id="appSectionQuestFilter" onchange="loadSectionApplications()" style="font-size:.8125rem;padding:.4rem .75rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Outfit',sans-serif">
 <% quests.filter(function(q){return q.gated && q.memberApproval;}).forEach(function(q){ %>
 <option value="<%= q._id %>"><%= q.title %></option>
 <% }); %>
 </select>
 <select id="appSectionStatusFilter" onchange="loadSectionApplications()" style="font-size:.8125rem;padding:.4rem .75rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Outfit',sans-serif">
 <option value="">All</option>
 <option value="pending">Pending</option>
 <option value="approved">Approved</option>
 <option value="rejected">Rejected</option>
 </select>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="loadSectionApplications()"><i class="fas fa-refresh"></i> Refresh</button>
 </div>
 </div>
 <% var gatedApprovalQuests = quests.filter(function(q){return q.gated && q.memberApproval;}); %>
 <% if (!gatedApprovalQuests.length) { %>
 <div class="p-card"><div class="p-empty"><i class="fas fa-user-check"></i><p>No gated quests with member approval enabled.</p></div></div>
 <% } else { %>
 <div class="p-card">
 <div id="appSectionWrap">
 <div style="text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem"><i class="fas fa-spinner fa-spin"></i> Loading applications...</div>
 </div>
 </div>
 <% } %>
 </div>

 <!-- ── BOUNTIES ── -->
 <div id="sec-bounties" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-coins" style="color:var(--green)"></i> Bounties</h1>
 <p>Create competitive bounties with prize pools for top performers</p>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="openModal('bountyModal')">
 <i class="fas fa-plus"></i> Create Bounty
 </button>
 </div>
 <% if (!bounties.length) { %>
 <div class="p-card"><div class="p-empty"><i class="fas fa-coins"></i><p>No bounties yet. Create your first bounty to attract top talent.</p></div></div>
 <% } else { %>
 <div class="p-card">
 <div class="p-table-wrap">
 <table class="pt">
 <thead><tr><th>Bounty</th><th>Pool</th><th>Submissions</th><th>Status</th><th>End Date</th></tr></thead>
 <tbody>
 <% bounties.forEach(b => { %>
 <tr>
 <td>
 <div style="font-weight:700"><%= b.title %></div>
 <div style="font-size:.75rem;color:var(--text-3)"><%= b.category %></div>
 </td>
 <td style="color:var(--green);font-weight:700">$<%= (b.rewardPool||0).toFixed(2) %></td>
 <td style="color:var(--text-2)"><%= b.totalSubmissions || 0 %></td>
 <td><span class="p-badge <%= b.approvalStatus==='pending'?'p-badge-warning':'p-badge-'+b.status %>"><%= b.approvalStatus==='pending'?'Pending Review':b.status %></span></td>
 <td style="color:var(--text-2);font-size:.8rem"><%= b.endDate ? new Date(b.endDate).toLocaleDateString() : 'No end' %></td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 </div>
 <% } %>
 </div>

 <!-- ── EVENTS ── -->
 <div id="sec-events" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-calendar-alt" style="color:var(--green)"></i> Events</h1>
 <p>Host events and manage registrations</p>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="openModal('bizEventModal')">
 <i class="fas fa-plus"></i> Create Event
 </button>
 </div>
 <% if (!events || !events.length) { %>
 <div class="p-card"><div class="p-empty"><i class="fas fa-calendar-alt"></i><p>No events yet. Create your first event.</p></div></div>
 <% } else { %>
 <div class="p-card">
 <div class="p-table-wrap">
 <table class="pt">
 <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Approval</th><th>Registered</th><th>Pending</th><th>Actions</th></tr></thead>
 <tbody>
 <% events.forEach(ev => {
 var pending = (ev.registrations || []).filter(r => r.status === 'pending').length;
 %>
 <tr>
 <td style="font-weight:700"><%= ev.title %></td>
 <td style="font-size:.8rem;color:var(--text-3)"><%= new Date(ev.startDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
 <td><span class="p-badge p-badge-info" style="text-transform:capitalize"><%= ev.eventType || 'online' %></span></td>
 <td><span class="p-badge <%= ev.approvalType==='manual'?'p-badge-warning':'p-badge-success' %>"><%= ev.approvalType==='manual'?'Manual':'Auto' %></span></td>
 <td style="font-weight:700"><%= ev.totalRegistrations || 0 %></td>
 <td><% if (pending > 0) { %><span style="background:rgba(245,158,11,.15);color:#f59e0b;border-radius:20px;padding:.15rem .5rem;font-size:.72rem;font-weight:700"><%= pending %> pending</span><% } else { %>—<% } %></td>
 <td><button data-eid="<%= ev._id %>" data-etitle="<%= ev.title.replace(/"/g,'&quot;') %>" onclick="bizOpenEventRegs(this.dataset.eid,this.dataset.etitle)" class="p-btn p-btn-secondary p-btn-sm"><i class="fas fa-users"></i> Manage</button></td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 </div>
 <% } %>
 </div>

 <!-- ── WALLET ── -->
 <div id="sec-wallet" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-wallet" style="color:var(--green)"></i> Wallet & Funding</h1>
 <p>Manage your account balance and fund requests</p>
 </div>
 <button class="p-btn p-btn-bd p-btn-sm" onclick="openModal('fundModal')">
 <i class="fas fa-arrow-up-from-bracket"></i> Request Funding
 </button>
 </div>

 <div style="background:linear-gradient(135deg,#0d1f14,#0a1a0f);border:1px solid rgba(16,185,129,.25);border-radius:var(--radius);padding:2rem;margin-bottom:1.5rem">
 <div style="font-size:.75rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.375rem">Available Balance</div>
 <div style="font-size:3rem;font-weight:900;color:#fff;margin-bottom:.5rem">$<%= (business.balance||0).toFixed(2) %></div>
 <div style="display:flex;gap:2rem;flex-wrap:wrap">
 <div><span style="color:var(--text-3);font-size:.8125rem">Total Funded</span><br><span style="font-size:1.125rem;font-weight:700;color:var(--green)">$<%= (business.totalFunded||0).toFixed(2) %></span></div>
 <div><span style="color:var(--text-3);font-size:.8125rem">Total Spent</span><br><span style="font-size:1.125rem;font-weight:700;color:var(--amber)">$<%= (business.totalSpent||0).toFixed(2) %></span></div>
 </div>
 </div>

 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-clock-rotate-left"></i> Fund Request History</div>
 <% if (!fundRequests.length) { %>
 <div class="p-empty"><i class="fas fa-file-invoice-dollar"></i><p>No fund requests yet.</p></div>
 <% } else { %>
 <div class="p-table-wrap">
 <table class="pt">
 <thead><tr><th>Amount</th><th>Token</th><th>Network</th><th>Status</th><th>Date</th></tr></thead>
 <tbody>
 <% fundRequests.forEach(fr => { %>
 <tr>
 <td style="font-weight:700;color:var(--green)">$<%= (fr.amount||0).toFixed(2) %></td>
 <td><span class="p-badge p-badge-info"><%= fr.token %></span></td>
 <td style="color:var(--text-2);text-transform:capitalize"><%= fr.network === 'bnb' ? 'BNB (BEP-20)' : fr.network === 'erc20' ? 'Ethereum (ERC-20)' : 'Solana (SPL)' %></td>
 <td><span class="p-badge p-badge-<%= fr.status %>"><%= fr.status %></span></td>
 <td style="color:var(--text-3);font-size:.8rem"><%= new Date(fr.createdAt).toLocaleDateString() %></td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 <% } %>
 </div>
 </div>

 <!-- ── TRANSACTIONS ── -->
 <div id="sec-transactions" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-receipt" style="color:var(--green)"></i> Transactions</h1>
 <p>Full ledger of all account activity</p>
 </div>
 </div>
 <div class="p-card">
 <% if (!transactions.length) { %>
 <div class="p-empty"><i class="fas fa-receipt"></i><p>No transactions yet.</p></div>
 <% } else { %>
 <div class="p-table-wrap">
 <table class="pt">
 <thead><tr><th>Type</th><th>Description</th><th>Total</th><th>Pool</th><th>BD Fee</th><th>Platform Fee</th><th>Balance After</th><th>Date</th></tr></thead>
 <tbody>
 <% transactions.forEach(tx => { %>
 <tr>
 <td>
 <span class="p-badge <%= tx.type==='fund'?'p-badge-approved':tx.type==='quest_creation'?'p-badge-info':'p-badge-pending' %>">
 <% if(tx.type==='fund'){ %><i class="fas fa-arrow-down"></i> Fund<% } else if(tx.type==='quest_creation'){ %><i class="fas fa-trophy"></i> Quest<% } else { %><i class="fas fa-coins"></i> Bounty<% } %>
 </span>
 </td>
 <td style="font-size:.8125rem;color:var(--text-2)"><%= tx.description || '—' %></td>
 <td style="font-weight:700;color:<%= tx.type==='fund'?'var(--green)':'var(--amber)' %>">
 <%= tx.type==='fund' ? '+' : '-' %>$<%= (tx.totalAmount||0).toFixed(2) %>
 </td>
 <td style="color:var(--text-2);font-size:.875rem">$<%= (tx.poolAmount||0).toFixed(2) %></td>
 <td style="color:var(--text-3);font-size:.8rem">$<%= (tx.bdCommission||0).toFixed(2) %> (<%= tx.bdCommissionRate||0 %>%)</td>
 <td style="color:var(--text-3);font-size:.8rem">$<%= (tx.platformCommission||0).toFixed(2) %> (<%= tx.platformCommissionRate||0 %>%)</td>
 <td style="font-weight:700;color:var(--green)">$<%= (tx.balanceAfter||0).toFixed(2) %></td>
 <td style="color:var(--text-3);font-size:.8rem"><%= new Date(tx.createdAt).toLocaleDateString() %></td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 <% } %>
 </div>
 </div>

 <!-- ── ANALYTICS ── -->
 <div id="sec-analytics" class="p-section" style="display:none">
 <div class="p-page-header">
 <div>
 <h1><i class="fas fa-chart-bar" style="color:var(--green)"></i> Analytics & KPIs</h1>
 <p>Performance metrics for your campaigns</p>
 </div>
 </div>
 <div class="p-stats" style="margin-bottom:1.5rem">
 <div class="p-stat">
 <div class="p-stat-label">Total Campaign Budget</div>
 <div class="p-stat-value v-green">$<%= (business.totalSpent||0).toFixed(2) %></div>
 <div class="p-stat-sub">Across <%= quests.length + bounties.length %> campaigns</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Total Engagements</div>
 <div class="p-stat-value v-green"><%= totalQuestCompletions + totalBountySubmissions %></div>
 <div class="p-stat-sub"><%= totalQuestCompletions %> completions + <%= totalBountySubmissions %> submissions</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Avg Cost / Engagement</div>
 <div class="p-stat-value v-green">
 <% const totalEng = totalQuestCompletions + totalBountySubmissions; %>
 <%= totalEng > 0 ? '$'+((business.totalSpent||0)/totalEng).toFixed(2) : '—' %>
 </div>
 <div class="p-stat-sub">Budget efficiency</div>
 </div>
 <div class="p-stat">
 <div class="p-stat-label">Available Balance</div>
 <div class="p-stat-value v-green">$<%= (business.balance||0).toFixed(2) %></div>
 <div class="p-stat-sub">Ready to spend</div>
 </div>
 </div>

 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem">
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-chart-pie" style="color:var(--green)"></i> Budget Allocation</div>
 <div style="position:relative;height:220px;display:flex;align-items:center;justify-content:center">
 <% const totalQBudgetA = quests.reduce((s,q)=>s+(q.usdcReward||0),0); %>
 <% const totalBBudgetA = bounties.reduce((s,b)=>s+(b.rewardPool||0),0); %>
 <% if(totalQBudgetA+totalBBudgetA > 0){ %>
 <canvas id="budgetChart" width="200" height="200"></canvas>
 <% } else { %>
 <div class="p-empty"><i class="fas fa-chart-pie"></i><p>No budget data yet</p></div>
 <% } %>
 </div>
 </div>
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-chart-bar" style="color:var(--green)"></i> Quest Completions</div>
 <div style="position:relative;height:220px">
 <% if(quests.length){ %>
 <canvas id="questCompletionsChart"></canvas>
 <% } else { %>
 <div class="p-empty"><i class="fas fa-chart-bar"></i><p>No quest data yet</p></div>
 <% } %>
 </div>
 </div>
 </div>

 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-trophy" style="color:var(--green)"></i> Quest KPIs</div>
 <div style="display:flex;flex-direction:column;gap:.875rem">
 <% const totalQBudget = quests.reduce((s,q)=>s+(q.usdcReward||0),0); %>
 <% [{l:'Total Quests',v:quests.length,c:'var(--text)'},{l:'Active Quests',v:quests.filter(q=>q.isActive).length,c:'var(--green)'},{l:'Total Completions',v:totalQuestCompletions,c:'var(--green)'},{l:'Reward Pool',v:'$'+totalQBudget.toFixed(2),c:'var(--amber)'},{l:'Cost / Completion',v:totalQuestCompletions>0?'$'+(totalQBudget/totalQuestCompletions).toFixed(2):'—',c:'var(--green)'}].forEach(row => { %>
 <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem;background:var(--surface);border-radius:var(--radius-sm)">
 <span style="color:var(--text-2);font-size:.875rem"><%= row.l %></span>
 <span style="font-weight:800;font-size:1.125rem;color:<%= row.c %>"><%= row.v %></span>
 </div>
 <% }) %>
 </div>
 </div>
 <div class="p-card">
 <div class="p-card-title"><i class="fas fa-coins" style="color:var(--green)"></i> Bounty KPIs</div>
 <div style="display:flex;flex-direction:column;gap:.875rem">
 <% const totalBBudget = bounties.reduce((s,b)=>s+(b.rewardPool||0),0); %>
 <% [{l:'Total Bounties',v:bounties.length,c:'var(--text)'},{l:'Active Bounties',v:bounties.filter(b=>b.isActive).length,c:'var(--green)'},{l:'Total Submissions',v:totalBountySubmissions,c:'var(--green)'},{l:'Prize Pool',v:'$'+totalBBudget.toFixed(2),c:'var(--amber)'},{l:'Cost / Submission',v:totalBountySubmissions>0?'$'+(totalBBudget/totalBountySubmissions).toFixed(2):'—',c:'var(--green)'}].forEach(row => { %>
 <div style="display:flex;justify-content:space-between;align-items:center;padding:.75rem;background:var(--surface);border-radius:var(--radius-sm)">
 <span style="color:var(--text-2);font-size:.875rem"><%= row.l %></span>
 <span style="font-weight:800;font-size:1.125rem;color:<%= row.c %>"><%= row.v %></span>
 </div>
 <% }) %>
 </div>
 </div>
 </div>
 </div>

 </div>
 </main>
</div>

<!-- ── Fund Request Modal ── -->
<div class="p-modal-overlay" id="fundModal">
 <div class="p-modal" style="max-width:560px">
 <div class="p-modal-head">
 <h3><i class="fas fa-arrow-up-from-bracket" style="color:var(--green)"></i> Fund Your Account</h3>
 <button class="p-modal-close" onclick="closeModal('fundModal')"><i class="fas fa-times"></i></button>
 </div>
 <form method="POST" action="/business/fund-request" enctype="multipart/form-data">
 <div class="p-modal-body">
 <div class="p-alert p-alert-info" style="margin-bottom:1.25rem;font-size:.8375rem">
 <i class="fas fa-info-circle"></i>
 Send funds to the wallet address shown below, then upload your payment screenshot. Your balance will be credited after admin approval.
 </div>
 <div class="p-form-group">
 <label>Amount (USD) <span style="color:var(--red)">*</span></label>
 <input class="p-input" type="number" name="amount" min="1" step="0.01" placeholder="500.00" required>
 </div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group">
 <label>Token <span style="color:var(--red)">*</span></label>
 <select class="p-input" name="token" id="fundToken" onchange="lookupWallet()" required>
 <option value="">Select token</option>
 <option value="USDC">USDC</option>
 <option value="USDT">USDT</option>
 </select>
 </div>
 <div class="p-form-group">
 <label>Network <span style="color:var(--red)">*</span></label>
 <select class="p-input" name="network" id="fundNetwork" onchange="lookupWallet()" required>
 <option value="">Select network</option>
 <option value="solana">Solana (SPL)</option>
 <option value="bnb">BNB Chain (BEP-20)</option>
 <option value="erc20">Ethereum (ERC-20)</option>
 </select>
 </div>
 </div>
 <div id="walletDisplay" style="display:none;margin-bottom:1rem">
 <label style="display:block;font-size:.8125rem;font-weight:600;color:var(--text-2);margin-bottom:.375rem">Send to this wallet address:</label>
 <div style="background:var(--surface);border:1px solid rgba(16,185,129,.3);border-radius:var(--radius-sm);padding:.875rem 1rem;display:flex;align-items:center;gap:.75rem">
 <div style="flex:1">
 <div id="walletLabel" style="font-size:.7rem;color:var(--green);font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.25rem"></div>
 <div id="walletAddr" style="font-family:monospace;font-size:.875rem;color:var(--text);word-break:break-all"></div>
 </div>
 <button type="button" onclick="copyWallet()" class="p-btn p-btn-ghost p-btn-sm" style="flex-shrink:0" id="copyBtn"><i class="fas fa-copy"></i></button>
 </div>
 <input type="hidden" name="walletAddressId" id="walletAddressId">
 </div>
 <div id="walletNotFound" style="display:none" class="p-alert p-alert-error">
 <i class="fas fa-triangle-exclamation"></i> No wallet address configured for this token/network. Contact support.
 </div>
 <div class="p-form-group">
 <label>Payment Screenshot <span style="color:var(--red)">*</span></label>
 <div style="border:2px dashed var(--border-2);border-radius:var(--radius-sm);padding:1.5rem;text-align:center;cursor:pointer;position:relative" id="dropZone" onclick="document.getElementById('screenshotInput').click()">
 <i class="fas fa-cloud-arrow-up" style="font-size:1.75rem;color:var(--text-3);margin-bottom:.5rem;display:block"></i>
 <p style="color:var(--text-2);font-size:.875rem;margin-bottom:.25rem">Click to upload screenshot</p>
 <p style="color:var(--text-3);font-size:.75rem">PNG, JPG, GIF, WebP — max 5 MB</p>
 <input type="file" name="screenshot" id="screenshotInput" accept="image/*" required style="display:none" onchange="previewScreenshot(this)">
 </div>
 <div id="screenshotPreview" style="display:none;margin-top:.75rem">
 <img id="previewImg" style="max-width:100%;max-height:200px;border-radius:var(--radius-sm);border:1px solid var(--border)" alt="Preview">
 </div>
 </div>
 <div class="p-form-group">
 <label>Additional Notes</label>
 <textarea class="p-input" name="proofNote" placeholder="Any additional info for the admin..." style="min-height:70px"></textarea>
 </div>
 </div>
 <div class="p-modal-foot">
 <button type="button" class="p-btn p-btn-secondary p-btn-sm" onclick="closeModal('fundModal')">Cancel</button>
 <button type="submit" class="p-btn p-btn-bd p-btn-sm"><i class="fas fa-paper-plane"></i> Submit Request</button>
 </div>
 </form>
 </div>
</div>

<!-- ── Create Quest Modal ── -->
<div class="p-modal-overlay" id="questModal">
 <div class="p-modal" style="max-width:700px">
 <div class="p-modal-head">
 <h3><i class="fas fa-trophy" style="color:var(--green)"></i> Create Quest</h3>
 <button class="p-modal-close" onclick="closeModal('questModal')"><i class="fas fa-times"></i></button>
 </div>
 <form method="POST" action="/business/create-quest" id="questForm" onsubmit="return prepareQuestSubmit()">
 <div class="p-modal-body">

 <!-- Basic Info -->
 <div class="p-form-group">
 <label>Quest Title <span style="color:var(--red)">*</span></label>
 <input class="p-input" type="text" name="title" placeholder="e.g. Follow us on Twitter + Join Discord" required>
 </div>
 <div class="p-form-group">
 <label>Short Description <span style="color:var(--red)">*</span></label>
 <input class="p-input" type="text" name="shortDescription" placeholder="One-liner shown on quest card" required>
 </div>
 <div class="p-form-group">
 <label>Full Description <span style="color:var(--red)">*</span></label>
 <textarea class="p-input" name="description" style="min-height:80px" placeholder="Detailed quest instructions..." required></textarea>
 </div>
 <div class="p-form-group">
 <label>Image URL</label>
 <input class="p-input" type="url" name="image" placeholder="https://example.com/image.png">
 </div>

 <!-- Category / Difficulty -->
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group">
 <label>Category</label>
 <select class="p-input" name="category">
 <option value="social">Social</option>
 <option value="learning">Learning</option>
 <option value="development">Development</option>
 <option value="community">Community</option>
 <option value="special">Special</option>
 </select>
 </div>
 <div class="p-form-group">
 <label>Difficulty</label>
 <select class="p-input" name="difficulty">
 <option value="beginner">Beginner</option>
 <option value="intermediate">Intermediate</option>
 <option value="advanced">Advanced</option>
 <option value="expert">Expert</option>
 </select>
 </div>
 </div>

 <!-- Quest Type + Base XP -->
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group">
 <label>Quest Type</label>
 <select class="p-input" name="questType" id="questTypeSelect" onchange="onQuestTypeChange(this.value)">
 <option value="standard">Standard</option>
 <option value="fcfs">First Come First Serve (FCFS)</option>
 <option value="competition">Competition (Leaderboard)</option>
 <option value="referral_boost">Referral Boost</option>
 <option value="permanent">Permanent</option>
 <option value="daily">Daily</option>
 <option value="weekly">Weekly</option>
 <option value="monthly">Monthly</option>
 <option value="special">Special</option>
 </select>
 </div>
 <div class="p-form-group">
 <label>Base XP Reward</label>
 <input class="p-input" type="number" name="baseXpReward" min="0" step="1" placeholder="100">
 </div>
 </div>

 <!-- FCFS Config -->
 <div id="fcfsConfig" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:.75rem">
 <div style="font-size:.8rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem"><i class="fas fa-users"></i> FCFS Settings</div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Max Participants</label>
 <input class="p-input" type="number" name="maxParticipants" min="1" step="1" placeholder="e.g. 500 (blank = unlimited)">
 </div>
 </div>
 <div style="margin-top:.875rem;padding-top:.875rem;border-top:1px solid var(--border)">
 <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.875rem;font-weight:600">
 <input type="checkbox" name="batchEnabled" id="batchEnabledChk" onchange="toggleBatchFields()"> Enable Batch Spot Release
 </label>
 <div id="batchFields" style="margin-top:.75rem;display:none;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Spots Per Batch</label>
 <input class="p-input" type="number" name="batchSize" min="1" value="50" placeholder="50">
 </div>
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Hours Between Batches</label>
 <input class="p-input" type="number" name="batchIntervalHours" min="1" value="48" placeholder="48">
 </div>
 </div>
 </div>
 </div>

 <!-- Competition Config -->
 <div id="competitionConfig" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:.75rem">
 <div style="font-size:.8rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem"><i class="fas fa-ranking-star"></i> Ranked Winner Settings</div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Number of prize places</label>
 <input class="p-input" type="number" name="competitionTopWinners" id="bizTopWinners" min="1" max="100" value="10" placeholder="10" oninput="renderBizRankFields()">
 </div>
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Winner Bonus XP</label>
 <input class="p-input" type="number" name="competitionWinnerXP" min="0" value="0" placeholder="0">
 </div>
 </div>
 </div>

 <!-- Referral Config -->
 <div id="referralConfig" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:.75rem">
 <div style="font-size:.8rem;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem"><i class="fas fa-user-plus"></i> Referral Boost Settings</div>
 <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.875rem;font-weight:600;margin-bottom:.75rem">
 <input type="checkbox" name="referralEnabled" id="referralEnabledChk"> Enable Referral Bonuses
 </label>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">XP Per Referral Join</label>
 <input class="p-input" type="number" name="referralJoinXP" min="0" value="0" placeholder="0">
 </div>
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">XP Per Referral Complete</label>
 <input class="p-input" type="number" name="referralCompleteXP" min="0" value="0" placeholder="0">
 </div>
 </div>
 </div>

 <!-- Dates -->
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
 <div class="p-form-group">
 <label>Start Date</label>
 <input class="p-input" type="date" name="startDate">
 </div>
 <div class="p-form-group">
 <label>End Date</label>
 <input class="p-input" type="date" name="endDate">
 </div>
 </div>

 <!-- Budget -->
 <div class="p-form-group">
 <label>Total Budget (USD) <span style="color:var(--red)">*</span></label>
 <input class="p-input" type="number" name="budget" min="1" step="0.01" placeholder="300.00" required id="questBudgetInput" oninput="updateQuestPreview()">
 <div style="font-size:.75rem;color:var(--text-3);margin-top:.25rem">Balance: $<%= (business.balance||0).toFixed(2) %></div>
 </div>
 <div class="p-commission-box" id="questCommissionPreview" style="display:none">
 <div style="font-size:.75rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Fee Breakdown</div>
 <div class="p-commission-row"><span>BD Commission (<span id="qBdRate">-</span>%)</span><span id="qBdAmt">-</span></div>
 <div class="p-commission-row"><span>Platform Fee (<span id="qPlatRate">-</span>%)</span><span id="qPlatAmt">-</span></div>
 <div class="p-commission-row pool"><span><i class="fas fa-trophy"></i> Quest Reward Pool</span><span id="qPoolAmt">-</span></div>
 </div>

 <!-- Reward Plan -->
 <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;margin-bottom:.75rem" id="rewardPlanSection">
 <div style="font-size:.8rem;font-weight:700;color:var(--text-2);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem"><i class="fas fa-chart-pie" style="color:var(--green)"></i> Reward Distribution</div>
 <div id="bizEqualRewardFields" style="display:none;grid-template-columns:1fr 1fr;gap:.875rem">
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">USDC Per Person</label>
 <input class="p-input" type="number" name="rewardPerPerson" id="bizRewardPerPerson" min="0" step="0.01" placeholder="e.g. 5.00" oninput="calcBizRewardPlan()" style="font-size:.8125rem">
 </div>
 <div class="p-form-group" style="margin:0">
 <label style="font-size:.8rem">Max Recipients <span style="color:var(--text-3);font-weight:400">(auto)</span></label>
 <input class="p-input" type="number" name="maxWinners" id="bizMaxWinners" min="0" placeholder="Auto from budget" style="font-size:.8125rem">
 </div>
 </div>
