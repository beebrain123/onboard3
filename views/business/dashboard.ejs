 <div id="editTaskMsg" style="display:none;padding:.5rem .875rem;border-radius:8px;font-size:.8rem;font-weight:600;margin-top:.5rem"></div>
 </div>
 <div class="p-modal-foot">
 <button type="button" class="p-btn p-btn-secondary p-btn-sm" onclick="closeModal('editTaskModal')">Cancel</button>
 <button type="button" class="p-btn p-btn-bd p-btn-sm" onclick="bizSaveEditTask()"><i class="fas fa-save"></i> Save Changes</button>
 </div>
 </div>
</div>

<script>
// ── Section nav ───────────────────────────────────────────────────────────────
function showSection(name, el) {
 document.querySelectorAll('.p-section').forEach(s => s.style.display = 'none');
 document.querySelectorAll('.p-nav-item').forEach(n => n.classList.remove('active'));
 document.getElementById('sec-' + name).style.display = '';
 if (el) el.classList.add('active');
 if (name === 'analytics') initCharts();
 if (name === 'applications') loadSectionApplications();
}

function goToApplications() {
 var navItems = document.querySelectorAll('.p-nav-item');
 var appNav = null;
 navItems.forEach(function(n) { if (n.textContent.trim().indexOf('Applications') !== -1) appNav = n; });
 showSection('applications', appNav);
}

// ── Section-level Applications ────────────────────────────────────────────────
function loadSectionApplications() {
 var questSel = document.getElementById('appSectionQuestFilter');
 var statusSel = document.getElementById('appSectionStatusFilter');
 var wrap = document.getElementById('appSectionWrap');
 if (!questSel || !wrap) return;
 var questId = questSel.value;
 var status = statusSel ? statusSel.value : '';
 if (!questId) { wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem">Select a quest above.</div>'; return; }
 wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
 fetch('/business/api/quest/' + questId + '/applications' + (status ? '?status=' + status : ''))
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (!d.success) { wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:#ef4444;font-size:.875rem">Failed to load applications.</div>'; return; }
 var apps = d.applications;
 if (!apps || !apps.length) {
 wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem">No applications' + (status ? ' with status "' + status + '"' : '') + '.</div>';
 return;
 }
 var pendingCount = apps.filter(function(a){ return a.status === 'pending'; }).length;
 var header = '<div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem">' +
 '<span style="font-size:.8rem;font-weight:700;color:var(--text-2)">' + apps.length + ' total</span>' +
 (pendingCount > 0 ? '<span style="background:rgba(245,158,11,.15);color:#f59e0b;border:1px solid rgba(245,158,11,.3);border-radius:20px;padding:.15rem .6rem;font-size:.75rem;font-weight:800">' + pendingCount + ' pending review</span>' : '') +
 '</div>';
 var rows = apps.map(function(a) {
 var username = (a.userId && a.userId.username) ? a.userId.username : 'Unknown';
 var statusBg = { pending: 'rgba(245,158,11,.12)', approved: 'rgba(16,185,129,.1)', rejected: 'rgba(239,68,68,.08)' };
 var statusColor = { pending: '#f59e0b', approved: 'var(--green)', rejected: '#ef4444' };
 var bg = statusBg[a.status] || 'var(--surface)';
 var sc = statusColor[a.status] || 'var(--text-3)';
 var actions = '';
 if (a.status === 'pending') {
 actions = '<button onclick="sectionApproveApp(\'' + questId + '\',\'' + a._id + '\')" style="background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.35);color:var(--green);border-radius:8px;padding:.35rem 1rem;font-size:.8rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif;margin-right:.5rem"><i class="fas fa-check"></i> Approve</button>' +
 '<button onclick="sectionRejectApp(\'' + questId + '\',\'' + a._id + '\')" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#ef4444;border-radius:8px;padding:.35rem 1rem;font-size:.8rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-times"></i> Reject</button>';
 } else {
 actions = '<span style="font-size:.8rem;font-weight:800;color:' + sc + ';text-transform:capitalize">' + a.status + '</span>';
 }
 return '<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;padding:1rem 1.25rem;border-radius:10px;background:' + bg + ';border:1px solid var(--border);margin-bottom:.625rem">' +
 '<div style="display:flex;align-items:center;gap:.875rem">' +
 '<div style="width:38px;height:38px;border-radius:50%;background:rgba(16,185,129,.15);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1rem;color:var(--green)">' + username.charAt(0).toUpperCase() + '</div>' +
 '<div>' +
 '<div style="font-weight:700;font-size:.9375rem">@' + username + '</div>' +
 '<div style="font-size:.75rem;color:var(--text-3);margin-top:.1rem">' +
 (a.xHandle ? '<i class="fa-brands fa-x-twitter"></i> @' + a.xHandle + '&nbsp;&nbsp;' : '') +
 (a.telegramUsername ? '<i class="fab fa-telegram"></i> @' + a.telegramUsername : '') +
 '</div>' +
 '<div style="font-size:.7rem;color:var(--text-3);margin-top:.15rem">Applied ' + new Date(a.createdAt).toLocaleDateString() + '</div>' +
 '</div>' +
 '</div>' +
 '<div>' + actions + '</div>' +
 '</div>';
 }).join('');
 wrap.innerHTML = header + rows;
 })
 .catch(function() {
 wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:#ef4444;font-size:.875rem">Error loading applications.</div>';
 });
}

function sectionApproveApp(questId, appId) {
 fetch('/business/api/quest/' + questId + '/applications/' + appId + '/approve', { method: 'POST' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) loadSectionApplications();
 else alert(d.message || 'Error');
 });
}

function sectionRejectApp(questId, appId) {
 var reason = prompt('Rejection reason (optional):') || '';
 fetch('/business/api/quest/' + questId + '/applications/' + appId + '/reject', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ reason: reason })
 })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) loadSectionApplications();
 else alert(d.message || 'Error');
 });
}
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
function toggleSidebar() {
 document.getElementById('pSidebar').classList.toggle('open');
 document.getElementById('pOverlay').classList.toggle('active');
}
function closeSidebar() {
 document.getElementById('pSidebar').classList.remove('open');
 document.getElementById('pOverlay').classList.remove('active');
}
document.querySelectorAll('.p-modal-overlay').forEach(o => {
 o.addEventListener('click', function(e) { if (e.target === this) closeModal(this.id); });
});

// ── Wallet lookup ─────────────────────────────────────────────────────────────
var currentWalletAddr = '';
function lookupWallet() {
 var token = document.getElementById('fundToken').value;
 var network = document.getElementById('fundNetwork').value;
 if (!token || !network) return;
 fetch('/business/api/wallet-address?token=' + token + '&network=' + network)
 .then(r => r.json())
 .then(d => {
 if (d.found) {
 currentWalletAddr = d.address;
 document.getElementById('walletAddr').textContent = d.address;
 document.getElementById('walletLabel').textContent = d.label || (token + ' · ' + network.toUpperCase());
 document.getElementById('walletAddressId').value = d.id;
 document.getElementById('walletDisplay').style.display = '';
 document.getElementById('walletNotFound').style.display = 'none';
 } else {
 document.getElementById('walletDisplay').style.display = 'none';
 document.getElementById('walletNotFound').style.display = '';
 }
 });
}
function copyWallet() {
 if (!currentWalletAddr) return;
 navigator.clipboard.writeText(currentWalletAddr).then(() => {
 var btn = document.getElementById('copyBtn');
 btn.innerHTML = '<i class="fas fa-check"></i>';
 setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i>', 1500);
 });
}

// ── Screenshot preview ────────────────────────────────────────────────────────
function previewScreenshot(input) {
 if (input.files && input.files[0]) {
 var reader = new FileReader();
 reader.onload = function(e) {
 document.getElementById('previewImg').src = e.target.result;
 document.getElementById('screenshotPreview').style.display = '';
 document.getElementById('dropZone').style.borderColor = 'var(--green)';
 };
 reader.readAsDataURL(input.files[0]);
 }
}

// ── Commission previews ───────────────────────────────────────────────────────
var debounceQ, debounceB;
function updateQuestPreview() {
 clearTimeout(debounceQ);
 debounceQ = setTimeout(function() {
 var amt = parseFloat(document.getElementById('questBudgetInput').value);
 if (!amt || amt <= 0) { document.getElementById('questCommissionPreview').style.display='none'; return; }
 fetch('/business/api/commission-preview?amount=' + amt)
 .then(r => r.json()).then(d => {
 document.getElementById('questCommissionPreview').style.display = '';
 document.getElementById('qBdRate').textContent = d.bdRate;
 document.getElementById('qPlatRate').textContent = d.platRate;
 document.getElementById('qBdAmt').textContent = '$' + d.bdAmt.toFixed(2);
 document.getElementById('qPlatAmt').textContent = '$' + d.platAmt.toFixed(2);
 document.getElementById('qPoolAmt').textContent = '$' + d.poolAmt.toFixed(2);
 calcBizRewardPlan(); updateBizRankPreview();
 });
 }, 400);
}
function updateBountyPreview() {
 clearTimeout(debounceB);
 debounceB = setTimeout(function() {
 var amt = parseFloat(document.getElementById('bountyBudgetInput').value);
 if (!amt || amt <= 0) { document.getElementById('bountyCommissionPreview').style.display='none'; return; }
 fetch('/business/api/commission-preview?amount=' + amt)
 .then(r => r.json()).then(d => {
 document.getElementById('bountyCommissionPreview').style.display = '';
 document.getElementById('bBdRate').textContent = d.bdRate;
 document.getElementById('bPlatRate').textContent = d.platRate;
 document.getElementById('bBdAmt').textContent = '$' + d.bdAmt.toFixed(2);
 document.getElementById('bPlatAmt').textContent = '$' + d.platAmt.toFixed(2);
 document.getElementById('bPoolAmt').textContent = '$' + d.poolAmt.toFixed(2);
 });
 }, 400);
}

// ── Reward plan calculator ────────────────────────────────────────────────────
function getBizPool(){var text=document.getElementById('qPoolAmt')?.textContent||'0';return parseFloat(text.replace('$',''))||0;}
function renderBizRankFields(){var countInput=document.getElementById('bizTopWinners'),holder=document.getElementById('bizRankFields');if(!countInput||!holder)return;var count=Math.max(1,Math.min(100,parseInt(countInput.value,10)||1));countInput.value=count;var old=Array.from(holder.querySelectorAll('.biz-rank-percent')).map(function(i){return parseFloat(i.value)||0;});var vals=old.length===count?old:(count===1?[100]:count===2?[50,50]:[50,10].concat(Array(count-2).fill(Math.floor(4000/(count-2))/100)));if(old.length!==count&&count>2) vals[count-1]=Number((100-vals.slice(0,count-1).reduce((a,b)=>a+b,0)).toFixed(2));holder.innerHTML='';for(var i=0;i<count;i++){var label=document.createElement('label');label.style.cssText='font-size:.8rem;color:var(--text-2)';label.textContent='Place '+(i+1)+' (%)';var input=document.createElement('input');input.type='number';input.min='0';input.max='100';input.step='.01';input.value=Number(vals[i]).toFixed(2);input.className='p-input biz-rank-percent';input.style.cssText='display:block;width:100%;margin-top:.3rem';input.oninput=updateBizRankPreview;label.appendChild(input);holder.appendChild(label);}updateBizRankPreview();}
function updateBizRankPreview(){var pool=getBizPool(),holder=document.getElementById('bizRankFields'),summary=document.getElementById('bizRankSummary'),hidden=document.getElementById('bizRankPercentages');if(!holder||!summary||!hidden)return;var vals=Array.from(holder.querySelectorAll('.biz-rank-percent')).map(function(i){return parseFloat(i.value)||0;}),total=vals.reduce((a,b)=>a+b,0);hidden.value=JSON.stringify(vals);summary.style.display='';summary.innerHTML=vals.map(function(p,i){return 'Place '+(i+1)+': <strong>$'+(pool*p/100).toFixed(2)+'</strong> ('+p.toFixed(2)+'%)';}).join(' &nbsp;|&nbsp; ')+'<br><span style="color:'+(Math.abs(total-100)<.011?'var(--green)':'var(--red)')+'">Total '+total.toFixed(2)+'%'+(Math.abs(total-100)<.011?'':' - must equal 100%')+'</span>'; }
function calcBizRewardPlan(){var perPerson=parseFloat(document.getElementById('bizRewardPerPerson').value)||0,preview=document.getElementById('bizRewardPreview'),pool=getBizPool();if(pool<=0||perPerson<=0){preview.style.display='none';return;}var winners=Math.floor(pool/perPerson);document.getElementById('bizMaxWinners').value=winners;preview.style.display='';preview.innerHTML='<strong style="color:var(--green)">$'+pool.toFixed(2)+'</strong> pool / <strong style="color:var(--green)">$'+perPerson.toFixed(2)+'</strong> per person - <strong style="color:var(--green)">'+winners+' recipients</strong>'; }

function onQuestTypeChange(type) {
 document.getElementById('fcfsConfig').style.display = type === 'fcfs' ? '' : 'none';
 document.getElementById('competitionConfig').style.display = '';
 document.getElementById('bizRankFields').style.display = 'grid';
 document.getElementById('bizRankSummary').style.display = '';
 document.getElementById('bizEqualRewardFields').style.display = 'none';
 renderBizRankFields();
 document.getElementById('referralConfig').style.display = type === 'referral_boost' ? '' : 'none';
}
renderBizRankFields();
function toggleBatchFields() {
 var chk = document.getElementById('batchEnabledChk');
 var fields = document.getElementById('batchFields');
 fields.style.display = chk.checked ? 'grid' : 'none';
}

// ── Quest task builder ────────────────────────────────────────────────────────
var questTaskCount = 0;
var taskExtraFields = {
 discord_join: '<input class="p-input" placeholder="Discord Guild ID" data-task-field="discordGuildId" style="font-size:.8125rem;margin-top:.5rem;display:block;width:100%;box-sizing:border-box"><input class="p-input" placeholder="Discord Server Name" data-task-field="discordGuildName" style="font-size:.8125rem;margin-top:.5rem;display:block;width:100%;box-sizing:border-box">',
 telegram_join: '<input class="p-input" placeholder="Telegram Chat ID (e.g. -100123456)" data-task-field="telegramChatId" style="font-size:.8125rem;margin-top:.5rem;display:block;width:100%;box-sizing:border-box"><input class="p-input" placeholder="Telegram Group/Channel Name" data-task-field="telegramChatName" style="font-size:.8125rem;margin-top:.5rem;display:block;width:100%;box-sizing:border-box">',
 webhook: '<input class="p-input" placeholder="Webhook Verification URL" data-task-field="webhookUrl" style="font-size:.8125rem;margin-top:.5rem;display:block;width:100%;box-sizing:border-box">'
};

function addQuestTask() {
 questTaskCount++;
 var idx = questTaskCount;
 var html = '<div class="quest-task-row" id="qtask-' + idx + '" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.875rem">' +
 '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.625rem">' +
 '<span style="font-size:.8rem;font-weight:700;color:var(--text-2)">Task #' + idx + '</span>' +
 '<button type="button" onclick="removeQuestTask(this)" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:.9rem"><i class="fas fa-trash"></i></button>' +
 '</div>' +
 '<div style="display:grid;grid-template-columns:1fr 1fr;gap:.625rem;margin-bottom:.5rem">' +
 '<input class="p-input" placeholder="Task title *" data-task-field="title" style="font-size:.8125rem">' +
 '<select class="p-input" data-task-field="taskType" style="font-size:.8125rem" onchange="onTaskTypeChange(this)">' +
 '<option value="external">External Link</option>' +
 '<option value="social">Social Action</option>' +
 '<option value="submission">Text Submission</option>' +
 '<option value="verification">Verification</option>' +
 '<option value="discord_join">Join Discord</option>' +
 '<option value="telegram_join">Join Telegram</option>' +
 '<option value="webhook">Webhook Verify</option>' +
 '</select>' +
 '</div>' +
 '<input class="p-input" placeholder="Task description" data-task-field="description" style="font-size:.8125rem;margin-bottom:.5rem;display:block;width:100%;box-sizing:border-box">' +
 '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:.625rem">' +
 '<input class="p-input" type="number" min="0" placeholder="XP reward" data-task-field="xpReward" style="font-size:.8125rem">' +
 '<input class="p-input" placeholder="Button text" data-task-field="buttonText" style="font-size:.8125rem">' +
 '<input class="p-input" placeholder="Button link (URL)" data-task-field="buttonLink" style="font-size:.8125rem">' +
 '</div>' +
 '<div class="task-extra-fields"></div>' +
 '</div>';
 var list = document.getElementById('questTasksList');
 list.insertAdjacentHTML('beforeend', html);
 document.getElementById('questNoTasks').style.display = 'none';
}

function onTaskTypeChange(sel) {
 var row = sel.closest('.quest-task-row');
 var extra = row.querySelector('.task-extra-fields');
 extra.innerHTML = taskExtraFields[sel.value] || '';
}

function removeQuestTask(btn) {
 btn.closest('.quest-task-row').remove();
 if (!document.querySelector('.quest-task-row')) document.getElementById('questNoTasks').style.display = '';
}

function prepareQuestSubmit() {
 var rows = document.querySelectorAll('.quest-task-row');
 var tasks = [];
 rows.forEach(function(row) {
 var get = function(f) { var el = row.querySelector('[data-task-field="' + f + '"]'); return el ? el.value : ''; };
 tasks.push({
 title: get('title') || 'Task',
 description: get('description') || '',
 taskType: get('taskType') || 'external',
 xpReward: parseInt(get('xpReward')) || 0,
 buttonText: get('buttonText') || 'Complete',
 buttonLink: get('buttonLink') || '',
 discordGuildId: get('discordGuildId') || '',
 discordGuildName: get('discordGuildName') || '',
 telegramChatId: get('telegramChatId') || '',
 telegramChatName: get('telegramChatName') || '',
 webhookUrl: get('webhookUrl') || ''
 });
 });
 document.getElementById('tasksJsonInput').value = JSON.stringify(tasks);
 if (document.getElementById('questTypeSelect').value === 'competition') {
  var shares = JSON.parse(document.getElementById('bizRankPercentages').value || '[]');
  var total = shares.reduce(function(sum, value) { return sum + value; }, 0);
  if (shares.length !== parseInt(document.getElementById('bizTopWinners').value, 10) || Math.abs(total - 100) > 0.01) { alert('Winner percentages must add up to 100%.'); return false; }
 }
 return true;
}

// ── Bounty split builder ──────────────────────────────────────────────────────
var splitRowCount = 0;
var splitDefaultLabels = ['1st Place', '2nd Place', '3rd Place', '4th Place', '5th Place'];
function initDefaultSplit() {
 addSplitRow(50, '1st Place');
 addSplitRow(30, '2nd Place');
 addSplitRow(20, '3rd Place');
}
function addSplitRow(pct, lbl) {
 splitRowCount++;
 var idx = splitRowCount;
 var defPct = pct !== undefined ? pct : 0;
 var defLbl = lbl || (splitDefaultLabels[idx - 1] || ('#' + idx + ' Place'));
 var html = '<div class="split-row" id="splitrow-' + idx + '" style="display:grid;grid-template-columns:1fr 90px auto;gap:.5rem;align-items:center">' +
 '<input class="p-input" value="' + defLbl + '" data-split-field="label" style="font-size:.8125rem" oninput="updateSplitTotal()">' +
 '<div style="position:relative">' +
 '<input class="p-input" type="number" min="0" max="100" step="0.1" value="' + defPct + '" data-split-field="percentage" style="font-size:.8125rem;padding-right:1.75rem" oninput="updateSplitTotal()">' +
 '<span style="position:absolute;right:.5rem;top:50%;transform:translateY(-50%);font-size:.75rem;color:var(--text-3);pointer-events:none">%</span>' +
 '</div>' +
 '<button type="button" onclick="removeSplitRow(this)" style="background:none;border:none;color:var(--text-3);cursor:pointer;padding:.25rem .5rem;font-size:.875rem"><i class="fas fa-trash"></i></button>' +
 '</div>';
 document.getElementById('bountySplitList').insertAdjacentHTML('beforeend', html);
 updateSplitTotal();
}
function removeSplitRow(btn) {
 btn.closest('.split-row').remove();
 updateSplitTotal();
}
function updateSplitTotal() {
 var total = 0;
 document.querySelectorAll('[data-split-field="percentage"]').forEach(function(inp) { total += parseFloat(inp.value) || 0; });
 var el = document.getElementById('splitTotal');
 if (el) {
 el.textContent = 'Total: ' + total.toFixed(1) + '%';
 el.style.color = Math.abs(total - 100) < 0.1 ? 'var(--green)' : 'var(--amber)';
 }
}
function prepareBountySubmit() {
 var rows = document.querySelectorAll('.split-row');
 var split = [];
 rows.forEach(function(row) {
 split.push({
 label: row.querySelector('[data-split-field="label"]').value || 'Place',
 percentage: parseFloat(row.querySelector('[data-split-field="percentage"]').value) || 0
 });
 });
 if (!split.length) split = [{label:'1st Place',percentage:50},{label:'2nd Place',percentage:30},{label:'3rd Place',percentage:20}];
 document.getElementById('splitJsonInput').value = JSON.stringify(split);
 return true;
}
initDefaultSplit();

// ── Quest Manager ─────────────────────────────────────────────────────────────
var currentQuestId = null;
var currentQuestType = null;

function switchQMTab(tab) {
 document.getElementById('qmPane-leaderboard').style.display = tab === 'leaderboard' ? '' : 'none';
 document.getElementById('qmPane-tasks').style.display = tab === 'tasks' ? '' : 'none';
 document.getElementById('qmPane-applications').style.display = tab === 'applications' ? '' : 'none';
 var tabs = ['leaderboard','tasks','applications'];
 tabs.forEach(function(t) {
 var btn = document.getElementById('qmTab-' + t);
 if (btn) {
 btn.style.color = t === tab ? 'var(--green)' : 'var(--text-3)';
 btn.style.borderColor = t === tab ? 'var(--green)' : 'transparent';
 }
 });
 if (tab === 'tasks') loadBizTaskList(currentQuestId, currentQuestType);
 if (tab === 'applications') loadQuestApplications(currentQuestId);
}

function openApplications(questId, questTitle) {
 currentQuestId = questId;
 document.getElementById('qmTitle').innerHTML = '<i class="fas fa-user-check" style="color:var(--green)"></i> ' + questTitle;
 openModal('questManagerModal');
 switchQMTab('applications');
}

function loadQuestApplications(questId) {
 if (!questId) return;
 var wrap = document.getElementById('qmApplicationsWrap');
 var status = document.getElementById('qmAppFilter') ? document.getElementById('qmAppFilter').value : '';
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
 fetch('/business/api/quest/' + questId + '/applications' + (status ? '?status=' + status : ''))
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (!d.success) { wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--red);font-size:.8rem">Failed to load applications.</div>'; return; }
 var apps = d.applications;
 if (!apps || !apps.length) {
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem">No applications found.</div>';
 return;
 }
 var statusColors = { pending: 'var(--amber)', approved: 'var(--green)', rejected: '#ef4444' };
 var rows = apps.map(function(a) {
 var username = (a.userId && a.userId.username) ? '@' + a.userId.username : 'Unknown';
 var sc = statusColors[a.status] || 'var(--text-3)';
 var actions = '';
 if (a.status === 'pending') {
 actions = '<button onclick="bizApproveApp(\'' + questId + '\',\'' + a._id + '\')" style="background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.3);color:var(--green);border-radius:20px;padding:.2rem .6rem;font-size:.68rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif;margin-right:.35rem"><i class="fas fa-check"></i> Approve</button>' +
 '<button onclick="bizRejectApp(\'' + questId + '\',\'' + a._id + '\')" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#ef4444;border-radius:20px;padding:.2rem .6rem;font-size:.68rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-times"></i> Reject</button>';
 } else {
 actions = '<span style="font-size:.72rem;color:' + sc + ';font-weight:700;text-transform:capitalize">' + a.status + '</span>';
 }
 return '<tr>' +
 '<td style="padding:.5rem .75rem;font-weight:600;font-size:.875rem">' + username + '</td>' +
 '<td style="padding:.5rem .375rem;font-size:.8rem;color:var(--text-3)">' + (a.xHandle ? '@' + a.xHandle : '—') + '</td>' +
 '<td style="padding:.5rem .375rem;font-size:.8rem;color:var(--text-3)">' + (a.telegramUsername ? '@' + a.telegramUsername : '—') + '</td>' +
 '<td style="padding:.5rem .375rem;font-size:.75rem;color:var(--text-3)">' + new Date(a.createdAt).toLocaleDateString() + '</td>' +
 '<td style="padding:.5rem .75rem">' + actions + '</td>' +
 '</tr>';
 }).join('');
 wrap.innerHTML = '<table style="width:100%;border-collapse:collapse;min-width:460px">' +
 '<thead><tr style="background:var(--surface)">' +
 '<th style="font-size:.68rem;color:var(--text-3);padding:.5rem .75rem;text-align:left">User</th>' +
 '<th style="font-size:.68rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">X Handle</th>' +
 '<th style="font-size:.68rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">Telegram</th>' +
 '<th style="font-size:.68rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">Applied</th>' +
 '<th style="font-size:.68rem;color:var(--text-3);padding:.5rem .75rem;text-align:left">Action</th>' +
 '</tr></thead><tbody>' + rows + '</tbody></table>';
 })
 .catch(function() {
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--red);font-size:.8rem">Failed to load applications.</div>';
 });
}

function bizApproveApp(questId, appId) {
 fetch('/business/api/quest/' + questId + '/applications/' + appId + '/approve', { method: 'POST' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) loadQuestApplications(questId);
 else alert(d.message || 'Error approving application.');
 });
}

function bizRejectApp(questId, appId) {
 var reason = prompt('Rejection reason (optional):') || '';
 fetch('/business/api/quest/' + questId + '/applications/' + appId + '/reject', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ reason: reason })
 })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) loadQuestApplications(questId);
 else alert(d.message || 'Error rejecting application.');
 });
}

function openQuestManager(questId, questTitle) {
 currentQuestId = questId;
 currentQuestType = null;
 document.getElementById('qmTitle').innerHTML = '<i class="fas fa-sliders" style="color:var(--green)"></i> ' + questTitle;
 document.getElementById('qmParticipants').textContent = '—';
 document.getElementById('qmCompletions').textContent = '—';
 document.getElementById('qmRate').textContent = '—';
 document.getElementById('qmPool').textContent = '—';
 document.getElementById('awardMsg').style.display = 'none';
 document.getElementById('disburseMsg').style.display = 'none';
 document.getElementById('disburseSection').style.display = 'none';
 document.getElementById('distributedBadge').style.display = 'none';
 document.getElementById('tgLinkMsg').style.display = 'none';
 document.getElementById('tgLinkInput').value = '';
 var si = document.getElementById('entrySearchInput');
 if (si) si.value = '';
 var cb = document.getElementById('entryCountBadge');
 if (cb) cb.textContent = '';
 document.getElementById('qmEntriesWrap').innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem">Click Refresh to load entries</div>';
 document.getElementById('qmLeaderboard').innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
 document.getElementById('qmApplicationsWrap').innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem">Click Refresh to load applications</div>';
 switchQMTab('leaderboard');
 openModal('questManagerModal');
 loadQuestStats(questId);
}

function loadQuestStats(questId) {
 fetch('/business/api/quest/' + questId + '/stats')
 .then(r => r.json())
 .then(d => {
 if (!d.success) return;
 var s = d.stats;
 currentQuestType = s.questType || null;
 document.getElementById('qmParticipants').textContent = s.totalParticipants;
 document.getElementById('qmCompletions').textContent = s.totalCompletions;
 document.getElementById('qmRate').textContent = s.completionRate + '%';
 document.getElementById('qmPool').textContent = '$' + (s.rewardPool||0).toFixed(2);

 if (s.rewardsDistributed) {
 document.getElementById('distributedBadge').style.display = '';
 } else if (s.hasEnded) {
 document.getElementById('disburseSection').style.display = '';
 }
 // Pre-fill Telegram link input
 var tgInput = document.getElementById('tgLinkInput');
 if (tgInput) tgInput.value = s.telegramGroupLink || '';

 var lb = d.leaderboard;
 if (!lb || !lb.length) {
 document.getElementById('qmLeaderboard').innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem">No participants yet.</div>';
 return;
 }
 var medals = ['#1','#2','#3'];
 var rows = lb.map(function(p) {
 var medal = medals[p.rank - 1] || ('#' + p.rank);
 var statusColor = p.status === 'completed' ? 'var(--green)' : p.status === 'abandoned' ? 'var(--text-3)' : 'var(--text-3)';
 var removeBtn = p.status === 'abandoned'
 ? '<span style="font-size:.65rem;color:var(--text-3)">Removed</span>'
 : '<button onclick="bizRemoveEntry(' + JSON.stringify(currentQuestId) + ',' + JSON.stringify(String(p.progressId)) + ')" style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:#ef4444;border-radius:20px;padding:.15rem .5rem;font-size:.65rem;font-weight:700;cursor:pointer;font-family:Outfit,sans-serif"><i class="fas fa-user-minus"></i> Remove</button>';
 return '<tr>' +
 '<td style="font-size:.8rem;color:var(--text-2);padding:.5rem .75rem">' + medal + '</td>' +
 '<td style="font-weight:600;font-size:.875rem;padding:.5rem .375rem">@' + p.username + '</td>' +
 '<td style="color:var(--green);font-weight:700;font-size:.875rem;padding:.5rem .375rem">' + (p.xp||0) + ' XP</td>' +
 '<td style="color:' + statusColor + ';font-size:.75rem;padding:.5rem .375rem;text-transform:capitalize">' + p.status + '</td>' +
 '<td style="color:var(--text-3);font-size:.75rem;padding:.5rem .375rem">' + (p.usdcEarned > 0 ? '$'+p.usdcEarned.toFixed(2) : '—') + '</td>' +
 '<td style="padding:.5rem .75rem">' + removeBtn + '</td>' +
 '</tr>';
 }).join('');
 document.getElementById('qmLeaderboard').innerHTML =
 '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;min-width:360px">' +
 '<thead><tr style="background:var(--surface-2,#111)">' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .75rem;text-align:left">Rank</th>' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">User</th>' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">XP</th>' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">Status</th>' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .375rem;text-align:left">USDC</th>' +
 '<th style="font-size:.7rem;color:var(--text-3);padding:.5rem .75rem;text-align:left">Action</th>' +
 '</tr></thead><tbody>' + rows + '</tbody></table></div>';
 })
 .catch(function() {
 document.getElementById('qmLeaderboard').innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--red);font-size:.8rem">Failed to load data.</div>';
 });
}

var _bizAllEntries = [];
var _bizEntriesQuestId = null;

function renderEntryCards(entries, questId) {
 var wrap = document.getElementById('qmEntriesWrap');
 var cb = document.getElementById('entryCountBadge');
 if (!entries.length) {
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem">No entries found.</div>';
 if (cb) cb.textContent = '';
 return;
 }
 if (cb) cb.textContent = entries.length + ' / ' + _bizAllEntries.length;
 var cards = entries.map(function(e, i) {
 var tasks = e.taskProgress || [];
 var pendingTasks = tasks.filter(function(t) { return t.approvalStatus === 'pending'; });
 var reviewBtns = pendingTasks.map(function(t) {
 return '<div style="display:flex;align-items:center;gap:.5rem;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:8px;padding:.375rem .625rem;margin:.25rem 0">' +
 '<span style="font-size:.72rem;color:#f59e0b;font-weight:700;flex:1"><i class="fas fa-clock"></i> Pending review</span>' +
 '<button onclick="bizReviewTask(\'' + questId + '\',\'' + e._id + '\',\'' + t.taskId + '\',\'approve\')" style="background:rgba(94,194,19,.15);border:1px solid rgba(94,194,19,.3);color:#5ec213;border-radius:6px;padding:.2rem .5rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-check"></i> Approve</button>' +
 '<button onclick="bizReviewTask(\'' + questId + '\',\'' + e._id + '\',\'' + t.taskId + '\',\'reject\')" style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);color:#ef4444;border-radius:6px;padding:.2rem .5rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-times"></i> Reject</button>' +
 '</div>';
 }).join('');
 var subItems = tasks.filter(function(t) {
 return t.submissionUrl || t.submissionText || (t.submissionData && Object.keys(t.submissionData).length);
 }).map(function(t) {
 if (t.submissionUrl) return '<a href="' + t.submissionUrl + '" target="_blank" style="display:block;color:#60a5fa;font-size:.75rem;word-break:break-all;margin:.1rem 0">' + t.submissionUrl + '</a>';
 if (t.submissionText) return '<span style="display:block;font-size:.75rem;color:var(--text-2);word-break:break-all;margin:.1rem 0">' + String(t.submissionText) + '</span>';
 if (t.submissionData && typeof t.submissionData === 'object') {
 return Object.values(t.submissionData).filter(function(v){ return v; }).map(function(v) {
 var sv = String(v).trim();
 if (/^https?:\/\//.test(sv)) return '<a href="' + sv + '" target="_blank" style="display:block;color:#60a5fa;font-size:.75rem;word-break:break-all;margin:.1rem 0">' + sv + '</a>';
 return '<span style="display:block;font-size:.75rem;color:var(--text-2);word-break:break-all;margin:.1rem 0">' + sv + '</span>';
 }).join('');
 }
 return '';
 }).join('');
 var username = (e.userId && e.userId.username) ? '@' + e.userId.username : 'Unknown';
 var xp = (e.xpBreakdown && e.xpBreakdown.totalXp) ? e.xpBreakdown.totalXp : 0;
 var statusColor = e.status === 'completed' ? 'var(--green)' : e.status === 'not_started' ? 'var(--text-3)' : e.status === 'abandoned' ? '#6b7280' : '#f59e0b';
 return '<div style="padding:.75rem 1rem;border-bottom:1px solid var(--border)">' +
 '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.375rem">' +
 '<div style="display:flex;align-items:center;gap:.5rem">' +
 '<span style="font-size:.72rem;color:var(--text-3);min-width:1.5rem">#' + (i+1) + '</span>' +
 '<span style="font-weight:700;font-size:.875rem">' + username + '</span>' +
 '</div>' +
 '<div style="display:flex;align-items:center;gap:.5rem">' +
 '<span style="color:var(--green);font-weight:800;font-size:.8rem">' + xp + ' XP</span>' +
 '<span style="font-size:.68rem;color:' + statusColor + ';text-transform:capitalize;background:rgba(255,255,255,.05);border-radius:20px;padding:.1rem .45rem">' + (e.status||'—') + '</span>' +
 '</div>' +
 '</div>' +
 (subItems ? '<div style="margin:.375rem 0;padding:.375rem .5rem;background:var(--surface);border-radius:6px;border-left:2px solid rgba(96,165,250,.4)">' + subItems + '</div>' : '') +
 (reviewBtns ? '<div style="margin-top:.375rem">' + reviewBtns + '</div>' : '') +
 '<div style="margin-top:.5rem;display:flex;gap:.4rem;flex-wrap:wrap">' +
 '<button onclick="bizFlagEntry(\'' + questId + '\',\'' + e._id + '\')" style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:#ef4444;border-radius:20px;padding:.25rem .75rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-flag"></i> Flag -50XP</button>' +
 (e.status !== 'abandoned' ? '<button onclick="bizRemoveEntry(\'' + questId + '\',\'' + e._id + '\')" style="background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.4);color:#ef4444;border-radius:20px;padding:.25rem .75rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:\'Outfit\',sans-serif"><i class="fas fa-user-minus"></i> Remove from Quest</button>' : '<span style="font-size:.7rem;color:var(--text-3);padding:.25rem .5rem;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid var(--border)"><i class="fas fa-ban"></i> Removed</span>') +
 '</div>' +
 '</div>';
 }).join('');
 wrap.innerHTML = '<div>' + cards + '</div>';
}

function filterEntries(query) {
 if (!_bizAllEntries.length) return;
 var q = (query || '').toLowerCase().trim();
 var filtered = q ? _bizAllEntries.filter(function(e) {
 return ((e.userId && e.userId.username) || '').toLowerCase().includes(q);
 }) : _bizAllEntries;
 renderEntryCards(filtered, _bizEntriesQuestId);
}

function loadQuestEntries(questId) {
 _bizEntriesQuestId = questId;
 _bizAllEntries = [];
 var si = document.getElementById('entrySearchInput');
 if (si) si.value = '';
 var cb = document.getElementById('entryCountBadge');
 if (cb) cb.textContent = '';
 var wrap = document.getElementById('qmEntriesWrap');
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--text-3);font-size:.8rem"><i class="fas fa-spinner fa-spin"></i> Loading entries...</div>';
 fetch('/business/api/quest/' + questId + '/entries')
 .then(r => r.json())
 .then(d => {
 if (!d.success) { wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--red);font-size:.8rem">Failed to load entries.</div>'; return; }
 _bizAllEntries = d.entries || [];
 var cb = document.getElementById('entryCountBadge');
 if (cb) cb.textContent = _bizAllEntries.length + ' total';
 renderEntryCards(_bizAllEntries, questId);
 })
 .catch(function() {
 wrap.innerHTML = '<div style="text-align:center;padding:1.5rem;color:var(--red);font-size:.8rem">Failed to load entries.</div>';
 });
}

function bizFlagEntry(questId, progressId) {
 if (!confirm('Flag this entry and remove 50 XP? This cannot be undone.')) return;
 fetch('/business/api/quest/' + questId + '/entries/' + progressId + '/flag', { method: 'POST' })
 .then(r => r.json())
 .then(d => {
 if (d.success) { alert('Entry flagged.'); loadQuestEntries(questId); }
 else alert(d.message || 'Error flagging entry.');
 });
}

function bizRemoveEntry(questId, progressId) {
 if (!confirm('Remove this participant from the leaderboard?\n\nTheir quest XP will be fully deducted. This cannot be undone.')) return;
 fetch('/business/api/quest/' + questId + '/entries/' + progressId + '/remove', { method: 'POST' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) { alert(d.message || 'Participant removed from leaderboard.'); loadQuestEntries(questId); loadQuestStats(questId); }
 else alert(d.message || 'Error removing participant.');
 })
 .catch(function() { alert('Network error. Please try again.'); });
}

function saveTelegramLink() {
 var link = (document.getElementById('tgLinkInput').value || '').trim();
 var msgEl = document.getElementById('tgLinkMsg');
 if (link && !link.startsWith('https://t.me/')) {
 msgEl.style.display = '';
 msgEl.style.background = 'rgba(239,68,68,.1)';
 msgEl.style.color = '#ef4444';
 msgEl.textContent = 'Link must start with https://t.me/';
 return;
 }
 fetch('/business/api/quest/' + currentQuestId + '/telegram-link', {
 method: 'PATCH',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ link: link || null })
 })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 msgEl.style.display = '';
 if (d.success) {
 msgEl.style.background = 'rgba(94,194,19,.1)';
 msgEl.style.color = 'var(--green)';
 msgEl.textContent = link ? 'Group link saved! Participants will now see a Join Community button.' : 'Link removed.';
 } else {
 msgEl.style.background = 'rgba(239,68,68,.1)';
 msgEl.style.color = '#ef4444';
 msgEl.textContent = d.message || 'Error saving link.';
 }
 setTimeout(function() { msgEl.style.display = 'none'; }, 4000);
 });
}

function clearTelegramLink() {
 document.getElementById('tgLinkInput').value = '';
 saveTelegramLink();
}

function bizReviewTask(questId, progressId, taskId, action) {
 fetch('/business/api/quest/' + questId + '/review/' + progressId, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ action: action, taskId: taskId })
 })
 .then(r => r.json())
 .then(d => {
 if (d.success) { loadQuestEntries(questId); loadQuestStats(questId); }
 else alert(d.message || 'Error reviewing task.');
 });
}

function loadBizTaskList(questId, questType) {
 var wrap = document.getElementById('qmTaskListBiz');
 var addSection = document.getElementById('qmAddTaskSection');
 if (addSection) addSection.style.display = questType === 'competition' ? '' : 'none';
 if (!questId) return;
 fetch('/business/api/quest/' + questId + '/stats')
 .then(r => r.json())
 .then(d => {
 if (!d.success) return;
 currentQuestType = d.stats.questType;
 if (addSection) addSection.style.display = d.stats.questType === 'competition' ? '' : 'none';
 });
 // Load entries to get task info
 fetch('/business/api/quest/' + questId + '/entries')
 .then(r => r.json())
 .then(d => {
 if (!d.success || !d.quest) { wrap.innerHTML = '<div style="color:var(--text-3);font-size:.85rem;padding:.75rem 0">No task data available.</div>'; return; }
 var tasks = d.quest.tasks || [];
 if (!tasks.length) { wrap.innerHTML = '<div style="color:var(--text-3);font-size:.85rem;padding:.75rem 0">No tasks yet.</div>'; return; }
 _bizTaskCache = {};
 tasks.forEach(function(t) { _bizTaskCache[t._id] = t; });
 wrap.innerHTML = tasks.map(function(t, i) {
 return '<div style="display:flex;align-items:center;gap:.625rem;padding:.625rem .875rem;border-radius:10px;background:var(--surface);border:1px solid var(--border);margin-bottom:.5rem">' +
 '<div style="flex-shrink:0;width:26px;height:26px;border-radius:50%;background:rgba(16,185,129,.12);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:900">' + (i+1) + '</div>' +
 '<div style="flex:1;min-width:0">' +
 '<p style="font-size:.83rem;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + (t.title||'Task') + '</p>' +
 '<span style="font-size:.7rem;color:var(--text-3)">' + (t.taskType||'external') + '</span>' +
 '</div>' +
 '<span style="font-size:.75rem;font-weight:800;color:var(--green);margin-right:.25rem">' + (t.xpReward||0) + ' XP</span>' +
 '<button onclick="bizOpenEditTask(\'' + currentQuestId + '\',\'' + t._id + '\')" title="Edit task" style="background:none;border:none;color:var(--text-3);cursor:pointer;padding:.25rem .375rem;border-radius:6px;font-size:.8rem" onmouseover="this.style.color=\'var(--green)\'" onmouseout="this.style.color=\'var(--text-3)\'"><i class="fas fa-pen"></i></button>' +
 '<button onclick="bizDeleteTask(\'' + currentQuestId + '\',\'' + t._id + '\')" title="Delete task" style="background:none;border:none;color:var(--text-3);cursor:pointer;padding:.25rem .375rem;border-radius:6px;font-size:.8rem" onmouseover="this.style.color=\'#ef4444\'" onmouseout="this.style.color=\'var(--text-3)\'"><i class="fas fa-trash"></i></button>' +
 '</div>';
 }).join('');
 });
}

function submitBizAddTask() {
 if (!currentQuestId) return;
 var title = document.getElementById('nt_biz_title').value.trim();
 if (!title) { alert('Task title is required'); return; }
 var payload = {
 title: title,
 description: document.getElementById('nt_biz_desc').value.trim(),
 taskType: document.getElementById('nt_biz_type').value,
 xpReward: parseInt(document.getElementById('nt_biz_xp').value) || 0,
 buttonText: document.getElementById('nt_biz_btntext').value.trim() || 'Complete',
 buttonLink: document.getElementById('nt_biz_btnlink').value.trim(),
 inputType: document.getElementById('nt_biz_input_type').value,
 inputName: document.getElementById('nt_biz_input_name').value.trim(),
 inputLabel: document.getElementById('nt_biz_input_label').value.trim(),
 requiresApproval: document.getElementById('nt_biz_approval').value === '1'
 };
 fetch('/business/api/quest/' + currentQuestId + '/tasks', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(payload)
 })
 .then(r => r.json())
 .then(d => {
 var msg = document.getElementById('addTaskBizMsg');
 msg.textContent = d.success ? 'Task added!' : (d.message || 'Error adding task');
 msg.style.display = '';
 msg.style.background = d.success ? 'rgba(16,185,129,.15)' : 'rgba(239,68,68,.15)';
 msg.style.color = d.success ? 'var(--green)' : 'var(--red)';
 if (d.success) {
 document.getElementById('nt_biz_title').value = '';
 document.getElementById('nt_biz_desc').value = '';
 document.getElementById('nt_biz_xp').value = '0';
 loadBizTaskList(currentQuestId, currentQuestType);
 }
 setTimeout(function() { msg.style.display = 'none'; }, 3000);
 });
}

var _bizTaskCache = {};

function bizOpenEditTask(questId, taskId) {
 var t = _bizTaskCache[taskId];
 if (!t) { alert('Task data not loaded. Close and reopen the quest.'); return; }
 document.getElementById('et_task_id').value = taskId;
 document.getElementById('et_title').value = t.title || '';
 document.getElementById('et_type').value = t.taskType || 'external';
 document.getElementById('et_xp').value = t.xpReward || 0;
 document.getElementById('et_btntext').value = t.buttonText || '';
 document.getElementById('et_btnlink').value = t.buttonLink || '';
 document.getElementById('et_input_type').value = t.inputType || 'none';
 document.getElementById('et_input_name').value = t.inputName || '';
 document.getElementById('et_input_label').value = t.inputLabel || '';
 document.getElementById('et_desc').value = t.description || '';
 var msg = document.getElementById('editTaskMsg');
 msg.style.display = 'none';
 openModal('editTaskModal');
}

function bizSaveEditTask() {
 var taskId = document.getElementById('et_task_id').value;
 var title = document.getElementById('et_title').value.trim();
 if (!title) { alert('Task title is required'); return; }
 var payload = {
 title: title,
 description: document.getElementById('et_desc').value.trim(),
 taskType: document.getElementById('et_type').value,
 xpReward: parseInt(document.getElementById('et_xp').value) || 0,
 buttonText: document.getElementById('et_btntext').value.trim(),
 buttonLink: document.getElementById('et_btnlink').value.trim(),
 inputType: document.getElementById('et_input_type').value,
 inputName: document.getElementById('et_input_name').value.trim(),
 inputLabel: document.getElementById('et_input_label').value.trim()
 };
 fetch('/business/api/quest/' + currentQuestId + '/tasks/' + taskId, {
 method: 'PATCH',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(payload)
 })
 .then(r => r.json())
 .then(d => {
 var msg = document.getElementById('editTaskMsg');
 msg.textContent = d.success ? 'Task updated!' : (d.message || 'Error updating task');
 msg.style.display = '';
 msg.style.background = d.success ? 'rgba(16,185,129,.15)' : 'rgba(239,68,68,.15)';
 msg.style.color = d.success ? 'var(--green)' : 'var(--red)';
 if (d.success) {
 loadBizTaskList(currentQuestId, currentQuestType);
 setTimeout(function() { closeModal('editTaskModal'); }, 1000);
 }
 });
}

function bizDeleteTask(questId, taskId) {
 if (!confirm('Delete this task? This cannot be undone.')) return;
 fetch('/business/api/quest/' + questId + '/tasks/' + taskId, { method: 'DELETE' })
 .then(r => r.json())
 .then(d => {
 if (d.success) { loadBizTaskList(questId, currentQuestType); }
 else alert(d.message || 'Error deleting task');
 });
}

function awardXP() {
 if (!currentQuestId) return;
 var username = document.getElementById('awardUsername').value.replace('@','').trim();
 var xp = parseInt(document.getElementById('awardXP').value);
 if (!username || !xp || xp <= 0) { showAwardMsg('error','Enter a valid username and XP amount.'); return; }

 fetch('/business/api/quest/' + currentQuestId + '/award-xp', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ username: username, xpAmount: xp })
 })
 .then(r => r.json())
 .then(d => {
 showAwardMsg(d.success ? 'success' : 'error', d.message);
 if (d.success) {
 document.getElementById('awardUsername').value = '';
 document.getElementById('awardXP').value = '';
 loadQuestStats(currentQuestId);
 }
 });
}

function showAwardMsg(type, msg) {
 var el = document.getElementById('awardMsg');
 el.textContent = msg;
 el.style.display = '';
 el.style.background = type === 'success' ? 'rgba(16,185,129,.15)' : 'rgba(239,68,68,.15)';
 el.style.color = type === 'success' ? 'var(--green)' : 'var(--red)';
}

function disburseRewards() {
 if (!currentQuestId) return;
 if (!confirm('Distribute USDC rewards to all completers? This cannot be undone.')) return;

 fetch('/business/api/quest/' + currentQuestId + '/disburse', { method: 'POST' })
 .then(r => r.json())
 .then(d => {
 var el = document.getElementById('disburseMsg');
 el.textContent = d.message;
 el.style.display = '';
 el.style.background = d.success ? 'rgba(16,185,129,.15)' : 'rgba(239,68,68,.15)';
 el.style.color = d.success ? 'var(--green)' : 'var(--red)';
 if (d.success) {
 document.getElementById('disburseSection').style.display = 'none';
 document.getElementById('distributedBadge').style.display = '';
 loadQuestStats(currentQuestId);
 }
 });
}

// ── Analytics Charts ──────────────────────────────────────────────────────────
var chartsInitialized = false;
function initCharts() {
 if (chartsInitialized) return;
 chartsInitialized = true;

 var budgetCanvas = document.getElementById('budgetChart');
 if (budgetCanvas) {
 new Chart(budgetCanvas, {
 type: 'doughnut',
 data: {
 labels: ['Quests', 'Bounties'],
 datasets: [{
 data: [<%= quests.reduce((s,q)=>s+(q.usdcReward||0),0).toFixed(2) %>, <%= bounties.reduce((s,b)=>s+(b.rewardPool||0),0).toFixed(2) %>],
 backgroundColor: ['rgba(16,185,129,.8)', 'rgba(245,158,11,.8)'],
 borderColor: ['#10b981','#f59e0b'],
 borderWidth: 2
 }]
 },
 options: {
 responsive: true,
 maintainAspectRatio: false,
 plugins: { legend: { labels: { color: '#9ca3af', font: { family: 'Outfit' } } } }
 }
 });
 }

 var completionsCanvas = document.getElementById('questCompletionsChart');
 if (completionsCanvas) {
 var qLabels = <%- JSON.stringify(quests.slice(0,8).map(function(q){return q.title.length>18?q.title.slice(0,18)+'…':q.title;})) %>;
 var qData = <%- JSON.stringify(quests.slice(0,8).map(function(q){return q.totalCompletions||0;})) %>;
 new Chart(completionsCanvas, {
 type: 'bar',
 data: {
 labels: qLabels,
 datasets: [{
 label: 'Completions',
 data: qData,
 backgroundColor: 'rgba(16,185,129,.6)',
 borderColor: '#10b981',
 borderWidth: 1,
 borderRadius: 4
 }]
 },
 options: {
 responsive: true,
 maintainAspectRatio: false,
 plugins: { legend: { display: false } },
 scales: {
 x: { ticks: { color: '#6b7280', font: { family: 'Outfit', size: 10 } }, grid: { color: 'rgba(255,255,255,.05)' } },
 y: { ticks: { color: '#6b7280', font: { family: 'Outfit' } }, grid: { color: 'rgba(255,255,255,.05)' }, beginAtZero: true }
 }
 }
 });
 }
}

// ── Query string handling ─────────────────────────────────────────────────────
(function() {
 const p = new URLSearchParams(location.search);
 const tab = p.get('tab');
 if (tab) {
 const el = document.querySelector('[onclick*="' + tab + '"]');
 showSection(tab, el);
 }
 const errs = { insufficient_balance:'Insufficient balance.', missing_fields:'Fill all required fields.', invalid_amount:'Invalid amount.', screenshot_required:'Please upload a payment screenshot.', server_error:'Something went wrong. Please try again.' };
 const oks = { quest_created:'Quest created!', bounty_created:'Bounty created!', fund_request_submitted:'Fund request submitted. Awaiting admin approval.', quest_submitted:'Quest submitted for review! It will go live after admin approval.', bounty_submitted:'Bounty submitted! Awaiting admin approval before going live.' };
 const e = p.get('error'), s = p.get('success');
 if (e) showFlash('error', errs[e] || decodeURIComponent(e));
 if (s && oks[s]) showFlash('success', oks[s]);
})();

function showFlash(type, msg) {
 var div = document.createElement('div');
 div.className = 'p-alert p-alert-' + type;
 div.innerHTML = '<i class="fas fa-' + (type==='success'?'check':'exclamation') + '-circle"></i> ' + msg;
 div.style.cssText = 'position:fixed;top:1rem;right:1rem;z-index:9999;max-width:380px';
 document.body.appendChild(div);
 setTimeout(function() { div.remove(); }, 4000);
}

/* ── Business Events ── */
var _bizEventId = null;
var _bizEventRegs = [];

function bizOpenEventRegs(eventId, title) {
 _bizEventId = eventId;
 _bizEventRegs = [];
 document.getElementById('bizRegModalTitle').textContent = title;
 document.getElementById('bizRegTab').dataset.tab = 'pending';
 document.getElementById('bizRegList').innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-3)">Loading…</div>';
 openModal('bizEventRegsModal');
 fetch('/business/api/events/' + eventId + '/registrations')
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (!d.success) { document.getElementById('bizRegList').innerHTML = '<div style="color:#ef4444;padding:1rem">Failed to load registrations.</div>'; return; }
 _bizEventRegs = d.registrations || [];
 bizRenderRegs('pending');
 });
}

function bizRenderRegs(tab) {
 document.querySelectorAll('.biz-reg-tab').forEach(function(t) {
 var on = t.dataset.tab === tab;
 t.style.background = on ? 'rgba(94,194,19,.1)' : 'none';
 t.style.color = on ? '#5ec213' : 'var(--text-3)';
 t.style.borderColor = on ? 'rgba(94,194,19,.25)' : 'transparent';
 t.classList.toggle('active', on);
 });
 var regs = _bizEventRegs.filter(function(r) { return tab === 'all' || r.status === tab; });
 var html = '';
 if (!regs.length) {
 html = '<div style="text-align:center;padding:2rem;color:var(--text-3)">No ' + (tab === 'all' ? '' : tab) + ' registrations.</div>';
 } else {
 regs.forEach(function(r) {
 var u = r.user || {};
 var name = u.username || r.username || 'Unknown';
 var email = u.email || r.email || '';
 var date = new Date(r.registeredAt).toLocaleDateString('en-US',{month:'short',day:'numeric'});
 var statusColor = r.status === 'approved' ? '#5ec213' : r.status === 'rejected' ? '#ef4444' : '#f59e0b';
 html += '<div style="display:flex;align-items:center;gap:.75rem;padding:.75rem;border-bottom:1px solid var(--border)">' +
 '<div style="width:36px;height:36px;border-radius:50%;background:rgba(94,194,19,.1);border:2px solid rgba(94,194,19,.2);display:flex;align-items:center;justify-content:center;font-weight:800;color:#5ec213;font-size:.85rem;flex-shrink:0">' + name.charAt(0).toUpperCase() + '</div>' +
 '<div style="flex:1;min-width:0"><div style="font-weight:700;font-size:.85rem">@' + name + '</div><div style="font-size:.72rem;color:var(--text-3)">' + email + '</div></div>' +
 '<div style="font-size:.72rem;color:var(--text-3)">' + date + '</div>' +
 '<span style="background:rgba(255,255,255,.05);border-radius:20px;padding:.1rem .5rem;font-size:.68rem;font-weight:700;color:' + statusColor + '">' + r.status + '</span>';
 var userId = (u._id || u.id || '');
 if (r.status === 'pending') {
 html += '<button onclick="bizApproveReg(\'' + userId + '\')" style="background:rgba(94,194,19,.12);color:#5ec213;border:1px solid rgba(94,194,19,.3);border-radius:20px;padding:.2rem .6rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:Outfit,sans-serif"><i class="fas fa-check"></i> Approve</button>' +
 '<button onclick="bizRejectReg(\'' + userId + '\')" style="background:rgba(239,68,68,.08);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:20px;padding:.2rem .6rem;font-size:.7rem;font-weight:700;cursor:pointer;font-family:Outfit,sans-serif"><i class="fas fa-times"></i> Reject</button>';
 } else if (r.status === 'approved') {
 html += '<button onclick="bizRejectReg(\'' + userId + '\')" style="background:rgba(255,255,255,.04);color:var(--text-3);border:1px solid var(--border);border-radius:20px;padding:.2rem .6rem;font-size:.68rem;cursor:pointer;font-family:Outfit,sans-serif"><i class="fas fa-ban"></i> Revoke</button>';
 }
 html += '</div>';
 });
 }
 document.getElementById('bizRegList').innerHTML = html;
}

function bizApproveReg(userId) {
 fetch('/business/api/events/' + _bizEventId + '/approve/' + userId, { method: 'POST' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) {
 var r = _bizEventRegs.find(function(x) { return (x.user && (x.user._id || x.user.id)) === userId; });
 if (r) { r.status = 'approved'; r.approvedAt = new Date().toISOString(); }
 bizRenderRegs(document.querySelector('.biz-reg-tab.active')?.dataset.tab || 'pending');
 } else { alert(d.message || 'Error approving.'); }
 });
}

function bizRejectReg(userId) {
 fetch('/business/api/events/' + _bizEventId + '/reject/' + userId, { method: 'POST', headers:{'Content-Type':'application/json'}, body: '{}' })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 if (d.success) {
 var r = _bizEventRegs.find(function(x) { return (x.user && (x.user._id || x.user.id)) === userId; });
 if (r) r.status = 'rejected';
 bizRenderRegs(document.querySelector('.biz-reg-tab.active')?.dataset.tab || 'pending');
 } else { alert(d.message || 'Error rejecting.'); }
 });
}

document.getElementById('bizEventForm')?.addEventListener('submit', function(e) {
 e.preventDefault();
 var btn = document.getElementById('bizEventSubmitBtn');
 btn.disabled = true;
 btn.textContent = 'Creating…';
 var data = {};
 new FormData(this).forEach(function(v, k) { data[k] = v; });
 fetch('/business/api/events/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
 .then(function(r) { return r.json(); })
 .then(function(d) {
 btn.disabled = false; btn.textContent = 'Create Event';
 if (d.success) { closeModal('bizEventModal'); location.reload(); }
 else { alert(d.message || 'Error creating event.'); }
 })
 .catch(function() { btn.disabled = false; btn.textContent = 'Create Event'; alert('Network error.'); });
});
</script>

<!-- ── Create Event Modal ── -->
<div class="p-modal-overlay" id="bizEventModal">
 <div class="p-modal" style="max-width:580px">
 <div class="p-modal-head">
 <h3><i class="fas fa-calendar-plus" style="color:var(--green)"></i> Create Event</h3>
 <button class="p-modal-close" onclick="closeModal('bizEventModal')"><i class="fas fa-times"></i></button>
 </div>
 <form id="bizEventForm">
 <div class="p-modal-body">
 <div class="p-form-group"><label>Title <span style="color:var(--red)">*</span></label><input type="text" name="title" class="p-input" required placeholder="Event name"></div>
 <div class="p-form-group"><label>Description <span style="color:var(--red)">*</span></label><textarea name="description" class="p-input" rows="3" required placeholder="What's this event about?"></textarea></div>
 <div class="p-form-group"><label>Event Type</label><select name="eventType" class="p-input"><option value="virtual">Virtual (Online)</option><option value="physical">In-Person</option><option value="hybrid">Hybrid</option></select></div>
 <div class="p-form-group">
 <label>Registration Approval <span style="color:var(--red)">*</span></label>
 <select name="approvalType" class="p-input">
 <option value="auto">Automatic — anyone who registers is instantly approved</option>
 <option value="manual">Manual — you review and approve each registration</option>
 </select>
 </div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
 <div class="p-form-group"><label>Start Date <span style="color:var(--red)">*</span></label><input type="datetime-local" name="startDate" class="p-input" required></div>
 <div class="p-form-group"><label>End Date</label><input type="datetime-local" name="endDate" class="p-input"></div>
 </div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
 <div class="p-form-group"><label>Venue / Meeting Link</label><input type="text" name="location" class="p-input" placeholder="e.g. Lagos Venue or https://meet.google.com/..."></div>
 <div class="p-form-group"><label>Max Attendees</label><input type="number" name="maxAttendees" class="p-input" placeholder="Leave blank for unlimited"></div>
 </div>
 <div class="p-form-group"><label>Featured Image URL <span style="color:var(--text-3);font-weight:400;font-size:.78rem">(optional)</span></label><input type="url" name="bannerImage" class="p-input" placeholder="https://..."></div>
 </div>
 <div class="p-modal-foot">
 <button type="button" onclick="closeModal('bizEventModal')" class="p-btn p-btn-ghost">Cancel</button>
 <button type="submit" id="bizEventSubmitBtn" class="p-btn p-btn-primary"><i class="fas fa-calendar-plus"></i> Create Event</button>
 </div>
 </form>
 </div>
</div>

<!-- ── Event Registrations Modal ── -->
<div class="p-modal-overlay" id="bizEventRegsModal">
 <div class="p-modal" style="max-width:620px">
 <div class="p-modal-head">
 <h3><i class="fas fa-users" style="color:var(--green)"></i> <span id="bizRegModalTitle">Registrations</span></h3>
 <button class="p-modal-close" onclick="closeModal('bizEventRegsModal')"><i class="fas fa-times"></i></button>
 </div>
 <div class="p-modal-body" style="padding-top:.5rem">
 <div id="bizRegTab" style="display:flex;gap:.4rem;margin-bottom:1rem;border-bottom:1px solid var(--border);padding-bottom:.6rem">
 <button class="biz-reg-tab active" data-tab="pending" onclick="bizRenderRegs('pending')" style="padding:.35rem .9rem;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;background:rgba(94,194,19,.1);color:#5ec213;border:1px solid rgba(94,194,19,.25);font-family:Outfit,sans-serif">Pending</button>
 <button class="biz-reg-tab" data-tab="approved" onclick="bizRenderRegs('approved')" style="padding:.35rem .9rem;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;background:none;color:var(--text-3);border:1px solid transparent;font-family:Outfit,sans-serif">Approved</button>
 <button class="biz-reg-tab" data-tab="rejected" onclick="bizRenderRegs('rejected')" style="padding:.35rem .9rem;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;background:none;color:var(--text-3);border:1px solid transparent;font-family:Outfit,sans-serif">Rejected</button>
 <button class="biz-reg-tab" data-tab="all" onclick="bizRenderRegs('all')" style="padding:.35rem .9rem;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;background:none;color:var(--text-3);border:1px solid transparent;font-family:Outfit,sans-serif">All</button>
 </div>
 <div id="bizRegList" style="max-height:400px;overflow-y:auto"></div>
 </div>
 </div>
</div>

<%- include('../partials/whatsapp-float') %>
</body>
</html>
