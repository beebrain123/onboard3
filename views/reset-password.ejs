<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Reset Password - ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <style>
 * {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }

 :root {
 --primary: #39FF14;
 --primary-dark: #2ACC10;
 --darker-bg: #050810;
 --card-bg: rgba(20, 25, 40, 0.7);
 --border-color: rgba(57, 255, 20, 0.12);
 --text-primary: #FFFFFF;
 --text-secondary: #A8B3CF;
 }

 body {
 font-family: 'Outfit', sans-serif;
 background: var(--darker-bg);
 color: var(--text-primary);
 min-height: 100vh;
 display: flex;
 align-items: center;
 justify-content: center;
 padding: 2rem;
 }

 .bg-grid {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background-image:
 linear-gradient(rgba(57, 255, 20, 0.02) 1px, transparent 1px),
 linear-gradient(90deg, rgba(57, 255, 20, 0.02) 1px, transparent 1px);
 background-size: 60px 60px;
 pointer-events: none;
 z-index: 0;
 }

 .glow-orb {
 position: fixed;
 width: 500px;
 height: 500px;
 border-radius: 50%;
 background: radial-gradient(circle, rgba(57, 255, 20, 0.08) 0%, transparent 70%);
 filter: blur(80px);
 pointer-events: none;
 z-index: 0;
 }

 .glow-orb-1 {
 top: -250px;
 left: -250px;
 }

 .glow-orb-2 {
 bottom: -250px;
 right: -250px;
 }

 .reset-container {
 position: relative;
 z-index: 1;
 background: var(--card-bg);
 border: 1px solid var(--border-color);
 border-radius: 28px;
 padding: 3rem;
 max-width: 500px;
 width: 100%;
 backdrop-filter: blur(20px);
 box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), 0 0 40px rgba(57, 255, 20, 0.08);
 }

 .logo {
 font-size: 1.75rem;
 font-weight: 900;
 color: var(--primary);
 text-align: center;
 margin-bottom: 2rem;
 }

 .icon {
 font-size: 4rem;
 margin-bottom: 1.5rem;
 text-align: center;
 }

 .icon.success {
 color: var(--primary);
 }

 .icon.error {
 color: #ff4444;
 }

 h1 {
 font-size: 1.75rem;
 text-align: center;
 margin-bottom: 1rem;
 font-weight: 700;
 }

 h1.success {
 color: var(--primary);
 }

 h1.error {
 color: #ff4444;
 }

 .description {
 color: var(--text-secondary);
 text-align: center;
 line-height: 1.6;
 margin-bottom: 2rem;
 font-size: 1rem;
 }

 .form-group {
 margin-bottom: 1.5rem;
 }

 .form-group label {
 display: block;
 margin-bottom: 0.5rem;
 color: var(--text-secondary);
 font-size: 0.875rem;
 font-weight: 600;
 }

 .form-group input {
 width: 100%;
 padding: 1rem 1.125rem;
 background: rgba(0, 0, 0, 0.3);
 border: 1px solid var(--border-color);
 border-radius: 14px;
 color: var(--text-primary);
 font-size: 0.9375rem;
 font-family: 'Outfit', sans-serif;
 transition: all 0.3s ease;
 }

 .form-group input::placeholder {
 color: #6B7489;
 }

 .form-group input:focus {
 outline: none;
 border-color: var(--primary);
 background: rgba(0, 0, 0, 0.4);
 box-shadow: 0 0 0 4px rgba(57, 255, 20, 0.12);
 }

 .btn-submit {
 width: 100%;
 padding: 1.125rem 2rem;
 background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
 color: #000;
 border: none;
 border-radius: 14px;
 font-size: 1.0625rem;
 font-weight: 800;
 cursor: pointer;
 transition: all 0.3s ease;
 font-family: 'Outfit', sans-serif;
 box-shadow: 0 10px 40px rgba(57, 255, 20, 0.35);
 }

 .btn-submit:hover {
 transform: translateY(-3px);
 box-shadow: 0 16px 60px rgba(57, 255, 20, 0.5);
 }

 .btn {
 display: inline-block;
 padding: 1rem 2.5rem;
 background: var(--primary);
 color: #0a0a0a;
 text-decoration: none;
 border-radius: 14px;
 font-weight: 700;
 font-size: 1rem;
 transition: all 0.3s;
 }

 .btn:hover {
 transform: translateY(-2px);
 box-shadow: 0 10px 30px rgba(57, 255, 20, 0.4);
 }

 .btn-secondary {
 background: transparent;
 border: 1px solid var(--primary);
 color: var(--primary);
 margin-left: 1rem;
 }

 .btn-secondary:hover {
 background: rgba(57, 255, 20, 0.1);
 }

 .buttons {
 text-align: center;
 margin-top: 1.5rem;
 }

 .alert {
 padding: 1rem 1.25rem;
 border-radius: 12px;
 margin-bottom: 1.5rem;
 font-size: 0.875rem;
 font-weight: 500;
 display: none;
 }

 .alert.show {
 display: block;
 }

 .alert-success {
 background: rgba(57, 255, 20, 0.12);
 border: 1px solid rgba(57, 255, 20, 0.3);
 color: var(--primary);
 }

 .alert-error {
 background: rgba(244, 67, 54, 0.15);
 border: 1px solid rgba(244, 67, 54, 0.3);
 color: #F44336;
 }

 .back-link {
 display: block;
 text-align: center;
 color: var(--text-secondary);
 font-size: 0.875rem;
 text-decoration: none;
 margin-top: 1.5rem;
 transition: color 0.2s ease;
 }

 .back-link:hover {
 color: var(--primary);
 }

 @media (max-width: 768px) {
 .reset-container {
 padding: 2rem 1.5rem;
 }

 h1 {
 font-size: 1.5rem;
 }

 .icon {
 font-size: 3rem;
 }

 .buttons {
 display: flex;
 flex-direction: column;
 gap: 0.75rem;
 }

 .btn {
 display: block;
 text-align: center;
 }

 .btn-secondary {
 margin-left: 0;
 }
 }
 </style>
</head>
<body>
 <div class="bg-grid"></div>
 <div class="glow-orb glow-orb-1"></div>
 <div class="glow-orb glow-orb-2"></div>

 <div class="reset-container">
 <div class="logo">ONBOARD3</div>

 <% if (valid) { %>
 <h1>Create New Password</h1>
 <p class="description">Enter your new password below. Make sure it's at least 6 characters long.</p>

 <div id="alert" class="alert"></div>

 <form id="resetPasswordForm">
 <input type="hidden" id="resetToken" value="<%= token %>">
 <div class="form-group">
 <label for="newPassword">New Password</label>
 <input type="password" id="newPassword" name="password" placeholder="Enter new password" required minlength="6">
 </div>
 <div class="form-group">
 <label for="confirmPassword">Confirm Password</label>
 <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required minlength="6">
 </div>
 <button type="submit" class="btn-submit">Reset Password</button>
 </form>
 <a href="/auth" class="back-link">Back to Login</a>
 <% } else { %>
 <div class="icon error">
 <i class="fas fa-times-circle"></i>
 </div>
 <h1 class="error">Invalid Reset Link</h1>
 <p class="description"><%= message %></p>
 <div class="buttons">
 <a href="/auth" class="btn">Back to Login</a>
 <a href="/" class="btn btn-secondary">Go Home</a>
 </div>
 <% } %>
 </div>

 <% if (valid) { %>
 <script>
 function showAlert(message, type) {
 const alert = document.getElementById('alert');
 alert.textContent = message;
 alert.className = `alert alert-${type} show`;
 }

 function hideAlert() {
 document.getElementById('alert').className = 'alert';
 }

 document.getElementById('resetPasswordForm').addEventListener('submit', async (e) => {
 e.preventDefault();

 const token = document.getElementById('resetToken').value;
 const password = document.getElementById('newPassword').value;
 const confirmPassword = document.getElementById('confirmPassword').value;

 if (password !== confirmPassword) {
 showAlert('Passwords do not match', 'error');
 return;
 }

 if (password.length < 6) {
 showAlert('Password must be at least 6 characters', 'error');
 return;
 }

 try {
 const response = await fetch('/auth/reset-password', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ token, password, confirmPassword })
 });

 const data = await response.json();

 if (data.success) {
 showAlert('Password reset successful! Redirecting to login...', 'success');
 setTimeout(() => {
 window.location.href = '/auth';
 }, 2000);
 } else {
 showAlert(data.message, 'error');
 }
 } catch (error) {
 showAlert('An error occurred. Please try again.', 'error');
 }
 });
 </script>
 <% } %>

<%- include('partials/whatsapp-float') %>
</body>
</html>
