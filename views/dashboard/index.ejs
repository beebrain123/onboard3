 .sf-skel-l { height:10px;border-radius:4px;background:rgba(255,255,255,.06); }
 .sf-skel-l--wide{width:75%}.sf-skel-l--med{width:55%}.sf-skel-l--narrow{width:35%}

 /* Sidebar */
 .sf-sidebar-col { display:flex;flex-direction:column; }
 .sf-quick-links { }
