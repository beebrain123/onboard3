<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Dashboard — ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/dashboard.css">
 <%- include('../partials/achievement-popup') %>
</head>
<body>
 <%- include('../partials/salary-popup') %>
 <div class="grid-bg"></div>

 <% const currentPage = 'dashboard'; %>
 <%- include('../partials/sidebar', { user, currentPage }) %>

 <div class="dashboard-container">
 <main class="main-content">

 <!-- ═══ HEADER ═══ -->
 <header class="header">
 <div class="header-content">
 <div class="header-title">
 <h2>
 <%
 const hr = new Date().getHours();
 const greet = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';
 %>
 <%= greet %>, <%= user.username %>
 </h2>
 <p>Track your progress, quests, and rewards.</p>
 </div>
 <div class="header-stats">
 <div class="stat-badge" style="background:<%=roleData.currentRole.color%>18;border-color:<%=roleData.currentRole.color%>55;">
 <i class="fas <%= roleData.currentRole.icon %>" style="color:<%=roleData.currentRole.color%>"></i>
 <span style="color:<%=roleData.currentRole.color%>"><%= roleData.currentRole.name %></span>
 </div>
 <% if (roleData.isEarlyCitizen) { %>
 <div class="stat-badge" style="background:#FFD70018;border-color:#FFD70055;">
 <i class="fas fa-star" style="color:#FFD700"></i>
 <span style="color:#FFD700">Early Citizen</span>
 </div>
 <% } %>
 <div class="stat-badge">
 <i class="fas fa-bolt" style="color:var(--green)"></i>
 <span><%= (user.xp || 0).toLocaleString() %> XP</span>
 </div>
 <a href="/dashboard/withdrawal" class="stat-badge">
 <i class="fas fa-wallet" style="color:var(--green)"></i>
 <span>Withdraw</span>
 </a>
 </div>
 </div>
 </header>

 <div class="content">
 <%
 /* ── Role progression data ── */
 const MILESTONES = [
 { key:'citizen', label:'Citizen', min:0, nextMin:10000 },
 { key:'contributor', label:'Contributor', min:10000, nextMin:25000 },
 { key:'ambassador', label:'Ambassador', min:25000, nextMin:100000 },
 { key:'legend', label:'Legend', min:100000, nextMin:250000 },
 { key:'major', label:'Major', min:250000, nextMin:null }
 ];
 const xp = user.xp || 0;
 const curIdx = MILESTONES.findIndex(m => m.key === roleData.roleKey);
 const cur = MILESTONES[curIdx] || MILESTONES[0];
 const nxt = MILESTONES[curIdx + 1] || null;
 const progressPct = nxt
 ? Math.min(100, Math.round(((xp - cur.min) / (nxt.nextMin - cur.min)) * 100))
 : 100;
 const xpToNext = nxt ? (nxt.nextMin - xp).toLocaleString() : 0;
 const memberSince = new Date(user.createdAt).toLocaleDateString('en-US', { month:'short', year:'numeric' });
 %>

 <%
 const pathwayMeta = {
 web3_jobs: { fa:'fa-briefcase', name:'Web3 Jobs', color:'rgba(251,191,36,0.15)', border:'rgba(251,191,36,0.35)', text:'#fbbf24' },
 ai: { fa:'fa-microchip', name:'AI & Web3', color:'rgba(168,85,247,0.12)', border:'rgba(168,85,247,0.35)', text:'#c084fc' },
 trading: { fa:'fa-chart-line', name:'Trading', color:'rgba(16,185,129,0.10)', border:'rgba(16,185,129,0.35)', text:'#10b981' },
 nft: { fa:'fa-image', name:'NFTs & Digital Assets', color:'rgba(236,72,153,0.10)', border:'rgba(236,72,153,0.35)', text:'#f472b6' }
 };
 %>

 <% if (user.pathway) {
 const pm = pathwayMeta[user.pathway] || pathwayMeta.web3_jobs;
 const ps = user.pathwayStatus;
 const isApproved = !ps || ps === 'approved' || ps === 'auto_approved';
 const isLead = Array.isArray(user.pathwayLeadOf) && user.pathwayLeadOf.includes(user.pathway);
 %>
 <!-- Pathway badge -->
 <div style="display:flex;align-items:center;gap:1rem;padding:1rem 1.375rem;border-radius:15px;background:<%=pm.color%>;border:1px solid <%=pm.border%>;animation:cardIn .5s ease both">
 <i class="fas <%= pm.fa %>" style="font-size:1.375rem;color:<%=pm.text%>;flex-shrink:0"></i>
 <div style="flex:1;min-width:0">
 <p style="font-size:.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-3);margin-bottom:.2rem">Your Pathway</p>
 <p style="font-size:1rem;font-weight:800;color:<%=pm.text%>;margin-bottom:.1rem"><%= pm.name %></p>
 <p style="font-size:.72rem;color:var(--text-3);margin:0"><i class="fas fa-users" style="margin-right:.3rem"></i><%= pathwayCount.toLocaleString() %> member<%= pathwayCount !== 1 ? 's' : '' %></p>
 </div>
 <div style="display:flex;gap:.5rem;align-items:center;flex-shrink:0">
 <% if (isLead) { %>
 <button type="button" onclick="openMembersModal()" style="font-size:.78rem;font-weight:700;padding:.45rem .9rem;border-radius:9px;background:<%=pm.color%>;border:1px solid <%=pm.border%>;color:<%=pm.text%>;cursor:pointer;font-family:Outfit,sans-serif">
 <i class="fas fa-list-ul"></i> Members
 </button>
 <% } %>
 <% if (isApproved) { %>
 <button type="button" onclick="joinCommunity()" class="btn btn-outline" style="font-size:.8rem;padding:.5rem 1rem;border-color:<%=pm.border%>;color:<%=pm.text%>;cursor:pointer;background:none">
 <i class="fas fa-users"></i> Join Community
 </button>
 <% } else if (ps === 'pending') { %>
 <span style="font-size:.75rem;font-weight:700;padding:.375rem .75rem;border-radius:99px;background:rgba(245,158,11,.15);color:#f59e0b;border:1px solid rgba(245,158,11,.3)">
 <i class="fas fa-clock"></i> Under Review
 </span>
 <% } else if (ps === 'rejected') { %>
 <span style="font-size:.75rem;font-weight:700;padding:.375rem .75rem;border-radius:99px;background:rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)">
 <i class="fas fa-times"></i> Not Approved
 </span>
 <% } %>
 </div>
 </div>

 <% if (isLead && pathwayMembers) { %>
 <!-- Pathway Members Modal -->
 <div id="membersModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:1rem">
 <div style="background:#0a120a;border:1px solid rgba(94,194,19,.2);border-radius:20px;width:100%;max-width:560px;max-height:80vh;display:flex;flex-direction:column;overflow:hidden">
 <div style="padding:1.25rem 1.5rem;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;flex-shrink:0">
 <div>
 <h3 style="font-size:1rem;font-weight:800;color:var(--text);margin:0"><%= pm.name %> Members</h3>
 <p style="font-size:.75rem;color:var(--text-3);margin:.2rem 0 0"><%= pathwayCount.toLocaleString() %> enrolled</p>
 </div>
 <button onclick="closeMembersModal()" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:8px;width:32px;height:32px;cursor:pointer;color:var(--text-2);font-size:.9rem;display:flex;align-items:center;justify-content:center">
 <i class="fas fa-times"></i>
 </button>
 </div>
 <div style="overflow-y:auto;padding:.75rem 1rem">
 <% if (!pathwayMembers.length) { %>
 <p style="text-align:center;color:var(--text-3);padding:2rem;font-size:.875rem">No approved members yet</p>
 <% } else { %>
 <% pathwayMembers.forEach(function(m, i) { %>
 <div style="display:flex;align-items:center;gap:.75rem;padding:.625rem .5rem;border-radius:10px;<%=i>0?'border-top:1px solid rgba(255,255,255,.04)':''%>">
 <% if (m.profilePicture) { %>
 <img src="<%=m.profilePicture%>" style="width:34px;height:34px;border-radius:50%;object-fit:cover;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
 <% } %>
 <div style="width:34px;height:34px;border-radius:50%;background:rgba(94,194,19,.12);border:1px solid rgba(94,194,19,.2);display:<%= m.profilePicture ? 'none' : 'flex' %>;align-items:center;justify-content:center;font-size:.8rem;font-weight:800;color:var(--green);flex-shrink:0">
 <%=m.username.charAt(0).toUpperCase()%>
 </div>
 <div style="flex:1;min-width:0">
 <p style="font-size:.875rem;font-weight:700;color:var(--text);margin:0">@<%=m.username%></p>
 <p style="font-size:.7rem;color:var(--text-3);margin:.1rem 0 0">Joined <%=new Date(m.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})%></p>
 </div>
 <span style="font-size:.65rem;font-weight:700;padding:.2rem .5rem;border-radius:99px;background:rgba(94,194,19,.1);color:var(--green);border:1px solid rgba(94,194,19,.2);flex-shrink:0">#<%=i+1%></span>
 </div>
 <% }) %>
 <% } %>
 </div>
 </div>
 </div>
 <% } %>

 <% } else { %>
 <!-- Pathway selection card -->
 <div id="pathwaySelectCard" style="border-radius:18px;border:1px solid rgba(94,194,19,.25);background:linear-gradient(135deg,rgba(14,23,14,.9),rgba(8,18,8,.95));padding:1.375rem;animation:cardIn .5s ease both">
 <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:1rem">
 <div style="width:36px;height:36px;border-radius:10px;background:rgba(94,194,19,.12);border:1px solid rgba(94,194,19,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0">
 <i class="fas fa-map-signs" style="color:var(--green);font-size:.9rem"></i>
 </div>
 <div>
 <p style="font-size:.9rem;font-weight:800;color:var(--text)">Choose Your Pathway</p>
 <p style="font-size:.72rem;color:var(--text-3)">Select the area you want to focus on</p>
 </div>
 </div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:.625rem" id="pathwayOptions">
 <button onclick="selectPathway('web3_jobs')" class="pw-opt" style="display:flex;align-items:center;gap:.625rem;padding:.75rem;border-radius:12px;background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.25);cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;text-align:left;width:100%">
 <i class="fas fa-briefcase" style="color:#fbbf24;font-size:.9rem;width:18px;flex-shrink:0"></i>
 <span style="font-size:.78rem;font-weight:700;color:#fbbf24">Web3 Jobs</span>
 </button>
 <button onclick="selectPathway('ai')" class="pw-opt" style="display:flex;align-items:center;gap:.625rem;padding:.75rem;border-radius:12px;background:rgba(168,85,247,.07);border:1px solid rgba(168,85,247,.25);cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;text-align:left;width:100%">
 <i class="fas fa-microchip" style="color:#c084fc;font-size:.9rem;width:18px;flex-shrink:0"></i>
 <span style="font-size:.78rem;font-weight:700;color:#c084fc">AI & Web3</span>
 </button>
 <button onclick="selectPathway('trading')" class="pw-opt" style="display:flex;align-items:center;gap:.625rem;padding:.75rem;border-radius:12px;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;text-align:left;width:100%">
 <i class="fas fa-chart-line" style="color:#10b981;font-size:.9rem;width:18px;flex-shrink:0"></i>
 <span style="font-size:.78rem;font-weight:700;color:#10b981">Trading</span>
 </button>
 <button onclick="selectPathway('nft')" class="pw-opt" style="display:flex;align-items:center;gap:.625rem;padding:.75rem;border-radius:12px;background:rgba(236,72,153,.07);border:1px solid rgba(236,72,153,.25);cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;text-align:left;width:100%">
 <i class="fas fa-image" style="color:#f472b6;font-size:.9rem;width:18px;flex-shrink:0"></i>
 <span style="font-size:.78rem;font-weight:700;color:#f472b6">NFTs & Digital Assets</span>
 </button>
 </div>
 <div id="pwSelectMsg" style="display:none;margin-top:.75rem;font-size:.78rem;font-weight:600;text-align:center"></div>
 </div>
 <!-- Pathway success card (shown after selection, initially hidden) -->
 <div id="pathwaySuccessCard" style="display:none;border-radius:15px;border:1px solid;animation:cardIn .5s ease both"></div>
 <% } %>

 <!-- ═══ XP HERO CARD ═══ -->
 <div class="card xp-card">
 <div class="xp-top">
 <div class="xp-left">
 <p class="xp-label">Total XP Balance</p>
 <div class="xp-value" id="xpCounter" data-target="<%= xp %>">0<span class="xp-unit">XP</span></div>
 <p class="xp-sub">
 <% if (nxt) { %>
 <%= xpToNext %> XP to reach <strong style="color:var(--text-2)"><%= nxt.label %></strong>
 <% } else { %>
 Maximum rank achieved
 <% } %>
 </p>
 </div>
 <div style="display:flex;flex-direction:column;align-items:center;gap:.625rem;flex-shrink:0">
 <div style="position:relative">
 <img src="/images/badges/<%= roleData.roleKey %>.png"
 alt="<%= roleData.currentRole.name %>"
 style="width:80px;height:80px;object-fit:contain;filter:drop-shadow(0 0 18px <%=roleData.currentRole.color%>66);"
 onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'">
 <div style="display:none;width:80px;height:80px;border-radius:20px;background:<%=roleData.currentRole.color%>18;border:2px solid <%=roleData.currentRole.color%>44;align-items:center;justify-content:center;font-size:2rem;color:<%=roleData.currentRole.color%>">
 <i class="fas <%= roleData.currentRole.icon %>"></i>
 </div>
 <% if (roleData.isEarlyCitizen) { %>
 <img src="/images/badges/early_citizen.png" alt="Early Citizen"
 style="width:26px;height:26px;object-fit:contain;position:absolute;bottom:-4px;right:-4px;filter:drop-shadow(0 0 6px #FFD70099);"
 onerror="this.style.display='none'">
 <% } %>
 </div>
 <span style="font-size:.72rem;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:<%=roleData.currentRole.color%>"><%= roleData.currentRole.name %></span>
 </div>
 </div>

 <!-- Progress bar -->
 <div class="xp-progress-section">
 <div class="xp-progress-meta">
 <span><%= cur.label %> &mdash; <%= cur.min.toLocaleString() %> XP</span>
 <% if (nxt) { %><strong><%= progressPct %>%</strong><% } else { %><strong>Max</strong><% } %>
 <% if (nxt) { %><span><%= nxt.label %> &mdash; <%= nxt.min.toLocaleString() %> XP</span><% } %>
 </div>
 <div class="xp-bar-wrap">
 <div class="xp-bar-fill" id="xpBar" style="width:0%"></div>
 </div>
 <% if (nxt) { %>
 <p class="xp-progress-tip"><i class="fas fa-bolt"></i> Complete quests to earn more XP and unlock <%= nxt.label %></p>
 <% } %>
 </div>

 <!-- Role steps with badge images -->
 <div class="role-steps" id="roleSteps">
 <% MILESTONES.forEach((m, i) => {
 const isDone = i < curIdx;
 const isCurrent = i === curIdx;
 const isLocked = i > curIdx;
 %>
 <div class="role-step <%= isDone ? 'done' : isCurrent ? 'current' : '' %>">
 <div class="role-step-img-wrap" style="
 width:40px;height:40px;border-radius:11px;overflow:hidden;
 border:2px solid <%= isDone ? 'rgba(94,194,19,0.5)' : isCurrent ? 'var(--green)' : 'rgba(255,255,255,0.1)' %>;
 background:<%= isDone ? 'rgba(94,194,19,0.1)' : isCurrent ? 'rgba(94,194,19,0.15)' : 'rgba(255,255,255,0.03)' %>;
 display:flex;align-items:center;justify-content:center;
 box-shadow:<%= isCurrent ? '0 0 16px rgba(94,194,19,0.55)' : isDone ? '0 0 8px rgba(94,194,19,0.2)' : 'none' %>;
 opacity:<%= isLocked ? '0.35' : '1' %>;
 transition:all .3s;
 <%= isCurrent ? 'animation:dotPulse 2s ease-in-out infinite;' : '' %>
 ">
 <img src="/images/badges/<%= m.key %>.png"
 alt="<%= m.label %>"
 style="width:34px;height:34px;object-fit:contain;<%= isLocked ? 'filter:grayscale(1)' : '' %>"
 onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'">
 <div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;font-size:.65rem;font-weight:800;color:<%= isCurrent ? 'var(--green-light)' : isDone ? 'var(--green)' : '#555' %>">
 <%= m.label.substring(0,3) %>
 </div>
 </div>
 <span class="role-step-label"><%= m.label %></span>
 </div>
 <% if (i < MILESTONES.length - 1) { %>
 <div class="role-step-line <%= isDone ? 'done' : '' %>"></div>
 <% } %>
 <% }) %>
 </div>
 </div>

 <!-- ═══ STATS GRID ═══ -->
 <div class="stats-grid">
 <div class="stat-card">
 <div class="stat-icon"><i class="fas fa-dollar-sign"></i></div>
 <div class="stat-val">$<span><%= user.usdcBalance || 0 %></span></div>
 <div class="stat-lbl">USDC Balance</div>
 </div>
 <div class="stat-card">
 <div class="stat-icon"><i class="fas fa-users"></i></div>
 <div class="stat-val"><span><%= user.referralStats?.totalReferrals || 0 %></span></div>
 <div class="stat-lbl">Onboarded</div>
 </div>
 <div class="stat-card">
 <div class="stat-icon"><i class="fas fa-fire"></i></div>
 <div class="stat-val"><span><%= user.streakCount || user.checkInStreak || 0 %></span></div>
 <div class="stat-lbl">Check-in Streak</div>
 </div>
 <div class="stat-card">
 <div class="stat-icon"><i class="fas fa-calendar"></i></div>
 <div class="stat-val" style="font-size:1.25rem"><span><%= memberSince %></span></div>
 <div class="stat-lbl">Member Since</div>
 </div>
 </div>

 <!-- ═══ ACTIVITY FEED ═══ -->
 <div class="card" style="animation-delay:220ms;padding:0;overflow:hidden">
 <div style="display:flex;align-items:center;justify-content:space-between;padding:.875rem 1.25rem;border-bottom:1px solid var(--border)">
 <h3 style="font-size:.9375rem;font-weight:800;margin:0;display:flex;align-items:center;gap:.5rem">
 <i class="fas fa-bolt" style="color:var(--green);font-size:.875rem"></i> Recent Activity
 </h3>
 <% if (activityFeed.length) { %>
 <span style="font-size:.72rem;color:var(--text-3);font-weight:600"><%= activityFeed.length %> events</span>
 <% } %>
 </div>

 <% if (!activityFeed.length) { %>
 <div style="padding:2.5rem 1.25rem;text-align:center;color:var(--text-3)">
 <i class="fas fa-clock" style="font-size:1.75rem;display:block;margin-bottom:.75rem;opacity:.4"></i>
 <p style="font-size:.875rem;font-weight:600;margin:0">No activity yet</p>
 <p style="font-size:.78rem;margin:.3rem 0 0;opacity:.7">Complete quests or earn rewards to see your history here</p>
 </div>
 <% } else { %>
 <div style="max-height:420px;overflow-y:auto;overflow-x:hidden">
 <% activityFeed.forEach(function(ev, i) {
 const isLast = i === activityFeed.length - 1;
 const cfg = {
 quest_completed:  { icon:'fa-flag-checkered', color:'#5EC213', bg:'rgba(94,194,19,.10)' },
 quest_reward:     { icon:'fa-trophy',          color:'#fbbf24', bg:'rgba(251,191,36,.10)' },
 bounty_won:       { icon:'fa-medal',           color:'#f59e0b', bg:'rgba(245,158,11,.10)' },
 withdrawal:       { icon:'fa-arrow-up-right-dots', color:'#60a5fa', bg:'rgba(96,165,250,.10)' },
 referral_bonus:   { icon:'fa-user-plus',       color:'#a78bfa', bg:'rgba(167,139,250,.10)' },
 admin_adjustment: { icon:'fa-sliders',         color:'#10b981', bg:'rgba(16,185,129,.10)' },
 activity:         { icon:'fa-star',            color:'#e879f9', bg:'rgba(232,121,249,.10)' },
 }[ev.kind] || { icon:'fa-circle-dot', color:'var(--text-3)', bg:'rgba(255,255,255,.05)' };

 const statusBadge = {
 pending:   { label:'Pending',   color:'#f59e0b' },
 completed: { label:'',          color:'' },
 rejected:  { label:'Rejected',  color:'#ef4444' },
 cancelled: { label:'Cancelled', color:'#6b7280' },
 }[ev.status] || {};

 const now = new Date();
 const evDate = new Date(ev.date);
 const diffMs = now - evDate;
 const diffMins = Math.floor(diffMs / 60000);
 const diffHrs = Math.floor(diffMs / 3600000);
 const diffDays = Math.floor(diffMs / 86400000);
 const timeAgo = diffMins < 1 ? 'just now'
   : diffMins < 60 ? diffMins + 'm ago'
   : diffHrs < 24 ? diffHrs + 'h ago'
   : diffDays < 7 ? diffDays + 'd ago'
   : evDate.toLocaleDateString('en-US', { month:'short', day:'numeric' });
 %>
 <div style="display:flex;align-items:center;gap:.875rem;padding:.8rem 1.25rem;<%=isLast?'':'border-bottom:1px solid rgba(255,255,255,.04)'%>;transition:background .15s" onmouseover="this.style.background='rgba(255,255,255,.02)'" onmouseout="this.style.background=''">
 <div style="width:36px;height:36px;border-radius:10px;background:<%=cfg.bg%>;display:flex;align-items:center;justify-content:center;flex-shrink:0">
 <i class="fas <%=cfg.icon%>" style="font-size:.85rem;color:<%=cfg.color%>"></i>
 </div>
 <div style="flex:1;min-width:0">
 <p style="font-size:.875rem;font-weight:700;color:var(--text);margin:0"><%=ev.label%></p>
 <% if (ev.sublabel) { %><p style="font-size:.72rem;color:var(--text-3);margin:.1rem 0 0;line-height:1.4"><%=ev.sublabel%></p><% } %>
 <p style="font-size:.72rem;color:var(--text-3);margin:.1rem 0 0">
 <%=timeAgo%>
 <% if (ev.rank) { %> · <span style="color:<%=cfg.color%>">#<%=ev.rank%> place</span><% } %>
 </p>
 </div>
 <div style="text-align:right;flex-shrink:0">
 <% if (ev.amount !== null && ev.amount !== undefined && ev.currency) { %>
 <p style="font-size:.9rem;font-weight:800;margin:0;color:<%=ev.currency==='XP'?'var(--green)':ev.kind==='withdrawal'?'#60a5fa':'#fbbf24'%>">
 <%=ev.kind==='withdrawal'?'−':'+' %><%=ev.currency==='USDC'?'$':''%><%=typeof ev.amount==='number'?ev.amount.toLocaleString():ev.amount%><% if(ev.currency!=='USDC'){ %> <span style="font-size:.65rem;font-weight:700;opacity:.8"><%=ev.currency%></span><% } %>
 </p>
 <% } %>
