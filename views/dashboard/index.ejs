 <input id="profileSearchInput" type="text" placeholder="Search members by username…"
 style="flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9rem;font-weight:600;"
 oninput="runProfileSearch(this.value)">
 <button onclick="closeProfileSearch()" style="background:transparent;border:none;color:var(--text-3);cursor:pointer;padding:.2rem .4rem;font-size:1rem;">
