 <span style="font-size:.65rem;font-weight:700;color:<%=statusBadge.color%>;background:<%=statusBadge.color%>18;border:1px solid <%=statusBadge.color%>33;border-radius:99px;padding:.1rem .4rem"><%=statusBadge.label%></span>
 <% } %>
 </div>
 </div>
 <% }) %>
 </div>
 <% } %>
