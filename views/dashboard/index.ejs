 </style>

 <!-- ── Profile Search Modal ── -->
 <div id="profileSearchModal" style="display:none;position:fixed;inset:0;z-index:800;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);align-items:flex-start;justify-content:center;padding:5rem 1rem 1rem;">
