 <script>
 /* ── Animated XP counter ── */
 (function() {
 const el = document.getElementById('xpCounter');
 const unit = el.querySelector('.xp-unit');
 const target = parseInt(el.dataset.target || '0', 10);
 const dur = 1400;
 const start = performance.now();
 function tick(now) {
 const t = Math.min(1, (now - start) / dur);
 const ease = 1 - Math.pow(1 - t, 3);
 el.childNodes[0].textContent = Math.round(ease * target).toLocaleString();
 if (t < 1) requestAnimationFrame(tick);
 }
 requestAnimationFrame(tick);
 })();

 /* ── XP progress bar ── */
 window.addEventListener('DOMContentLoaded', () => {
 setTimeout(() => {
 const bar = document.getElementById('xpBar');
 if (bar) bar.style.width = '<%= progressPct %>%';
 }, 300);
 });

 /* Monthly claim removed */

 /* ── Social Feed ── */
 (function() {
 var RC = { citizen:'#6b7280',contributor:'#10b981',ambassador:'#3b82f6',legend:'#eab308',major:'#f97316' };
 var RL = { citizen:'Citizen',contributor:'Contributor',ambassador:'Ambassador',legend:'Legend',major:'Major' };

 function ago(d) {
 var s = (Date.now() - new Date(d)) / 1000;
 if (s < 60) return 'just now';
 if (s < 3600) return Math.floor(s/60) + 'm ago';
 if (s < 86400) return Math.floor(s/3600) + 'h ago';
 return Math.floor(s/86400) + 'd ago';
 }

 /* Like state — persisted in DB via API */
 window.toggleLike = function(btn, evId) {
 var isLiked = btn.classList.contains('liked');
 var countEl = btn.querySelector('.sf-like-count');
 var iconEl = btn.querySelector('i');
 var cur = parseInt(countEl.textContent, 10) || 0;
 /* Optimistic update */
 if (isLiked) {
 countEl.textContent = Math.max(0, cur - 1);
 iconEl.className = 'far fa-heart';
 btn.classList.remove('liked');
 } else {
 countEl.textContent = cur + 1;
 iconEl.className = 'fas fa-heart';
 btn.classList.add('liked');
 }
 fetch('/api/feed/' + evId + '/like', { method:'POST', headers:{'Content-Type':'application/json'} })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (d.success) {
 countEl.textContent = d.count;
 } else {
 /* revert on failure */
 if (isLiked) { btn.classList.add('liked'); iconEl.className='fas fa-heart'; countEl.textContent=cur; }
 else { btn.classList.remove('liked'); iconEl.className='far fa-heart'; countEl.textContent=cur; }
 }
 }).catch(function(){});
 };

 window.sharePost = function(username) {
 var url = window.location.origin + '/u/' + username;
 navigator.clipboard.writeText(url).then(function() {
 showMiniToast('Link copied!');
 }).catch(function() { showMiniToast('Copy: ' + url); });
 };

 function showMiniToast(msg) {
 var t = document.getElementById('sfToast');
 t.textContent = msg;
 t.classList.add('sf-toast--show');
 setTimeout(function(){ t.classList.remove('sf-toast--show'); }, 2000);
 }

 function mkPost(ev, isNew) {
 var isRole = ev.type === 'role_upgrade';
 var isUsdc = ev.type === 'usdc_earned';
 var isQuest = ev.type === 'quest_completed';
 if (!isRole && !isUsdc && !isQuest) return null;

 var evId = ev._id || (ev.username + ev.createdAt);
 var isLiked = !!ev.viewerLiked;
 var likeCount = (ev.likes && ev.likes.count) || 0;

 var avColor = isRole ? (RC[ev.data.newRole] || '#5ec213') : isUsdc ? '#f59e0b' : '#5ec213';
 var initial = (ev.username || '?').charAt(0).toUpperCase();

 var contentHtml = '';
 if (isRole) {
 var col = RC[ev.data.newRole] || '#5ec213';
 var fromLabel = RL[ev.data.oldRole] || ev.data.oldRole || '?';
 var toLabel = RL[ev.data.newRole] || ev.data.newRole;
 contentHtml =
 '<div class="spost-upgrade" style="background:' + col + '09;border-color:' + col + '25">' +
 '<div class="spost-upgrade-icon" style="background:' + col + '18;border:1px solid ' + col + '33;color:' + col + '"><i class="fas fa-shield-halved"></i></div>' +
 '<div class="spost-upgrade-text">' +
 '<div class="spost-upgrade-headline">Just leveled up! </div>' +
 '<div class="spost-upgrade-path">' +
 '<span class="spost-role-from">' + fromLabel + '</span>' +
 '<i class="fas fa-arrow-right"></i>' +
 '<span style="color:' + col + ';font-weight:900">' + toLabel + '</span>' +
 '</div>' +
 '</div>' +
 '</div>';
 } else if (isUsdc) {
 var amt = parseFloat(ev.data.amount || 0).toFixed(2);
 var qtitle = ev.data.questTitle ? '"' + ev.data.questTitle + '"' : 'a quest';
 contentHtml =
 '<div class="spost-reward">' +
 '<div class="spost-reward-icon"><i class="fas fa-sack-dollar"></i></div>' +
 '<div>' +
 '<div class="spost-reward-amount">$' + amt + ' <span style="font-size:.65rem;font-weight:700;color:rgba(245,158,11,.7)">USDC</span></div>' +
 '<div class="spost-reward-label">earned from ' + qtitle + '</div>' +
 '</div>' +
 '</div>';
 } else {
 var qt = ev.data.questTitle || 'a quest';
 contentHtml =
 '<div class="spost-upgrade" style="background:rgba(94,194,19,.06);border-color:rgba(94,194,19,.2)">' +
 '<div class="spost-upgrade-icon" style="background:rgba(94,194,19,.15);border:1px solid rgba(94,194,19,.3);color:#5ec213"><i class="fas fa-trophy"></i></div>' +
 '<div class="spost-upgrade-text">' +
 '<div class="spost-upgrade-headline" style="color:#5ec213">Quest Completed! </div>' +
 '<div style="font-size:.78rem;color:var(--text-2);margin-top:.2rem">' + qt + '</div>' +
 '</div>' +
 '</div>';
 }

 var likeIcon = isLiked ? 'fas fa-heart' : 'far fa-heart';
 var actionsHtml =
 '<div class="spost-actions">' +
 '<button class="spost-btn like-btn' + (isLiked ? ' liked' : '') + '" onclick="toggleLike(this,' + JSON.stringify(evId) + ')">' +
 '<i class="' + likeIcon + '"></i><span class="sf-like-count">' + likeCount + '</span>' +
 '</button>' +
 '<button class="spost-btn" onclick="sharePost(' + JSON.stringify(ev.username) + ')">' +
 '<i class="fas fa-share-nodes"></i> Share' +
 '</button>' +
 '<a href="/u/' + ev.username + '" class="spost-view-link">' +
 '<i class="fas fa-user"></i> Profile' +
 '</a>' +
 '</div>';

 var el = document.createElement('div');
 el.className = 'spost' + (isNew ? ' spost--new' : '');
 el.innerHTML =
 '<div class="spost-av" style="background:' + avColor + '22;color:' + avColor + '">' + initial + '</div>' +
 '<div class="spost-body">' +
 '<div class="spost-meta">' +
 '<a href="/u/' + ev.username + '" class="spost-username">@' + ev.username + '</a>' +
 '<span class="spost-time">' + ago(ev.createdAt) + '</span>' +
 '</div>' +
 contentHtml +
 actionsHtml +
 '</div>';
 return el;
 }

 var feed = document.getElementById('socialFeed');
 var MAX = 5;

 fetch('/api/feed').then(function(r){return r.json();}).then(function(d){
 feed.innerHTML = '';
 if (!d.events || !d.events.length) {
 feed.innerHTML = '<div class="sf-empty"><i class="fas fa-satellite-dish"></i><span>Waiting for community activity…</span></div>';
 return;
 }
 d.events.slice(0, MAX).forEach(function(ev) {
 var p = mkPost(ev, false);
 if (p) feed.appendChild(p);
 });
 }).catch(function() {
 feed.innerHTML = '<div class="sf-empty"><i class="fas fa-wifi"></i><span>Feed unavailable</span></div>';
 });

 if (typeof io !== 'undefined') {
 var socket = io({ transports: ['websocket','polling'] });
 socket.on('feed_event', function(ev) {
 var p = mkPost(ev, true);
 if (!p) return;
 /* Remove skeleton if still there */
 var skel = feed.querySelector('.sf-skel');
 if (skel) feed.innerHTML = '';
 feed.insertBefore(p, feed.firstChild);
 while (feed.children.length > MAX) feed.removeChild(feed.lastChild);
 setTimeout(function(){ p.classList.remove('spost--new'); }, 600);
 });
 }
 })();

 /* ── Profile Search ── */
 var _searchTimer = null;
 function openProfileSearch() {
 var m = document.getElementById('profileSearchModal');
 m.style.display = 'flex';
 setTimeout(function(){ document.getElementById('profileSearchInput').focus(); }, 50);
 }
 function closeProfileSearch() {
 document.getElementById('profileSearchModal').style.display = 'none';
 document.getElementById('profileSearchInput').value = '';
 document.getElementById('profileSearchResults').innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-3);font-size:.82rem;">Start typing to search members</div>';
 }
 document.getElementById('profileSearchModal').addEventListener('click', function(e){ if(e.target===this) closeProfileSearch(); });
 document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeProfileSearch(); });

 function runProfileSearch(q) {
 clearTimeout(_searchTimer);
 var res = document.getElementById('profileSearchResults');
 if (!q || q.length < 2) {
 res.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-3);font-size:.82rem;">Start typing to search members</div>';
 return;
 }
 res.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-3);font-size:.82rem"><i class="fas fa-spinner fa-spin"></i></div>';
 _searchTimer = setTimeout(function() {
 fetch('/api/users/search?q=' + encodeURIComponent(q))
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.results || !d.results.length) {
 res.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-3);font-size:.82rem">No members found for "<b style=color:var(--text)>' + q + '</b>"</div>';
 return;
 }
 res.innerHTML = d.results.map(function(u) {
 var init = (u.username || '?').charAt(0).toUpperCase();
 var av = u.profilePicture
 ? '<img src="' + u.profilePicture + '" style="width:36px;height:36px;border-radius:50%;object-fit:cover">'
 : '<div style="width:36px;height:36px;border-radius:50%;background:rgba(94,194,19,.15);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.875rem;color:var(--green)">' + init + '</div>';
 return '<a href="/u/' + u.username + '" onclick="closeProfileSearch()" style="display:flex;align-items:center;gap:.75rem;padding:.75rem 1.25rem;text-decoration:none;transition:background .15s;border-bottom:1px solid rgba(94,194,19,.06)" onmouseover="this.style.background=\'rgba(94,194,19,.05)\'" onmouseout="this.style.background=\'transparent\'">' +
 av +
 '<div style="flex:1;min-width:0">' +
 '<div style="font-size:.875rem;font-weight:800;color:var(--text)">@' + u.username + '</div>' +
 '<div style="font-size:.72rem;color:var(--text-3)">' + u.roleName + (u.pathway ? ' · ' + u.pathway : '') + '</div>' +
 '</div>' +
 '<span style="font-size:.72rem;color:var(--green);font-weight:700">' + (u.xp||0).toLocaleString() + ' XP</span>' +
 '</a>';
 }).join('');
 }).catch(function() {
 res.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--text-3);font-size:.82rem">Search unavailable</div>';
 });
 }, 280);
 }

 /* ── Join Community (pathway-specific group link from admin) ── */
 var _communityLink = 'https://t.me/onboard_3'; // default fallback

 // Pre-fetch on load so window.open() stays synchronous (avoids popup blocker)
 (function() {
 var pw = '<%= user.pathway %>';
 if (!pw || pw === 'undefined' || pw === 'null') return;
 fetch('/dashboard/pathway-config/' + encodeURIComponent(pw))
 .then(function(r){ return r.json(); })
 .then(function(d){ if (d.config && d.config.groupLink) _communityLink = d.config.groupLink; })
 .catch(function(){});
 })();

 function joinCommunity() {
 window.open(_communityLink, '_blank');
 }

 /* ── Pathway members modal ── */
 function openMembersModal() {
 var m = document.getElementById('membersModal');
 if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
 }
 function closeMembersModal() {
 var m = document.getElementById('membersModal');
 if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
 }
 document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMembersModal(); });

 /* ── Pathway popup modal ── */
 function openPathwayPopup() {
 var m = document.getElementById('pathwayPopupModal');
 if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
 }
 function closePathwayPopup() {
 var m = document.getElementById('pathwayPopupModal');
 if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
 sessionStorage.setItem('pw_popup_dismissed', '1');
 }
 function selectPathwayPopup(pw) {
 var opts = document.querySelectorAll('.pw-popup-opt');
 opts.forEach(function(b){ b.disabled = true; b.style.opacity = '.5'; });
 var msg = document.getElementById('pwPopupMsg');
 msg.style.display = 'block'; msg.style.color = 'var(--text-3)';
 msg.textContent = 'Saving your pathway...';
 fetch('/dashboard/select-pathway', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ pathway: pw })
 })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) {
 msg.style.color = '#ef4444';
 msg.textContent = d.message || 'Error saving. Try again.';
 opts.forEach(function(b){ b.disabled = false; b.style.opacity = '1'; });
 return;
 }
 if (d.groupLink) _communityLink = d.groupLink;
 var meta = _pwMeta[pw] || _pwMeta.web3_jobs;
 document.getElementById('pwPopupContent').innerHTML =
 '<div style="text-align:center;padding:1.5rem 0">' +
 '<div style="width:56px;height:56px;border-radius:16px;background:' + meta.color + ';border:1px solid ' + meta.border + ';display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.5rem;color:' + meta.text + '"><i class="fas ' + meta.fa + '"></i></div>' +
 '<p style="font-size:1.1rem;font-weight:800;color:' + meta.text + ';margin-bottom:.4rem">' + meta.name + '</p>' +
 '<p style="font-size:.85rem;color:var(--text-3);margin-bottom:1.25rem">' + (d.status === 'auto_approved' ? 'You\'re all set! Welcome to the pathway.' : 'Application submitted — you\'ll be notified once approved.') + '</p>' +
 '<button onclick="closePathwayPopup()" style="padding:.65rem 1.75rem;background:var(--green);color:#000;border:none;border-radius:10px;font-family:Outfit,sans-serif;font-size:.9rem;font-weight:800;cursor:pointer">Continue to Dashboard</button>' +
 '</div>';
 // also sync inline card
 var inlineCard = document.getElementById('pathwaySelectCard');
 if (inlineCard) inlineCard.style.display = 'none';
 var sc = document.getElementById('pathwaySuccessCard');
 if (sc) { sc.style.background = meta.color; sc.style.borderColor = meta.border; sc.style.padding = '1rem 1.375rem'; sc.style.display = 'flex'; sc.style.alignItems = 'center'; sc.style.gap = '1rem'; sc.innerHTML = '<i class="fas ' + meta.fa + '" style="font-size:1.375rem;color:' + meta.text + ';flex-shrink:0"></i><div style="flex:1"><p style="font-size:.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-3);margin-bottom:.2rem">Your Pathway</p><p style="font-size:1rem;font-weight:800;color:' + meta.text + '">' + meta.name + '</p></div>'; }
 })
 .catch(function() {
 msg.style.color = '#ef4444';
 msg.textContent = 'Network error. Please try again.';
 opts.forEach(function(b){ b.disabled = false; b.style.opacity = '1'; });
 });
 }
 <% if (!user.pathway) { %>
 (function() {
 if (!sessionStorage.getItem('pw_popup_dismissed')) {
 setTimeout(function() { openPathwayPopup(); }, 800);
 }
 })();
 <% } %>

 /* ── Pathway selection ── */
 var _pwMeta = {
 web3_jobs: { fa:'fa-briefcase', name:'Web3 Jobs', color:'rgba(251,191,36,0.15)', border:'rgba(251,191,36,0.35)', text:'#fbbf24' },
 ai: { fa:'fa-microchip', name:'AI & Web3', color:'rgba(168,85,247,0.12)', border:'rgba(168,85,247,0.35)', text:'#c084fc' },
 trading: { fa:'fa-chart-line', name:'Trading', color:'rgba(16,185,129,0.10)', border:'rgba(16,185,129,0.35)', text:'#10b981' },
 nft: { fa:'fa-image', name:'NFTs & Digital Assets', color:'rgba(236,72,153,0.10)', border:'rgba(236,72,153,0.35)', text:'#f472b6' }
 };

 function selectPathway(pw) {
 var opts = document.querySelectorAll('.pw-opt');
 opts.forEach(function(b){ b.disabled = true; b.style.opacity = '.5'; });
 var msg = document.getElementById('pwSelectMsg');
 msg.style.display = 'block';
 msg.style.color = 'var(--text-3)';
 msg.textContent = 'Saving your pathway...';

 fetch('/dashboard/select-pathway', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ pathway: pw })
 })
 .then(function(r){ return r.json(); })
 .then(function(d) {
 if (!d.success) {
 msg.style.color = '#ef4444';
 msg.textContent = d.message || 'Error saving. Try again.';
 opts.forEach(function(b){ b.disabled = false; b.style.opacity = '1'; });
 return;
 }
 // Store community link for joinCommunity()
 if (d.groupLink) _communityLink = d.groupLink;

 // Swap select card for success card
 var meta = _pwMeta[pw] || _pwMeta.web3_jobs;
 document.getElementById('pathwaySelectCard').style.display = 'none';
 var sc = document.getElementById('pathwaySuccessCard');
 sc.style.background = meta.color;
 sc.style.borderColor = meta.border;
 sc.style.padding = '1rem 1.375rem';
 sc.style.display = 'flex';
 sc.style.alignItems = 'center';
 sc.style.gap = '1rem';

 if (d.status === 'auto_approved') {
 sc.innerHTML =
 '<i class="fas ' + meta.fa + '" style="font-size:1.375rem;color:' + meta.text + ';flex-shrink:0"></i>' +
 '<div style="flex:1">' +
 '<p style="font-size:.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-3);margin-bottom:.2rem">Your Pathway</p>' +
 '<p style="font-size:1rem;font-weight:800;color:' + meta.text + '">' + meta.name + '</p>' +
 '</div>' +
 '<button type="button" onclick="joinCommunity()" style="font-size:.8rem;padding:.5rem 1rem;border-radius:8px;border:1px solid ' + meta.border + ';color:' + meta.text + ';cursor:pointer;background:none;font-family:Outfit,sans-serif;font-weight:700">' +
 '<i class="fas fa-users"></i> Join Community' +
 '</button>';
 } else {
 sc.innerHTML =
 '<i class="fas ' + meta.fa + '" style="font-size:1.375rem;color:' + meta.text + ';flex-shrink:0"></i>' +
 '<div style="flex:1">' +
 '<p style="font-size:.72rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-3);margin-bottom:.2rem">Your Pathway</p>' +
 '<p style="font-size:1rem;font-weight:800;color:' + meta.text + '">' + meta.name + '</p>' +
 '</div>' +
 '<span style="font-size:.75rem;font-weight:700;padding:.375rem .75rem;border-radius:99px;background:rgba(245,158,11,.15);color:#f59e0b;border:1px solid rgba(245,158,11,.3)">' +
 '<i class="fas fa-clock"></i> Under Review' +
 '</span>';
 }
 })
 .catch(function() {
 msg.style.color = '#ef4444';
 msg.textContent = 'Network error. Please try again.';
 opts.forEach(function(b){ b.disabled = false; b.style.opacity = '1'; });
 });
 }
 </script>

