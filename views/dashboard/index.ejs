 .spost-btn.like-btn.liked { color:#f43f5e; }
 .spost-btn.like-btn.liked i { animation:heartPop .35s cubic-bezier(.34,1.56,.64,1); }
 @keyframes heartPop{0%{transform:scale(1)}40%{transform:scale(1.45)}100%{transform:scale(1)}}
 .spost-btn.like-btn:hover { background:rgba(244,63,94,.08);color:#f43f5e; }
 .spost-view-link {
