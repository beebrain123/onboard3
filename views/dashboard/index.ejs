<style>
 .wq-overlay {
 position: fixed; inset: 0; z-index: 10000;
 background: rgba(0,0,0,.92); backdrop-filter: blur(8px);
 display: flex; align-items: center; justify-content: center; padding: 1rem;
 animation: wqFadeIn .4s ease both;
 }
 @keyframes wqFadeIn { from{opacity:0} to{opacity:1} }
 .wq-modal {
 background: linear-gradient(160deg,rgba(14,22,14,.99),rgba(8,14,8,.99));
 border: 1px solid rgba(94,194,19,.3); border-radius: 24px;
 padding: 2.25rem 2rem; max-width: 520px; width: 100%;
 box-shadow: 0 30px 90px rgba(0,0,0,.6), 0 0 60px rgba(94,194,19,.07);
 animation: wqSlideUp .45s cubic-bezier(.34,1.56,.64,1) both;
 max-height: 90vh; overflow-y: auto;
 }
 @keyframes wqSlideUp { from{opacity:0;transform:translateY(40px) scale(.95)} to{opacity:1;transform:none} }
 .wq-header { text-align: center; margin-bottom: 1.75rem; }
 .wq-icon-ring {
 width: 72px; height: 72px; border-radius: 50%;
 background: rgba(94,194,19,.12); border: 2px solid rgba(94,194,19,.4);
 display: inline-flex; align-items: center; justify-content: center;
 font-size: 1.875rem; margin-bottom: 1rem;
 animation: wqPulse 2.2s ease-in-out infinite;
 }
 @keyframes wqPulse { 0%,100%{box-shadow:0 0 0 0 rgba(94,194,19,.4)} 50%{box-shadow:0 0 0 12px rgba(94,194,19,0)} }
 .wq-title { font-size: 1.5rem; font-weight: 900; letter-spacing: -.5px; color: var(--text); margin-bottom: .5rem; }
 .wq-teaser { font-size: .875rem; color: var(--text-3); line-height: 1.6; }
 .wq-rewards-strip {
 display: flex; gap: .625rem; justify-content: center; flex-wrap: wrap; margin: 1.25rem 0;
 }
 .wq-reward-pill {
 padding: .4rem 1rem; border-radius: 50px; font-size: .8rem; font-weight: 800;
 display: flex; align-items: center; gap: .375rem;
 }
 .wq-reward-pill--usdc { background: rgba(94,194,19,.12); border: 1px solid rgba(94,194,19,.3); color: var(--green); }
 .wq-reward-pill--xp { background: rgba(251,191,36,.12); border: 1px solid rgba(251,191,36,.3); color: #fbbf24; }
 .wq-tasks { display: flex; flex-direction: column; gap: .625rem; margin-bottom: 1.5rem; }
 .wq-task {
 display: flex; align-items: flex-start; gap: .875rem;
 padding: .875rem 1rem; border-radius: 14px;
 background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
 text-decoration: none; transition: border-color .2s, background .2s;
 }
 .wq-task:hover { background: rgba(94,194,19,.06); border-color: rgba(94,194,19,.25); }
 .wq-task-num {
 width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
 background: rgba(94,194,19,.15); border: 1px solid rgba(94,194,19,.3);
 display: flex; align-items: center; justify-content: center;
 font-size: .75rem; font-weight: 900; color: var(--green);
 }
 .wq-task-body { flex: 1; min-width: 0; }
 .wq-task-title { font-size: .9rem; font-weight: 800; color: var(--text); margin-bottom: .2rem; }
 .wq-task-desc { font-size: .775rem; color: var(--text-3); line-height: 1.55; }
 .wq-task-meta { display: flex; gap: .5rem; margin-top: .375rem; flex-wrap: wrap; }
 .wq-xp-badge { font-size: .65rem; font-weight: 800; padding: .15rem .55rem; border-radius: 50px; background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.25); }
 .wq-cta-btn { font-size: .7rem; font-weight: 800; padding: .2rem .7rem; border-radius: 50px; background: rgba(94,194,19,.12); color: var(--green); border: 1px solid rgba(94,194,19,.3); white-space: nowrap; }
 .wq-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
 .wq-start-btn {
 flex: 1; padding: .875rem 1.5rem; border-radius: 14px; border: none; cursor: pointer;
 background: var(--green); color: #000; font-size: .9375rem; font-weight: 900;
 font-family: 'Outfit',sans-serif; letter-spacing: -.2px;
 transition: opacity .2s, transform .1s;
 }
 .wq-start-btn:hover { opacity: .88; transform: translateY(-1px); }
 .wq-skip-btn {
 padding: .875rem 1.125rem; border-radius: 14px; border: 1px solid var(--border);
 background: transparent; color: var(--text-3); font-size: .85rem; font-weight: 700;
 font-family: 'Outfit',sans-serif; cursor: pointer; white-space: nowrap; transition: all .2s;
 }
 .wq-skip-btn:hover { background: rgba(255,255,255,.05); color: var(--text-2); }
 .wq-skip-btn:disabled { opacity: .35; cursor: not-allowed; pointer-events: none; }
 .wq-skip-timer { font-size: .72rem; color: var(--text-3); margin-top: .375rem; text-align: right; }
</style>

<div class="wq-overlay" id="wqOverlay">
 <div class="wq-modal">
 <div class="wq-header">
 <div class="wq-icon-ring"><i class="fas fa-gift"></i></div>
 <h2 class="wq-title"><%- welcomeQuest.title %></h2>
 <p class="wq-teaser"><%- welcomeQuest.teaser %></p>

 <% const totalXp = welcomeQuest.tasks.reduce(function(s,t){ return s + (t.xpReward||0); }, 0);
 const totalUsdc = welcomeQuest.tasks.reduce(function(s,t){ return s + (t.usdcReward||0); }, 0); %>
 <div class="wq-rewards-strip">
 <% if (totalXp > 0) { %>
 <span class="wq-reward-pill wq-reward-pill--xp"><i class="fas fa-bolt"></i> +<%= totalXp.toLocaleString() %> XP</span>
 <% } %>
 <% if (totalUsdc > 0) { %>
 <span class="wq-reward-pill wq-reward-pill--usdc"><i class="fas fa-dollar-sign"></i> +$<%= totalUsdc.toFixed(2) %> USDC</span>
 <% } %>
 </div>
 </div>

 <div class="wq-tasks">
 <% welcomeQuest.tasks.sort(function(a,b){ return a.order-b.order; }).forEach(function(task, i) { %>
 <% if (task.link) { %>
 <a href="<%- task.link %>" target="_blank" rel="noopener" class="wq-task">
 <% } else { %>
 <div class="wq-task">
 <% } %>
 <div class="wq-task-num"><%= i+1 %></div>
 <div class="wq-task-body">
 <div class="wq-task-title"><%- task.title %></div>
 <% if (task.description) { %><div class="wq-task-desc"><%- task.description %></div><% } %>
 <div class="wq-task-meta">
 <% if (task.xpReward > 0) { %><span class="wq-xp-badge"><i class="fas fa-bolt"></i> +<%= task.xpReward %> XP</span><% } %>
 <% if (task.usdcReward > 0) { %><span class="wq-xp-badge" style="background:rgba(94,194,19,.12);color:var(--green);border-color:rgba(94,194,19,.25)"><i class="fas fa-dollar-sign"></i> +$<%= task.usdcReward.toFixed(2) %></span><% } %>
 <% if (task.link) { %><span class="wq-cta-btn"><%- task.linkLabel || 'Go' %> <i class="fas fa-arrow-right" style="font-size:.6rem"></i></span><% } %>
 </div>
 </div>
 <% if (task.link) { %></a><% } else { %></div><% } %>
 <% }); %>
 </div>

 <div class="wq-footer">
 <button class="wq-start-btn" onclick="dismissWelcomeQuest()">
 <i class="fas fa-rocket"></i> Got it, let's go!
 </button>
 <div>
 <button class="wq-skip-btn" id="wqSkipBtn" disabled onclick="dismissWelcomeQuest()">
 Skip for now
 </button>
 <div class="wq-skip-timer" id="wqSkipTimer">Skip available in <span id="wqSkipCount">10</span>s</div>
 </div>
 </div>
 </div>
</div>

<script>
 (function() {
 let skipSeconds = 10;
 const skipBtn = document.getElementById('wqSkipBtn');
 const skipTimer = document.getElementById('wqSkipTimer');
 const skipCount = document.getElementById('wqSkipCount');

 const timer = setInterval(function() {
 skipSeconds--;
 if (skipSeconds <= 0) {
 clearInterval(timer);
 skipBtn.disabled = false;
 skipTimer.style.display = 'none';
 } else {
 skipCount.textContent = skipSeconds;
 }
 }, 1000);
 })();

 async function dismissWelcomeQuest() {
 try {
 await fetch('/dashboard/welcome-quest/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
 } catch(e) {}
 const overlay = document.getElementById('wqOverlay');
 overlay.style.animation = 'wqFadeIn .3s ease reverse both';
 setTimeout(function() { overlay.remove(); }, 320);
 }
</script>
<% } %>

