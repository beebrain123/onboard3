 <script>
 let currentQuestId = null;
 let currentQuestData = {};

 function showQuestModal(id, title, desc, xp, usdc, difficulty, duration) {
 currentQuestId = id;
 currentQuestData = { id, title, desc, xp, usdc, difficulty, duration };
 document.getElementById('modalTitle').textContent = title;
 document.getElementById('modalDescription').textContent = desc;
 const stats = `
 <span style="background:rgba(94,194,19,0.1);padding:.5rem 1rem;border-radius:8px;color:var(--green);font-weight:600;font-size:.8rem"><i class="fas fa-bolt"></i> ${xp} XP</span>
 ${usdc > 0 ? `<span style="background:rgba(251,191,36,0.1);padding:.5rem 1rem;border-radius:8px;color:#fbbf24;font-weight:600;font-size:.8rem"><i class="fas fa-coins"></i> ${usdc} USDC</span>` : ''}
 <span style="background:rgba(255,255,255,0.05);padding:.5rem 1rem;border-radius:8px;color:var(--text-2);font-weight:600;font-size:.8rem">${difficulty}</span>
 <span style="background:rgba(255,255,255,0.05);padding:.5rem 1rem;border-radius:8px;color:var(--text-2);font-weight:600;font-size:.8rem"><i class="fas fa-clock"></i> ${duration}</span>
 `;
 document.getElementById('modalStats').innerHTML = stats;
 document.getElementById('modalStartBtn').onclick = () => startQuest(id);
 document.getElementById('questModal').classList.add('show');
 }

 function closeQuestModal() {
 document.getElementById('questModal').classList.remove('show');
 currentQuestId = null;
 }

 async function startQuest(questId) {
 closeQuestModal();
 showCustomModal('loading');
 try {
 const response = await fetch('/dashboard/quests/start', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ questId })
 });
 const data = await response.json();
 if (data.success) {
 setTimeout(() => showCustomModal('success', questId), 1000);
 } else if (data.requiresConnection) {
 // Social connection required — show gate banner instead of generic error
 closeCustomModal();
 const parts = [];
 if (data.missingX) parts.push('<a href="/auth/twitter" style="color:#5EC213;font-weight:700;text-decoration:none"><i class="fab fa-x-twitter"></i> Connect X</a>');
 if (data.missingTg) parts.push('<a href="https://t.me/onboard3bot" target="_blank" style="color:#1d9bf0;font-weight:700;text-decoration:none"><i class="fab fa-telegram"></i> Connect Telegram</a>');
 const gate = document.getElementById('questGateBanner');
 if (gate) {
 gate.style.display = 'block';
 gate.innerHTML = '<div style="background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.3);border-radius:14px;padding:1.25rem 1.375rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap"><i class="fas fa-lock" style="color:#f87171;font-size:1.125rem;flex-shrink:0"></i><div style="flex:1"><p style="font-weight:800;color:var(--text);margin-bottom:.25rem;font-size:.9rem">Social accounts required</p><p style="font-size:.8125rem;color:var(--text-2)">' + data.message + '</p></div><div style="display:flex;gap:.625rem;flex-wrap:wrap">' + parts.join('') + '</div></div>';
 gate.scrollIntoView({ behavior:'smooth', block:'center' });
 }
 } else {
 setTimeout(() => showCustomModal('error', null, data.message || 'Failed to start quest'), 800);
 }
 } catch (error) {
 console.error('Error starting quest:', error);
 setTimeout(() => showCustomModal('error', null, 'Network error. Please check your connection.'), 800);
 }
 }

 function showCustomModal(state, questId = null, errorMsg = null) {
 const modal = document.getElementById('customModal');
 document.getElementById('loadingState').style.display = 'none';
 document.getElementById('successState').style.display = 'none';
 document.getElementById('errorState').style.display = 'none';
 modal.classList.add('show');
 if (state === 'loading') {
 document.getElementById('loadingState').style.display = 'flex';
 } else if (state === 'success') {
 document.getElementById('successState').style.display = 'flex';
 const usdcValue = currentQuestData.usdc || 0;
 const difficultyValue = currentQuestData.difficulty || 'Medium';
 document.getElementById('successDifficulty').textContent = difficultyValue;
 if (usdcValue > 0) {
 document.getElementById('successUSDCContainer').style.display = 'flex';
 document.getElementById('successUSDC').textContent = `${usdcValue} USDC`;
 } else {
 document.getElementById('successUSDCContainer').style.display = 'none';
 }
 setTimeout(() => { document.getElementById('successProgress').style.width = '100%'; }, 100);
 document.getElementById('continueBtn').onclick = () => { window.location.href = `/dashboard/quests/${questId}`; };
 } else if (state === 'error') {
 document.getElementById('errorState').style.display = 'flex';
 if (errorMsg) document.getElementById('errorMessage').textContent = errorMsg;
 }
 }

 function closeCustomModal() {
 document.getElementById('customModal').classList.remove('show');
 setTimeout(() => { document.getElementById('successProgress').style.width = '0%'; }, 300);
 }

 document.getElementById('questModal')?.addEventListener('click', function(e) { if (e.target === this) closeQuestModal(); });
 document.getElementById('customModal')?.addEventListener('click', function(e) { if (e.target === this) closeCustomModal(); });

 const observer = new MutationObserver((mutations) => {
 mutations.forEach((mutation) => {
 document.body.style.overflow = mutation.target.classList.contains('show') ? 'hidden' : '';
 });
 });
 const questModal = document.getElementById('questModal');
 const customModal = document.getElementById('customModal');
 if (questModal) observer.observe(questModal, { attributes: true, attributeFilter: ['class'] });
 if (customModal) observer.observe(customModal, { attributes: true, attributeFilter: ['class'] });

 /* Handle OAuth redirect results */
 (function() {
 const p = new URLSearchParams(window.location.search);
 if (p.get('twitter_connected') === '1') {
 showToast('X account connected! Quests are now unlocked.', 'success');
 history.replaceState({}, '', window.location.pathname);
 }
 if (p.get('discord_connected') === '1') {
 showToast('Discord connected! You can now verify Discord tasks.', 'success');
 history.replaceState({}, '', window.location.pathname);
 }
 const err = p.get('error');
 if (err) {
 const msgs = {
 twitter_denied: 'X authorization was cancelled.',
 twitter_failed: 'X connection failed. Please try again.',
 twitter_already_linked: 'This X account is already linked to another ONBOARD3 user.',
 twitter_invalid_state: 'Session expired. Please try again.',
 twitter_session_expired: 'Session expired. Please try again.',
 discord_denied: 'Discord authorization was cancelled.',
 discord_failed: 'Discord connection failed. Please try again.',
 discord_already_linked: 'This Discord account is already linked to another ONBOARD3 user.',
 discord_not_configured: 'Discord integration is not configured yet.',
 discord_session_expired: 'Session expired. Please try again.'
 };
 showToast(msgs[err] || 'Connection error. Please try again.', 'error');
 history.replaceState({}, '', window.location.pathname);
 }
 })();

 /* Animate progress bars after load */
 window.addEventListener('DOMContentLoaded', () => {
 setTimeout(() => {
 document.querySelectorAll('.qcard-bar-fill').forEach(bar => {
 const w = bar.style.width;
 bar.style.width = '0%';
 setTimeout(() => { bar.style.width = w; }, 100);
 });
 }, 200);
 });
 </script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
