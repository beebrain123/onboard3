<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Quests — ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <%- include('../partials/achievement-popup') %>
 <link rel="stylesheet" href="/css/dashboard.css">
 <style>
 /* ── Quest banner ── */
 .qcard-img {
 width: 100%; height: 148px; border-radius: 13px; overflow: hidden;
 margin-bottom: 0.25rem; position: relative; flex-shrink: 0;
 display: flex; align-items: center; justify-content: center;
 }

 /* ── Partner logo: centered + large, not stretched ── */
 .qcard-img--logo {
 background: linear-gradient(135deg, #0d190d 0%, #111c11 60%, #0f1d0e 100%);
 }
 .qcard-img--logo::before {
 content: '';
 position: absolute; inset: 0;
 background: radial-gradient(ellipse at center, rgba(94,194,19,0.08) 0%, transparent 70%);
 }
 .qcard-logo-wrap {
 position: relative; z-index: 1;
 width: 88px; height: 88px; border-radius: 22px; overflow: hidden;
 background: #fff; padding: 10px;
 box-shadow: 0 8px 32px rgba(0,0,0,0.55), 0 0 0 1.5px rgba(255,255,255,0.15);
 transition: transform 0.45s cubic-bezier(0.4,0,0.2,1), box-shadow 0.45s;
 }
 .qcard:hover .qcard-logo-wrap {
 transform: scale(1.08);
 box-shadow: 0 14px 44px rgba(0,0,0,0.6), 0 0 32px rgba(94,194,19,0.18), 0 0 0 2px rgba(94,194,19,0.3);
 }
 .qcard-logo-wrap img { width: 100%; height: 100%; object-fit: contain; border-radius: 12px; }

 /* ONBOARD3 default logo — dark bg, no white box */
 .qcard-logo-wrap--brand {
 background: rgba(94,194,19,0.12);
 border: 1.5px solid rgba(94,194,19,0.3);
 box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 24px rgba(94,194,19,0.15);
 }
 .qcard:hover .qcard-logo-wrap--brand {
 box-shadow: 0 14px 44px rgba(0,0,0,0.55), 0 0 40px rgba(94,194,19,0.28), 0 0 0 2px rgba(94,194,19,0.4);
 }

 /* Glow ring that pulses on card hover */
 .qcard-img--logo::after {
 content: '';
 position: absolute; inset: 0; border-radius: 13px;
 box-shadow: inset 0 0 40px rgba(94,194,19,0.04);
 transition: box-shadow 0.4s;
 }
 .qcard:hover .qcard-img--logo::after {
 box-shadow: inset 0 0 60px rgba(94,194,19,0.1);
 }

 /* ── Gradient fallback banners (no partner) ── */
 .qcard-img--social { background: linear-gradient(135deg, #1a1428, #0f2620); }
 .qcard-img--dev { background: linear-gradient(135deg, #0f1a2e, #0a1f18); }
 .qcard-img--learning { background: linear-gradient(135deg, #0e1a14, #131f10); }
 .qcard-img--community{ background: linear-gradient(135deg, #1a130e, #0f1a0a); }
 .qcard-img--special { background: linear-gradient(135deg, #1a0e1a, #0f1a14); }
 .qcard-img--nft { background: linear-gradient(135deg, #1a0e1a, #0f0a1a); }
 .qcard-img-icon {
 font-size: 3.25rem; opacity: 0.16; color: var(--green);
 animation: iconPulse 3s ease-in-out infinite;
 }
 @keyframes iconPulse { 0%,100%{opacity:.12} 50%{opacity:.22} }

 /* ── List item logo avatar ── */
 .qlist-logo {
 width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0;
 overflow: hidden; background: #fff; padding: 3px;
 box-shadow: 0 2px 8px rgba(0,0,0,0.4);
 border: 1px solid rgba(255,255,255,0.15);
 }
 .qlist-logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; }
 /* ONBOARD3 default — dark tinted bg instead of white */
 .qlist-logo--brand {
 background: rgba(94,194,19,0.1);
 border-color: rgba(94,194,19,0.25);
 box-shadow: none;
 }

 /* ── Quest grid ── */
 .quest-grid {
 display: grid;
 grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
 gap: 1.25rem;
 }
 @media (max-width: 700px) { .quest-grid { grid-template-columns: 1fr; } }

 /* ── Quest card ── */
 .qcard {
 background: var(--bg-card);
 border: 1px solid var(--border);
 border-radius: 18px;
 padding: 1.5rem;
 display: flex;
 flex-direction: column;
 gap: 1rem;
 position: relative;
 overflow: hidden;
 transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), border-color 0.3s, box-shadow 0.3s;
 animation: cardIn 0.5s cubic-bezier(0.4,0,0.2,1) both;
 cursor: pointer;
 text-decoration: none;
 color: inherit;
 }
 .qcard:hover {
 transform: translateY(-5px);
 border-color: rgba(94,194,19,0.35);
 box-shadow: 0 16px 48px rgba(0,0,0,0.35), 0 0 0 1px rgba(94,194,19,0.1);
 }
 .qcard::before {
 content: '';
 position: absolute;
 top: 0; left: -100%; right: 0; height: 2px;
 background: linear-gradient(90deg, transparent, var(--green), var(--green-light), var(--green), transparent);
 transition: left 0.5s cubic-bezier(0.4,0,0.2,1);
 }
 .qcard:hover::before { left: 0; }

 /* ── Card top row ── */
 .qcard-top {
 display: flex;
 align-items: flex-start;
 justify-content: space-between;
 gap: 0.75rem;
 }
 .qcard-icon {
 width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
 background: rgba(94,194,19,0.12); border: 1px solid rgba(94,194,19,0.25);
 display: flex; align-items: center; justify-content: center;
 font-size: 1.125rem; color: var(--green);
 }
 .qcard-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; }
 .qbadge {
 font-size: 0.68rem; font-weight: 800; letter-spacing: 0.5px;
 padding: 0.25rem 0.625rem; border-radius: 50px; white-space: nowrap;
 }
 .qbadge--xp { background: rgba(94,194,19,0.15); color: var(--green); border: 1px solid rgba(94,194,19,0.3); }
 .qbadge--usdc{ background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }
 .qbadge--easy { background: rgba(94,194,19,0.12); color: var(--green-light); border: 1px solid rgba(94,194,19,0.2); }
 .qbadge--medium{ background: rgba(251,146,60,0.12); color: #fb923c; border: 1px solid rgba(251,146,60,0.2); }
 .qbadge--hard { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
 .qbadge--done { background: rgba(94,194,19,0.18); color: var(--green); border: 1px solid rgba(94,194,19,0.4); }
 .qbadge--ended { background: rgba(100,100,100,0.15); color: #888; border: 1px solid rgba(100,100,100,0.2); }
 .qbadge--active{ background: rgba(251,146,60,0.15); color: #fb923c; border: 1px solid rgba(251,146,60,0.25);
 animation: activePulse 2s ease-in-out infinite; }
 @keyframes activePulse { 0%,100%{box-shadow:0 0 0 0 rgba(251,146,60,.3)} 50%{box-shadow:0 0 0 5px rgba(251,146,60,0)} }

 /* ── Card body ── */
 .qcard-title {
 font-size: 1rem; font-weight: 800; color: var(--text);
 letter-spacing: -0.3px; line-height: 1.35;
 }
 .qcard-desc {
 font-size: 0.8375rem; color: var(--text-2); line-height: 1.65;
 display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
 }

 /* ── Progress ── */
 .qcard-progress-wrap { margin-top: auto; }
 .qcard-progress-meta {
 display: flex; justify-content: space-between; margin-bottom: 0.4rem;
 font-size: 0.75rem; font-weight: 700;
 }
 .qcard-progress-meta .tasks { color: var(--text-3); }
 .qcard-progress-meta .pct { color: var(--green); }
 .qcard-bar { height: 6px; background: rgba(255,255,255,0.07); border-radius: 99px; overflow: hidden; }
 .qcard-bar-fill {
 height: 100%; border-radius: 99px;
 background: linear-gradient(90deg, var(--green-dark), var(--green));
 box-shadow: 0 0 8px rgba(94,194,19,0.4);
 transition: width 1s cubic-bezier(0.4,0,0.2,1);
 }

 /* ── Card footer ── */
 .qcard-foot {
 display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
 padding-top: 0.875rem; border-top: 1px solid rgba(255,255,255,0.06);
 margin-top: auto;
 }
 .qcard-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
 .qcard-meta-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 600; color: var(--text-3); }
 .qcard-meta-item i { font-size: 0.7rem; color: var(--text-3); }

 .qcard-btn {
 display: inline-flex; align-items: center; gap: 0.4rem;
 padding: 0.55rem 1.1rem; border-radius: 9px; font-size: 0.8125rem; font-weight: 800;
 border: none; cursor: pointer; font-family: 'Outfit', sans-serif;
 transition: all 0.25s cubic-bezier(0.4,0,0.2,1); white-space: nowrap; flex-shrink: 0;
 }
 .qcard-btn--start {
 background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
 color: #000; box-shadow: 0 3px 14px rgba(94,194,19,0.35);
 }
 .qcard-btn--start:hover { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(94,194,19,0.5); }
 .qcard-btn--view {
 background: rgba(255,255,255,0.06); color: var(--text-2);
 border: 1px solid var(--border);
 }
 .qcard-btn--view:hover { background: rgba(94,194,19,0.08); color: var(--text); border-color: rgba(94,194,19,0.3); }

 /* ── Completed / Past compact list ── */
 .qlist { display: flex; flex-direction: column; gap: 0.625rem; }
 .qlist-item {
 display: flex; align-items: center; gap: 1rem;
 padding: 0.875rem 1rem; border-radius: 12px;
 background: rgba(255,255,255,0.025); border: 1px solid var(--border);
 text-decoration: none; color: inherit;
 transition: all 0.25s; cursor: pointer;
 }
 .qlist-item:hover { background: rgba(94,194,19,0.05); border-color: rgba(94,194,19,0.25); }
 .qlist-icon { width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 0.875rem; }
 .qlist-icon--done { background: rgba(94,194,19,0.15); color: var(--green); }
 .qlist-icon--past { background: rgba(100,100,100,0.12); color: #888; }
 .qlist-body { flex: 1; min-width: 0; }
 .qlist-title { font-size: 0.875rem; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .qlist-sub { font-size: 0.75rem; color: var(--text-3); margin-top: 1px; }
 .qlist-right { flex-shrink: 0; text-align: right; }

 /* ── Stats summary row ── */
 .quest-stats-row {
 display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
 }
 .qs-box {
 background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px;
 padding: 1.25rem; text-align: center;
 animation: cardIn 0.5s cubic-bezier(0.4,0,0.2,1) both;
 }
 .qs-val { font-size: 2rem; font-weight: 900; letter-spacing: -1px; color: var(--text); }
 .qs-val span { color: var(--green); }
 .qs-lbl { font-size: 0.72rem; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 1px; margin-top: 0.25rem; }

 /* ── Section header ── */
 .section-row {
 display: flex; align-items: center; justify-content: space-between;
 margin-bottom: 1rem;
 }
 .section-row h3 {
 font-size: 1rem; font-weight: 800; color: var(--text); letter-spacing: -0.2px;
 display: flex; align-items: center; gap: 0.5rem;
 }
 .section-row h3 i { color: var(--green); font-size: 0.875rem; }
 .section-count {
 font-size: 0.78rem; font-weight: 700; color: var(--text-3);
 background: rgba(255,255,255,0.05); border: 1px solid var(--border);
 padding: 0.25rem 0.7rem; border-radius: 50px;
 }

 /* ── Modals (keep original modal styles) ── */
 .custom-modal-overlay {
 display: none; position: fixed; inset: 0;
 background: rgba(0,0,0,0.88); backdrop-filter: blur(8px);
 z-index: 9999; justify-content: center; align-items: center;
 opacity: 0; transition: opacity 0.3s;
 }
 .custom-modal-overlay.show { display: flex; opacity: 1; }

 .custom-modal {
 background: var(--bg-card); border: 1px solid var(--border);
 border-radius: 22px; padding: 2.5rem; max-width: 480px; width: 92%;
 text-align: center;
 box-shadow: 0 24px 80px rgba(0,0,0,0.5), 0 0 40px rgba(94,194,19,0.1);
 animation: modalIn 0.35s cubic-bezier(0.4,0,0.2,1) both;
 }
 @keyframes modalIn { from{opacity:0;transform:translateY(20px) scale(0.96)} to{opacity:1;transform:translateY(0) scale(1)} }

 .preview-modal {
 background: var(--bg-card); border: 1px solid var(--border);
 border-radius: 22px; padding: 2rem; max-width: 520px; width: 92%;
 box-shadow: 0 24px 80px rgba(0,0,0,0.5);
 animation: modalIn 0.35s cubic-bezier(0.4,0,0.2,1) both;
 }
 .preview-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
 .preview-modal-header h3 { font-size: 1.25rem; font-weight: 800; color: var(--text); letter-spacing: -0.3px; }
 .preview-modal-body { margin-bottom: 1.25rem; }
 .preview-modal-body p { color: var(--text-2); font-size: 0.9375rem; line-height: 1.7; margin-bottom: 1rem; }
 .preview-modal-stats { display: flex; gap: 0.625rem; flex-wrap: wrap; }
 .preview-modal-footer { display: flex; gap: 0.75rem; justify-content: flex-end; }

 .close-btn {
 width: 32px; height: 32px; border-radius: 8px; border: none; cursor: pointer;
 background: rgba(255,255,255,0.07); border: 1px solid var(--border);
 color: var(--text-2); font-size: 1rem; display: flex; align-items: center; justify-content: center;
 transition: all 0.2s;
 }
 .close-btn:hover { background: rgba(255,255,255,0.12); color: var(--text); transform: rotate(90deg); }

 /* modal states */
 .modal-loading, .modal-success, .modal-error {
 display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
 }
 .loading-spinner {
 width: 60px; height: 60px; border: 3px solid rgba(94,194,19,0.2);
 border-top-color: var(--green); border-radius: 50%; animation: spin 0.9s linear infinite;
 }
 @keyframes spin { to { transform: rotate(360deg); } }
 .modal-loading h3, .modal-success h3 { font-size: 1.375rem; font-weight: 800; color: var(--green); }
 .modal-error h3 { font-size: 1.375rem; font-weight: 800; color: #f87171; }
 .modal-loading p, .modal-success p, .modal-error p { color: var(--text-2); font-size: 0.9rem; }

 .success-icon { width: 72px; height: 72px; background: rgba(94,194,19,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; animation: popIn 0.5s ease; }
 .success-icon i { font-size: 2.5rem; color: var(--green); }
 @keyframes popIn { 0%{transform:scale(0)} 50%{transform:scale(1.1)} 100%{transform:scale(1)} }
 .error-icon { width: 72px; height: 72px; background: rgba(239,68,68,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
 .error-icon i { font-size: 2.5rem; color: #f87171; }

 .quest-info { background: rgba(94,194,19,0.07); border: 1px solid rgba(94,194,19,0.2); border-radius: 12px; padding: 1rem; width: 100%; text-align: left; }
 .quest-info-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem; }
 .quest-info-item:last-child { margin-bottom: 0; }
 .quest-info-label { color: var(--text-2); font-size: 0.875rem; }
 .quest-info-value { color: var(--green); font-weight: 700; font-size: 0.9rem; }

 .modal-progress { width: 100%; height: 5px; background: rgba(255,255,255,0.08); border-radius: 99px; overflow: hidden; }
 .modal-progress-fill { height: 100%; background: linear-gradient(90deg, var(--green-dark), var(--green)); width: 0%; transition: width 2s ease; }

 .modal-btn {
 padding: 0.8rem 1.75rem; border: none; border-radius: 11px;
 font-weight: 800; font-size: 0.9rem; cursor: pointer; transition: all 0.25s;
 font-family: 'Outfit', sans-serif;
 }
 .modal-btn-primary {
 background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
 color: #000; box-shadow: 0 4px 16px rgba(94,194,19,0.35);
 }
 .modal-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(94,194,19,0.5); }
 .modal-btn-secondary {
 background: rgba(255,255,255,0.07); color: var(--text-2); border: 1px solid var(--border);
 }
 .modal-btn-secondary:hover { background: rgba(255,255,255,0.12); color: var(--text); }

 @media (max-width: 600px) {
 .quest-stats-row { grid-template-columns: 1fr 1fr; }
 .preview-modal-footer { flex-direction: column; }
 .modal-btn { width: 100%; }
 }

 /* ── Empty state ── */
 .quest-empty {
 text-align: center; padding: 3rem 1rem;
 display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
 }
 .quest-empty-icon { font-size: 2.5rem; color: var(--text-3); }
 .quest-empty p { color: var(--text-3); font-size: 0.9rem; }
 </style>
</head>
<body>
 <div class="grid-bg"></div>

 <% const currentPage = 'quests'; %>
 <%- include('../partials/sidebar', { user, currentPage }) %>

 <div class="dashboard-container">
 <main class="main-content">

 <!-- Header -->
 <header class="header">
 <div class="header-content">
 <div class="header-title">
 <h2><i class="fas fa-trophy" style="color:var(--green);margin-right:.5rem"></i>Quests</h2>
 <p>Complete quests to earn XP and unlock rewards</p>
 </div>
 <div class="header-stats">
 <div class="stat-badge">
 <i class="fas fa-bolt" style="color:var(--green)"></i>
 <span><%= (user.xp || 0).toLocaleString() %> XP</span>
 </div>
 <div class="stat-badge">
 <i class="fas fa-check-double" style="color:var(--green)"></i>
 <span><%= completedCount %> Completed</span>
 </div>
 </div>
 </div>
 </header>

 <div class="content">

 <%
 const missingX = !user.twitterConnected;
 const missingTg = !user.telegramConnected;
 const isGated = false;
 %>

 <% if (isGated) { %>
 <!-- ══ HARD GATE — completely replaces quest content ══ -->
 <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:2rem 0">
 <div style="max-width:520px;width:100%;text-align:center;animation:cardIn .6s ease both">

 <!-- Lock icon -->
 <div style="width:80px;height:80px;border-radius:22px;background:rgba(239,68,68,0.1);border:1.5px solid rgba(239,68,68,0.3);display:flex;align-items:center;justify-content:center;font-size:2rem;color:#f87171;margin:0 auto 1.5rem;box-shadow:0 0 32px rgba(239,68,68,0.15)">
 <i class="fas fa-lock"></i>
 </div>

 <h2 style="font-size:1.5rem;font-weight:900;color:var(--text);letter-spacing:-.5px;margin-bottom:.625rem">Quests are locked</h2>
 <p style="font-size:.9375rem;color:var(--text-2);line-height:1.7;margin-bottom:2rem">
 Connect your <strong style="color:var(--text)">X account</strong> and <strong style="color:var(--text)">Telegram</strong> to unlock all quests and start earning XP and USDC rewards. Both are free and take under 2 minutes.
 </p>

 <!-- Step cards -->
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.75rem;text-align:left">

 <!-- X card -->
 <div style="padding:1.25rem;border-radius:16px;background:<%=missingX?'rgba(255,255,255,0.03)':'rgba(94,194,19,0.07)'%>;border:1.5px solid <%=missingX?'rgba(255,255,255,0.1)':'rgba(94,194,19,0.3)'%>">
 <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.75rem">
 <div style="width:34px;height:34px;border-radius:9px;background:<%=missingX?'rgba(255,255,255,.07)':'rgba(94,194,19,.15)'%>;display:flex;align-items:center;justify-content:center;color:<%=missingX?'var(--text)':'var(--green)'%>;font-size:.9375rem">
 <i class="fab fa-x-twitter"></i>
 </div>
 <span style="font-weight:800;font-size:.9rem;color:<%=missingX?'var(--text)':'var(--green)'%>">X Account</span>
 <% if (!missingX) { %><i class="fas fa-check-circle" style="color:var(--green);margin-left:auto"></i><% } %>
 </div>
 <% if (missingX) { %>
 <a href="/auth/twitter/connect" style="display:block;width:100%;padding:.6rem;border-radius:9px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);color:var(--text);text-decoration:none;font-size:.8125rem;font-weight:700;text-align:center;transition:all .25s" onmouseover="this.style.background='rgba(255,255,255,.13)'" onmouseout="this.style.background='rgba(255,255,255,.07)'">
 <i class="fab fa-x-twitter" style="margin-right:.3rem"></i> Sign in with X
 </a>
 <p style="font-size:.7rem;color:var(--text-3);margin-top:.5rem">You'll be redirected to X to authorize</p>
 <% } else { %>
 <p style="font-size:.78rem;color:var(--green);font-weight:700"><i class="fas fa-check"></i> @<%= user.twitter %> linked</p>
 <% } %>
 </div>

 <!-- Telegram card -->
 <div style="padding:1.25rem;border-radius:16px;background:<%=missingTg?'rgba(255,255,255,0.03)':'rgba(94,194,19,0.07)'%>;border:1.5px solid <%=missingTg?'rgba(255,255,255,0.1)':'rgba(94,194,19,0.3)'%>">
 <div style="display:flex;align-items:center;gap:.625rem;margin-bottom:.75rem">
 <div style="width:34px;height:34px;border-radius:9px;background:<%=missingTg?'rgba(29,161,242,.1)':'rgba(94,194,19,.15)'%>;display:flex;align-items:center;justify-content:center;color:<%=missingTg?'#1d9bf0':'var(--green)'%>;font-size:.9375rem">
 <i class="fab fa-telegram"></i>
 </div>
 <span style="font-weight:800;font-size:.9rem;color:<%=missingTg?'var(--text)':'var(--green)'%>">Telegram</span>
