 <script>

 /* Auto-poll connection status after user opens Telegram bot */
 let _tgPollTimer = null;
 function startTgPolling() {
 if (_tgPollTimer) return;
 const status = document.getElementById('tgPollStatus');
 let dots = 0;
 _tgPollTimer = setInterval(async () => {
 dots = (dots + 1) % 4;
 if (status) status.textContent = 'Checking connection' + '.'.repeat(dots);
 try {
 const r = await fetch('/dashboard/settings/connection-status');
 const d = await r.json();
 if (d.telegramConnected) {
 clearInterval(_tgPollTimer);
 if (status) status.textContent = 'Connected! Refreshing...';
 showToast('Telegram connected! Unlocking quests...', 'success');
 setTimeout(() => window.location.reload(), 1200);
 }
 } catch(_) {}
 }, 3000);
 // Stop polling after 3 minutes
 setTimeout(() => { clearInterval(_tgPollTimer); _tgPollTimer = null; if(status) status.textContent = 'Start the bot — page auto-refreshes when connected'; }, 180000);
 }
 </script>
 <% } %>

