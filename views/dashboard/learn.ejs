 <div class="grid-bg"></div>

 <!-- Include Sidebar -->
 <% const currentPage = 'learn'; %>
 <%- include('../partials/sidebar', { user, currentPage }) %>

 <div class="dashboard-container">
 <main class="main-content">
 <header class="header">
 <div class="header-content">
 <div class="header-title">
 <h2>Learn & Apply </h2>
 <p>Registration CLosed</p>
 </div>
 </div>
 </header>

 <div class="content">
 <!-- My Applications -->
 <div class="card">
 <div class="card-header">
 <h3><i class="fas fa-list-check"></i> My Applications</h3>
 </div>
 <div id="myApplicationsContainer">
 <p style="color: #888; text-align: center; padding: 2rem;">Loading...</p>
 </div>
 </div>

 Apply for Courses
 <div class="card">
 <div class="card-header">
 <h3><i class="fas fa-graduation-cap"></i> Apply for Courses</h3>
 </div>
 <p style="color: #888; margin-bottom: 2rem;">This is more than a class; it’s a guided mentorship that takes you from beginner to expert.</p>

 <form id="courseApplicationForm">
 <div class="form-group">
 <label>Select Course *</label>
 <select id="courseSelect" required>
 <option value="">-- Choose a course --</option>
 <option value="Content Creation">Content Creation</option>
 <option value="Community Management">Community Management</option>
 <option value="Frontend Development">Frontend Development</option>
 <option value="Web3 Survival Course">Web3 Survival Course</option>
 </select>
 </div>

 <div class="form-group">
 <label>Full Name *</label>
 <input type="text" id="fullName" placeholder="John Doe" required>
 </div>

 <div class="form-group">
 <label>Email Address *</label>
 <input type="email" id="email" placeholder="john@example.com" required>
 </div>

 <div class="form-group">
 <label>Twitter/X Handle</label>
 <input type="text" id="twitter" placeholder="@yourusername">
 </div>

 <div class="form-group">
 <label>Why do you want to join this course? *</label>
 <textarea id="motivation" placeholder="Tell us about your goals and what you hope to learn..." required></textarea>
 </div>

 <div class="form-group">
 <label>Previous Experience (if any)</label>
 <textarea id="experience" placeholder="Share any relevant experience or projects..."></textarea>
 </div>

 <button type="submit" class="btn btn-primary" style="width: 100%;">
 <i class="fas fa-paper-plane"></i> Submit Application
 </button>
 </form>
 </div>

