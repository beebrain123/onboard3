 <!-- ══ TASKS ══ -->
 <div class="card" style="animation-delay:100ms">
 <div class="card-header">
 <h3><i class="fas fa-list-check"></i> Tasks</h3>
 <span style="font-size:.78rem;font-weight:700;color:var(--text-3)"><%= userProgress.tasksCompleted %>/<%= quest.tasks.length %> done</span>
 </div>
 <div class="task-list">
 <% var usesDayGate = quest.tasks.some(function(t) { return t.availableFromDay > 0; }); %>
 <% quest.tasks.forEach(function(task, index) {
 var taskProgress = userProgress.taskProgress.find(function(tp) { return tp.taskId.toString() === task._id.toString(); });
 var isCompleted = taskProgress && taskProgress.isCompleted;
 var isPending = taskProgress && taskProgress.approvalStatus === 'pending';
 var isRejected = taskProgress && taskProgress.approvalStatus === 'rejected';
 var prevTask = index > 0 ? quest.tasks[index - 1] : null;
 var prevTaskProgress = prevTask ? userProgress.taskProgress.find(function(tp) { return tp.taskId.toString() === prevTask._id.toString(); }) : null;
 var isPreviousCompleted = index === 0 || (prevTaskProgress && (prevTaskProgress.isCompleted || prevTaskProgress.approvalStatus === 'pending'));
 var isDayLocked = false;
 var dayUnlockMs = 0;
 if (usesDayGate && task.availableFromDay > 0 && quest.startDate) {
   dayUnlockMs = new Date(quest.startDate).getTime() + task.availableFromDay * 24 * 60 * 60 * 1000;
   isDayLocked = Date.now() < dayUnlockMs;
 }
 var isLocked = usesDayGate ? (isDayLocked && !isCompleted && !isPending) : (!isPreviousCompleted && !isCompleted && !isPending);
 var isActive = !isCompleted && !isLocked && !isPending;
 var taskXp = task.xpReward || 0;
 var cardClass = isCompleted ? 'task-card--completed' : isPending ? 'task-card--pending' : isLocked ? 'task-card--locked' : 'task-card--active';
 %>
 <div class="task-card <%= cardClass %>" style="animation-delay:<%= index * 50 %>ms">
 <div class="task-card-head">
 <div class="task-num <%= isCompleted ? 'task-num--done' : isPending ? 'task-num--pending' : isLocked ? 'task-num--locked' : 'task-num--active' %>">
 <% if (isCompleted) { %><i class="fas fa-check"></i>
 <% } else if (isPending) { %><i class="fas fa-hourglass-half"></i>
 <% } else if (isLocked) { %><i class="fas fa-lock"></i>
 <% } else { %><span style="font-size:.875rem;font-weight:900"><%= index + 1 %></span><% } %>
 </div>
 <span class="task-card-title">Task <%= index + 1 %>: <%= task.title %></span>
 <% if (taskXp > 0) { %>
 <span class="task-xp-badge <%= isCompleted ? 'task-xp-badge--done' : isPending ? 'task-xp-badge--pending' : isLocked ? 'task-xp-badge--locked' : 'task-xp-badge--active' %>">
 <i class="fas fa-bolt"></i> <%= taskXp %> XP
 </span>
 <% } %>
 <span class="task-status-chip <%= isCompleted ? 'chip--done' : isPending ? 'chip--pending' : isLocked ? 'chip--locked' : 'chip--active' %>">
 <%= isCompleted ? 'Done' : isPending ? 'In Review' : isRejected ? 'Rejected' : isLocked ? 'Locked' : 'Active' %>
 </span>
 </div>
 <div class="task-card-body">
 <p class="task-desc"><%= task.description %></p>
 <% if (isCompleted) { %>
 <div class="task-meta">
 <span><i class="fas fa-clock"></i> Completed <%= new Date(taskProgress.completedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) %></span>
 <% if (taskProgress.xpEarned > 0) { %>
 <span><i class="fas fa-bolt"></i> Earned <%= taskProgress.xpEarned %> XP</span>
 <% } %>
 </div>
 <% } else if (isPending) { %>
 <div class="task-meta" style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);border-radius:10px;padding:.625rem .875rem">
 <span style="color:#f59e0b"><i class="fas fa-hourglass-half"></i> Submitted — pending admin review. XP will be credited once approved.</span>
 </div>
 <% } else if (isRejected) { %>
 <div class="task-meta" style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);border-radius:10px;padding:.625rem .875rem;margin-bottom:.75rem">
 <span style="color:#ef4444"><i class="fas fa-times-circle"></i> Submission rejected. Please resubmit with correct proof.</span>
 </div>
 <div class="task-actions-row">
 <button type="button" class="task-action-btn task-action-btn--primary submit-task-btn"
 data-task-id="<%= task._id %>"
 data-quest-id="<%= quest._id %>"
 data-task-title="<%= task.title.replace(/"/g, '&quot;') %>"
 data-input-label="<%= (task.inputLabel || '').replace(/"/g, '&quot;') %>"
 data-input-name="<%= (task.inputName || '').replace(/"/g, '&quot;') %>"
 data-input-type="<%= task.inputType || 'text' %>"
 data-has-button="false"
 data-twitter-target=""
 data-task-type="<%= task.taskType || 'submission' %>"
 data-poll-options="[]"
 data-discord-guild-id="" data-discord-guild-name=""
 data-telegram-chat-id="" data-telegram-chat-name=""
 data-webhook-url=""
 onclick="handleSubmitClick(this); return false;">
 <i class="fas fa-redo"></i> Resubmit
 </button>
 </div>
 <% } else if (isLocked) { %>
 <% if (isDayLocked) {
   var daysLeft = Math.ceil((dayUnlockMs - Date.now()) / (24 * 60 * 60 * 1000));
 %>
 <div class="locked-notice">
 <i class="fas fa-calendar-alt"></i> Unlocks on Day <%= task.availableFromDay + 1 %> of this quest<% if (daysLeft > 0) { %> — <%= daysLeft %> day<%= daysLeft !== 1 ? 's' : '' %> to go<% } %>
 </div>
 <% } else { %>
 <div class="locked-notice">
 <i class="fas fa-info-circle"></i> Complete Task <%= index %> to unlock this task
 </div>
 <% } %>
 <% } else { %>
 <div class="task-actions-row">
 <% if (task.buttonText && task.buttonLink) { %>
 <a href="<%= task.buttonLink %>" target="_blank" class="task-action-btn task-action-btn--secondary" onclick="trackTaskClick('<%= task._id %>')">
 <i class="fas fa-external-link-alt"></i> <%= task.buttonText %>
 </a>
 <% } %>
 <button type="button" class="task-action-btn task-action-btn--primary submit-task-btn"
 data-task-id="<%= task._id %>"
 data-quest-id="<%= quest._id %>"
 data-task-title="<%= task.title.replace(/"/g, '&quot;') %>"
 data-input-label="<%= (task.inputLabel || '').replace(/"/g, '&quot;') %>"
 data-input-name="<%= (task.inputName || '').replace(/"/g, '&quot;') %>"
 data-input-type="<%= task.inputType || 'text' %>"
 data-has-button="<%= !!task.buttonLink %>"
 data-twitter-target="<%= (task.twitterFollowTarget || '').replace(/"/g, '&quot;') %>"
 data-task-type="<%= task.taskType || 'submission' %>"
 data-poll-options="<%= encodeURIComponent(JSON.stringify(task.pollOptions || [])) %>"
 data-discord-guild-id="<%= task.discordGuildId || '' %>"
 data-discord-guild-name="<%= (task.discordGuildName || '').replace(/"/g, '&quot;') %>"
 data-telegram-chat-id="<%= task.telegramChatId || '' %>"
 data-telegram-chat-name="<%= (task.telegramChatName || '').replace(/"/g, '&quot;') %>"
 data-webhook-url="<%= task.webhookUrl || '' %>"
 onclick="handleSubmitClick(this); return false;">
 <% if (task.taskType === 'poll') { %>
 <i class="fas fa-poll"></i> Vote
 <% } else if (task.taskType === 'discord_join') { %>
 <i class="fab fa-discord"></i> Verify Discord
 <% } else if (task.taskType === 'telegram_join') { %>
 <i class="fab fa-telegram"></i> Verify Telegram
 <% } else if (task.taskType === 'webhook') { %>
 <i class="fas fa-shield-alt"></i> Verify
 <% } else if (task.taskType === 'submission') { %>
 <i class="fas fa-link"></i> Submit URL
 <% } else if (task.taskType === 'image_upload') { %>
 <i class="fas fa-upload"></i> Upload Proof
 <% } else { %>
 <i class="fas fa-paper-plane"></i> Submit Task
 <% } %>
 </button>
 </div>
 <% } %>
 </div>
 </div>
 <% }); %>
 </div>
 </div>

