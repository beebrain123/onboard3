 <!-- ══ TASK SUBMISSION MODAL (only for approved quest participants) ══ -->
 <% if (!quest.gated || !quest.memberApproval || appState === 'approved') { %>
 <div id="taskModal" class="modal" style="display:none">
 <div class="modal-content">
 <div class="modal-header">
 <div>
 <h3 id="taskModalTitle"><i class="fas fa-paper-plane"></i> Submit Task</h3>
 <p id="taskModalSub">Complete the action, then tap Submit</p>
 </div>
 <button class="modal-close-btn" onclick="closeTaskModal()"><i class="fas fa-times"></i></button>
 </div>
 <div id="taskInputContainer"></div>
 <div id="taskSubmitError" style="display:none;margin-top:.875rem;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.35);border-radius:12px;padding:.875rem 1rem;color:#f87171;font-size:.84rem;line-height:1.5"></div>
 <div class="modal-footer">
 <button type="button" class="btn btn-secondary" onclick="closeTaskModal()"><i class="fas fa-times"></i> Cancel</button>
 <button type="button" id="taskSubmitBtn" class="btn btn-primary" onclick="submitCurrentTask()"><i class="fas fa-check"></i> Submit Task</button>
 </div>
 </div>
 </div>

 <script>
 /* ══════════════════════════════════════════════════════════
 QUEST TASK SUBMISSION — Clean rewrite
 No FormData, no form-submit event, no timer gates,
 no warning-modal close/reopen cycle.
 Reads values directly from DOM at submit time.
 ══════════════════════════════════════════════════════════ */

 var currentTaskId = null;
 var currentQuestId = null;
 var isSubmitting = false;
 var clickedBtns = {}; // taskId -> timestamp (for soft reminder only)

 var userTwitterUsername = '<%= (user.twitter || "").replace(/'/g, "\\'") %>';
 var userDiscordConnected = <%= user.discordConnected ? 'true' : 'false' %>;
 var userDiscordUsername = '<%= (user.discordUsername || "").replace(/'/g, "\\'") %>';

 /* ══ SOUND SYSTEM (Web Audio API — no files needed) ══ */
 var _ac = null;
 function _getAC() {
 if (!_ac) { try { _ac = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {} }
 /* iOS requires resume after user gesture */
 if (_ac && _ac.state === 'suspended') { try { _ac.resume(); } catch(e) {} }
 return _ac;
 }
 function _note(ctx, freq, startDelay, dur, vol, wave) {
 try {
 var o = ctx.createOscillator(), g = ctx.createGain();
 o.connect(g); g.connect(ctx.destination);
 o.type = wave || 'sine';
 o.frequency.value = freq;
 var t = ctx.currentTime + startDelay;
 g.gain.setValueAtTime(0, t);
 g.gain.linearRampToValueAtTime(vol || 0.25, t + 0.01);
 g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
 o.start(t); o.stop(t + dur + 0.02);
 } catch(e) {}
 }
 function playSound(type) {
 var ctx = _getAC(); if (!ctx) return;
 try {
 if (type === 'click') {
 _note(ctx, 900, 0, 0.04, 0.18, 'sine');
 } else if (type === 'submit') {
 _note(ctx, 440, 0, 0.08, 0.2, 'sine');
 _note(ctx, 554, 0.07, 0.1, 0.2, 'sine');
 } else if (type === 'success') {
 _note(ctx, 523, 0, 0.12, 0.25, 'sine');
 _note(ctx, 659, 0.1, 0.12, 0.25, 'sine');
 _note(ctx, 784, 0.2, 0.18, 0.28, 'sine');
 } else if (type === 'quest_complete') {
 _note(ctx, 523, 0, 0.1, 0.3, 'sine');
 _note(ctx, 659, 0.08, 0.1, 0.3, 'sine');
 _note(ctx, 784, 0.16, 0.1, 0.3, 'sine');
 _note(ctx, 1047, 0.24, 0.22, 0.35,'sine');
 _note(ctx, 1319, 0.38, 0.28, 0.3, 'sine');
 } else if (type === 'error') {
 _note(ctx, 280, 0, 0.08, 0.2, 'sawtooth');
 _note(ctx, 210, 0.1, 0.12, 0.2, 'sawtooth');
 } else if (type === 'pending') {
 _note(ctx, 523, 0, 0.1, 0.2, 'sine');
 _note(ctx, 392, 0.12, 0.15, 0.2, 'sine');
 }
 } catch(e) {}
 }

 /* ── Toast ── */
 function showToast(msg, type) {
 var ex = document.getElementById('globalToast');
 if (ex) ex.remove();
 var t = document.createElement('div');
 t.id = 'globalToast';
 var bg = type === 'error' ? 'rgba(239,68,68,.95)' : type === 'warning' ? 'rgba(245,158,11,.95)' : 'rgba(94,194,19,.95)';
 var icon = type === 'error' ? 'fa-times-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-check-circle';
 t.style.cssText = 'position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120%);background:' + bg + ';color:#fff;padding:.85rem 1.5rem;border-radius:14px;font-size:.9rem;font-weight:700;font-family:Outfit,sans-serif;z-index:99999;display:flex;align-items:center;gap:.6rem;box-shadow:0 8px 32px rgba(0,0,0,.4);transition:transform .35s cubic-bezier(.34,1.56,.64,1);max-width:90vw;text-align:center;pointer-events:none';
 t.innerHTML = '<i class="fas ' + icon + '"></i><span>' + msg + '</span>';
 document.body.appendChild(t);
 requestAnimationFrame(function() {
 requestAnimationFrame(function() { t.style.transform = 'translateX(-50%) translateY(0)'; });
 });
 setTimeout(function() {
 t.style.transform = 'translateX(-50%) translateY(-120%)';
 setTimeout(function() { if (t.parentNode) t.remove(); }, 400);
 }, type === 'error' ? 5000 : 3500);
 }

 /* ── Progress bar ── */
 window.addEventListener('DOMContentLoaded', function() {
 setTimeout(function() {
 var fill = document.getElementById('progFill');
 if (fill) fill.style.width = '<%= userProgress ? userProgress.progress : 0 %>%';
 }, 300);
 /* Load leaderboard via AJAX so page renders fast */
 loadLeaderboard();
 /* backdrop + Escape */
 var modal = document.getElementById('taskModal');
 if (modal) {
 modal.addEventListener('click', function(e) { if (e.target === this && !isSubmitting) closeTaskModal(); });
 }
 document.addEventListener('keydown', function(e) {
 if (e.key === 'Escape' && !isSubmitting) {
 var m = document.getElementById('taskModal');
 if (m && m.style.display === 'flex') closeTaskModal();
 }
 });
 });

 /* ── Keep modal above virtual keyboard on mobile ── */
 function scrollModalToBottom() {
 setTimeout(function() {
 var mc = document.querySelector('#taskModal .modal-content');
 if (mc) mc.scrollTop = mc.scrollHeight;
 }, 350);
 }

 /* visualViewport: shrink modal max-height when keyboard opens so footer stays visible */
 if (window.visualViewport) {
 window.visualViewport.addEventListener('resize', function() {
 var modal = document.getElementById('taskModal');
 if (!modal || modal.style.display !== 'flex') return;
 var kbH = Math.max(0, window.innerHeight - window.visualViewport.height);
 var mc = modal.querySelector('.modal-content');
 if (mc) {
 if (kbH > 80) {
 mc.style.maxHeight = (window.visualViewport.height * 0.95) + 'px';
 mc.scrollTop = mc.scrollHeight;
 } else {
 mc.style.maxHeight = '';
 }
 }
 });
 }

 /* ── Track external link clicks (soft reminder only, never blocks) ── */
 function trackTaskClick(taskId) {
 clickedBtns[taskId] = Date.now();
 }

 /* ── Called by task card Submit buttons ── */
 function escapeTaskHtml(value) {
 return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
 }
 function handleSubmitClick(btn) {
 playSound('click');
 var taskId = btn.getAttribute('data-task-id');
 var questId = btn.getAttribute('data-quest-id');
 var taskTitle = btn.getAttribute('data-task-title');
 var inputLabel = btn.getAttribute('data-input-label');
 var inputName = btn.getAttribute('data-input-name');
 var inputType = btn.getAttribute('data-input-type') || 'text';
 var hasButton = btn.getAttribute('data-has-button') === 'true';
 var twitterTarget = btn.getAttribute('data-twitter-target');
 var taskType = btn.getAttribute('data-task-type') || 'default';
 var pollOptions = [];
 try { pollOptions = JSON.parse(decodeURIComponent(btn.getAttribute('data-poll-options') || '%5B%5D')); } catch(e) {}
 var discordGuildId = btn.getAttribute('data-discord-guild-id') || '';
 var discordGuildName = btn.getAttribute('data-discord-guild-name') || '';
 var telegramChatId = btn.getAttribute('data-telegram-chat-id') || '';
 var telegramChatName = btn.getAttribute('data-telegram-chat-name') || '';

 openTaskModal(taskId, questId, taskTitle, inputLabel, inputName, inputType, hasButton,
 twitterTarget, taskType, pollOptions,
 discordGuildId, discordGuildName, telegramChatId, telegramChatName);
 }

 function openTaskModal(taskId, questId, taskTitle, inputLabel, inputName, inputType, hasButton,
 twitterFollowTarget, taskType, pollOptions,
 discordGuildId, discordGuildName, telegramChatId, telegramChatName) {
 currentTaskId = taskId;
 currentQuestId = questId;

 var titleEl = document.getElementById('taskModalTitle');
