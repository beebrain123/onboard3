 hideSubmitError();
 var submitBtn = document.getElementById('taskSubmitBtn');
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fas fa-check"></i> Submit Task'; }
 currentTaskId = null;
 currentQuestId = null;
 }

 function showSubmitError(msg, details) {
 var box = document.getElementById('taskSubmitError');
 if (!box) return;
 var html = '<strong><i class="fas fa-exclamation-circle"></i> ' + msg + '</strong>';
 if (details && details.length) {
 html += '<ul style="margin:.5rem 0 0 1.1rem;padding:0">' +
 details.map(function(d) { return '<li style="margin-top:.25rem">' + d + '</li>'; }).join('') + '</ul>';
 }
 box.innerHTML = html;
 box.style.display = '';
 box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
 }

 function hideSubmitError() {
 var box = document.getElementById('taskSubmitError');
 if (box) { box.style.display = 'none'; box.innerHTML = ''; }
 }

 /* ── SUBMIT — reads directly from DOM, no FormData ── */
 function submitCurrentTask() {
 if (isSubmitting) return;
 if (!currentTaskId || !currentQuestId) {
 showSubmitError('Task info missing — please close and reopen the task.');
 return;
 }

 /* Commit any pending mobile keyboard input */
 if (document.activeElement && document.activeElement !== document.body) {
 document.activeElement.blur();
 }

 /* Find the active task button to read taskType */
 var activeBtn = document.querySelector('.submit-task-btn[data-task-id="' + currentTaskId + '"]');
 var taskType = activeBtn ? activeBtn.getAttribute('data-task-type') : 'default';

 /* Discord gate */
 if (taskType === 'discord_join' && !userDiscordConnected) {
 showSubmitError('Connect your Discord account first before submitting this task.');
 return;
 }

 hideSubmitError();

 /* Build payload by reading DOM elements directly */
 var payload = {
 questId: currentQuestId,
 taskId: currentTaskId,
 submissionUrl: '',
 submissionText: '',
 submissionData: {},
 timeSpent: 0
 };

 /* Read payload by checking what's actually in the DOM — not taskType string */
 var pollChosen = document.querySelector('input[name="pollChoice"]:checked');
 var urlEl = document.getElementById('qs_urlInput');
 var customEl = document.getElementById('qs_customInput');
 var b64El = document.getElementById('qs_imgBase64');

 if (pollChosen) {
 payload.submissionData.pollChoice = pollChosen.value;

 } else if (b64El && b64El.value) {
 payload.submissionData.image = b64El.value;

 } else if (b64El && !b64El.value) {
 /* image_upload modal is showing but no image selected */
 showSubmitError('Please upload a screenshot as proof before submitting.');
 return;

 } else if (customEl) {
 var fieldName = customEl.getAttribute('data-field-name') || 'input';
 var fieldVal = customEl.value.trim();
 if (!fieldVal) { showSubmitError('Please fill in the required field before submitting.'); return; }
 payload.submissionData[fieldName] = fieldVal;
 /* Also populate url + text so server-side requiresLink/requiresText validation passes */
 payload.submissionUrl = fieldVal;
 payload.submissionText = fieldVal;

 } else if (urlEl) {
 payload.submissionUrl = urlEl.value.trim();
 payload.submissionText = urlEl.value.trim();

 }
 /* else: poll/discord/telegram/webhook/twitter — no extra input needed */

 var urlCandidate = customEl && customEl.type === 'url' ? customEl.value.trim() : (urlEl ? urlEl.value.trim() : '');
 if (urlCandidate) {
  try {
   var parsedCandidate = new URL(urlCandidate);
   if (!['http:', 'https:'].includes(parsedCandidate.protocol)) throw new Error('protocol');
  } catch (e) { showSubmitError('Enter a complete URL starting with https:// or http://.'); return; }
 }
 /* Lock UI */
 playSound('submit');
 var submitBtn = document.getElementById('taskSubmitBtn');
 var origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
 isSubmitting = true;
 if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...'; }

 fetch('/dashboard/quests/submit-task', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(payload)
 })
 .then(function(res) {
 if (res.status === 401) {
 isSubmitting = false;
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origBtnHtml; }
 showSubmitError('Session expired — please refresh the page and log in again.');
 return null;
 }
 return res.json();
 })
 .then(function(data) {
 if (!data) return;
 isSubmitting = false;

 if (data.success) {
 closeTaskModal();
 if (data.pending) {
 playSound('pending');
 showToast('Submitted! Pending admin review — XP will be credited once approved.', 'success');
 } else if (data.isQuestCompleted) {
 playSound('quest_complete');
 showToast('Quest Completed! You earned ' + ((data.rewards && data.rewards.xp) || 0) + ' XP!', 'success');
 } else {
 playSound('success');
 showToast('Task done! +' + (data.taskXpEarned || 0) + ' XP earned', 'success');
 }
 setTimeout(function() { window.location.reload(); }, 1400);

 } else if (data.requiresConnection) {
 closeTaskModal();
 var parts = [];
 if (data.missingX) parts.push('<a href="/auth/twitter" style="color:#5EC213;font-weight:700"><i class="fab fa-x-twitter"></i> Connect X</a>');
 if (data.missingTg) parts.push('<a href="https://t.me/onboard3bot" target="_blank" style="color:#1d9bf0;font-weight:700"><i class="fab fa-telegram"></i> Connect Telegram</a>');
 var banner = document.getElementById('connectionGateBanner');
 if (banner) {
 banner.innerHTML = '<div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3);border-radius:14px;padding:1.25rem 1.375rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap"><i class="fas fa-lock" style="color:#f87171;font-size:1.125rem;flex-shrink:0"></i><div style="flex:1"><p style="font-size:.875rem;font-weight:700;color:var(--text);margin-bottom:.35rem">Social connection required</p><p style="font-size:.8125rem;color:var(--text-2)">' + (data.message || '') + '</p></div><div style="display:flex;gap:.5rem;flex-wrap:wrap">' + parts.join('') + '</div></div>';
 banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
 }
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origBtnHtml; }

 } else if (data.requiresFollow && data.targetAccount) {
 if (submitBtn) {
 submitBtn.innerHTML = '<a href="https://x.com/' + data.targetAccount + '" target="_blank" style="color:inherit;text-decoration:none"><i class="fab fa-x-twitter"></i> Follow @' + data.targetAccount + '</a>';
 submitBtn.disabled = false;
 }
 showSubmitError(data.message || 'Please follow the account first.', ['Tap the button above, follow @' + data.targetAccount + ', then Submit again.']);

 } else if (data.requiresTwitterConnect) {
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origBtnHtml; }
 showSubmitError(data.message || 'X account required.', ['<a href="/dashboard/connect-twitter?redirect=' + encodeURIComponent(window.location.pathname) + '" style="color:#5EC213;font-weight:700">Connect your X account</a> then try again.']);

 } else {
 playSound('error');
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origBtnHtml; }
 var errDetails = (data.errors && data.errors.length) ? data.errors : null;
 showSubmitError(data.message || 'Submission failed. Please try again.', errDetails);
 }
 })
 .catch(function(err) {
 playSound('error');
 isSubmitting = false;
 if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origBtnHtml; }
 var m = (err && err.message) ? err.message.toLowerCase() : '';
 if (m.indexOf('fetch') !== -1 || m.indexOf('network') !== -1 || m.indexOf('failed') !== -1) {
 showSubmitError('No internet connection. Check your network and try again.');
 } else if (m.indexOf('json') !== -1 || m.indexOf('syntax') !== -1) {
 showSubmitError('Server returned an unexpected response. Please try again in a moment.');
 } else {
 showSubmitError('Something went wrong. Please close and try again.');
 }
 });
 }

 /* ── Image upload helpers ── */
 function previewUploadedImg(input) {
 if (!input.files || !input.files[0]) return;
 var file = input.files[0];
 if (file.size > 5 * 1024 * 1024) { showToast('Image too large — max 5MB', 'error'); input.value = ''; return; }
 var reader = new FileReader();
 reader.onload = function(e) {
 document.getElementById('imgPreview').src = e.target.result;
 document.getElementById('imgFileName').textContent = file.name;
 document.getElementById('imgPreviewWrap').style.display = 'block';
 document.getElementById('imgUploadArea').style.display = 'none';
 document.getElementById('qs_imgBase64').value = e.target.result;
 };
 reader.readAsDataURL(file);
 }
 function handleImgDrop(e) {
 e.preventDefault();
 document.getElementById('imgUploadArea').style.borderColor = 'rgba(168,85,247,.3)';
 var file = e.dataTransfer.files[0];
 if (!file || !file.type.startsWith('image/')) return;
 previewUploadedImg({ files: [file] });
 }
 function clearImgUpload() {
 document.getElementById('qs_imgBase64').value = '';
 document.getElementById('imgPreviewWrap').style.display = 'none';
 document.getElementById('imgUploadArea').style.display = 'block';
 document.getElementById('imgFileInput').value = '';
 }

 /* ── Leaderboard AJAX loader ── */
 var _lbPrizeTiers = <%- JSON.stringify(quest.prizeDistribution || []) %>;
 var _lbRankPercents = <%- JSON.stringify(quest.competitionConfig?.rankPercentages || []) %>;
 var _lbRewardPool = <%- JSON.stringify(Number(quest.usdcReward) || 0) %>;

 function getPrizePercentLb(rank) {
 var percent = Number(_lbRankPercents[rank - 1]);
 return Number.isFinite(percent) && percent > 0 ? percent : null;
 }

 function getPrizeLb(rank, tiers) {
 if (tiers && tiers.length) {
  for (var i = 0; i < tiers.length; i++) {
   if (rank >= tiers[i].from && rank <= tiers[i].to) return Number(tiers[i].amount) || 0;
  }
 }
 var percent = getPrizePercentLb(rank);
 return percent === null ? 0 : Math.round((_lbRewardPool * percent / 100) * 100) / 100;
 }

 function getPrizeLabelLb(rank, tiers) {
 var amount = getPrizeLb(rank, tiers);
 var percent = getPrizePercentLb(rank);
 return '$' + amount.toFixed(2) + (percent === null ? '' : ' (' + percent + '%)');
 }

 function loadLeaderboard() {
 fetch('/dashboard/quests/api/<%= quest._id %>/leaderboard')
 .then(function(r) { return r.json(); })
 .then(function(data) {
 var spinner = document.getElementById('lbSpinner');
 var podium = document.getElementById('lbPodium');
 var list = document.getElementById('leaderboardList');
 var count = document.getElementById('lbCount');
 if (spinner) spinner.style.display = 'none';

 if (!data.entries || data.entries.length === 0) {
 if (count) count.textContent = '0 participants';
 if (list) list.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem">No participants yet — be the first!</div>';
 return;
 }

 var total = data.total;
 if (count) count.textContent = total + ' participant' + (total !== 1 ? 's' : '') + ' • ranked by total XP';

 // Podium (top 3)
 if (podium) {
 podium.style.display = 'flex';
 var medals = ['', '', ''];
 var pH = '';
 for (var i = 0; i < Math.min(3, data.entries.length); i++) {
 var e = data.entries[i];
 var prize = getPrizeLb(e.rank, _lbPrizeTiers);
 var ini = (e.username || '?').charAt(0).toUpperCase();
 var av = e.profilePicture
 ? '<img src="' + e.profilePicture + '" style="width:100%;height:100%;object-fit:cover" alt="">'
 : '<span>' + ini + '</span>';
 pH += '<div class="podium-box podium-box--' + (i + 1) + '">' +
 '<div class="podium-medal">' + medals[i] + '</div>' +
 '<div style="width:44px;height:44px;border-radius:12px;margin:0 auto .5rem;overflow:hidden;background:rgba(94,194,19,.1);border:1px solid rgba(94,194,19,.2);display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--green);font-size:1rem;flex-shrink:0">' + av + '</div>' +
 '<div class="podium-name">' + (e.username || 'Anonymous') + '</div>' +
 '<div class="podium-xp">' + e.totalXp.toLocaleString() + ' XP</div>' +
 (prize > 0 ? '<div style="font-size:.82rem;font-weight:900;color:#4ade80;margin-top:.2rem">' + getPrizeLabelLb(e.rank, _lbPrizeTiers) + '</div>' : '') +
 '<div class="podium-time">' + (e.timeSpentMinutes || 0) + 'm</div>' +
 '</div>';
 }
 podium.innerHTML = pH;
 }

 // Full list
 if (list) {
 var lH = '';
 for (var j = 0; j < data.entries.length; j++) {
 var entry = data.entries[j];
 var isMe = entry.isCurrentUser;
 var rc = j === 0 ? 'lb-rank--1' : j === 1 ? 'lb-rank--2' : j === 2 ? 'lb-rank--3' : 'lb-rank--x';
 var rp = getPrizeLb(entry.rank, _lbPrizeTiers);
 var dAgo = entry.completedAt ? Math.floor((Date.now() - new Date(entry.completedAt)) / 86400000) : null;
 var ini2 = (entry.username || '?').charAt(0).toUpperCase();
 var av2 = entry.profilePicture
 ? '<img src="' + entry.profilePicture + '" style="width:100%;height:100%;object-fit:cover" alt="">'
 : '<span>' + ini2 + '</span>';
 lH += '<div class="lb-row' + (isMe ? ' lb-row--me' : '') + (entry.isWinner ? ' lb-row--win' : '') + '" data-username="' + (entry.username || '').toLowerCase() + '">' +
 '<span class="lb-rank ' + rc + '">#' + entry.rank + '</span>' +
 '<div style="width:34px;height:34px;border-radius:9px;flex-shrink:0;overflow:hidden;background:rgba(94,194,19,.1);border:1px solid rgba(94,194,19,.15);display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--green);font-size:.875rem">' + av2 + '</div>' +
 '<div class="lb-name">' +
 '<div class="lb-username">' + (entry.username || 'Anonymous') +
 (isMe ? '<span class="lb-you">YOU</span>' : '') +
 (entry.isWinner ? '<i class="fas fa-trophy" style="color:var(--green);font-size:.75rem"></i>' : '') +
 (rp > 0 ? '<span style="background:rgba(74,222,128,.12);color:#4ade80;font-size:.65rem;font-weight:900;padding:.1rem .45rem;border-radius:4px;border:1px solid rgba(74,222,128,.3)">' + getPrizeLabelLb(entry.rank, _lbPrizeTiers) + '</span>' : '') +
 '</div>' +
 '<div class="lb-meta">' + (entry.timeSpentMinutes || 0) + 'm' + (dAgo !== null ? ' • ' + dAgo + 'd ago' : ' • In progress') + '</div>' +
 '</div>' +
 '<div class="lb-xp"><div class="lb-xp-val">' + entry.totalXp.toLocaleString() + '</div><div class="lb-xp-lbl">XP</div></div>' +
 '</div>';
 }
 list.innerHTML = lH;
 setTimeout(function() {
 var me = document.querySelector('.lb-row--me');
 if (me) me.scrollIntoView({ behavior: 'smooth', block: 'center' });
 }, 200);
 }
 })
 .catch(function() {
 var spinner = document.getElementById('lbSpinner');
 if (spinner) spinner.innerHTML = '<span style="color:var(--text-3);font-size:.875rem">Could not load leaderboard.</span>';
 });
 }

 /* ── Leaderboard search ── */
 function filterLeaderboard() {
 var filter = document.getElementById('leaderboardSearch').value.toLowerCase();
 var visible = 0;
 document.querySelectorAll('.lb-row').forEach(function(row) {
 var match = row.getAttribute('data-username').indexOf(filter) !== -1;
 row.style.display = match ? 'flex' : 'none';
 if (match) visible++;
 });
 var list = document.getElementById('leaderboardList');
 var noMsg = document.getElementById('noResultsMsg');
 if (!list) return;
 if (visible === 0 && filter) {
 if (!noMsg) {
 noMsg = document.createElement('div');
 noMsg.id = 'noResultsMsg';
 noMsg.style.cssText = 'text-align:center;padding:2rem;color:var(--text-3);font-size:.875rem';
 noMsg.innerHTML = '<i class="fas fa-search" style="display:block;font-size:1.5rem;margin-bottom:.5rem"></i>No users found for "' + filter + '"';
 list.appendChild(noMsg);
 }
 } else if (noMsg) { noMsg.remove(); }
 }
 </script>
 <% } %>

 <% if (quest.endDate) { %>
 <script>
 (function() {
 const endDate = new Date('<%= quest.endDate %>').getTime();
 function updateCountdown() {
 const distance = endDate - Date.now();
 const countdown = document.getElementById('questCountdown');
 const urgency = document.getElementById('urgencyIndicator');
 if (!countdown) return;
 if (distance < 0) {
 countdown.style.background = 'rgba(100,100,100,0.07)';
 countdown.style.borderColor = 'rgba(100,100,100,0.2)';
 document.getElementById('countdownDisplay').innerHTML = '<span style="color:#888">Quest Ended</span>';
 if (urgency) { urgency.textContent = 'Finished'; urgency.style.cssText = 'background:rgba(100,100,100,0.15);color:#888;border:1px solid rgba(100,100,100,0.2)'; }
 return;
 }
 const days = Math.floor(distance / 86400000);
 const hours = Math.floor((distance % 86400000) / 3600000);
 const minutes = Math.floor((distance % 3600000) / 60000);
 const seconds = Math.floor((distance % 60000) / 1000);
 document.getElementById('days').textContent = String(days).padStart(2,'0');
 document.getElementById('hours').textContent = String(hours).padStart(2,'0');
 document.getElementById('minutes').textContent = String(minutes).padStart(2,'0');
 document.getElementById('seconds').textContent = String(seconds).padStart(2,'0');
 if (!urgency) return;
 const totalH = days * 24 + hours;
 if (totalH < 1) {
 urgency.innerHTML = '<i class="fas fa-triangle-exclamation"></i> Final Hour!';
 urgency.style.cssText = 'background:rgba(239,68,68,0.2);color:#f87171;border:1px solid rgba(239,68,68,0.4)';
 } else if (totalH < 24) {
 urgency.innerHTML = '<i class="fas fa-fire"></i> Ending Soon';
 urgency.style.cssText = 'background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3)';
 } else if (days < 3) {
 urgency.innerHTML = '<i class="fas fa-hourglass-half"></i> Few Days Left';
 urgency.style.cssText = 'background:rgba(251,191,36,0.15);color:#fbbf24;border:1px solid rgba(251,191,36,0.3)';
 } else {
 urgency.innerHTML = '<i class="fas fa-clock"></i> Plenty of Time';
 urgency.style.cssText = 'background:rgba(94,194,19,0.12);color:var(--green);border:1px solid rgba(94,194,19,0.25)';
 }
 }
 updateCountdown();
 setInterval(updateCountdown, 1000);
 })();
 </script>
 <% } %>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
