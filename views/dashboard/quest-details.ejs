<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><%= quest.title %> — ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <%- include('../partials/achievement-popup') %>
 <link rel="stylesheet" href="/css/dashboard.css">
 <style>
 /* ══ HERO BANNER ══ */
 .qd-hero {
 position: relative; border-radius: 22px; overflow: hidden;
 margin-bottom: 1.5rem;
 animation: cardIn 0.5s ease both;
 border: 1px solid var(--border);
 min-height: 220px;
 }
 .qd-hero-bg {
 position: absolute; inset: 0;
 background: linear-gradient(135deg, #0d190d 0%, #111c11 50%, #0f1d0e 100%);
 }
 /* No stretched cover — logo is shown centered in qd-hero-logo */
 .qd-hero-overlay {
 position: absolute; inset: 0;
 background: radial-gradient(ellipse at 70% 50%, rgba(94,194,19,0.06) 0%, transparent 65%);
 }
 .qd-hero-content {
 position: relative; z-index: 1;
 padding: 2rem 2.25rem;
 display: flex; align-items: flex-end; justify-content: space-between;
 flex-wrap: wrap; gap: 1.5rem;
 min-height: 220px;
 }
 .qd-hero-left { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; }
 .qd-back {
 display: inline-flex; align-items: center; gap: 0.5rem;
 color: var(--text-3); font-size: 0.8125rem; font-weight: 700; text-decoration: none;
 margin-bottom: 1rem; transition: color 0.2s;
 width: fit-content;
 }
 .qd-back:hover { color: var(--green); }
 .qd-hero-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.875rem; }
 .qd-badge {
 font-size: 0.68rem; font-weight: 800; letter-spacing: 0.5px;
 padding: 0.3rem 0.75rem; border-radius: 50px; white-space: nowrap;
 }
 .qd-badge--type { background: rgba(94,194,19,0.18); color: var(--green); border: 1px solid rgba(94,194,19,0.35); }
 .qd-badge--fcfs { background: rgba(251,191,36,0.18); color: #fbbf24; border: 1px solid rgba(251,191,36,0.35); }
 .qd-badge--comp { background: rgba(239,68,68,0.18); color: #f87171; border: 1px solid rgba(239,68,68,0.35); }
 .qd-badge--ref { background: rgba(168,85,247,0.18); color: #c084fc; border: 1px solid rgba(168,85,247,0.35); }
 .qd-badge--done { background: rgba(94,194,19,0.2); color: var(--green-light); border: 1px solid rgba(94,194,19,0.5); }
 .qd-badge--diff { background: rgba(255,255,255,0.08); color: var(--text-2); border: 1px solid rgba(255,255,255,0.12); text-transform: capitalize; }
 .qd-title {
 font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900;
 color: var(--text); letter-spacing: -1px; line-height: 1.15;
 margin-bottom: 0.5rem;
 }
 .qd-short { font-size: 0.9375rem; color: var(--text-2); line-height: 1.65; }

 /* Quest logo — large, centered right of hero */
 .qd-hero-logo {
 width: 100px; height: 100px; border-radius: 24px; overflow: hidden;
 background: #fff; padding: 10px; flex-shrink: 0;
 box-shadow: 0 12px 40px rgba(0,0,0,0.6), 0 0 0 2px rgba(255,255,255,0.15), 0 0 40px rgba(94,194,19,0.12);
 animation: logoPop 0.6s cubic-bezier(0.34,1.56,0.64,1) both 0.2s;
 }
 /* ONBOARD3 default logo — dark green bg, no white box */
 .qd-hero-logo--brand {
 background: rgba(94,194,19,0.12);
 border: 2px solid rgba(94,194,19,0.35);
 box-shadow: 0 12px 40px rgba(0,0,0,0.55), 0 0 40px rgba(94,194,19,0.2);
 }
 @keyframes logoPop { from{opacity:0;transform:scale(0.7)} to{opacity:1;transform:scale(1)} }
 .qd-hero-logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 14px; }
 @media (max-width: 600px) { .qd-hero-logo { width: 64px; height: 64px; border-radius: 16px; padding: 7px; } }

 /* Reward strip */
 .qd-reward-strip {
 display: flex; flex-wrap: wrap; gap: 0.75rem;
 align-items: center; margin-top: 1.25rem;
 }
 .qd-reward-pill {
 display: inline-flex; align-items: center; gap: 0.45rem;
 padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.875rem; font-weight: 800;
 }
 .qd-reward-pill--xp { background: rgba(94,194,19,0.15); color: var(--green); border: 1px solid rgba(94,194,19,0.3); }
 .qd-reward-pill--usdc { background: rgba(251,191,36,0.15); color: #fbbf24; border: 1px solid rgba(251,191,36,0.3); }

 /* ══ PROGRESS CARD ══ */
 .qd-progress-card {
 background: var(--bg-card); border: 1px solid var(--border);
 border-radius: 18px; padding: 1.5rem;
 animation: cardIn 0.5s ease 60ms both;
 }
 .qd-progress-top {
 display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;
 }
 .qd-progress-label { font-size: 0.8125rem; font-weight: 800; color: var(--text-3); text-transform: uppercase; letter-spacing: 1px; }
 .qd-progress-pct { font-size: 1.5rem; font-weight: 900; color: var(--green); letter-spacing: -0.5px; }
 .qd-progress-bar { height: 10px; background: rgba(255,255,255,0.07); border-radius: 99px; overflow: hidden; }
 .qd-progress-fill {
 height: 100%; border-radius: 99px;
 background: linear-gradient(90deg, var(--green-dark), var(--green), var(--green-light));
 box-shadow: 0 0 12px rgba(94,194,19,0.5);
 transition: width 1.4s cubic-bezier(0.4,0,0.2,1);
 }
 .qd-progress-meta {
 display: flex; justify-content: space-between; margin-top: 0.625rem;
 font-size: 0.75rem; font-weight: 700; color: var(--text-3);
 }

 /* ══ INFO PILLS ROW ══ */
 .qd-info-row {
 display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;
 }
 .qd-info-pill {
 display: flex; flex-direction: column; align-items: center;
 padding: 0.75rem 1.25rem; border-radius: 13px;
 background: rgba(255,255,255,0.03); border: 1px solid var(--border);
 min-width: 90px;
 }
 .qd-info-pill-val { font-size: 0.9375rem; font-weight: 800; color: var(--green); }
 .qd-info-pill-lbl { font-size: 0.68rem; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.8px; margin-top: 2px; }

 /* ══ XP BREAKDOWN ══ */
 .xp-breakdown-grid {
 display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.875rem;
 margin-top: 1.25rem;
 }
 .xp-breakdown-item {
 padding: 1rem; border-radius: 13px;
 background: rgba(255,255,255,0.03); border: 1px solid var(--border);
 }
 .xp-breakdown-item.winner { background: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.3); }
 .xp-breakdown-lbl { font-size: 0.75rem; color: var(--text-3); margin-bottom: 0.35rem; }
 .xp-breakdown-val { font-size: 1.375rem; font-weight: 900; color: var(--green); letter-spacing: -0.5px; }
 .xp-breakdown-item.winner .xp-breakdown-val { color: #fbbf24; }

 /* ══ TASK CARDS ══ */
 .task-list { display: flex; flex-direction: column; gap: 0.875rem; }
 .task-card {
 border-radius: 15px; overflow: hidden;
 border: 1px solid var(--border);
 animation: cardIn 0.4s ease both;
 transition: border-color 0.25s, box-shadow 0.25s;
 }
 .task-card:hover { border-color: rgba(94,194,19,0.25); }
 .task-card--completed { border-color: rgba(94,194,19,0.3); background: rgba(94,194,19,0.04); }
 .task-card--active { border-color: rgba(251,146,60,0.35); background: rgba(251,146,60,0.03); }
 .task-card--locked { background: rgba(255,255,255,0.015); opacity: 0.6; }
 .task-card--pending { border-color: rgba(245,158,11,0.35); background: rgba(245,158,11,0.03); }

 .task-card-head {
 display: flex; align-items: center; gap: 1rem; padding: 1.125rem 1.25rem;
 }
 .task-num {
 width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0;
 display: flex; align-items: center; justify-content: center;
 font-size: 0.8125rem; font-weight: 900;
 }
 .task-num--done { background: rgba(94,194,19,0.2); color: var(--green); }
 .task-num--active { background: rgba(251,146,60,0.2); color: #fb923c; }
 .task-num--locked { background: rgba(100,100,100,0.15); color: #666; }
 .task-num--pending { background: rgba(245,158,11,0.2); color: #f59e0b; }
 .task-num--done i, .task-num--active i, .task-num--locked i, .task-num--pending i { font-size: 0.875rem; }

 .task-card-title {
 flex: 1; font-size: 0.9375rem; font-weight: 800; color: var(--text);
 letter-spacing: -0.2px;
 }
 .task-card--completed .task-card-title { color: var(--green); }
 .task-card--locked .task-card-title { color: var(--text-3); }
 .task-card--pending .task-card-title { color: #f59e0b; }

 .task-xp-badge {
 font-size: 0.72rem; font-weight: 800; padding: 0.25rem 0.6rem;
 border-radius: 50px; white-space: nowrap; flex-shrink: 0;
 }
 .task-xp-badge--done { background: rgba(94,194,19,0.15); color: var(--green); border: 1px solid rgba(94,194,19,0.3); }
 .task-xp-badge--active { background: rgba(251,146,60,0.15); color: #fb923c; border: 1px solid rgba(251,146,60,0.3); }
 .task-xp-badge--locked { background: rgba(100,100,100,0.12); color: #666; border: 1px solid rgba(100,100,100,0.2); }
 .task-xp-badge--pending { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.25); }

 .task-status-chip {
 font-size: 0.68rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;
 padding: 0.28rem 0.7rem; border-radius: 50px; flex-shrink: 0; white-space: nowrap;
 }
 .chip--done { background: rgba(94,194,19,0.15); color: var(--green); border: 1px solid rgba(94,194,19,0.3); }
 .chip--active { background: rgba(251,146,60,0.15); color: #fb923c; border: 1px solid rgba(251,146,60,0.3); }
 .chip--locked { background: rgba(100,100,100,0.12); color: #666; border: 1px solid rgba(100,100,100,0.2); }
 .chip--pending { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.25); }

 .task-card-body {
 padding: 0 1.25rem 1.125rem 1.25rem;
 border-top: 1px solid rgba(255,255,255,0.05);
 padding-top: 0.875rem;
 }
 .task-desc {
 font-size: 0.8375rem; color: var(--text-2); line-height: 1.7;
 white-space: pre-wrap; word-wrap: break-word; margin-bottom: 0.875rem;
 }
 .task-card--locked .task-desc { color: var(--text-3); }
 .task-meta { font-size: 0.75rem; color: var(--text-3); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
 .task-meta i { color: var(--green); font-size: 0.7rem; }
 .task-actions-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.875rem; }

 .task-action-btn {
 display: inline-flex; align-items: center; gap: 0.45rem;
 padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.8375rem; font-weight: 700;
 border: none; cursor: pointer; font-family: 'Outfit', sans-serif;
 transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
 }
 .task-action-btn--primary {
 background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
 color: #000; box-shadow: 0 3px 14px rgba(94,194,19,0.3);
 }
 .task-action-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(94,194,19,0.48); }
 .task-action-btn--secondary {
 background: rgba(255,255,255,0.06); color: var(--text-2); border: 1px solid var(--border);
 }
 .task-action-btn--secondary:hover { background: rgba(255,255,255,0.1); color: var(--text); }

 .locked-notice {
 display: flex; align-items: center; gap: 0.6rem;
 padding: 0.625rem 0.875rem; border-radius: 9px;
 background: rgba(251,193,7,0.07); border: 1px solid rgba(251,193,7,0.2);
 font-size: 0.78rem; color: #fbbf24; margin-top: 0.625rem;
 }

 /* ══ COUNTDOWN ══ */
 .qd-countdown {
 display: flex; align-items: center; justify-content: space-between;
 flex-wrap: wrap; gap: 1rem;
 padding: 1.125rem 1.5rem; border-radius: 15px;
 background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.3);
 animation: cardIn 0.5s ease both;
 }
 .qd-countdown-label { font-size: 0.72rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #f87171; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.4rem; }
 .qd-countdown-time {
 font-size: 1.5rem; font-weight: 900; color: var(--text); font-variant-numeric: tabular-nums; letter-spacing: -0.5px;
 }
 .qd-countdown-sub { font-size: 0.72rem; color: var(--text-3); margin-top: 0.25rem; }
 .qd-urgency { font-size: 0.75rem; font-weight: 800; padding: 0.4rem 1rem; border-radius: 50px; white-space: nowrap; }

 /* ══ LEADERBOARD ══ */
 .podium-row {
 display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.875rem;
 margin-bottom: 1.5rem;
 }
 @media (max-width: 600px) { .podium-row { grid-template-columns: 1fr; } }
 .podium-box {
 text-align: center; padding: 1.25rem 0.875rem; border-radius: 15px;
 transition: transform 0.3s;
 }
 .podium-box:hover { transform: translateY(-4px); }
 .podium-box--1 { background: rgba(255,215,0,0.08); border: 1px solid rgba(255,215,0,0.3); }
 .podium-box--2 { background: rgba(192,192,192,0.07); border: 1px solid rgba(192,192,192,0.25); }
 .podium-box--3 { background: rgba(205,127,50,0.07); border: 1px solid rgba(205,127,50,0.25); }
 .podium-medal { font-size: 2rem; margin-bottom: 0.375rem; }
 .podium-name { font-size: 0.875rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem; word-break: break-word; }
 .podium-xp { font-size: 1rem; font-weight: 900; color: var(--green); }
 .podium-time { font-size: 0.7rem; color: var(--text-3); margin-top: 0.25rem; }

 .lb-search {
 display: flex; align-items: center; gap: 0.5rem;
 padding: 0.625rem 1rem; border-radius: 10px;
 background: rgba(255,255,255,0.04); border: 1px solid var(--border);
 }
 .lb-search i { color: var(--text-3); font-size: 0.8rem; }
 .lb-search input {
 background: none; border: none; outline: none; color: var(--text);
 font-family: 'Outfit', sans-serif; font-size: 0.875rem; width: 100%;
 }
 .lb-search input::placeholder { color: var(--text-3); }

 .lb-row {
 display: flex; align-items: center; gap: 1rem;
 padding: 0.75rem 1rem; border-radius: 10px; margin-bottom: 3px;
 background: rgba(255,255,255,0.02); border: 1px solid transparent;
 transition: all 0.2s; cursor: default;
 }
 .lb-row:hover { background: rgba(94,194,19,0.04); border-color: rgba(94,194,19,0.15); transform: translateX(3px); }
 .lb-row--me { background: rgba(94,194,19,0.08) !important; border-color: rgba(94,194,19,0.25) !important; }
 .lb-row--win { border-left: 3px solid var(--green); }
 .lb-rank { min-width: 32px; font-size: 0.875rem; font-weight: 800; }
 .lb-rank--1 { color: #FFD700; }
 .lb-rank--2 { color: #C0C0C0; }
 .lb-rank--3 { color: #CD7F32; }
 .lb-rank--x { color: var(--text-3); }
 .lb-name { flex: 1; min-width: 0; }
 .lb-username { font-size: 0.875rem; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
 .lb-you { background: var(--green); color: #000; font-size: 0.6rem; font-weight: 900; padding: 0.1rem 0.45rem; border-radius: 4px; }
 .lb-meta { font-size: 0.72rem; color: var(--text-3); margin-top: 1px; }
 .lb-xp { text-align: right; flex-shrink: 0; }
 .lb-xp-val { font-size: 1rem; font-weight: 900; color: var(--green); }
 .lb-xp-lbl { font-size: 0.65rem; color: var(--text-3); }
 .lb-list { max-height: 380px; overflow-y: auto; margin-top: 1rem; }
 .lb-list::-webkit-scrollbar { width: 4px; }
 .lb-list::-webkit-scrollbar-thumb { background: rgba(94,194,19,0.2); border-radius: 10px; }

 /* ══ STATS BOXES ══ */
 .qd-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.875rem; }
 @media (max-width: 600px) { .qd-stats-row { grid-template-columns: 1fr 1fr; } }
 .qd-stat-box { text-align: center; padding: 1.125rem; border-radius: 13px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); }
 .qd-stat-val { font-size: 1.75rem; font-weight: 900; color: var(--green); letter-spacing: -0.5px; }
 .qd-stat-lbl { font-size: 0.72rem; font-weight: 700; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.8px; margin-top: 0.25rem; }

 /* ══ RESOURCES ══ */
 .resource-item {
 display: flex; align-items: center; gap: 1rem; padding: 0.875rem 1rem;
 border-radius: 12px; border: 1px solid var(--border);
 background: rgba(255,255,255,0.025); text-decoration: none; color: inherit;
 transition: all 0.25s; margin-bottom: 0.625rem;
 }
 .resource-item:hover { background: rgba(94,194,19,0.06); border-color: rgba(94,194,19,0.25); transform: translateX(3px); }
 .resource-icon { width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0; background: rgba(94,194,19,0.1); border: 1px solid rgba(94,194,19,0.2); display: flex; align-items: center; justify-content: center; font-size: 0.875rem; color: var(--green); }
 .resource-title { font-size: 0.9rem; font-weight: 700; color: var(--text); }
 .resource-type { font-size: 0.72rem; color: var(--text-3); text-transform: capitalize; margin-top: 1px; }

 /* ══ TASK SUBMIT MODAL ══ */
 .modal {
 position: fixed; inset: 0;
 background: rgba(0,0,0,0.88); backdrop-filter: blur(6px);
 z-index: 9999; justify-content: center; align-items: center;
 animation: fadeIn 0.3s ease;
 }
 @keyframes fadeIn { from{opacity:0} to{opacity:1} }
 .modal-content {
 background: var(--bg-card); border: 1px solid var(--border);
 border-radius: 22px; padding: 2rem; max-width: 540px; width: 92%;
 max-height: 88vh; overflow-y: auto; -webkit-overflow-scrolling: touch;
 box-shadow: 0 24px 80px rgba(0,0,0,0.5), 0 0 40px rgba(94,194,19,0.06);
 animation: slideUp 0.35s cubic-bezier(0.4,0,0.2,1) both;
 }
 @keyframes slideUp { from{transform:translateY(28px);opacity:0} to{transform:translateY(0);opacity:1} }
 .modal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
 .modal-header h3 { color: var(--green); font-size: 1.125rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; flex: 1; padding-right: 1rem; }
 .modal-header p { color: var(--text-3); font-size: 0.8rem; margin-top: 0.25rem; }
 .modal-close-btn { width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 9px; background: rgba(255,255,255,0.05); color: var(--text-2); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; transition: all 0.2s; flex-shrink: 0; }
 .modal-close-btn:hover { background: rgba(255,255,255,0.1); color: var(--text); transform: rotate(90deg); }
 .modal-footer { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); flex-wrap: wrap; }
 @media (max-width: 600px) {
 /* Keep modal CENTERED on mobile — bottom-sheet conflicts with virtual keyboard */
 .modal { align-items: center; padding: 1rem; }
 .modal-content { border-radius: 18px; width: 100%; max-height: 80vh; padding: 1.25rem 1rem; }
 .modal-footer { flex-direction: column; }
 .modal-footer .btn { width: 100%; justify-content: center; font-size: 1rem; padding: .875rem; }
 }

 /* ended banner */
 .qd-ended-banner {
 border-radius: 16px; padding: 1.375rem 1.5rem; margin-bottom: 1.5rem;
 display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
 animation: cardIn 0.5s ease both;
 }
 .qd-ended-banner--dist { background: rgba(255,152,0,0.08); border: 1px solid rgba(255,152,0,0.35); }
 .qd-ended-banner--done { background: rgba(76,175,80,0.08); border: 1px solid rgba(76,175,80,0.35); }
 .qd-ended-banner-icon { font-size: 2rem; flex-shrink: 0; }
 .qd-ended-banner-text h4 { font-size: 1.0625rem; font-weight: 800; margin-bottom: 0.25rem; }
 .qd-ended-banner-text p { font-size: 0.875rem; color: var(--text-2); line-height: 1.6; }

 /* user progress bar under leaderboard */
 .lb-my-progress {
 padding: 1rem 1.25rem; border-radius: 12px; margin-top: 1rem;
 background: rgba(94,194,19,0.06); border: 1px solid rgba(94,194,19,0.2);
 display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
 }
 .lb-my-progress-left { font-size: 0.875rem; color: var(--text-2); }
 .lb-my-progress-left strong { color: var(--green); }
 .lb-my-progress-right { font-size: 0.8rem; color: var(--text-3); }

 @media (max-width: 768px) {
 .qd-hero-content { padding: 1.5rem; min-height: 180px; }
 .qd-title { font-size: 1.5rem; }
 }
 </style>
</head>
<body>
 <div class="grid-bg"></div>
 <% const currentPage = 'quests'; %>
 <%- include('../partials/sidebar', { user, currentPage }) %>

 <div class="dashboard-container">
 <main class="main-content">
 <div class="content">
 <%
 /* ── Resolve quest image ── */
 function getQuestImage(q) {
 if (q.image) return { logo: q.image, isPartner: true };
 const t = (q.title || '').toLowerCase();
 const map = [
 { k:'eyecoin', v:'/img/partners/eyecoin.jpg' },
 { k:'ginox', v:'/img/partners/ginox.jpg' },
 { k:'twin3', v:'/img/partners/twin3.jpg' },
 { k:'aix', v:'/img/partners/aixpay.jpg' },
 { k:'tuition', v:'/img/partners/tuition.jpg' }
 ];
 for (const {k,v} of map) if (t.includes(k)) return { logo:v, isPartner:true };
 return { logo:'/img/logo.png', isPartner:false };
 }
 const qimg = getQuestImage(quest);
 %>

 <!-- Connection gate banner (populated by JS if needed) -->
 <div id="connectionGateBanner"></div>

 <!-- ══ ENDED BANNER ══ -->
 <% if (typeof questStatus !== 'undefined' && (questStatus === 'distributing' || questStatus === 'completed')) { %>
 <div class="qd-ended-banner <%= questStatus === 'distributing' ? 'qd-ended-banner--dist' : 'qd-ended-banner--done' %>">
 <div class="qd-ended-banner-icon">
 <% if (questStatus === 'distributing') { %>
 <i class="fas fa-hourglass-half" style="color:#fb923c"></i>
 <% } else { %>
 <i class="fas fa-check-circle" style="color:#4caf50"></i>
 <% } %>
 </div>
 <div class="qd-ended-banner-text">
 <% if (questStatus === 'distributing') { %>
 <h4 style="color:#fb923c">Quest Has Ended</h4>
 <p>Rewards are being distributed. Check the leaderboard for your final position!</p>
 <% } else { %>
 <h4 style="color:#4caf50">Quest Completed</h4>
 <p>This quest has ended and all rewards have been distributed.</p>
 <% } %>
 </div>
 </div>
 <% } %>

 <!-- ══ HERO CARD ══ -->
 <div class="qd-hero">
 <div class="qd-hero-bg"></div>
 <div class="qd-hero-overlay"></div>
 <div class="qd-hero-content">
 <div class="qd-hero-left">
 <a href="/dashboard/quests" class="qd-back"><i class="fas fa-arrow-left"></i> All Quests</a>
 <div class="qd-hero-badges">
 <% if (quest.questType && quest.questType !== 'standard') { %>
 <% if (quest.questType === 'referral_boost') { %><span class="qd-badge qd-badge--ref"><i class="fas fa-users"></i> Referral Boost</span>
 <% } else if (quest.questType === 'fcfs') { %><span class="qd-badge qd-badge--fcfs"><i class="fas fa-bolt"></i> First Come First Serve</span>
 <% } else if (quest.questType === 'competition') { %><span class="qd-badge qd-badge--comp"><i class="fas fa-trophy"></i> Competition</span>
 <% } else { %><span class="qd-badge qd-badge--type"><%= quest.questType %></span><% } %>
 <% } else { %><span class="qd-badge qd-badge--type">Quest</span><% } %>
 <span class="qd-badge qd-badge--diff"><%= quest.difficulty %></span>
 <span class="qd-badge qd-badge--diff"><%= quest.category %></span>
 <% if (questStatus === 'active') { %><span class="qd-badge" style="background:rgba(94,194,19,.12);color:#8ce66a;border:1px solid rgba(94,194,19,.3)"><i class="fas fa-circle" style="font-size:.45rem"></i> Campaign active</span><% } %>
 <% if (userProgress && userProgress.status === 'completed') { %><span class="qd-badge qd-badge--done"><i class="fas fa-check"></i> You completed</span><% } %>
 </div>
 <h1 class="qd-title"><%= quest.title %></h1>
 <p class="qd-short"><%= quest.shortDescription %></p>
 <div class="qd-reward-strip">
 <% if ((quest.baseXpReward || quest.xpReward) > 0) { %>
 <span class="qd-reward-pill qd-reward-pill--xp"><i class="fas fa-bolt"></i> <%= quest.baseXpReward || quest.xpReward %> XP</span>
 <% } %>
 <% if (quest.usdcReward > 0) { %>
 <span class="qd-reward-pill qd-reward-pill--usdc"><i class="fas fa-coins"></i> $<%= quest.usdcReward %> <%= quest.competitionConfig?.rankPercentages?.length ? 'prize pool' : quest.questType === 'fcfs' ? 'USDC per winner' : 'USDC' %></span>
 <% } %>
 <% if (userProgress && userProgress.status === 'completed' && userProgress.leaderboardRank) { %>
 <span class="qd-reward-pill" style="background:rgba(255,193,7,0.15);color:#fbbf24;border:1px solid rgba(255,193,7,0.3)"><i class="fas fa-medal"></i> Rank #<%= userProgress.leaderboardRank %></span>
 <% } %>
 </div>
 <% if (quest.telegramGroupLink) { %>
 <a href="<%= quest.telegramGroupLink %>" target="_blank" rel="noopener noreferrer"
 style="display:inline-flex;align-items:center;gap:.5rem;margin-top:.875rem;padding:.5rem 1.1rem;background:rgba(34,158,217,.15);border:1px solid rgba(34,158,217,.4);border-radius:20px;color:#38bdf8;font-size:.85rem;font-weight:700;text-decoration:none;transition:background .2s"
 onmouseover="this.style.background='rgba(34,158,217,.25)'" onmouseout="this.style.background='rgba(34,158,217,.15)'">
 <i class="fab fa-telegram" style="font-size:1rem"></i> Join Community
 </a>
 <% } %>
 </div>
 <div class="qd-hero-logo <%= !qimg.isPartner ? 'qd-hero-logo--brand' : '' %>">
 <img src="<%= qimg.logo %>" alt="<%= quest.title %>">
 </div>
 </div>
 </div>

 <!-- ══ GATED QUEST INFO (visible to ALL — sponsors + prize breakdown) ══ -->
 <% if (quest.gated && quest.memberApproval) { %>

 <!-- Sponsors row -->
 <% if (quest.sponsors && quest.sponsors.length > 0) { %>
 <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem">
 <span style="font-size:.78rem;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:1px">Hosted by</span>
 <% quest.sponsors.forEach(function(sp) { %>
 <div style="display:flex;align-items:center;gap:.4rem">
 <% if (sp.logo) { %>
 <div style="width:28px;height:28px;border-radius:7px;overflow:hidden;background:#fff;padding:3px;box-shadow:0 2px 8px rgba(0,0,0,.4)"><img src="<%= sp.logo %>" alt="<%= sp.name %>" style="width:100%;height:100%;object-fit:contain;border-radius:4px"></div>
 <% } %>
 <span style="font-size:.8375rem;font-weight:700;color:var(--text-2)"><%= sp.name %></span>
 </div>
 <% }); %>
 <span style="margin-left:auto;font-size:.78rem;color:var(--text-3)"><i class="fas fa-users"></i> <%= participantCount || 0 %> Raiders Enrolled</span>
 </div>
 <% } %>

 <!-- Prize distribution -->
 <% if (quest.prizeDistribution && quest.prizeDistribution.length) { %>
 <%
 var _prizeTotal = 0;
 quest.prizeDistribution.forEach(function(t){ _prizeTotal += t.amount * (t.to - t.from + 1); });
 var _topWin = quest.prizeDistribution[quest.prizeDistribution.length-1].to;
 var _tierColors = [
 { text:'#fbbf24', bg:'rgba(251,191,36,.08)', border:'rgba(251,191,36,.25)' },
 { text:'#9ca3af', bg:'rgba(156,163,175,.06)', border:'rgba(156,163,175,.2)' },
 { text:'#cd7f32', bg:'rgba(180,120,60,.06)', border:'rgba(180,120,60,.2)' },
 { text:'#60a5fa', bg:'rgba(96,165,250,.06)', border:'rgba(96,165,250,.2)' },
 { text:'#a78bfa', bg:'rgba(167,139,250,.06)', border:'rgba(167,139,250,.2)' }
 ];
 var _tierEmojis = ['','','','',''];
 var _ord = function(n){ return n===1?'1st':n===2?'2nd':n===3?'3rd':n+'th'; };
 %>
 <div class="card" style="margin-bottom:1.5rem;background:linear-gradient(135deg,rgba(251,191,36,.05) 0%,rgba(0,0,0,0) 100%);border-color:rgba(251,191,36,.2)">
 <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.125rem;flex-wrap:wrap;gap:.5rem">
 <h3 style="font-size:1rem;font-weight:900;color:var(--text);display:flex;align-items:center;gap:.5rem">
 <i class="fas fa-trophy" style="color:#fbbf24"></i> $<%= _prizeTotal %> Prize Pool
 </h3>
 <span style="font-size:.78rem;font-weight:700;color:#fbbf24;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.3);padding:.25rem .75rem;border-radius:50px">Top <%= _topWin %> Win</span>
 </div>
 <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.75rem">
 <% quest.prizeDistribution.forEach(function(tier, ti) {
 var tc = _tierColors[Math.min(ti, _tierColors.length-1)];
 var emoji = _tierEmojis[Math.min(ti, _tierEmojis.length-1)];
 var label = tier.from === tier.to ? _ord(tier.from) : (tier.from === 1 ? 'Top '+tier.to : _ord(tier.from)+' – '+_ord(tier.to));
 %>
 <div style="text-align:center;padding:1rem .75rem;border-radius:14px;background:<%= tc.bg %>;border:1px solid <%= tc.border %>">
 <div style="font-size:1.5rem;margin-bottom:.3rem"><%= emoji %></div>
 <div style="font-size:.75rem;font-weight:800;color:<%= tc.text %>;letter-spacing:.5px;text-transform:uppercase;margin-bottom:.25rem"><%= label %></div>
 <div style="font-size:1.375rem;font-weight:900;color:<%= tc.text %>;line-height:1">$<%= tier.amount %></div>
 <div style="font-size:.7rem;color:var(--text-3);margin-top:.25rem">per person</div>
 </div>
 <% }); %>
 </div>
 <% if (quest.slug === 'apex-raiders') { %>
 <p style="font-size:.82rem;color:#fbbf24;margin-top:.875rem;text-align:center"><strong>Reward update:</strong> This campaign ran for only one week, so the $100 pool is shared equally among ranks 1 through 20 ($5 each). Rewards have not yet been disbursed.</p>
 <% } %>
 <p style="font-size:.78rem;color:var(--text-3);margin-top:.875rem;text-align:center"><i class="fas fa-info-circle"></i> Rank higher by completing daily tasks and earning XP. Quality submissions earn bonus XP.</p>
 </div>
 <% } %>

 <% } %>

 <!-- ══ GATED QUEST GATE (code entry / pending / rejected — non-approved only) ══ -->
 <% if (quest.gated && quest.memberApproval && appState !== 'approved') { %>

 <!-- Steps -->
 <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-bottom:1.5rem">
 <% var steps=[{i:'fa-key',l:'Enter Code',n:1},{i:'fa-paper-plane',l:'Apply',n:2},{i:'fa-shield-check',l:'Get Approved',n:3},{i:'fa-list-check',l:'Complete Tasks',n:4}]; %>
 <% var curStep = (appState==='none'?1:appState==='pending'?3:appState==='rejected'?3:4); %>
 <% steps.forEach(function(s){ %>
 <div style="text-align:center;padding:.75rem .5rem;border-radius:12px;background:<%= s.n<=curStep?'rgba(94,194,19,.08)':'rgba(255,255,255,.03)' %>;border:1px solid <%= s.n<=curStep?'rgba(94,194,19,.25)':'rgba(255,255,255,.07)' %>">
 <div style="width:32px;height:32px;border-radius:50%;margin:0 auto .4rem;display:flex;align-items:center;justify-content:center;background:<%= s.n<=curStep?'rgba(94,194,19,.18)':'rgba(255,255,255,.06)' %>;color:<%= s.n<=curStep?'var(--green)':'var(--text-3)' %>;font-size:.8rem"><i class="fas <%= s.i %>"></i></div>
 <div style="font-size:.7rem;font-weight:700;color:<%= s.n<=curStep?'var(--text-2)':'var(--text-3)' %>"><%= s.l %></div>
 </div>
 <% }); %>
 </div>

 <!-- Gate state card -->
 <div class="card" style="max-width:520px;margin:0 auto">

 <% if (appState === 'none') { %>
 <!-- STEP 1: Code entry -->
 <div id="gateStep1">
 <div style="text-align:center;margin-bottom:1.5rem">
 <div style="width:56px;height:56px;border-radius:16px;background:rgba(245,158,11,.1);border:1.5px solid rgba(245,158,11,.3);display:flex;align-items:center;justify-content:center;font-size:1.375rem;color:#fbbf24;margin:0 auto .875rem">
 <i class="fas fa-key"></i>
 </div>
 <h3 style="font-size:1.125rem;font-weight:900;color:var(--text);margin-bottom:.35rem">Access Code Required</h3>
 <p style="color:var(--text-3);font-size:.875rem">Enter your Apex Raiders access code to join the campaign</p>
 </div>
 <div id="gateCodeErr" style="display:none;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:.75rem 1rem;font-size:.8375rem;color:#f87171;margin-bottom:1rem"></div>
 <input type="text" id="gateCodeInput" placeholder="Enter access code (e.g. APRAI2526)" style="width:100%;box-sizing:border-box;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:.875rem 1.125rem;color:var(--text);font-family:'Outfit',sans-serif;font-size:1rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;outline:none;margin-bottom:1rem">
 <button onclick="verifyCode()" style="width:100%;padding:.875rem;border-radius:12px;background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#000;border:none;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.9375rem;font-weight:800">
 <i class="fas fa-arrow-right"></i> Verify Code
 </button>
 </div>

 <!-- STEP 2: Application form (shown after code verified) -->
 <div id="gateStep2" style="display:none">
 <div style="text-align:center;margin-bottom:1.5rem">
 <div style="width:56px;height:56px;border-radius:16px;background:rgba(94,194,19,.1);border:1.5px solid rgba(94,194,19,.3);display:flex;align-items:center;justify-content:center;font-size:1.375rem;color:var(--green);margin:0 auto .875rem">
 <i class="fas fa-check"></i>
 </div>
 <h3 style="font-size:1.125rem;font-weight:900;color:var(--green);margin-bottom:.35rem">Code Verified!</h3>
 <p style="color:var(--text-3);font-size:.875rem">Now submit your X handle and Telegram username for admin review</p>
 </div>
 <div id="gateAppErr" style="display:none;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:.75rem 1rem;font-size:.8375rem;color:#f87171;margin-bottom:1rem"></div>
 <div style="margin-bottom:.875rem">
 <label style="display:block;font-size:.8125rem;font-weight:700;color:var(--text-2);margin-bottom:.4rem"><i class="fab fa-x-twitter"></i> X (Twitter) Handle</label>
 <input type="text" id="xHandleInput" placeholder="@yourhandle" style="width:100%;box-sizing:border-box;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:.75rem 1rem;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9375rem;outline:none">
 </div>
 <div style="margin-bottom:1.25rem">
 <label style="display:block;font-size:.8125rem;font-weight:700;color:var(--text-2);margin-bottom:.4rem"><i class="fab fa-telegram"></i> Telegram Username</label>
 <input type="text" id="telegramInput" placeholder="@yourusername" style="width:100%;box-sizing:border-box;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:.75rem 1rem;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9375rem;outline:none">
 </div>
 <button onclick="submitApplication()" style="width:100%;padding:.875rem;border-radius:12px;background:linear-gradient(135deg,var(--green),var(--green-dark));color:#000;border:none;cursor:pointer;font-family:'Outfit',sans-serif;font-size:.9375rem;font-weight:800">
 <i class="fas fa-paper-plane"></i> Submit Application
 </button>
 </div>

 <% } else if (appState === 'pending') { %>
 <div style="text-align:center;padding:1rem 0">
 <div style="width:64px;height:64px;border-radius:20px;background:rgba(245,158,11,.1);border:1.5px solid rgba(245,158,11,.3);display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:#fbbf24;margin:0 auto 1.25rem">
 <i class="fas fa-hourglass-half"></i>
 </div>
 <h3 style="font-size:1.125rem;font-weight:900;color:#fbbf24;margin-bottom:.5rem">Application Pending</h3>
 <p style="color:var(--text-2);font-size:.9rem;line-height:1.65;margin-bottom:1.25rem">Your application is under review. Admin will approve or reject it shortly. Check back soon!</p>
 <% if (application) { %>
 <div style="background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:12px;padding:1rem;text-align:left">
 <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;font-size:.8375rem"><span style="color:var(--text-3)">X Handle</span><span style="color:var(--text-2);font-weight:700"><%= application.xHandle || '—' %></span></div>
 <div style="display:flex;justify-content:space-between;font-size:.8375rem"><span style="color:var(--text-3)">Telegram</span><span style="color:var(--text-2);font-weight:700"><%= application.telegramUsername || '—' %></span></div>
 </div>
 <% } %>
 </div>

 <% } else if (appState === 'rejected') { %>
 <div style="text-align:center;padding:1rem 0">
 <div style="width:64px;height:64px;border-radius:20px;background:rgba(239,68,68,.1);border:1.5px solid rgba(239,68,68,.3);display:flex;align-items:center;justify-content:font-size:1.75rem;color:#f87171;margin:0 auto 1.25rem;display:flex;align-items:center;justify-content:center;font-size:1.75rem">
 <i class="fas fa-times-circle"></i>
 </div>
 <h3 style="font-size:1.125rem;font-weight:900;color:#f87171;margin-bottom:.5rem">Application Rejected</h3>
 <% if (application && application.rejectionReason) { %>
 <p style="color:var(--text-2);font-size:.875rem;line-height:1.65;margin-bottom:1rem">Reason: <strong style="color:var(--text)"><%= application.rejectionReason %></strong></p>
 <% } else { %>
 <p style="color:var(--text-2);font-size:.875rem;line-height:1.65;margin-bottom:1rem">Your application was not approved at this time.</p>
 <% } %>
 <p style="color:var(--text-3);font-size:.8125rem">Contact support if you think this is a mistake.</p>
 </div>
 <% } %>

 </div><!-- /gate card -->

 <script>
 var _gateQuestId = '<%= quest._id %>';
 function verifyCode() {
 var code = document.getElementById('gateCodeInput').value.trim();
 if (!code) return;
 fetch('/api/quests/' + _gateQuestId + '/apply-code', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ code: code })
 }).then(function(r) { return r.json(); }).then(function(d) {
 if (d.success) {
 document.getElementById('gateStep1').style.display = 'none';
 document.getElementById('gateStep2').style.display = 'block';
 } else {
 var el = document.getElementById('gateCodeErr');
 el.textContent = d.message || 'Invalid code';
 el.style.display = 'block';
 }
 }).catch(function() {
 var el = document.getElementById('gateCodeErr');
 el.textContent = 'Network error. Please try again.';
 el.style.display = 'block';
 });
 }
 function submitApplication() {
 var x = document.getElementById('xHandleInput').value.trim();
 var tg = document.getElementById('telegramInput').value.trim();
 fetch('/api/quests/' + _gateQuestId + '/apply', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({ xHandle: x, telegramUsername: tg })
 }).then(function(r) { return r.json(); }).then(function(d) {
 if (d.success) {
 window.location.reload();
 } else {
 var el = document.getElementById('gateAppErr');
 el.textContent = d.message || 'Error submitting application';
 el.style.display = 'block';
 }
 }).catch(function() {
 var el = document.getElementById('gateAppErr');
 el.textContent = 'Network error. Please try again.';
 el.style.display = 'block';
 });
 }
 document.getElementById('gateCodeInput') && document.getElementById('gateCodeInput').addEventListener('keypress', function(e) {
 if (e.key === 'Enter') verifyCode();
 });
 </script>

 <% } else if (userProgress) { %>
 <!-- ══ PROGRESS ══ -->
 <div class="qd-progress-card">
 <div class="qd-progress-top">
 <span class="qd-progress-label">Your Progress</span>
 <span class="qd-progress-pct" id="progPct"><%= userProgress.progress %>%</span>
 </div>
 <div class="qd-progress-bar">
 <div class="qd-progress-fill" id="progFill" style="width:0%"></div>
 </div>
 <div class="qd-progress-meta">
 <span><i class="fas fa-tasks" style="color:var(--green)"></i> <%= userProgress.tasksCompleted %>/<%= quest.tasks.length %> tasks done</span>
 <span><i class="fas fa-clock" style="color:var(--green)"></i> ~<%= quest.estimatedDuration %></span>
 </div>
 <div class="qd-info-row">
 <div class="qd-info-pill">
 <div class="qd-info-pill-val"><%= quest.totalParticipants %></div>
 <div class="qd-info-pill-lbl">Builders</div>
 </div>
 <div class="qd-info-pill">
 <div class="qd-info-pill-val"><%= quest.totalCompletions %></div>
 <div class="qd-info-pill-lbl">Completions</div>
 </div>
 <div class="qd-info-pill">
 <div class="qd-info-pill-val"><%= quest.tasks.length %></div>
 <div class="qd-info-pill-lbl">Tasks</div>
 </div>
 <% if (userProgress.timeSpentMinutes) { %>
 <div class="qd-info-pill">
 <div class="qd-info-pill-val"><%= userProgress.timeSpentMinutes %>m</div>
 <div class="qd-info-pill-lbl">Time Spent</div>
 </div>
 <% } %>
 </div>
 </div>

 <!-- ══ COUNTDOWN ══ -->
 <% if (quest.endDate) { %>
 <div id="questCountdown" class="qd-countdown">
 <div>
 <div class="qd-countdown-label"><i class="fas fa-clock"></i> Quest Ending In</div>
 <div id="countdownDisplay" class="qd-countdown-time">
 <span id="days">00</span>d <span id="hours">00</span>h <span id="minutes">00</span>m <span id="seconds">00</span>s
 </div>
 <div class="qd-countdown-sub">Ends: <%= new Date(quest.endDate).toLocaleString('en-US', { weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></div>
 </div>
 <div id="urgencyIndicator" class="qd-urgency"></div>
 </div>
 <% } else { %>
 <div style="display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:13px;background:rgba(94,194,19,0.05);border:1px solid rgba(94,194,19,0.2);">
 <i class="fas fa-infinity" style="color:var(--green);font-size:1.25rem"></i>
 <div>
 <div style="color:var(--green);font-weight:800;font-size:.875rem">No Time Limit</div>
 <div style="color:var(--text-3);font-size:.75rem">This quest is available indefinitely</div>
 </div>
 </div>
 <% } %>

 <!-- ══ XP BREAKDOWN ══ -->
 <% if (userProgress.status === 'completed' && userProgress.xpBreakdown) { %>
 <div class="card" style="border-color:rgba(94,194,19,0.3);background:linear-gradient(135deg,rgba(94,194,19,0.07),rgba(14,24,14,0.95));animation-delay:60ms">
 <div class="card-header">
 <h3><i class="fas fa-trophy"></i> XP Breakdown — Quest Complete!</h3>
 </div>
