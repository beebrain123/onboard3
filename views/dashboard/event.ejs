<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Events - ONBOARD3</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <%- include('../partials/achievement-popup') %>
 <link rel="stylesheet" href="/css/dashboard.css">
 <style>
 /* ── Event Card Grid ── */
 .ev-grid {
 display: grid;
 grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
 gap: 1rem;
 padding: 1rem;
 }

 .ev-card {
 display: flex;
 flex-direction: column;
 border-radius: 12px;
 overflow: hidden;
 background: var(--card-bg, #0f1a0d);
 border: 1px solid rgba(255,255,255,.07);
 text-decoration: none;
 color: inherit;
 transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
 }
 .ev-card:hover {
 transform: translateY(-3px);
 box-shadow: 0 8px 28px rgba(0,0,0,.45);
 border-color: rgba(255,255,255,.14);
 }

 /* Image / banner area */
 .ev-card-img {
 position: relative;
 height: 160px;
 background: linear-gradient(135deg,#0d2b0a 0%,#1a4a15 100%);
 flex-shrink: 0;
 }
 .ev-card-img-overlay {
 position: absolute;
 inset: 0;
 background: linear-gradient(to bottom, rgba(0,0,0,.15) 0%, rgba(0,0,0,.55) 100%);
 }

 .ev-card-badges {
 position: absolute;
 top: .6rem;
 left: .6rem;
 display: flex;
 gap: .35rem;
 flex-wrap: wrap;
 }
 .ev-card-type-badge {
 position: absolute;
 bottom: .6rem;
 right: .6rem;
 background: rgba(0,0,0,.55);
 color: #ccc;
 border: 1px solid rgba(255,255,255,.15);
 border-radius: 20px;
 padding: .2rem .55rem;
 font-size: .62rem;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: .03em;
 backdrop-filter: blur(4px);
 }

 /* Body */
 .ev-card-body {
 display: flex;
 flex-direction: column;
 flex: 1;
 padding: .9rem 1rem .8rem;
 gap: .45rem;
 }
 .ev-card-title {
 font-size: .95rem;
 font-weight: 700;
 color: var(--text-1, #e8f5e4);
 margin: 0;
 line-height: 1.35;
 display: -webkit-box;
 -webkit-line-clamp: 2;
 -webkit-box-orient: vertical;
 overflow: hidden;
 }
 .ev-card-meta {
 display: flex;
 flex-direction: column;
 gap: .22rem;
 }
 .ev-card-meta span {
 font-size: .75rem;
 color: var(--text-3, #7a9a76);
 display: flex;
 align-items: center;
 gap: .35rem;
 }
 .ev-card-meta i {
 width: 12px;
 opacity: .7;
 flex-shrink: 0;
 }

 .ev-card-footer {
 display: flex;
 align-items: center;
 justify-content: space-between;
 margin-top: auto;
 padding-top: .5rem;
 border-top: 1px solid rgba(255,255,255,.06);
 }
 .ev-card-attendees {
 font-size: .75rem;
 color: var(--green, #5ec213);
 font-weight: 600;
 display: flex;
 align-items: center;
 gap: .3rem;
 }
 .ev-card-cta {
 font-size: .72rem;
 font-weight: 700;
 color: var(--text-3, #7a9a76);
 text-transform: uppercase;
 letter-spacing: .04em;
 display: flex;
 align-items: center;
 gap: .3rem;
 transition: color .15s;
 }
 .ev-card:hover .ev-card-cta {
 color: var(--green, #5ec213);
 }

 /* Skeletons */
 .ev-card-skeleton {
 border-radius: 12px;
 overflow: hidden;
 background: var(--card-bg, #0f1a0d);
 border: 1px solid rgba(255,255,255,.07);
 }
 .ev-card-img-skeleton {
 height: 160px;
 background: linear-gradient(90deg, rgba(255,255,255,.04) 25%, rgba(255,255,255,.08) 50%, rgba(255,255,255,.04) 75%);
 background-size: 200% 100%;
 animation: sk-shimmer 1.4s infinite;
 }
 .sk-line {
 border-radius: 4px;
 background: linear-gradient(90deg, rgba(255,255,255,.05) 25%, rgba(255,255,255,.09) 50%, rgba(255,255,255,.05) 75%);
 background-size: 200% 100%;
 animation: sk-shimmer 1.4s infinite;
 display: block;
 }
 @keyframes sk-shimmer {
 0% { background-position: 200% 0; }
 100% { background-position: -200% 0; }
 }

 /* Section wrapper */
 .ev-section {
 margin-bottom: 1.5rem;
 }
 .ev-section-header {
 display: flex;
 align-items: center;
 gap: .6rem;
 padding: 1.2rem 1.2rem .6rem;
 font-size: .8rem;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: .06em;
 color: var(--text-3, #7a9a76);
 border-bottom: 1px solid rgba(255,255,255,.06);
 margin-bottom: 0;
 }
 .ev-section-header i {
 color: var(--green, #5ec213);
 font-size: .85rem;
 }

 @media (max-width: 500px) {
 .ev-grid { grid-template-columns: 1fr; padding: .75rem; }
 }
 </style>
</head>
<body>
 <div class="grid-bg"></div>

 <% const currentPage = 'events'; %>
 <%- include('../partials/sidebar', { user, currentPage }) %>

 <div class="dashboard-container">
 <main class="main-content">
 <header class="header">
 <div class="header-content">
 <div class="header-title">
 <h2><i class="fas fa-calendar-alt" style="color:var(--green);margin-right:.5rem"></i>Events</h2>
 <p>Join upcoming events, hackathons, and meetups</p>
 </div>
 </div>
 </header>

 <div class="content">
 <!-- My Registered Events -->
 <div class="card ev-section">
 <div class="ev-section-header">
 <i class="fas fa-check-circle"></i> My Registered Events
 </div>
 <div id="userRegisteredEventsContainer" class="ev-grid"></div>
 </div>

 <!-- Upcoming Events -->
 <div class="card ev-section">
 <div class="ev-section-header">
 <i class="fas fa-calendar"></i> Upcoming Events
 </div>
 <div id="activeEventsContainer" class="ev-grid"></div>
 </div>

 <!-- Past Events -->
 <div class="card ev-section">
 <div class="ev-section-header">
 <i class="fas fa-history"></i> Past Events
 </div>
 <div id="pastEventsContainer" class="ev-grid"></div>
 </div>
 </div>
 </main>
 </div>

 <script src="/js/eventList.js"></script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
