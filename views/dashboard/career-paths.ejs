<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<%- include('../partials/achievement-popup') %>
<link rel="stylesheet" href="/css/dashboard.css">
<style>
/* ── Page ── */
.cp-page { background: transparent }

/* ── Hero header ── */
.cp-hero {
  padding: 2rem 2rem 1.5rem;
  border-bottom: 1px solid var(--border);
}
.cp-hero-title {
  font-size: clamp(1.6rem,3vw,2.25rem);
  font-weight: 900;
  letter-spacing: -1.5px;
  color: var(--text);
  line-height: 1;
  margin-bottom: .4rem;
}
.cp-hero-sub { font-size: .9rem; color: var(--text-3); }

/* ── Banner (no-pathway prompt) ── */
.cp-banner {
  display: flex; align-items: center; gap: .875rem;
  background: rgba(94,194,19,.05);
  border: 1px solid rgba(94,194,19,.18);
  border-radius: 14px;
  padding: .875rem 1.125rem;
  margin-bottom: 1.75rem;
  font-size: .85rem; color: var(--text-2);
}
.cp-banner a { color: var(--green); font-weight: 800; text-decoration: none }

/* ── Grid ── */
.cp-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px,1fr));
  gap: 1.25rem;
}
@media (min-width: 1400px) { .cp-grid { grid-template-columns: repeat(3, 1fr) } }
@media (max-width: 720px)  { .cp-grid { grid-template-columns: 1fr } }

/* ── Card ── */
.cp-card {
  border-radius: 20px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,.022);
  display: flex; flex-direction: column;
  text-decoration: none;
  overflow: hidden;
  transition: transform .22s, border-color .22s, box-shadow .22s;
  position: relative;
}
.cp-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,.45);
}
.cp-card--mine {
  border-color: var(--card-accent);
  box-shadow: 0 0 0 1px var(--card-accent-border), 0 8px 28px rgba(0,0,0,.35);
}

/* ── Accent stripe (top colour bar) ── */
.cp-accent {
  height: 4px;
  background: var(--card-accent);
  opacity: .65;
}
.cp-card--mine .cp-accent { opacity: 1 }

/* ── Card image / icon area ── */
.cp-card-top {
  padding: 1.375rem 1.375rem .875rem;
}
.cp-card-row {
  display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem;
}
.cp-icon {
  width: 50px; height: 50px;
  border-radius: 14px;
  background: var(--card-bg);
  border: 1px solid var(--card-accent-border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-size: 1.25rem;
  color: var(--card-color);
  box-shadow: 0 0 18px var(--card-glow);
}
.cp-badges { display: flex; flex-direction: column; align-items: flex-end; gap: .3rem }
.cp-badge {
  display: inline-flex; align-items: center; gap: .325rem;
  border-radius: 99px; padding: .22rem .65rem;
  font-size: .62rem; font-weight: 800; letter-spacing: .5px;
  white-space: nowrap;
}
.cp-badge--mine {
  background: var(--card-bg);
  border: 1px solid var(--card-accent-border);
  color: var(--card-color);
}
.cp-badge--live {
  background: rgba(239,68,68,.15);
  border: 1px solid rgba(239,68,68,.35);
  color: #ef4444;
}

/* ── Card body ── */
.cp-card-body { padding: 0 1.375rem 1.375rem; flex: 1; display: flex; flex-direction: column }

.cp-name {
  font-size: 1.05rem; font-weight: 900; color: var(--text);
  margin: .625rem 0 .2rem; line-height: 1.2;
}
.cp-tagline { font-size: .78rem; color: var(--text-3); line-height: 1.55; margin-bottom: 1rem }

/* ── Lead ── */
.cp-lead {
  display: flex; align-items: center; gap: .625rem;
  padding: .625rem .75rem;
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  border: 1px solid rgba(255,255,255,.06);
  margin-bottom: 1rem;
}
.cp-lead-av {
  width: 30px; height: 30px; border-radius: 50%;
  background: var(--card-bg); border: 1.5px solid var(--card-accent-border);
  display: flex; align-items: center; justify-content: center;
  font-size: .72rem; font-weight: 800; color: var(--card-color);
  flex-shrink: 0; overflow: hidden;
}
.cp-lead-av img { width: 100%; height: 100%; object-fit: cover }
.cp-lead-name { font-size: .75rem; font-weight: 700; color: var(--text-2) }
.cp-lead-role { font-size: .65rem; color: var(--text-3) }

/* ── Footer ── */
.cp-card-foot {
  margin-top: auto;
  display: flex; align-items: center; justify-content: space-between;
  padding-top: .875rem;
  border-top: 1px solid rgba(255,255,255,.055);
}
.cp-count { font-size: .75rem; color: var(--text-3) }
.cp-cta {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .78rem; font-weight: 800;
  color: var(--card-color);
  background: var(--card-bg);
  border: 1px solid var(--card-accent-border);
  border-radius: 9px;
  padding: .38rem .85rem;
  text-decoration: none;
  transition: all .18s;
}
.cp-card:hover .cp-cta {
  background: var(--card-accent-hover);
}

@keyframes livePulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
</style>
</head>
<body>
<div class="grid-bg"></div>
<%- include('../partials/sidebar', { user, currentPage, pathwaySlug }) %>

<div class="dashboard-container">
<main class="main-content cp-page">

<div class="cp-hero">
  <h1 class="cp-hero-title"><i class="fas fa-road" style="color:var(--green);margin-right:.5rem;font-size:1.5rem;vertical-align:middle"></i>Career Paths</h1>
  <p class="cp-hero-sub">Pick your lane, build your skills, and connect with your community.</p>
</div>

<div class="content" style="max-width:1120px">

<% if (!user.pathway && (!myLeadPaths || !myLeadPaths.length)) { %>
<div style="text-align:center;padding:4rem 1rem">
  <i class="fas fa-road" style="font-size:2.5rem;color:var(--text-3);opacity:.3;display:block;margin-bottom:1rem"></i>
  <p style="font-size:1rem;font-weight:800;color:var(--text-2);margin-bottom:.5rem">No pathway selected yet</p>
  <p style="font-size:.85rem;color:var(--text-3);margin-bottom:1.5rem">Head to your dashboard to choose a Career Path and unlock your community.</p>
  <a href="/dashboard" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(94,194,19,.12);border:1px solid rgba(94,194,19,.3);color:var(--green);border-radius:10px;padding:.6rem 1.25rem;font-size:.85rem;font-weight:800;text-decoration:none">
    <i class="fas fa-arrow-right"></i> Go to Dashboard
  </a>
</div>
<% } %>

<div class="cp-grid">
<% PATHWAYS.forEach(pw => {
  const m        = PATHWAY_META[pw];
  const cfg      = cfgMap[pw] || {};
  const cnt      = cntMap[pw] || 0;
  const live     = liveSet.includes(pw);
  const lead     = cfg.leadUserId ? leadMap[cfg.leadUserId.toString()] : null;
  const isMyPath = user.pathway === pw;
  const isMyLead = myLeadPaths && myLeadPaths.includes(pw);
%>
<a href="/dashboard/career-paths/<%= pw %>" class="cp-card <%= isMyPath ? 'cp-card--mine' : '' %>"
   style="--card-color:<%= m.color %>;--card-bg:<%= m.bg %>;--card-accent:<%= m.color %>55;--card-accent-border:<%= m.border %>;--card-glow:<%= m.color %>18;--card-accent-hover:<%= m.color %>22">

  <div class="cp-accent"></div>

  <div class="cp-card-top">
    <div class="cp-card-row">
      <div class="cp-icon">
        <i class="fas <%= m.icon %>"></i>
      </div>
      <div class="cp-badges">
        <% if (isMyPath) { %>
        <span class="cp-badge cp-badge--mine"><i class="fas fa-check-circle" style="font-size:.55rem"></i> YOUR PATH</span>
        <% } %>
        <% if (isMyLead) { %>
        <span class="cp-badge" style="background:rgba(251,191,36,.15);border-color:rgba(251,191,36,.4);color:#fbbf24"><i class="fas fa-star" style="font-size:.55rem"></i> LEAD</span>
        <% } %>
        <% if (live) { %>
        <span class="cp-badge cp-badge--live"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;animation:livePulse 1.4s ease-in-out infinite;display:inline-block"></span> LIVE NOW</span>
        <% } %>
      </div>
    </div>

    <h3 class="cp-name"><%= m.name %></h3>
    <p class="cp-tagline"><%= cfg.tagline || m.tagline %></p>
  </div>

  <div class="cp-card-body">
    <% if (lead) { %>
    <div class="cp-lead">
      <div class="cp-lead-av">
        <% if (lead.profilePicture) { %><img src="<%= lead.profilePicture %>" alt=""><% } else { %><%= lead.username.charAt(0).toUpperCase() %><% } %>
      </div>
      <div>
        <div class="cp-lead-name"><%= cfg.leadName || lead.username %></div>
        <div class="cp-lead-role">Pathway Lead</div>
      </div>
    </div>
    <% } %>

    <div class="cp-card-foot">
      <span class="cp-count"><i class="fas fa-layer-group" style="margin-right:.35rem;opacity:.5"></i><%= cnt %> resource<%= cnt !== 1 ? 's' : '' %></span>
      <span class="cp-cta">View Pathway <i class="fas fa-arrow-right" style="font-size:.65rem"></i></span>
    </div>
  </div>
</a>
<% }) %>
</div>

</div>
</main>
</div>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
